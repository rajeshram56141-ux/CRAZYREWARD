<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>Redis Cache Management - Crazyreward Admin</title>
    <link rel="stylesheet" href="/css/admin.css">
    <link rel="icon" href="/images/favicon.png">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg: #f8fafc;
            --surface: #ffffff;
            --border: #e2e8f0;
            --primary: #052e1f;
            --primary-hover: #042418;
            --text: #0f172a;
            --muted: #64748b;
        }

        * {
            box-sizing: border-box;
            font-family: 'Plus Jakarta Sans', sans-serif;
        }

        body {
            margin: 0;
            background: var(--bg);
            color: var(--text);
        }

        .glass-card {
            background: #ffffff;
            border-radius: 20px;
            padding: 24px;
            margin-bottom: 24px;
            box-shadow: 0 4px 16px rgba(0, 0, 0, 0.03);
            border: 1px solid var(--border);
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

        .redis-badge {
            display: inline-flex;
            align-items: center;
            padding: 6px 14px;
            border-radius: 999px;
            font-size: 12px;
            font-weight: 800;
        }

        .badge-online { background: #dcfce7; color: #15803d; border: 1px solid #bbf7d0; }
        .badge-fallback { background: #fef3c7; color: #b45309; border: 1px solid #fde68a; }
        .badge-offline { background: #fef2f2; color: #dc2626; border: 1px solid #fecaca; }

        .redis-metrics {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 16px;
            margin-top: 20px;
        }

        .redis-stat {
            background: #ffffff;
            border-radius: 16px;
            padding: 18px;
            border: 1px solid var(--border);
            box-shadow: 0 2px 8px rgba(0,0,0,0.02);
        }

        .redis-stat-val {
            font-size: 20px;
            font-weight: 800;
            color: #052e1f;
            margin-top: 4px;
        }

        .redis-stat-lbl {
            font-size: 11px;
            font-weight: 700;
            color: var(--muted);
            text-transform: uppercase;
            letter-spacing: 0.04em;
        }

        .btn-action-primary {
            background: #052e1f;
            color: #ffffff;
            border: none;
            border-radius: 12px;
            padding: 10px 18px;
            font-size: 13px;
            font-weight: 700;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: all 0.2s ease;
        }

        .btn-action-primary:hover {
            background: #042418;
            transform: translateY(-1px);
        }

        .btn-toggle-off {
            background: #fee2e2;
            color: #b91c1c;
            border: 1px solid #fca5a5;
            border-radius: 12px;
            padding: 10px 18px;
            font-size: 13px;
            font-weight: 700;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: all 0.2s ease;
        }

        .btn-toggle-off:hover {
            background: #fecaca;
        }

        .btn-toggle-on {
            background: #dcfce7;
            color: #15803d;
            border: 1px solid #86efac;
            border-radius: 12px;
            padding: 10px 18px;
            font-size: 13px;
            font-weight: 700;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: all 0.2s ease;
        }

        .btn-toggle-on:hover {
            background: #bbf7d0;
        }

        .btn-danger-lg {
            background: #dc2626;
            color: white;
            border: none;
            padding: 10px 18px;
            border-radius: 12px;
            font-size: 13px;
            font-weight: 700;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: background 0.2s ease, transform 0.1s ease;
            box-shadow: 0 4px 12px rgba(220, 38, 38, 0.2);
        }

        .btn-danger-lg:hover { 
            background: #b91c1c; 
            transform: translateY(-1px);
        }

        .form-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: 20px;
            margin-top: 16px;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .form-label {
            font-size: 12px;
            font-weight: 700;
            color: #0f172a;
        }

        .form-hint {
            font-size: 11px;
            color: var(--muted);
            line-height: 1.4;
        }

        .form-input {
            padding: 10px 14px;
            border-radius: 10px;
            border: 1px solid var(--border);
            font-size: 14px;
            font-weight: 600;
            color: #0f172a;
            background: #f8fafc;
            transition: all 0.2s ease;
        }

        .form-input:focus {
            outline: none;
            border-color: #052e1f;
            background: #ffffff;
            box-shadow: 0 0 0 3px rgba(5, 46, 31, 0.1);
        }

        /* Table Styling */
        .table-container {
            border: 1px solid var(--border);
            border-radius: 16px;
            overflow: auto;
            margin-top: 14px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th, td {
            padding: 12px 16px;
            font-size: 13px;
            border-bottom: 1px solid var(--border);
            vertical-align: middle;
        }

        th {
            background: #052e1f;
            color: #ffffff;
            font-weight: 700;
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            text-align: left;
        }

        code {
            font-family: 'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, monospace;
            background: #f1f5f9;
            padding: 4px 8px;
            border-radius: 6px;
            color: #0f172a;
            font-size: 12px;
            border: 1px solid #cbd5e1;
        }

        .badge-type {
            font-size: 11px;
            font-weight: 800;
            padding: 3px 8px;
            border-radius: 6px;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            display: inline-block;
        }
        .badge-type-string { background: #e0f2fe; color: #0369a1; border: 1px solid #bae6fd; }
        .badge-type-zset { background: #f3e8ff; color: #7e22ce; border: 1px solid #e9d5ff; }
        .badge-type-hash { background: #fef3c7; color: #b45309; border: 1px solid #fde68a; }
        .badge-type-set { background: #fce7f3; color: #be185d; border: 1px solid #fbcfe8; }
        .badge-type-list { background: #ecfdf5; color: #047857; border: 1px solid #a7f3d0; }
        .badge-type-memory { background: #f1f5f9; color: #475569; border: 1px solid #cbd5e1; }
        .badge-ttl {
            font-size: 12px;
            font-weight: 700;
            color: #065f46;
            background: #ecfdf5;
            padding: 3px 8px;
            border-radius: 6px;
            border: 1px solid #a7f3d0;
            display: inline-flex;
            align-items: center;
            gap: 5px;
            white-space: nowrap;
        }
        .badge-ttl-perm {
            font-size: 12px;
            font-weight: 600;
            color: #475569;
            background: #f1f5f9;
            padding: 3px 8px;
            border-radius: 6px;
            border: 1px solid #cbd5e1;
            display: inline-flex;
            align-items: center;
            gap: 5px;
            white-space: nowrap;
        }
        .badge-ttl-exp {
            font-size: 12px;
            font-weight: 600;
            color: #991b1b;
            background: #fee2e2;
            padding: 3px 8px;
            border-radius: 6px;
            border: 1px solid #fecaca;
            display: inline-flex;
            align-items: center;
            gap: 5px;
            white-space: nowrap;
        }
        .code-preview {
            max-width: 260px;
            display: inline-block;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            vertical-align: middle;
            color: #334155;
            background: #f8fafc;
        }

        .btn-modal-open {
            background: #e0f2fe;
            color: #0369a1;
            border: 1px solid #bae6fd;
            border-radius: 7px;
            padding: 4px 10px;
            font-size: 11px;
            font-weight: 700;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 5px;
            transition: all 0.15s ease;
            white-space: nowrap;
        }

        .btn-modal-open:hover {
            background: #0284c7;
            color: #ffffff;
            border-color: #0284c7;
            transform: translateY(-1px);
        }

        /* Value Inspector Modal */
        .modal-backdrop {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background: rgba(15, 23, 42, 0.65);
            backdrop-filter: blur(5px);
            z-index: 10000;
            display: none;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .modal-card {
            background: #ffffff;
            border-radius: 20px;
            width: 100%;
            max-width: 840px;
            max-height: 85vh;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
            display: flex;
            flex-direction: column;
            border: 1px solid var(--border);
            overflow: hidden;
            animation: popIn 0.22s cubic-bezier(0.16, 1, 0.3, 1);
        }

        @keyframes popIn {
            from { transform: scale(0.96); opacity: 0; }
            to { transform: scale(1); opacity: 1; }
        }

        .modal-header {
            padding: 16px 22px;
            background: #f8fafc;
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
        }

        .modal-close-btn {
            background: #e2e8f0;
            border: none;
            width: 32px;
            height: 32px;
            border-radius: 8px;
            cursor: pointer;
            font-size: 15px;
            font-weight: 800;
            color: #475569;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s ease;
        }

        .modal-close-btn:hover {
            background: #cbd5e1;
            color: #0f172a;
        }

        .modal-body {
            padding: 20px 22px;
            overflow-y: auto;
            flex: 1;
        }

        .modal-code-pre {
            background: #0f172a;
            color: #38bdf8;
            padding: 16px 18px;
            border-radius: 12px;
            font-size: 12.5px;
            font-family: 'SFMono-Regular', Consolas, Menlo, monospace;
            line-height: 1.6;
            margin: 0;
            overflow-x: auto;
            max-height: 55vh;
            white-space: pre-wrap;
            word-break: break-all;
            border: 1px solid #1e293b;
        }

        .btn-copy-val {
            background: #e2e8f0;
            color: #0f172a;
            border: none;
            padding: 6px 12px;
            border-radius: 8px;
            font-size: 12px;
            font-weight: 700;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            transition: all 0.2s ease;
        }

        .btn-copy-val:hover {
            background: #cbd5e1;
        }

        /* Toast notification */
        #toast {
            position: fixed;
            bottom: 24px;
            right: 24px;
            background: #052e1f;
            color: white;
            padding: 14px 22px;
            border-radius: 12px;
            font-size: 13px;
            font-weight: 700;
            display: none;
            box-shadow: 0 10px 25px rgba(0,0,0,0.15);
            z-index: 9999;
            animation: slideUp 0.3s ease;
        }

        @keyframes slideUp {
            from { transform: translateY(20px); opacity: 0; }
            to { transform: translateY(0); opacity: 1; }
        }
    </style>
</head>

<body class="dashboard-body">
    <div id="toast"></div>
    <div id="redis-page-data" data-redis-active="<%= (typeof isRedisActive !== 'undefined' && isRedisActive) ? 'true' : 'false' %>"></div>

    <div class="dashboard-shell">
        <%- include('partials/sidebar', { activePage: 'redis-manage' }) %>

        <div class="dashboard-main">
            <header class="navbar dashboard-navbar">
                <div class="nav-left" style="display: flex; align-items: center; gap: 12px; white-space: nowrap;">
                    <button type="button" class="sidebar-toggle-btn" onclick="toggleSidebar()">☰</button>
                    <h2 style="margin: 0; font-size: 18px; font-weight: 800; white-space: nowrap;">Redis Cache & Performance Management</h2>
                </div>

                <div class="nav-right" onclick="toggleDropdown()">
                    <div class="avatar"><%- typeof photo !== 'undefined' && photo ? photo : 'A' %></div>
                    <div class="dropdown" id="dropdown">
                        <a href="/logout">Logout</a>
                    </div>
                </div>
            </header>

            <main class="container dashboard-home">
                <!-- 1. MASTER STATUS & ON/OFF CONTROL -->
                <div class="glass-card">
                    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px;">
                        <div>
                            <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 6px;">
                                <h3 style="margin: 0; font-size: 20px; font-weight: 800; color: #052e1f;">Redis Cache Master Switch</h3>
                                <span id="redis-status-badge" class="redis-badge <%= (typeof isRedisActive !== 'undefined' && isRedisActive) ? 'badge-online' : 'badge-fallback' %>">
                                    <%= (typeof isRedisActive !== 'undefined' && isRedisActive) ? '🔴 Redis Active (0.1ms RAM)' : '⚠️ In-Memory Fallback Active' %>
                                </span>
                            </div>
                            <p style="margin: 0; font-size: 13px; color: var(--muted);">
                                Instantly toggle Redis on or off. If off, server automatically uses in-memory Node.js RAM without any downtime.
                            </p>
                        </div>
                        <div style="display: flex; gap: 10px; flex-wrap: wrap; align-items: center;">
                            <button type="button" id="btn-toggle-redis" class="<%= (typeof isRedisActive !== 'undefined' && isRedisActive) ? 'btn-toggle-off' : 'btn-toggle-on' %>" onclick="toggleRedisState()">
                                <i class="fa-solid <%= (typeof isRedisActive !== 'undefined' && isRedisActive) ? 'fa-power-off' : 'fa-play' %>"></i>
                                <span id="btn-toggle-text"><%= (typeof isRedisActive !== 'undefined' && isRedisActive) ? 'Turn OFF Redis' : 'Turn ON Redis' %></span>
                            </button>
                            <button type="button" class="btn-action-primary" onclick="loadRedisStats()">
                                <i class="fa-solid fa-rotate-right"></i> Refresh
                            </button>
                            <button type="button" class="btn-danger-lg" onclick="flushRedisCache()">
                                <i class="fa-solid fa-bolt"></i> Flush / Reset Entire Cache
                            </button>
                        </div>
                    </div>

                    <div class="redis-metrics">
                        <div class="redis-stat">
                            <div class="redis-stat-lbl">Cache Engine Mode</div>
                            <div class="redis-stat-val" id="redis-mode-val" style="font-size: 16px;">
                                <%= (typeof isRedisActive !== 'undefined' && isRedisActive) ? 'Redis RAM Cluster (Port 6379)' : 'Node.js RAM Sliding Window' %>
                            </div>
                        </div>
                        <div class="redis-stat">
                            <div class="redis-stat-lbl">Active DP Signatures</div>
                            <div class="redis-stat-val" id="redis-keys-count"><%= (typeof initialKeysCount !== 'undefined') ? initialKeysCount : 0 %></div>
                        </div>
                        <div class="redis-stat">
                            <div class="redis-stat-lbl">App Isolation</div>
                            <div class="redis-stat-val" style="font-size: 16px; color: #15803d;">
                                <i class="fa-solid fa-shield-halved"></i> Isolated (DP Only)
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 2. EDITABLE TTL (TIME-TO-LIVE) CONFIGURATION -->
                <div class="glass-card">
                    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; margin-bottom: 8px;">
                        <div>
                            <h3 style="margin: 0 0 4px 0; font-size: 18px; font-weight: 800; color: #052e1f;">
                                <i class="fa-solid fa-stopwatch" style="margin-right: 6px; color: #052e1f;"></i> Cache Duration (TTL) Settings
                            </h3>
                            <p style="color: var(--muted); font-size: 13px; margin: 0;">
                                Configure cache expiration timers (in seconds). Changes apply immediately without server restart.
                            </p>
                        </div>
                        <button type="button" class="btn-action-primary" onclick="saveTtlConfig()">
                            <i class="fa-solid fa-floppy-disk"></i> Save TTL Settings
                        </button>
                    </div>

                    <div class="form-grid">
                        <div class="form-group">
                            <label class="form-label" for="globalTtlSeconds">Global Cache TTL (Seconds)</label>
                            <input type="number" id="globalTtlSeconds" class="form-input" min="5" value="<%= (typeof redisConfig !== 'undefined' && redisConfig.globalTtlSeconds) ? redisConfig.globalTtlSeconds : 300 %>">
                            <span class="form-hint">Default: 300s (5 mins). Applies to Battle Rooms, Wallet Methods, Games List, Daily Tasks & App Config. Auto-cleared when edited in Admin.</span>
                        </div>

                        <div class="form-group">
                            <label class="form-label" for="leaderboardTtlSeconds">Leaderboards Cache TTL (Seconds)</label>
                            <input type="number" id="leaderboardTtlSeconds" class="form-input" min="5" value="<%= (typeof redisConfig !== 'undefined' && redisConfig.leaderboardTtlSeconds) ? redisConfig.leaderboardTtlSeconds : 60 %>">
                            <span class="form-hint">Default: 60s (1 min). Applies to Coins Leaderboard & Battle Arena Leaderboard. Keeps scores super fresh & fast.</span>
                        </div>
                    </div>
                </div>

                <!-- 3. ACTIVE CACHE KEYS TABLE -->
                <div class="glass-card">
                    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px;">
                        <div>
                            <h3 style="margin: 0 0 4px 0; font-size: 18px; font-weight: 800; color: #052e1f;">Active Cache Keys</h3>
                            <p style="color: var(--muted); font-size: 13px; margin: 0;">Keys currently stored in RAM cache:</p>
                        </div>
                    </div>

                    <div class="table-container">
                        <table>
                            <thead>
                                <tr>
                                    <th style="width: 45px;">#</th>
                                    <th>Key Name</th>
                                    <th style="width: 100px;">Type</th>
                                    <th style="width: 120px;">TTL</th>
                                    <th style="min-width: 260px;">Value Preview</th>
                                    <th style="text-align: right; width: 85px;">Action</th>
                                </tr>
                            </thead>
                            <tbody id="redis-keys-tbody">
                                <% if (typeof initialKeys !== 'undefined' && initialKeys && initialKeys.length > 0) { %>
                                    <% initialKeys.forEach(function(k, idx) { 
                                        const keyName = typeof k === 'string' ? k : (k.name || '');
                                        const keyType = (typeof k === 'object' && k.type ? k.type : 'STRING').toLowerCase();
                                        const keyTtl = typeof k === 'object' && k.ttl !== undefined ? Number(k.ttl) : -1;
                                        const keyPreview = typeof k === 'object' && k.preview ? k.preview : '-';
                                    %>
                                        <tr id="key-row-<%= idx %>">
                                            <td style="font-weight: 800; color: #052e1f;"><%= idx + 1 %></td>
                                            <td><code style="font-weight: 700; color: #052e1f;"><%= keyName %></code></td>
                                            <td>
                                                <span class="badge-type badge-type-<%= keyType %>"><%= keyType.toUpperCase() %></span>
                                            </td>
                                            <td>
                                                <% if (keyTtl > 0) { %>
                                                    <span class="badge-ttl"><i class="fa-solid fa-stopwatch" style="color: #059669; font-size: 11px;"></i> <%= keyTtl %>s</span>
                                                <% } else if (keyTtl === -1) { %>
                                                    <span class="badge-ttl-perm"><i class="fa-solid fa-infinity" style="color: #64748b; font-size: 11px;"></i> Permanent</span>
                                                <% } else { %>
                                                    <span class="badge-ttl-exp"><i class="fa-solid fa-hourglass-end" style="color: #dc2626; font-size: 11px;"></i> Expired</span>
                                                <% } %>
                                            </td>
                                            <td>
                                                <div style="display: flex; align-items: center; gap: 8px;">
                                                    <code class="code-preview" style="cursor: pointer;" data-idx="<%= idx %>" onclick="handleRowModal(this)" title="Click to view full value in Modal"><%= keyPreview %></code>
                                                    <button type="button" class="btn-modal-open" data-idx="<%= idx %>" onclick="handleRowModal(this)" title="Full Screen Modal View">
                                                        <i class="fa-solid fa-up-right-and-down-left-from-center"></i> Modal
                                                    </button>
                                                </div>
                                            </td>
                                            <td style="text-align: right;">
                                                <button type="button" class="btn-danger-lg" style="padding: 4px 10px; font-size: 11px;" data-key="<%= keyName %>" onclick="handleRowDelete(this)">Delete</button>
                                            </td>
                                        </tr>
                                    <% }); %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="6" style="text-align: center; color: var(--muted); padding: 24px; font-weight: 600;">No active cache keys in Redis / RAM</td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </main>
        </div>
    </div>

    <script id="redis-initial-keys-json" type="application/json"><%- JSON.stringify(typeof initialKeys !== 'undefined' ? initialKeys : []).replace(/</g, '\\u003c') %></script>
    <script src="/js/admin.js"></script>
    <script>
        const initialActiveStr = document.getElementById('redis-page-data')?.getAttribute('data-redis-active') || 'false';
        let currentRedisActive = initialActiveStr === 'true';

        function showToast(msg, isError) {
            const toast = document.getElementById('toast');
            toast.innerText = msg;
            toast.style.background = isError ? '#dc2626' : '#052e1f';
            toast.style.display = 'block';
            setTimeout(function () {
                toast.style.display = 'none';
            }, 3500);
        }

        async function loadRedisStats() {
            try {
                let res = await fetch('/api/admin/redis-status');
                if (!res.ok) res = await fetch('/redis-status');
                const data = await res.json();
                if (data.success) {
                    const badge = document.getElementById('redis-status-badge');
                    const keysCount = document.getElementById('redis-keys-count');
                    const modeVal = document.getElementById('redis-mode-val');
                    const toggleBtn = document.getElementById('btn-toggle-redis');
                    const toggleText = document.getElementById('btn-toggle-text');

                    keysCount.innerText = data.keysCount || 0;
                    currentRedisActive = Boolean(data.isRedisActive);

                    if (currentRedisActive) {
                        badge.className = 'redis-badge badge-online';
                        badge.innerText = '🔴 Redis Active (0.1ms RAM)';
                        modeVal.innerText = 'Redis RAM Cluster (Port 6379)';
                        toggleBtn.className = 'btn-toggle-off';
                        toggleText.innerText = 'Turn OFF Redis';
                    } else {
                        badge.className = 'redis-badge badge-fallback';
                        badge.innerText = '⚠️ In-Memory Fallback Active';
                        modeVal.innerText = 'Node.js RAM Sliding Window';
                        toggleBtn.className = 'btn-toggle-on';
                        toggleText.innerText = 'Turn ON Redis';
                    }

                    if (data.config) {
                        if (data.config.globalTtlSeconds && document.getElementById('globalTtlSeconds')) document.getElementById('globalTtlSeconds').value = data.config.globalTtlSeconds;
                        if (data.config.leaderboardTtlSeconds && document.getElementById('leaderboardTtlSeconds')) document.getElementById('leaderboardTtlSeconds').value = data.config.leaderboardTtlSeconds;
                    }

                    renderKeysTable(data.keys || []);
                }
            } catch (e) {
                console.error('Error fetching Redis status:', e);
            }
        }

        async function toggleRedisState() {
            const newState = !currentRedisActive;
            const actionStr = newState ? 'ENABLE Redis RAM caching' : 'DISABLE Redis and switch to In-Memory Fallback';
            if (!confirm('Are you sure you want to ' + actionStr + '?')) return;

            try {
                let res = await fetch('/api/admin/redis-toggle', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ enabled: newState })
                });
                if (!res.ok) {
                    res = await fetch('/redis-toggle', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ enabled: newState })
                    });
                }
                const data = await res.json();
                if (data.success) {
                    showToast(data.message || 'Status updated', false);
                    loadRedisStats();
                } else {
                    showToast(data.message || 'Failed to toggle Redis', true);
                }
            } catch (e) {
                showToast('Network error toggling Redis', true);
            }
        }

        async function saveTtlConfig() {
            const globalTtlSeconds = parseInt(document.getElementById('globalTtlSeconds').value, 10);
            const leaderboardTtlSeconds = parseInt(document.getElementById('leaderboardTtlSeconds').value, 10);

            try {
                let res = await fetch('/api/admin/redis-config', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        globalTtlSeconds: globalTtlSeconds,
                        leaderboardTtlSeconds: leaderboardTtlSeconds
                    })
                });
                if (!res.ok) {
                    res = await fetch('/redis-config', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            globalTtlSeconds: globalTtlSeconds,
                            leaderboardTtlSeconds: leaderboardTtlSeconds
                        })
                    });
                }
                const data = await res.json();
                if (data.success) {
                    showToast('✅ Redis TTL settings saved successfully!', false);
                    loadRedisStats();
                } else {
                    showToast('❌ ' + (data.message || 'Failed to save settings'), true);
                }
            } catch (e) {
                showToast('❌ Error saving TTL settings', true);
            }
        }

        let currentLoadedKeys = [];
        try {
            const jsonEl = document.getElementById('redis-initial-keys-json');
            if (jsonEl && jsonEl.textContent) {
                currentLoadedKeys = JSON.parse(jsonEl.textContent.trim());
            }
        } catch (_) {}

        function formatPayload(rawVal) {
            if (rawVal === null || rawVal === undefined) return '(Empty / Null)';
            if (typeof rawVal === 'string') {
                try {
                    const parsed = JSON.parse(rawVal);
                    return JSON.stringify(parsed, null, 2);
                } catch (_) {
                    return rawVal;
                }
            }
            if (typeof rawVal === 'object') {
                return JSON.stringify(rawVal, null, 2);
            }
            return String(rawVal);
        }

        function handleRowModal(el) {
            const idx = parseInt(el.getAttribute('data-idx') || (el.dataset && el.dataset.idx), 10);
            if (!isNaN(idx)) openValueModalByIndex(idx);
        }

        function handleRowDelete(el) {
            const key = el.getAttribute('data-key') || (el.dataset && el.dataset.key);
            if (key) deleteSingleKey(key);
        }

        function openValueModalByIndex(idx) {
            const k = currentLoadedKeys[idx];
            if (!k) return;
            const keyName = typeof k === 'string' ? k : (k.name || '');
            const keyType = typeof k === 'object' && k.type ? k.type : 'STRING';
            const keyTtl = typeof k === 'object' && k.ttl !== undefined ? k.ttl : -1;
            const preloadedVal = k.formatted || (k.value !== undefined && k.value !== null ? formatPayload(k.value) : null);
            openValueModal(keyName, keyType, keyTtl, preloadedVal);
        }

        function renderKeysTable(keys) {
            currentLoadedKeys = keys || [];
            const tbody = document.getElementById('redis-keys-tbody');
            if (!keys || keys.length === 0) {
                tbody.innerHTML = '<tr><td colspan="6" style="text-align: center; color: var(--muted); padding: 24px; font-weight: 600;">No active cache keys in Redis / RAM</td></tr>';
                return;
            }

            let html = '';
            keys.forEach(function (k, idx) {
                const keyName = typeof k === 'string' ? k : (k.name || '');
                const keyType = (typeof k === 'object' && k.type ? k.type : 'STRING').toLowerCase();
                const keyTtl = typeof k === 'object' && k.ttl !== undefined ? Number(k.ttl) : -1;
                const keyPreview = typeof k === 'object' && k.preview ? k.preview : '-';

                let ttlHtml = '';
                if (keyTtl > 0) {
                    ttlHtml = '<span class="badge-ttl"><i class="fa-solid fa-stopwatch" style="color: #059669; font-size: 11px;"></i> ' + keyTtl + 's</span>';
                } else if (keyTtl === -1) {
                    ttlHtml = '<span class="badge-ttl-perm"><i class="fa-solid fa-infinity" style="color: #64748b; font-size: 11px;"></i> Permanent</span>';
                } else {
                    ttlHtml = '<span class="badge-ttl-exp"><i class="fa-solid fa-hourglass-end" style="color: #dc2626; font-size: 11px;"></i> Expired</span>';
                }

                if (typeof k === 'object' && k.value !== undefined && k.value !== null) {
                    k.formatted = formatPayload(k.value);
                }

                html += '<tr id="key-row-' + idx + '">' +
                    '<td style="font-weight: 800; color: #052e1f;">' + (idx + 1) + '</td>' +
                    '<td><code style="font-weight: 700; color: #052e1f;">' + escapeHtml(keyName) + '</code></td>' +
                    '<td><span class="badge-type badge-type-' + keyType + '">' + keyType.toUpperCase() + '</span></td>' +
                    '<td>' + ttlHtml + '</td>' +
                    '<td>' +
                        '<div style="display: flex; align-items: center; gap: 8px;">' +
                            '<code class="code-preview" style="cursor: pointer;" data-idx="' + idx + '" onclick="handleRowModal(this)" title="Click to view full value in Modal">' + escapeHtml(keyPreview) + '</code>' +
                            '<button type="button" class="btn-modal-open" data-idx="' + idx + '" onclick="handleRowModal(this)" title="Full Screen Modal View">' +
                                '<i class="fa-solid fa-up-right-and-down-left-from-center"></i> Modal' +
                            '</button>' +
                        '</div>' +
                    '</td>' +
                    '<td style="text-align: right;"><button type="button" class="btn-danger-lg" style="padding: 4px 10px; font-size: 11px;" data-key="' + escapeHtml(keyName) + '" onclick="handleRowDelete(this)">Delete</button></td>' +
                    '</tr>';
            });
            tbody.innerHTML = html;
        }

        function escapeHtml(str) {
            if (!str) return '';
            return String(str)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#39;');
        }

        async function flushRedisCache() {
            if (!confirm('Are you sure you want to INSTANTLY RESET & FLUSH all Crazyreward cache? (Fresh data will be loaded from MongoDB)')) return;
            try {
                let res = await fetch('/api/admin/redis-flush', { method: 'POST' });
                if (!res.ok) res = await fetch('/redis-flush', { method: 'POST' });
                const data = await res.json();
                if (data.success) {
                    showToast('✅ Crazyreward Cache flushed successfully!', false);
                    loadRedisStats();
                } else {
                    showToast('❌ Failed to flush cache: ' + (data.message || 'Unknown error'), true);
                }
            } catch (e) {
                showToast('❌ Error resetting Redis cache', true);
            }
        }

        async function deleteSingleKey(key) {
            try {
                let res = await fetch('/api/admin/redis-delete-key', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ key: key })
                });
                if (!res.ok) {
                    res = await fetch('/redis-delete-key', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ key: key })
                    });
                }
                const data = await res.json();
                if (data.success) {
                    showToast('Key deleted', false);
                    loadRedisStats();
                }
            } catch (e) {}
        }

        let currentInspectedRawValue = '';

        async function openValueModal(keyName, keyType, optTtl, optVal) {
            const modal = document.getElementById('redis-val-modal');
            const keyEl = document.getElementById('modal-key-name');
            const typeEl = document.getElementById('modal-key-type');
            const ttlEl = document.getElementById('modal-key-ttl');
            const preEl = document.getElementById('modal-code-content');

            keyEl.innerText = keyName;
            typeEl.innerText = (keyType || 'STRING').toUpperCase();
            typeEl.className = 'badge-type badge-type-' + (keyType || 'string').toLowerCase();
            
            if (optTtl !== undefined && optTtl !== null && optTtl !== '') {
                const ttlNum = Number(optTtl);
                if (ttlNum > 0) {
                    ttlEl.innerHTML = '<i class="fa-regular fa-clock"></i> ' + ttlNum + 's remaining';
                } else if (ttlNum === -1) {
                    ttlEl.innerHTML = 'Permanent (No expiry)';
                } else {
                    ttlEl.innerHTML = 'Expired / Deleted';
                }
            } else {
                ttlEl.innerHTML = '<i class="fa-regular fa-clock"></i> Loading TTL...';
            }

            modal.style.display = 'flex';

            if (optVal) {
                currentInspectedRawValue = optVal;
                preEl.innerText = optVal;
                return;
            }

            preEl.innerText = 'Loading full value from Redis RAM...';
            currentInspectedRawValue = '';

            try {
                let res = await fetch('/api/admin/redis-key-value?key=' + encodeURIComponent(keyName));
                if (!res.ok) res = await fetch('/redis-key-value?key=' + encodeURIComponent(keyName));
                const data = await res.json();

                if (data.success) {
                    if (data.ttl > 0) {
                        ttlEl.innerHTML = '<i class="fa-regular fa-clock"></i> ' + data.ttl + 's remaining';
                    } else if (data.ttl === -1) {
                        ttlEl.innerHTML = 'Permanent (No expiry)';
                    } else {
                        ttlEl.innerHTML = 'Expired / Deleted';
                    }

                    const formatted = formatPayload(data.value);
                    currentInspectedRawValue = formatted;
                    preEl.innerText = formatted;
                } else {
                    preEl.innerText = 'Failed to load value: ' + (data.message || 'Key not found');
                }
            } catch (e) {
                preEl.innerText = 'Error fetching key value: ' + e.message;
            }
        }

        function closeValueModal() {
            document.getElementById('redis-val-modal').style.display = 'none';
        }

        function closeModalOnBackdrop(e) {
            if (e.target.id === 'redis-val-modal') {
                closeValueModal();
            }
        }

        function copyModalValue() {
            if (!currentInspectedRawValue) return;
            navigator.clipboard.writeText(currentInspectedRawValue).then(() => {
                showToast('📋 Copied full value to clipboard!', false);
            }).catch(() => {
                showToast('Failed to copy', true);
            });
        }

        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') closeValueModal();
        });

        document.addEventListener('DOMContentLoaded', loadRedisStats);
    </script>

    <!-- REDIS VALUE INSPECTOR MODAL -->
    <div id="redis-val-modal" class="modal-backdrop" onclick="closeModalOnBackdrop(event)">
        <div class="modal-card">
            <div class="modal-header">
                <div style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap;">
                    <h3 style="margin: 0; font-size: 16px; font-weight: 800; color: #052e1f;">
                        <i class="fa-solid fa-code" style="color: #052e1f;"></i> Redis Value Inspector
                    </h3>
                    <code id="modal-key-name" style="font-size: 12px; font-weight: 700; color: #052e1f; background: #e2e8f0;"></code>
                    <span id="modal-key-type" class="badge-type badge-type-string">STRING</span>
                    <span id="modal-key-ttl" class="badge-ttl" style="font-size: 12px;"></span>
                </div>
                <button type="button" class="modal-close-btn" onclick="closeValueModal()">✕</button>
            </div>
            <div class="modal-body">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                    <span style="font-size: 12px; font-weight: 700; color: #64748b;">Formatted JSON / Data Payload</span>
                    <button type="button" class="btn-copy-val" onclick="copyModalValue()">
                        <i class="fa-regular fa-copy"></i> Copy Value
                    </button>
                </div>
                <pre id="modal-code-content" class="modal-code-pre">Loading...</pre>
            </div>
        </div>
    </div>
</body>
</html>
