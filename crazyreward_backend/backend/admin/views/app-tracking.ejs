                                <th>Category</th>
                                <th style="text-align: right; width: 100px;">Visitors</th>
                                <th style="text-align: center; width: 140px;">Exit / Drop-off %</th>
                                <th style="text-align: right; width: 110px;">Lost Users</th>
                                <th style="min-width: 260px;">Root Cause & Churn Diagnosis</th>
                                <th style="min-width: 260px;">Recommended Action & Fix</th>
                            </tr>
                        </thead>
                        <tbody id="modalChurnRiskTableBody">
                            <tr>
                                <td colspan="8" style="text-align: center; padding: 32px; color: #64748b;">
                                    <i class="fa-solid fa-circle-notch fa-spin" style="font-size: 22px; color: #dc2626;"></i>
                                    <div style="margin-top: 8px; font-weight: 600; font-size: 13px;">Loading screen churn data...</div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <div style="padding: 14px 24px; background: #f8fafc; border-top: 1px solid #e2e8f0; display: flex; justify-content: flex-end;">
                <button type="button" onclick="closeChurnModal()" style="background: #052e1f; color: white; border: none; padding: 8px 18px; border-radius: 8px; font-weight: 700; font-size: 13px; cursor: pointer;">
                    Close Window
                </button>
            </div>
        </div>
    </div>

    <!-- SCRIPT SECTION -->
    <script>
        let trendChartInstance = null;
        let barChartInstance = null;
        let allScreensData = [];

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', () => loadStats());
        } else {
            loadStats();
        }

        function onRangeChange() {
            const range = document.getElementById('rangeSelect').value;
            const startInput = document.getElementById('startDate');
            const endInput = document.getElementById('endDate');

            if (range === 'custom') {
                startInput.disabled = false;
                endInput.disabled = false;
            } else {
                startInput.disabled = true;
                endInput.disabled = true;
                startInput.value = '';
                endInput.value = '';
                loadStats();
            }
        }

        async function loadStats() {
            const range = document.getElementById('rangeSelect').value;
            const startDate = document.getElementById('startDate').value;
            const endDate = document.getElementById('endDate').value;
            const appName = document.getElementById('appSelect')?.value || 'Crazyreward';

            let url = `/api/app-tracking/stats?range=${encodeURIComponent(range)}&appName=${encodeURIComponent(appName)}&_t=${Date.now()}`;
            if (range === 'custom') {
                if (!startDate || !endDate) return;
                url += `&startDate=${encodeURIComponent(startDate)}&endDate=${encodeURIComponent(endDate)}`;
            }

            try {
                const res = await fetch(url);
                const data = await res.json();
                console.log('📊 App Tracking API Data:', data);
                if (!data.success) throw new Error(data.message || 'Failed to load tracking data');

                renderStats(data);
            } catch (err) {
                console.error('Error loading stats:', err);
            }
        }

        function renderStats(data) {
            if (!data) return;
            const stats = data.stats || {};

            // Render top 4 stat cards
            const elRealtime = document.getElementById('stat-realtime-users');
            if (elRealtime) elRealtime.textContent = formatNumber(stats.realtimeActiveUsers || 0);

            const elTotalViews = document.getElementById('stat-total-views');
            if (elTotalViews) elTotalViews.textContent = formatNumber(stats.totalScreenViews || 0);

            const elEngaged = document.getElementById('stat-engaged-users');
            if (elEngaged) elEngaged.textContent = formatNumber(stats.engagedUsers || 0);

            const elAvgDur = document.getElementById('stat-avg-duration');
            if (elAvgDur) elAvgDur.textContent = stats.avgEngagementTime || '--';

            // Dedicated App Installs & Uninstalls Lifecycle Hub
            const installs = stats.newInstalls || 0;
            const uninstalls = stats.uninstalls || 0;
            const clearData = stats.appClearData || 0;
            const net = installs - uninstalls;

            const elLcInstalls = document.getElementById('stat-lifecycle-installs');
            if (elLcInstalls) elLcInstalls.textContent = formatNumber(installs);

            const elLcUninstalls = document.getElementById('stat-lifecycle-uninstalls');
            if (elLcUninstalls) elLcUninstalls.textContent = formatNumber(uninstalls);

            const elLcClearData = document.getElementById('stat-lifecycle-cleardata');
            if (elLcClearData) elLcClearData.textContent = formatNumber(clearData);

            const elLcNet = document.getElementById('stat-lifecycle-netgrowth');
            if (elLcNet) {
                elLcNet.textContent = (net >= 0 ? `+${formatNumber(net)}` : formatNumber(net)) + ' Users';
                elLcNet.style.color = net >= 0 ? '#15803d' : '#dc2626';
            }

            const elGrowthSub = document.getElementById('stat-lifecycle-growth-sub');
            if (elGrowthSub) {
                elGrowthSub.textContent = net >= 0 ? 'Net retained user base' : 'High churn loss in period';
            }

            // Dual Progress Retention vs Churn Bar
            let churnPct = 0;
            let retainedPct = 100;
            if (installs > 0) {
                churnPct = Math.min(100, parseFloat(((uninstalls / installs) * 100).toFixed(1)));
                retainedPct = Math.max(0, parseFloat((100 - churnPct).toFixed(1)));
            } else if (uninstalls > 0) {
                churnPct = 100;
                retainedPct = 0;
            }

            const retainedFill = document.getElementById('bar-retained-fill');
            const churnFill = document.getElementById('bar-churn-fill');
            if (retainedFill) retainedFill.style.width = `${retainedPct}%`;
            if (churnFill) churnFill.style.width = `${churnPct}%`;

            const retainedText = document.getElementById('bar-retained-text');
            if (retainedText) retainedText.textContent = `${formatNumber(Math.max(0, net))} Users (${retainedPct}%)`;

            const churnText = document.getElementById('bar-churn-text');
            if (churnText) churnText.textContent = `${formatNumber(uninstalls)} Users (${churnPct}%)`;

            const healthPill = document.getElementById('lifecycle-status-pill');
            if (healthPill) {
                if (net >= 0 && churnPct <= 30) {
                    healthPill.className = 'health-pill-healthy';
                    healthPill.innerHTML = '<i class="fa-solid fa-shield-heart"></i> Net Growth Healthy';
                } else if (churnPct > 30) {
                    healthPill.className = 'health-pill-churn';
                    healthPill.innerHTML = '<i class="fa-solid fa-triangle-exclamation"></i> High Churn (' + churnPct + '%)';
                } else {
                    healthPill.className = 'health-pill-healthy';
                    healthPill.innerHTML = '<i class="fa-solid fa-shield-heart"></i> Net User Growth: +' + formatNumber(net);
                }
            }

            // Connection Badge
            const badge = document.getElementById('ga4-status-badge');
            if (badge) {
                if (data.isGA4Connected || (data.stats && (data.stats.totalScreenViews > 0 || data.stats.engagedUsers > 0))) {
                    badge.style.background = '#dcfce7';
                    badge.style.color = '#15803d';
                    badge.textContent = '🟢 GA4 Connected Live';
                } else if (data.propertyId) {
                    badge.style.background = '#e0f2fe';
                    badge.style.color = '#0369a1';
                    badge.textContent = '🔵 GA4 Configured';
                } else {
                    badge.style.background = '#fef3c7';
                    badge.style.color = '#92400e';
                    badge.textContent = '🟡 Setup Ready (Preview Mode)';
                }
            }

            // Safe render each chart and table
            try { renderTrendChart(data.trend || []); } catch (e) { console.error('trendChart error:', e); }
            try { renderScreensBarChart(data.topScreens || []); } catch (e) { console.error('barChart error:', e); }

            allScreensData = Array.isArray(data.screens) ? data.screens : [];
            try { renderChurnRiskTable(data.uninstallRiskScreens || data.screens || []); } catch (e) { console.error('churnRiskTable error:', e); }
            try { filterScreensTable(); } catch (e) { console.error('filterScreensTable error:', e); }
            try { renderEntryDropoffCards(allScreensData); } catch (e) { console.error('renderEntryDropoffCards error:', e); }
            try { renderCountryTable(data.countries || []); } catch (e) { console.error('renderCountryTable error:', e); }
        }

        function renderChurnRiskTable(screens) {
            const tbody = document.getElementById('churnRiskTableBody');
            if (!tbody) return;

            const safeScreens = Array.isArray(screens) ? screens : [];
            // Filter out non-UI screens like (not set), empty strings, and background sessions
            const uiScreens = safeScreens.filter(s => {
                if (!s || !s.screenName) return false;
                const raw = (s.rawKey || '').toLowerCase();
                const name = s.screenName.toLowerCase();
                return raw !== '(not set)' && raw !== '' && !name.includes('background') && !name.includes('session');
            });

            // Calculate lost users and sort by lost users descending, then dropoffRate descending
            const analyzedScreens = uiScreens.map(s => {
                const dropRate = parseFloat(s.dropoffRate || 0);
                const visitors = parseInt(s.users || 0, 10);
                const lost = s.lostUsers !== undefined ? parseInt(s.lostUsers, 10) : Math.round(visitors * (dropRate / 100));

                let riskLevel = 'Low Risk';
                let riskClass = 'risk-low';
                let riskIcon = 'fa-solid fa-circle-check';

                if (dropRate >= 50 || lost >= 2) {
                    riskLevel = 'Critical Churn Risk';
                    riskClass = 'risk-critical';
                    riskIcon = 'fa-solid fa-triangle-exclamation';
                } else if (dropRate >= 35) {
                    riskLevel = 'High Risk';
                    riskClass = 'risk-high';
                    riskIcon = 'fa-solid fa-circle-exclamation';
                } else if (dropRate >= 20) {
                    riskLevel = 'Moderate Risk';
                    riskClass = 'risk-mod';
                    riskIcon = 'fa-solid fa-circle-info';
                }

                // Churn diagnosis & actionable fix
                const reason = s.churnReason || 'Users drop off without interacting or completing expected actions on this screen.';
                const fix = s.churnFix || 'Add a clear primary button, reduce initial loading friction, and optimize page layout.';

                return {
                    ...s,
                    visitors,
                    dropRate,
                    lost,
                    riskLevel,
                    riskClass,
                    riskIcon,
                    reason,
                    fix
                };
            }).sort((a, b) => {
                if (b.lost !== a.lost) return b.lost - a.lost;
                return b.dropRate - a.dropRate;
            });

            // Update in-page & modal KPI summary cards
            const topChurn = analyzedScreens[0];
            const kpiScreen = document.getElementById('kpi-top-churn-screen');
            const kpiRate = document.getElementById('kpi-top-churn-rate');
            const modalKpiScreen = document.getElementById('modal-kpi-top-screen');
            const modalKpiRate = document.getElementById('modal-kpi-top-rate');

            if (topChurn) {
                if (kpiScreen) kpiScreen.textContent = topChurn.screenName;
                if (kpiRate) kpiRate.textContent = `${topChurn.dropRate.toFixed(1)}% exit (${topChurn.lost} abandoned)`;
                if (modalKpiScreen) modalKpiScreen.textContent = topChurn.screenName;
                if (modalKpiRate) modalKpiRate.textContent = `${topChurn.dropRate.toFixed(1)}% exit (${topChurn.lost} abandoned)`;
            } else {
                if (kpiScreen) kpiScreen.textContent = 'None';
                if (kpiRate) kpiRate.textContent = '0% exit rate';
                if (modalKpiScreen) modalKpiScreen.textContent = 'None';
                if (modalKpiRate) modalKpiRate.textContent = '0% exit rate';
            }

            const totalLost = analyzedScreens.reduce((sum, s) => sum + (s.lost || 0), 0);
            const kpiTotalLost = document.getElementById('kpi-total-lost-users');
            const modalKpiTotalLost = document.getElementById('modal-kpi-total-lost');
            if (kpiTotalLost) kpiTotalLost.textContent = `${formatNumber(totalLost)} Users`;
            if (modalKpiTotalLost) modalKpiTotalLost.textContent = `${formatNumber(totalLost)} Users`;

            const highRiskCount = analyzedScreens.filter(s => s.dropRate >= 35).length;
            const kpiHighRisk = document.getElementById('kpi-high-risk-count');
            const modalKpiHighRisk = document.getElementById('modal-kpi-high-risk');
            if (kpiHighRisk) kpiHighRisk.textContent = `${highRiskCount} Screens`;
            if (modalKpiHighRisk) modalKpiHighRisk.textContent = `${highRiskCount} Screens`;

            const riskBadge = document.getElementById('risk-screens-count-badge');
            if (riskBadge) {
                riskBadge.textContent = `${analyzedScreens.length} UI Screens Analyzed`;
            }

            const modalTbody = document.getElementById('modalChurnRiskTableBody');
            if (analyzedScreens.length === 0) {
                const emptyRow = `
                    <tr>
                        <td colspan="8" style="text-align: center; padding: 32px; color: #64748b;">
                            <div style="font-size: 24px; margin-bottom: 8px;">🎉</div>
                            <div style="font-weight: 700; color: #0f172a;">No high drop-off screens detected in this time range.</div>
                            <div style="font-size: 12px; margin-top: 4px;">User session retention is currently healthy across all routes.</div>
                        </td>
                    </tr>
                `;
                tbody.innerHTML = emptyRow;
                if (modalTbody) modalTbody.innerHTML = emptyRow;
                return;
            }

            const rowsHtml = analyzedScreens.map((row) => {
                let catClass = 'cat-core';
                if (row.category === 'Earning') catClass = 'cat-earning';
                if (row.category === 'Auth') catClass = 'cat-auth';
                if (row.category === 'Reward') catClass = 'cat-reward';
                if (row.category === 'Battle Arena') catClass = 'cat-battle';

                const progressWidth = Math.min(100, Math.max(8, row.dropRate));
                const barColor = row.dropRate >= 50 ? '#dc2626' : (row.dropRate >= 35 ? '#ea580c' : (row.dropRate >= 20 ? '#d97706' : '#16a34a'));

                return `
                    <tr>
                        <td style="text-align: center;">
                            <span class="risk-badge ${row.riskClass}">
                                <i class="${row.riskIcon}"></i> ${escapeHtml(row.riskLevel)}
                            </span>
                        </td>
                        <td>
                            <div style="font-weight: 800; color: #0f172a; display: flex; align-items: center; gap: 8px; font-size: 13.5px;">
                                <i class="${row.icon || 'fa-solid fa-mobile-screen'}" style="color: #0284c7; width: 16px;"></i>
                                <span>${escapeHtml(row.screenName)}</span>
                            </div>
                            <span style="font-size: 11px; color: #64748b; margin-left: 24px; font-family: monospace;">${escapeHtml(row.route || '')}</span>
                        </td>
                        <td><span class="cat-badge ${catClass}">${escapeHtml(row.category || 'Core')}</span></td>
                        <td style="text-align: right; font-weight: 800; color: #0f172a; font-size: 13.5px;">${formatNumber(row.visitors)}</td>
                        <td>
                            <div style="display: flex; flex-direction: column; align-items: center; gap: 4px;">
                                <span style="font-weight: 800; font-size: 13px; color: ${barColor};">${row.dropRate.toFixed(1)}%</span>
                                <div style="width: 100%; max-width: 90px; height: 6px; background: #e2e8f0; border-radius: 999px; overflow: hidden;">
                                    <div style="width: ${progressWidth}%; height: 100%; background: ${barColor}; border-radius: 999px;"></div>
                                </div>
                            </div>
                        </td>
                        <td style="text-align: right; font-weight: 800; color: ${row.lost > 0 ? '#dc2626' : '#64748b'}; font-size: 13.5px;">
                            ${row.lost > 0 ? `-${formatNumber(row.lost)} Users` : '0 Users'}
                        </td>
                        <td>
                            <div class="churn-reason-box">
                                <i class="fa-solid fa-triangle-exclamation" style="color: #dc2626; margin-right: 4px;"></i>
                                ${escapeHtml(row.reason)}
                            </div>
                        </td>
                        <td>
                            <div class="churn-fix-box">
                                <i class="fa-solid fa-lightbulb" style="color: #2563eb; margin-right: 4px;"></i>
                                ${escapeHtml(row.fix)}
                            </div>
                        </td>
                    </tr>
                `;
            }).join('');

            tbody.innerHTML = rowsHtml;
            if (modalTbody) modalTbody.innerHTML = rowsHtml;
        }

        function toggleChurnTable() {
            const container = document.getElementById('churnTableContainer');
            const btnText = document.getElementById('toggleText');
            const btnIcon = document.getElementById('toggleIcon');
            if (!container) return;

            if (container.style.display === 'none' || container.style.display === '') {
                container.style.display = 'block';
                if (btnText) btnText.textContent = 'Hide Churn Table';
                if (btnIcon) btnIcon.className = 'fa-solid fa-chevron-up';
            } else {
                container.style.display = 'none';
                if (btnText) btnText.textContent = 'View Churn Breakdown Table';
                if (btnIcon) btnIcon.className = 'fa-solid fa-table-list';
            }
        }

        function openChurnModal() {
            const overlay = document.getElementById('churnModalOverlay');
            if (overlay) {
                overlay.classList.add('active');
                document.body.style.overflow = 'hidden';
            }
        }

        function closeChurnModal() {
            const overlay = document.getElementById('churnModalOverlay');
            if (overlay) {
                overlay.classList.remove('active');
                document.body.style.overflow = '';
            }
        }

        function closeChurnModalOnBackdrop(e) {
            if (e.target && e.target.id === 'churnModalOverlay') {
                closeChurnModal();
            }
        }

        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') closeChurnModal();
        });

        function renderTrendChart(trendData) {
            const canvas = document.getElementById('trendChart');
            if (!canvas) return;
            const ctx = canvas.getContext('2d');
            if (trendChartInstance) trendChartInstance.destroy();

            const labels = (trendData || []).map(d => d.date);
            const views = (trendData || []).map(d => d.views || 0);
            const users = (trendData || []).map(d => d.users || 0);

            trendChartInstance = new Chart(ctx, {
                type: 'line',
                data: {
                    labels,
                    datasets: [
                        {
                            label: 'Screen Views',
                            data: views,
                            borderColor: '#0284c7',
                            backgroundColor: 'rgba(2, 132, 199, 0.08)',
                            borderWidth: 2.5,
                            fill: true,
                            tension: 0.35,
                            pointRadius: 3,
                            pointHoverRadius: 6
                        },
                        {
                            label: 'Active Users',
                            data: users,
                            borderColor: '#16a34a',
                            backgroundColor: 'rgba(22, 163, 74, 0.05)',
                            borderWidth: 2.5,
                            fill: true,
                            tension: 0.35,
                            pointRadius: 3,
                            pointHoverRadius: 6
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            grid: { color: '#f1f5f9' },
                            ticks: { font: { family: 'Plus Jakarta Sans' } }
                        },
                        x: {
                            grid: { display: false },
                            ticks: { font: { family: 'Plus Jakarta Sans' } }
                        }
                    }
                }
            });
        }

        function renderScreensBarChart(topScreens) {
            const canvas = document.getElementById('screensBarChart');
            if (!canvas) return;
            const ctx = canvas.getContext('2d');
            if (barChartInstance) barChartInstance.destroy();

            const validScreens = (topScreens || []).filter(s => s && s.screenName);
            const labels = validScreens.map(s => s.screenName);
            const views = validScreens.map(s => s.views || 0);

            barChartInstance = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels,
                    datasets: [{
                        label: 'Total Views',
                        data: views,
                        backgroundColor: [
                            '#0284c7', '#052e1f', '#7c3aed', '#16a34a', '#f59e0b', '#ec4899', '#0d9488', '#6366f1'
                        ],
                        borderRadius: 6
                    }]
                },
                options: {
                    indexAxis: 'y',
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false }
                    },
                    scales: {
                        x: {
                            beginAtZero: true,
                            grid: { color: '#f1f5f9' },
                            ticks: { font: { family: 'Plus Jakarta Sans' } }
                        },
                        y: {
                            grid: { display: false },
                            ticks: { font: { family: 'Plus Jakarta Sans', weight: '600' } }
                        }
                    }
                }
            });
        }

        function filterScreensTable() {
            const query = (document.getElementById('screenSearchInput')?.value || '').toLowerCase().trim();
            const category = document.getElementById('categoryFilterSelect')?.value || 'all';

            const filtered = allScreensData.filter(s => {
                if (!s) return false;
                const sName = (s.screenName || '').toLowerCase();
                const sRoute = (s.route || '').toLowerCase();
                const matchesQuery = sName.includes(query) || sRoute.includes(query);
                const matchesCat = category === 'all' || s.category === category;
                return matchesQuery && matchesCat;
            });

            const tbody = document.getElementById('screensTableBody');
            if (!tbody) return;

            if (filtered.length === 0) {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="8" style="text-align: center; padding: 30px; color: #64748b;">
                            No matching screens found.
                        </td>
                    </tr>
                `;
                return;
            }

            tbody.innerHTML = filtered.map(row => {
                let catClass = 'cat-core';
                if (row.category === 'Earning') catClass = 'cat-earning';
                if (row.category === 'Auth') catClass = 'cat-auth';
                if (row.category === 'Reward') catClass = 'cat-reward';
                if (row.category === 'Battle Arena') catClass = 'cat-battle';

                let tagClass = 'tag-med';
                if (row.status === 'High Traffic') tagClass = 'tag-high';
                if (row.status === 'High Exit') tagClass = 'tag-drop';
                if (row.status === 'No Traffic') tagClass = 'tag-idle';

                return `
                    <tr>
                        <td>
                            <div style="font-weight: 700; color: #0f172a; display: flex; align-items: center; gap: 8px;">
                                <i class="${row.icon || 'fa-solid fa-mobile-screen'}" style="color: #0284c7; width: 16px;"></i>
                                <span>${escapeHtml(row.screenName || 'Screen')}</span>
                            </div>
                            <span style="font-size: 11px; color: #64748b; margin-left: 24px;">${escapeHtml(row.route || '')}</span>
                        </td>
                        <td><span class="cat-badge ${catClass}">${escapeHtml(row.category || 'Core')}</span></td>
                        <td style="text-align: right; font-weight: 800; color: #0f172a;">${formatNumber(row.views || 0)}</td>
                        <td style="text-align: right; font-weight: 700; color: #475569;">${formatNumber(row.users || 0)}</td>
                        <td style="text-align: right; font-weight: 600; color: #0369a1;">${row.viewsPerUser || '1.0'}</td>
                        <td style="text-align: center; font-weight: 600; color: #334155;">${row.avgTime || '--'}</td>
                        <td style="text-align: center; font-weight: 700; color: ${parseFloat(row.dropoffRate || 0) > 40 ? '#ef4444' : '#16a34a'};">
                            ${row.dropoffRate || '0.0'}%
                        </td>
                        <td style="text-align: center;">
                            <span class="tag-pill ${tagClass}">${escapeHtml(row.status || 'Healthy')}</span>
                        </td>
                    </tr>
                `;
            }).join('');
        }

        function renderEntryDropoffCards(screens) {
            const safeScreens = Array.isArray(screens) ? screens : [];
            const uiScreens = safeScreens.filter(s => s && s.screenName && !s.screenName.toLowerCase().includes('background') && !s.screenName.toLowerCase().includes('sessions') && !s.screenName.toLowerCase().includes('unknown') && s.screenName !== '(not set)');
            const validScreens = (uiScreens.length >= 2 ? uiScreens : safeScreens);

            const sortedByViews = [...validScreens].sort((a, b) => (b.views || 0) - (a.views || 0)).slice(0, 4);
            const sortedByDropoff = [...validScreens].sort((a, b) => parseFloat(b.dropoffRate || 0) - parseFloat(a.dropoffRate || 0)).slice(0, 4);

            const entryEl = document.getElementById('top-entries-list');
            if (entryEl) {
                if (sortedByViews.length === 0) {
                    entryEl.innerHTML = '<div style="color: #64748b; font-size: 13px; text-align: center; padding: 12px;">No screen entry data recorded</div>';
                } else {
                    entryEl.innerHTML = sortedByViews.map((s, idx) => `
                        <div style="display: flex; justify-content: space-between; align-items: center; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 8px 12px;">
                            <div style="display: flex; align-items: center; gap: 8px;">
                                <span style="font-weight: 800; font-size: 12px; color: #16a34a; background: #dcfce7; width: 22px; height: 22px; border-radius: 6px; display: flex; align-items: center; justify-content: center;">#${idx+1}</span>
                                <span style="font-weight: 700; font-size: 13px; color: #1e293b;">${escapeHtml(s.screenName || 'Screen')}</span>
                            </div>
                            <span style="font-weight: 800; font-size: 13px; color: #0284c7;">${formatNumber(s.views || 0)} views</span>
                        </div>
                    `).join('');
                }
            }

            const dropEl = document.getElementById('top-dropoffs-list');
            if (dropEl) {
                if (sortedByDropoff.length === 0) {
                    dropEl.innerHTML = '<div style="color: #64748b; font-size: 13px; text-align: center; padding: 12px;">No screen dropoff data recorded</div>';
                } else {
                    dropEl.innerHTML = sortedByDropoff.map((s, idx) => `
                        <div style="display: flex; justify-content: space-between; align-items: center; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 8px 12px;">
                            <div style="display: flex; align-items: center; gap: 8px;">
                                <span style="font-weight: 800; font-size: 12px; color: #dc2626; background: #fee2e2; width: 22px; height: 22px; border-radius: 6px; display: flex; align-items: center; justify-content: center;">#${idx+1}</span>
                                <span style="font-weight: 700; font-size: 13px; color: #1e293b;">${escapeHtml(s.screenName || 'Screen')}</span>
                            </div>
                            <span style="font-weight: 800; font-size: 13px; color: #ef4444;">${s.dropoffRate || '0.0'}% exit rate</span>
                        </div>
                    `).join('');
                }
            }
        }

        function escapeHtml(str) {
            if (!str) return '';
            return String(str)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#039;');
        }

        const COUNTRY_FLAGS = {
            'India': '🇮🇳',
            'Nepal': '🇳🇵',
            'Bangladesh': '🇧🇩',
            'Pakistan': '🇵🇰',
            'United States': '🇺🇸',
            'United Kingdom': '🇬🇧',
            'United Arab Emirates': '🇦🇪',
            'Saudi Arabia': '🇸🇦',
            'Indonesia': '🇮🇩',
            'Philippines': '🇵🇭',
            'Nigeria': '🇳🇬',
            'Brazil': '🇧🇷',
            'Vietnam': '🇻🇳',
            'Türkiye': '🇹🇷',
            'Turkey': '🇹🇷',
            'Germany': '🇩🇪',
            'Canada': '🇨🇦',
            'Russia': '🇷🇺',
            'France': '🇫🇷',
            'Australia': '🇦🇺',
            'South Africa': '🇿🇦',
            'Egypt': '🇪🇬',
            'Sri Lanka': '🇱🇰',
            'Malaysia': '🇲🇾',
            'Singapore': '🇸🇬',
            'Japan': '🇯🇵',
            'Other / Unknown': '🌐'
        };

        function renderCountryTable(countries) {
            const tbody = document.getElementById('countryTableBody');
            if (!tbody) return;

            const safeCountries = Array.isArray(countries) ? countries : [];
            const countBadge = document.getElementById('country-count-badge');
            if (countBadge) {
                countBadge.textContent = `${safeCountries.length} Countries Tracked`;
            }

            if (safeCountries.length === 0) {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="6" style="text-align: center; padding: 40px 20px; color: #64748b;">
                            <div style="width: 52px; height: 52px; border-radius: 50%; background: #f0f9ff; color: #0284c7; display: inline-flex; align-items: center; justify-content: center; font-size: 24px; margin-bottom: 12px; box-shadow: 0 2px 8px rgba(2, 132, 199, 0.12);">
                                <i class="fa-solid fa-earth-americas"></i>
                            </div>
                            <div style="font-weight: 800; font-size: 15px; color: #1e293b;">No Geographic Data for Current Time Range</div>
                            <div style="font-size: 12.5px; color: #64748b; margin-top: 5px; max-width: 440px; margin-left: auto; margin-right: auto; line-height: 1.5;">
                                Google Analytics 4 standard geographic reports can have a 24–48 hour latency for newly active regions.
                            </div>
                            <button onclick="document.getElementById('rangeSelect').value='last30'; onRangeChange();" style="margin-top: 14px; background: linear-gradient(135deg, #0284c7, #0369a1); color: #fff; border: none; padding: 8px 18px; border-radius: 8px; font-weight: 700; font-size: 12.5px; cursor: pointer; box-shadow: 0 2px 6px rgba(2, 132, 199, 0.25); display: inline-flex; align-items: center; gap: 6px;">
                                <i class="fa-solid fa-calendar-days"></i> View Last 30 Days Traffic
                            </button>
                        </td>
                    </tr>
                `;
                return;
            }

            tbody.innerHTML = safeCountries.map((c, idx) => {
                const rankBadge = idx === 0 
                    ? '<span style="background: #fef3c7; color: #b45309; font-weight: 800; font-size: 11px; padding: 3px 8px; border-radius: 6px; border: 1px solid #fde68a;">🥇 #1</span>'
                    : (idx === 1 
                        ? '<span style="background: #f1f5f9; color: #475569; font-weight: 800; font-size: 11px; padding: 3px 8px; border-radius: 6px; border: 1px solid #e2e8f0;">🥈 #2</span>'
                        : (idx === 2 
                            ? '<span style="background: #ffedd5; color: #c2410c; font-weight: 800; font-size: 11px; padding: 3px 8px; border-radius: 6px; border: 1px solid #fed7aa;">🥉 #3</span>'
                            : `<span style="color: #64748b; font-weight: 700; font-size: 12px; background: #f8fafc; padding: 2px 7px; border-radius: 5px; border: 1px solid #e2e8f0;">#${idx + 1}</span>`));

                const flag = COUNTRY_FLAGS[c.country] || '🌐';
                const sharePercent = parseFloat(c.share) || 0;

                return `
                    <tr>
                        <td style="font-weight: 700; text-align: center;">${rankBadge}</td>
                        <td>
                            <div style="display: flex; align-items: center; gap: 10px; font-weight: 700; color: #0f172a;">
                                <span style="font-size: 19px; line-height: 1;">${flag}</span>
                                <span style="font-size: 13.5px;">${escapeHtml(c.country)}</span>
                            </div>
                        </td>
                        <td style="text-align: right; font-weight: 800; color: #0f172a; font-size: 13.5px;">${formatNumber(c.users)}</td>
                        <td style="text-align: right; font-weight: 700; color: #0284c7; font-size: 13.5px;">${formatNumber(c.views)}</td>
                        <td style="text-align: right; font-weight: 700; color: #475569; font-size: 13.5px;">${formatNumber(c.sessions)}</td>
                        <td>
                            <div style="display: flex; align-items: center; gap: 12px; justify-content: flex-end; padding-right: 8px;">
                                <div style="flex: 1; height: 8px; background: #e2e8f0; border-radius: 999px; overflow: hidden; min-width: 80px; max-width: 140px;">
                                    <div style="width: ${sharePercent}%; height: 100%; background: linear-gradient(90deg, #0284c7, #38bdf8); border-radius: 999px; transition: width 0.4s ease;"></div>
                                </div>
                                <span style="font-size: 12px; font-weight: 800; color: #0f172a; min-width: 44px; text-align: right;">${c.share}%</span>
                            </div>
                        </td>
                    </tr>
                `;
            }).join('');
        }

        async function saveGa4PropertyId() {
            const propertyId = (document.getElementById('ga4PropertyIdInput')?.value || '').trim();
            if (!propertyId) {
                alert('Please enter your GA4 Property ID (e.g. 412345678)');
                return;
            }

            try {
                const res = await fetch('/api/app-tracking/config', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ propertyId })
                });
                const data = await res.json();
                if (!data.success) throw new Error(data.message || 'Failed to save Property ID');

                alert('✅ GA4 Property ID saved successfully! You can now click "Test Connection".');
                loadStats();
            } catch (err) {
                alert('Error: ' + err.message);
            }
        }

        async function testGa4Connection() {
            const propertyId = (document.getElementById('ga4PropertyIdInput')?.value || '').trim();
            if (!propertyId) {
                alert('Please enter and save your GA4 Property ID first!');
                return;
            }

            try {
                const btn = event.currentTarget;
                const originalText = btn.innerHTML;
                btn.innerHTML = '<i class="fa-solid fa-circle-notch fa-spin"></i> Testing...';
                btn.disabled = true;

                const res = await fetch('/api/app-tracking/test-connection', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ propertyId })
                });
                const data = await res.json();
                btn.innerHTML = originalText;
                btn.disabled = false;

                if (data.success) {
                    const badge = document.getElementById('ga4-status-badge');
                    if (badge) {
                        badge.style.background = '#dcfce7';
                        badge.style.color = '#15803d';
                        badge.textContent = '🟢 GA4 Connected Live';
                    }
                    alert('🎉 Connection Successful! Google Analytics 4 is now connected live to your Admin Panel.');
                    loadStats();
                } else {
                    alert('⚠️ ' + (data.message || 'Connection test failed.'));
                }
            } catch (err) {
                alert('Connection test error: ' + err.message);
            }
        }

        function copyServiceAccountEmail() {
            const email = document.getElementById('sa-email-text')?.textContent.trim();
            navigator.clipboard.writeText(email).then(() => {
                const btn = document.getElementById('btn-copy-sa');
                btn.innerHTML = '<i class="fa-solid fa-check" style="color: #16a34a;"></i> Copied!';
                setTimeout(() => {
                    btn.innerHTML = '<i class="fa-regular fa-copy"></i> Copy Email';
                }, 2000);
            });
        }

        function formatNumber(val) {
            return new Intl.NumberFormat('en-IN').format(Number(val) || 0);
        }

        function toggleSidebar() {
            document.querySelector('.dashboard-shell')?.classList.toggle('sidebar-collapsed');
        }

        function toggleDropdown() {
            document.getElementById('dropdown')?.classList.toggle('show');
        }
    </script>
</body>

</html>
