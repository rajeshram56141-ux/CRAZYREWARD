        // PROFIT & LOSS REPORT
        async function checkProfitLoss() {
            const modal = document.getElementById('profitLossModal');
            const container = document.getElementById('profitLossReportContent');
            modal.classList.add('is-open');

            container.innerHTML = `<div style="text-align: center; color: var(--muted); padding: 40px;"><i class="fa-solid fa-spinner fa-spin fa-2x" style="margin-bottom: 12px; color: #052e1f;"></i><br>Calculating Profit & Loss statement...</div>`;

            try {
                const app = getSelectedApp();
                const start = document.getElementById('globalStartDate').value;
                const end = document.getElementById('globalEndDate').value;
                const preset = document.getElementById('globalPresetSelect').value;

                const res = await fetch('/api/promoters/profit-loss', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        app,
                        start: preset === 'lifetime' ? '' : start,
                        end: preset === 'lifetime' ? '' : end,
                        usdToInrRate: 95
                    })
                });

                const json = await res.json();
                if (!res.ok || !json.success) throw new Error(json.message || 'Failed to calculate P/L');

                plCurrentData = json;
                renderProfitLossHTML(json);
            } catch (err) {
                container.innerHTML = `<div style="text-align: center; color: #dc2626; padding: 30px; font-weight: 700;"><i class="fa-solid fa-triangle-exclamation fa-2x" style="margin-bottom: 10px;"></i><br>Error: ${err.message}</div>`;
            }
        }

        function recalculatePLFromInput(rateVal) {
            if (!plCurrentData) return;
            const rate = parseFloat(rateVal) || 95;
            plCurrentData.usdToInrRate = rate;

            const grossUSD = plCurrentData.grossUSD || plCurrentData.earningsUsd || 0;
            const grossINR = grossUSD * rate;
            const invalidCut = grossINR * 0.30;
            const postInvalid = grossINR - invalidCut;
            const commissionCut = postInvalid * 0.10;
            const netAppRevenue = postInvalid - commissionCut;
            const promoterCost = plCurrentData.promoterCostInr || plCurrentData.totalCost || 0;
            const userPayouts = plCurrentData.payoutsTotalInr || 0;
            const netProfitLoss = netAppRevenue - promoterCost - userPayouts;

            plCurrentData.grossINR = grossINR;
            plCurrentData.invalidCutInr = invalidCut;
            plCurrentData.commissionCutInr = commissionCut;
            plCurrentData.netAppRevenueInr = netAppRevenue;
            plCurrentData.netProfitLossInr = netProfitLoss;
            plCurrentData.isProfitable = netProfitLoss >= 0;

            renderProfitLossHTML(plCurrentData, false);
        }

