        // ADD PROMOTER MODAL LOGIC
        function openAddPromoterModal() {
            document.getElementById('addSelectedUserId').value = '';
            document.getElementById('addSearchInput').value = '';
            document.getElementById('addChannelName').value = '';
            document.getElementById('addPriceInInr').value = '';
            document.getElementById('addPromoDate').value = new Date().toISOString().split('T')[0];
