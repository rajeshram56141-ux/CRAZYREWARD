            document.getElementById('addPromoterModal').classList.remove('is-open');
        }

        let searchTimeout = null;
        function searchUsersForPromoter(query) {
            clearTimeout(searchTimeout);
            const container = document.getElementById('userSearchResults');

            if (!query || query.length < 2) {
                container.style.display = 'none';
                return;
            }

            searchTimeout = setTimeout(async () => {
                try {
                    const app = getSelectedApp();
                    const res = await fetch(`/api/promoters/search-users?app=${encodeURIComponent(app)}&query=${encodeURIComponent(query)}`);
                    const data = await res.json();

                    if (!data.success || !data.users || data.users.length === 0) {
                        container.innerHTML = `<div style="padding: 12px; font-size: 12px; color: var(--muted); text-align: center;">No users found matching "${escapeHtml(query)}"</div>`;
                        container.style.display = 'block';
                        return;
                    }

                    container.innerHTML = data.users.map(u => `
                        <div onclick="selectUserForPromoter('${u.userId}', '${escapeHtml(u.name || '')}', '${escapeHtml(u.email || '')}')" style="padding: 10px 14px; border-bottom: 1px solid #f1f5f9; cursor: pointer; transition: background 0.2s;" onmouseover="this.style.background='#f8fafc'" onmouseout="this.style.background='white'">
                            <div style="font-weight: 800; font-size: 13px; color: #0f172a;">${escapeHtml(u.name || 'User')}</div>
                            <div style="font-size: 11px; color: var(--muted);">${escapeHtml(u.email || '')} | UID: <span style="color:#052e1f; font-weight:700;">${u.userId}</span></div>
                        </div>
                    `).join('');
                    container.style.display = 'block';
                } catch (err) {
                    console.error('Search error:', err);
                }
            }, 300);
        }

        function selectUserForPromoter(userId, name, email) {
            document.getElementById('addSelectedUserId').value = userId;
            document.getElementById('addSearchInput').value = `${name} (${email || userId})`;
            document.getElementById('userSearchResults').style.display = 'none';
        }

        async function submitAddPromoter() {
            const userId = document.getElementById('addSelectedUserId').value;
            const channelName = document.getElementById('addChannelName').value.trim();
            const priceInInr = Number(document.getElementById('addPriceInInr').value) || 0;
            const promoDate = document.getElementById('addPromoDate').value;
            const videoLink = document.getElementById('addVideoLink').value.trim();

            if (!userId) {
                alert('Please search and select a user first!');
                return;
            }

            try {
                const res = await fetch('/api/promoters/add', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        app: getSelectedApp(),
                        userId,
                        channelName,
                        priceInInr,
                        promoDate,
                        videoLink
                    })
                });

                const json = await res.json();
                if (!res.ok || !json.success) throw new Error(json.message || 'Failed to add promoter');

                closeAddPromoterModal();
                loadPromotersList();
                fetchCostSummary();
                alert('Promoter added successfully!');
            } catch (err) {
                alert(err.message || 'Failed to add promoter');
            }
        }

        // EDIT & REMOVE PROMOTER
        async function togglePayoutBlock() {
            if (!currentPromoterId || !currentDetailData) return;
            const isBlocked = currentDetailData.isBlocked;

            let reason = '';
            if (!isBlocked) {
                reason = prompt('Reason for blocking withdrawals (Optional):') || '';
            }

            try {
                const res = await fetch('/api/promoters/update-details', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        app: getSelectedApp(),
                        userId: currentPromoterId,
                        isBlocked: !isBlocked,
                        blockReason: reason
                    })
                });

                const json = await res.json();
                if (!res.ok || !json.success) throw new Error(json.message || 'Failed to update status');

                loadPromoterDetail(currentPromoterId);
            } catch (err) {
                alert(err.message || 'Failed to update withdrawal status');
            }
        }

        async function confirmRemovePromoter() {
            if (!currentPromoterId) return;
            if (!confirm('Remove this promoter from the promoters catalog?')) return;

            try {
                const res = await fetch('/api/promoters/remove', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ app: getSelectedApp(), userId: currentPromoterId })
                });

                const json = await res.json();
                if (!res.ok || !json.success) throw new Error(json.message || 'Failed to remove promoter');

                currentPromoterId = null;
                document.getElementById('detailPlaceholder').style.display = 'block';
                document.getElementById('detailContent').style.display = 'none';
                loadPromotersList();
                fetchCostSummary();
            } catch (err) {
                alert(err.message || 'Failed to remove promoter');
            }
        }

        function toggleEditMongoDetails(showEdit) {
            document.getElementById('mongoDetailsView').style.display = showEdit ? 'none' : 'block';
            document.getElementById('mongoDetailsEdit').style.display = showEdit ? 'block' : 'none';

            if (showEdit && currentDetailData && currentDetailData.promoter) {
                const p = currentDetailData.promoter;
                document.getElementById('editChannelName').value = p.channelName || '';
                document.getElementById('editPriceInInr').value = p.priceInInr || 0;
                document.getElementById('editPromoDate').value = p.promoDate ? p.promoDate.split('T')[0] : '';
                document.getElementById('editVideoLink').value = p.videoLink || '';
            }
        }

        async function submitUpdateMongoDetails() {
            if (!currentPromoterId) return;

            const payload = {
                app: getSelectedApp(),
                userId: currentPromoterId,
                channelName: document.getElementById('editChannelName').value.trim(),
                priceInInr: Number(document.getElementById('editPriceInInr').value) || 0,
                promoDate: document.getElementById('editPromoDate').value,
                videoLink: document.getElementById('editVideoLink').value.trim(),
            };

            try {
                const res = await fetch('/api/promoters/update-details', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const json = await res.json();
                if (!res.ok || !json.success) throw new Error(json.message || 'Failed to update details');

                toggleEditMongoDetails(false);
                loadPromoterDetail(currentPromoterId);
                loadPromotersList();
                fetchCostSummary();
            } catch (err) {
                alert(err.message || 'Failed to update details');
            }
        }

        // PRESET DATE FILTER IN DETAIL CARD
        function applyPreset(preset) {
            document.querySelectorAll('.presets-row .btn-preset').forEach(b => {
                if (b.getAttribute('data-preset') === preset) b.classList.add('active');
                else b.classList.remove('active');
            });

            const today = new Date();
            let start = '', end = '';

            if (preset === 'today') {
                start = end = today.toISOString().split('T')[0];
            } else if (preset === 'yesterday') {
                const yest = new Date(today);
                yest.setDate(yest.getDate() - 1);
                start = end = yest.toISOString().split('T')[0];
            } else if (preset === 'last7') {
                const d = new Date(today);
                d.setDate(d.getDate() - 6);
                start = d.toISOString().split('T')[0];
                end = today.toISOString().split('T')[0];
            } else if (preset === 'thismonth') {
                start = getFirstDayOfMonth();
                end = today.toISOString().split('T')[0];
            }

            document.getElementById('filterStartDate').value = start;
            document.getElementById('filterEndDate').value = end;

            if (currentPromoterId) {
                loadPromoterDetail(currentPromoterId);
            }
        }

        function applyCustomFilter() {
            document.querySelectorAll('.presets-row .btn-preset').forEach(b => b.classList.remove('active'));
            if (currentPromoterId) {
                loadPromoterDetail(currentPromoterId);
            }
        }

        function downloadPromotersCSV() {
            if (!loadedPromoters || loadedPromoters.length === 0) {
                alert('No promoters to export.');
                return;
            }

            const app = getSelectedApp();
            let csv = 'Rank,Name,Email,UID,Referral Code,Direct Refers,Total Refers,Price INR\n';

            loadedPromoters.forEach((p, idx) => {
                csv += `"${idx + 1}","${p.name || ''}","${p.email || ''}","${p.userId || ''}","${p.referralCode || ''}","${p.directRefers || 0}","${p.totalRefers || 0}","${p.priceInInr || 0}"\n`;
            });

            const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
            const url = URL.createObjectURL(blob);
            const link = document.createElement('a');
            link.href = url;
            link.setAttribute('download', `promoters_${app}.csv`);
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }

        function escapeHtml(str) {
            if (!str) return '';
            return String(str)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;');
        }
    </script>
</body>

</html>
