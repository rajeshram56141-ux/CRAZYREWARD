        function downloadProfitLossPDF() {
            const element = document.getElementById('profitLossReportContent');
            if (!element) return;

            const opt = {
                margin:       10,
                filename:     `Profit_Loss_Report_${getSelectedApp()}_${new Date().toISOString().split('T')[0]}.pdf`,
                image:        { type: 'jpeg', quality: 0.98 },
                html2canvas:  { scale: 2, useCORS: true },
                jsPDF:        { unit: 'mm', format: 'a4', orientation: 'portrait' }
            };

            html2pdf().set(opt).from(element).save();
        }

