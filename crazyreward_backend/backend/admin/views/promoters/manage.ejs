    <script src="/js/admin.js"></script>
    <script>
        let loadedPromoters = [];
        let currentPromoterId = null;
        let currentDetailData = null;
        let selectedLevel = 1;

        // Pagination state for bottom table
        let tablePage = 1;
        const pageSize = 20;

        // Pagination state for popup modal
        let modalLevelPage = 1;
        const modalPageSize = 20;

        // P/L Report dynamic calculation cache
        let plCurrentData = null;

        document.addEventListener('DOMContentLoaded', () => {
            // Set initial dates for global date range
            const today = new Date().toISOString().split('T')[0];
            document.getElementById('globalEndDate').value = today;
            document.getElementById('globalStartDate').value = getFirstDayOfMonth();
            
            // Initial load of promoters and cost KPIs
            loadPromotersList();
            fetchCostSummary();
        });

        function getFirstDayOfMonth() {
            const date = new Date();
            return new Date(date.getFullYear(), date.getMonth(), 1).toISOString().split('T')[0];
        }

        function getSelectedApp() {
            return document.getElementById('appSelect')?.value || '';
        }

        function onAppChange() {
            currentPromoterId = null;
            document.getElementById('detailPlaceholder').style.display = 'block';
            document.getElementById('detailContent').style.display = 'none';
            loadPromotersList();
            fetchCostSummary();
        }

        function onGlobalPresetChange() {
            const preset = document.getElementById('globalPresetSelect').value;
            const today = new Date();
            let start = '', end = '';

            if (preset === 'today') {
                start = end = today.toISOString().split('T')[0];
            } else if (preset === 'yesterday') {
                const yest = new Date(today);
                yest.setDate(yest.getDate() - 1);
                start = end = yest.toISOString().split('T')[0];
            } else if (preset === 'thismonth') {
                start = getFirstDayOfMonth();
                end = today.toISOString().split('T')[0];
            } else if (preset === 'lastmonth') {
                const first = new Date(today.getFullYear(), today.getMonth() - 1, 1);
                const last = new Date(today.getFullYear(), today.getMonth(), 0);
                start = first.toISOString().split('T')[0];
                end = last.toISOString().split('T')[0];
            }

            if (preset !== 'lifetime') {
                document.getElementById('globalStartDate').value = start;
                document.getElementById('globalEndDate').value = end;
            }

            loadPromotersList();
            fetchCostSummary();
            if (currentPromoterId) loadPromoterDetail(currentPromoterId);
        }

        function onGlobalDateChange() {
            document.getElementById('globalPresetSelect').value = 'custom';
            loadPromotersList();
            fetchCostSummary();
            if (currentPromoterId) loadPromoterDetail(currentPromoterId);
        }

        // Fetch cost summary KPI cards
        async function fetchCostSummary() {
            try {
                const app = getSelectedApp();
                const preset = document.getElementById('globalPresetSelect').value;
                const start = document.getElementById('globalStartDate').value;
                const end = document.getElementById('globalEndDate').value;

                let url = `/api/promoters/cost-summary?app=${encodeURIComponent(app)}`;
                if (preset !== 'lifetime' && start && end) {
                    url += `&start=${encodeURIComponent(start)}&end=${encodeURIComponent(end)}`;
                }

                const res = await fetch(url);
                const data = await res.json();
                if (!res.ok || !data.success) return;

                const c = data.costs || data;
                document.getElementById('costToday').textContent = `₹${Number(c.today ?? data.todayCost ?? 0).toLocaleString('en-IN')}`;
                document.getElementById('costYesterday').textContent = `₹${Number(c.yesterday ?? data.yesterdayCost ?? 0).toLocaleString('en-IN')}`;
                document.getElementById('costThisMonth').textContent = `₹${Number(c.thisMonth ?? data.thisMonthCost ?? 0).toLocaleString('en-IN')}`;
                document.getElementById('costLastMonth').textContent = `₹${Number(c.lastMonth ?? data.lastMonthCost ?? 0).toLocaleString('en-IN')}`;
                document.getElementById('costFiltered').textContent = `₹${Number(c.filtered ?? data.filteredCost ?? 0).toLocaleString('en-IN')}`;
            } catch (err) {
                console.error('Failed to fetch cost summary:', err);
            }
        }

        // Fetch promoters list from API
        async function loadPromotersList() {
            const app = getSelectedApp();
            const tableBody = document.getElementById('promotersTableBody');
            const badge = document.getElementById('promotersCountBadge');

            const preset = document.getElementById('globalPresetSelect').value;
            const start = document.getElementById('globalStartDate').value;
            const end = document.getElementById('globalEndDate').value;

            tableBody.innerHTML = `<tr><td colspan="5" style="text-align: center; color: var(--muted); padding: 20px; font-weight: 600;">Loading promoters...</td></tr>`;

            try {
                let url = `/api/promoters/list?app=${encodeURIComponent(app)}`;
                if (preset !== 'lifetime' && start && end) {
                    url += `&start=${encodeURIComponent(start)}&end=${encodeURIComponent(end)}`;
                }

                const res = await fetch(url);
                const data = await res.json();

                if (!res.ok || !data.success) throw new Error(data.message || 'Failed to load');

                badge.innerText = `${data.promoters.length} Promoters`;
                loadedPromoters = data.promoters;

                if (data.promoters.length === 0) {
                    tableBody.innerHTML = `<tr><td colspan="5" style="text-align: center; color: var(--muted); padding: 20px; font-weight: 600;">No promoters found for this app.</td></tr>`;
                    return;
                }

                tableBody.innerHTML = data.promoters.map((prom, index) => {
                    const isSelected = String(prom.userId) === String(currentPromoterId);
                    return `
                        <tr class="${isSelected ? 'selected-promoter-row' : ''}" onclick="selectPromoter('${prom.userId}')" style="cursor: pointer;">
                            <td style="font-weight: 800; color: #052e1f;">#${index + 1}</td>
                            <td>
                                <div style="font-weight: 800; color: #0f172a;">${escapeHtml(prom.name || 'User')}</div>
                                <div style="font-size: 11px; color: var(--muted);">${escapeHtml(prom.email || '')}</div>
                            </td>
                            <td style="text-align: right; font-weight: 800;">${Number(prom.directRefers || 0).toLocaleString('en-IN')}</td>
                            <td style="text-align: right; font-weight: 800; color: #052e1f;">${Number(prom.totalRefers || 0).toLocaleString('en-IN')}</td>
                            <td style="text-align: right; font-weight: 800; color: #16a34a;">₹${Number(prom.priceInInr || 0).toLocaleString('en-IN')}</td>
                        </tr>
                    `;
                }).join('');
            } catch (err) {
                tableBody.innerHTML = `<tr><td colspan="5" style="text-align: center; color: #dc2626; padding: 20px; font-weight: 600;">Error loading promoters.</td></tr>`;
            }
        }

        function selectPromoter(userId) {
            currentPromoterId = userId;
            loadPromotersList();
            loadPromoterDetail(userId);
        }

        async function loadPromoterDetail(userId) {
            const app = getSelectedApp();
            document.getElementById('detailPlaceholder').style.display = 'none';
            document.getElementById('detailContent').style.display = 'block';

            const preset = document.getElementById('globalPresetSelect').value;
            const start = document.getElementById('globalStartDate').value;
            const end = document.getElementById('globalEndDate').value;

            try {
                let url = `/api/promoters/detail?app=${encodeURIComponent(app)}&userId=${encodeURIComponent(userId)}`;
                if (preset !== 'lifetime' && start && end) {
                    url += `&start=${encodeURIComponent(start)}&end=${encodeURIComponent(end)}`;
                }

                const res = await fetch(url);
                const data = await res.json();

                if (!res.ok || !data.success) throw new Error(data.message || 'Failed to fetch details');

                currentDetailData = data;
                renderPromoterDetailData(data);
            } catch (err) {
                alert('Error loading promoter details: ' + err.message);
            }
        }

        function renderPromoterDetailData(data) {
            const prom = data.promoter;
            document.getElementById('detName').textContent = prom.name || 'User';
            document.getElementById('detEmail').textContent = prom.email || '';
            document.getElementById('detCode').textContent = prom.referralCode || 'N/A';
            document.getElementById('detUid').textContent = prom.userId || '';

            // Withdraw status badge
            const badgeBox = document.getElementById('detPayoutBadge');
            const reasonBanner = document.getElementById('detBlockReasonBanner');
            const reasonText = document.getElementById('detBlockReasonText');

            if (data.isBlocked) {
                badgeBox.innerHTML = `<span style="background: #fef2f2; color: #dc2626; border: 1px solid #fecaca; border-radius: 999px; padding: 4px 10px; font-size: 12px; font-weight: 800;">🚫 Withdraw Blocked</span>`;
                reasonBanner.style.display = 'block';
                reasonText.textContent = data.blockReason || 'No reason specified';
            } else {
                badgeBox.innerHTML = `<span style="background: rgba(22, 163, 74, 0.1); color: #16a34a; border: 1px solid rgba(22, 163, 74, 0.2); border-radius: 999px; padding: 4px 10px; font-size: 12px; font-weight: 800;">✅ Withdraw Allowed</span>`;
                reasonBanner.style.display = 'none';
            }

            // Deal details
            document.getElementById('detChannelName').textContent = prom.channelName || 'N/A';
