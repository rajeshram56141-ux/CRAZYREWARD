<div id="user-modal" class="modal user-modal">
    <div class="modal-content user-modal-content">
        <div class="user-modal-head">
            <div class="user-modal-title-wrap">
                <h3>User Details</h3>
                <p>Profile insights, and account actions, controls</p>
            </div>
            <button type="button" class="user-modal-close" onclick="closeUserModal()"
                aria-label="Close">&times;</button>
        </div>

        <div id="user-modal-body" class="user-modal-body"></div>

        <div class="modal-actions user-modal-actions">
            <button class="btn-ok" onclick="closeUserModal()">Close</button>
        </div>
    </div>
</div>

<!-- DELETE USER CONFIRMATION MODAL -->
<div id="delete-user-modal" style="display: none; position: fixed; inset: 0; background: rgba(15, 23, 42, 0.65); z-index: 10000; align-items: center; justify-content: center; backdrop-filter: blur(4px);">
    <div style="background: #ffffff; border-radius: 20px; max-width: 520px; width: 90%; box-shadow: 0 20px 40px rgba(0,0,0,0.25); overflow: hidden; border: 1px solid #fee2e2;">
        <div style="background: #fef2f2; border-bottom: 1px solid #fecaca; padding: 20px 24px; display: flex; justify-content: space-between; align-items: center;">
            <div style="display: flex; align-items: center; gap: 12px;">
                <div style="width: 40px; height: 40px; border-radius: 12px; background: #fee2e2; border: 1px solid #fecaca; color: #dc2626; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                    <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                </div>
                <div>
                    <h3 style="margin: 0; font-size: 17px; font-weight: 800; color: #991b1b;">Delete User Account</h3>
                    <p style="margin: 3px 0 0 0; font-size: 12.5px; color: #b91c1c;">Permanent account deletion confirmation</p>
                </div>
            </div>
            <button type="button" onclick="closeDeleteUserModal()" style="border: none; background: none; font-size: 24px; cursor: pointer; color: #94a3b8;">&times;</button>
        </div>

        <div style="padding: 24px;">
            <p style="font-size: 13.5px; color: #334155; line-height: 1.5; margin: 0 0 16px 0;">
                Are you sure you want to permanently delete this user? This action cannot be undone and will delete all user records, wallet balance, and task history.
            </p>

            <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 14px; padding: 16px; margin-bottom: 20px;">
                <div style="display: flex; justify-content: space-between; margin-bottom: 8px; font-size: 13px;">
                    <span style="color: #64748b; font-weight: 600;">User Name:</span>
                    <span id="del_modal_name" style="font-weight: 700; color: #0f172a;">-</span>
                </div>
                <div style="display: flex; justify-content: space-between; margin-bottom: 8px; font-size: 13px;">
                    <span style="color: #64748b; font-weight: 600;">Email / Handle:</span>
                    <span id="del_modal_email" style="font-weight: 600; color: #0f172a;">-</span>
                </div>
                <div style="display: flex; justify-content: space-between; margin-bottom: 8px; font-size: 13px;">
                    <span style="color: #64748b; font-weight: 600;">User ID:</span>
                    <code id="del_modal_userid" style="font-family: monospace; font-size: 12px; background: #e2e8f0; padding: 2px 6px; border-radius: 4px; color: #0f172a;">-</code>
                </div>
                <div style="display: flex; justify-content: space-between; margin-bottom: 8px; font-size: 13px;">
                    <span style="color: #64748b; font-weight: 600;">Current Balance:</span>
                    <span id="del_modal_coins" style="font-weight: 800; color: #2563eb;">-</span>
                </div>
                <div style="display: flex; justify-content: space-between; font-size: 13px;">
                    <span style="color: #64748b; font-weight: 600;">Joined Date:</span>
                    <span id="del_modal_joined" style="color: #475569;">-</span>
                </div>
            </div>

            <div style="display: flex; justify-content: flex-end; gap: 12px;">
                <button type="button" class="btn-ghost" onclick="closeDeleteUserModal()" style="padding: 10px 18px; border-radius: 10px; font-weight: 700; border: 1px solid #cbd5e1; background: #fff; cursor: pointer; color: #475569;">Cancel</button>
                <button type="button" id="del_modal_confirm_btn" onclick="confirmDeleteUser()" style="padding: 10px 22px; border-radius: 10px; font-weight: 700; border: none; background: #dc2626; color: #ffffff; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; box-shadow: 0 4px 12px rgba(220, 38, 38, 0.3);">
                    <svg width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                    <span>Delete User Account</span>
                </button>
            </div>
        </div>
    </div>
</div>