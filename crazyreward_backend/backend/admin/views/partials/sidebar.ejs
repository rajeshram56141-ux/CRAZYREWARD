<%
    const safeAdmin = (typeof admin !== 'undefined' && admin) ? admin : {};
    const safeRole = safeAdmin.role || 'superadmin';
    const safePerms = safeAdmin.permissions || {};
    const isSuperAdmin = (safeRole === 'superadmin');
    const hasPerm = (key) => isSuperAdmin || Boolean(safePerms[key]);
%>
<aside class="dashboard-sidebar">
    <div class="sidebar-brand-wrapper">
        <div class="brand-logo-icon">
            <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
            </svg>
        </div>
        <div class="brand-text-group">
            <div class="sidebar-brand">Crazyreward</div>
            <div class="sidebar-caption">Admin Dashboard</div>
        </div>
        <button type="button" class="sidebar-collapse-btn" onclick="toggleSidebarCollapse()" title="Toggle Menu Collapse/Expand">
            <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 19l-7-7 7-7m8 14l-7-7 7-7"/>
            </svg>
        </button>
    </div>

    <nav class="sidebar-nav">
        <!-- 1. Dashboard -->
        <% if (hasPerm('dashboard')) { %>
            <a href="/" class="side-link <%= activePage === 'dashboard' ? 'active' : '' %>">
                <span class="link-icon">
                    <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
                </span>
                <span class="link-text">Dashboard</span>
                <span class="link-arrow">›</span>
            </a>
        <% } %>

        <!-- 2. Admin Manager -->
        <% if (isSuperAdmin) { %>
            <a href="/admin-manager" class="side-link <%= activePage === 'admin-manager' ? 'active' : '' %>">
                <span class="link-icon">
                    <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/></svg>
                </span>
                <span class="link-text">Admin Manager</span>
                <span class="link-arrow">›</span>
            </a>
        <% } %>

        <!-- SECTION 1: APP DATA (A) -->
        <% const canAccessAppData = hasPerm('appConfig') || hasPerm('moreApps') || hasPerm('myEarnings') || hasPerm('taskPerformance'); %>
        <% if (canAccessAppData) { %>
            <% const isAppDataGroupActive = ['my-earning', 'task-performance', 'app-settings', 'more-apps'].includes(activePage); %>
            <div class="side-menu-group <%= isAppDataGroupActive ? 'open' : '' %>" id="group-app-data">
                <button type="button" class="side-link side-group-btn" onclick="toggleSubMenu(event, 'group-app-data')">
                    <span class="link-icon">
                        <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4"/></svg>
                    </span>
                    <span class="link-text">App Data</span>
                    <span class="sub-menu-chevron">▼</span>
                </button>

                <div class="sub-menu-list">
                    <!-- Manage App Settings -->
                    <% if (hasPerm('appConfig')) { %>
                        <a href="/manage-app-settings" class="sub-side-link <%= activePage === 'app-settings' ? 'active' : '' %>">
                            <span class="sub-bullet">•</span>
                            <span class="link-text">Manage App Settings</span>
                        </a>
                    <% } %>

                    <!-- More Apps -->
                    <% if (hasPerm('moreApps') || hasPerm('appConfig')) { %>
                        <a href="/more-apps-admin" class="sub-side-link <%= activePage === 'more-apps' ? 'active' : '' %>">
                            <span class="sub-bullet">•</span>
                            <span class="link-text">More Apps</span>
                        </a>
                    <% } %>

                    <!-- My Earnings -->
                    <% if (hasPerm('myEarnings') || (isSuperAdmin && hasPerm('dashboard'))) { %>
                        <a href="/my-earning" class="sub-side-link <%= activePage === 'my-earning' ? 'active' : '' %>">
                            <span class="sub-bullet">•</span>
                            <span class="link-text">My Earnings</span>
                        </a>
                    <% } %>

                    <!-- Task Performance -->
                    <% if (hasPerm('taskPerformance') || (isSuperAdmin && hasPerm('dashboard'))) { %>
                        <a href="/task-performance" class="sub-side-link <%= activePage === 'task-performance' ? 'active' : '' %>">
                            <span class="sub-bullet">•</span>
                            <span class="link-text">Task Performance</span>
                        </a>
                    <% } %>
                </div>
            </div>
        <% } %>

        <!-- BATTLE ARENA GROUP -->
        <% if (hasPerm('battleArena')) { %>
            <% const isBattleArenaActive = ['battle-config', 'battle-game', 'battle-create', 'battle-history', 'battle-leaderboard', 'battle-bots'].includes(activePage); %>
            <div class="side-menu-group <%= isBattleArenaActive ? 'open' : '' %>" id="group-battle-arena">
                <button type="button" class="side-link side-group-btn" onclick="toggleSubMenu(event, 'group-battle-arena')">
                    <span class="link-icon">
                        <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                    </span>
                    <span class="link-text">Battle Arena</span>
                    <span class="sub-menu-chevron">▼</span>
                </button>

                <div class="sub-menu-list">
                    <a href="/admin/battle-arena/config" class="sub-side-link <%= activePage === 'battle-config' ? 'active' : '' %>">
                        <span class="sub-bullet">•</span>
                        <span class="link-text">Battle Config</span>
                    </a>
                    <a href="/admin/battle-arena/quiz-bank" class="sub-side-link <%= activePage === 'battle-game' ? 'active' : '' %>">
                        <span class="sub-bullet">•</span>
                        <span class="link-text">Battle Game</span>
                    </a>
                    <a href="/admin/battle-arena/rooms" class="sub-side-link <%= activePage === 'battle-create' ? 'active' : '' %>">
                        <span class="sub-bullet">•</span>
                        <span class="link-text">Battle Create</span>
                    </a>
                    <a href="/admin/battle-arena/history" class="sub-side-link <%= activePage === 'battle-history' ? 'active' : '' %>">
                        <span class="sub-bullet">•</span>
                        <span class="link-text">Battle History</span>
                    </a>
                    <a href="/admin/battle-arena/leaderboard" class="sub-side-link <%= activePage === 'battle-leaderboard' ? 'active' : '' %>">
                        <span class="sub-bullet">•</span>
                        <span class="link-text">Battle Leaderboard</span>
                    </a>
                    <a href="/admin/battle-arena/bots" class="sub-side-link <%= activePage === 'battle-bots' ? 'active' : '' %>">
                        <span class="sub-bullet">•</span>
                        <span class="link-text">Battle Bots</span>
                    </a>
                </div>
            </div>
        <% } %>

        <!-- SECTION 2: PAYMENT SECTION (P) -->
        <% const canAccessPayment = hasPerm('wallet') || hasPerm('payouts'); %>
        <% if (canAccessPayment) { %>
            <% const isPaymentSectionActive = ['manage-wallet', 'payouts', 'payment-history'].includes(activePage); %>
            <div class="side-menu-group <%= isPaymentSectionActive ? 'open' : '' %>" id="paymentSectionGroup">
                <button type="button" class="side-link side-group-btn" onclick="toggleSubMenu(event, 'paymentSectionGroup')">
                    <span class="link-icon">
                        <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2V7a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
                    </span>
                    <span class="link-text">Payment Section</span>
                    <span class="sub-menu-chevron">▼</span>
                </button>

                <div class="sub-menu-list">
                    <!-- Manage Wallet -->
                    <% if (hasPerm('wallet')) { %>
                        <a href="/manage-wallet" class="sub-side-link <%= activePage === 'manage-wallet' ? 'active' : '' %>">
                            <span class="sub-bullet">•</span>
                            <span class="link-text">Manage Wallet</span>
                        </a>
                    <% } %>

                    <!-- Payment History -->
                    <% if (hasPerm('payouts')) { %>
                        <a href="/payment-history" class="sub-side-link <%= activePage === 'payment-history' ? 'active' : '' %>">
                            <span class="sub-bullet">•</span>
                            <span class="link-text">Payment History</span>
                        </a>
                    <% } %>

                    <!-- Pending Payout -->
                    <% if (hasPerm('payouts')) { %>
                        <a href="/confirm-payments" class="sub-side-link <%= activePage === 'payouts' ? 'active' : '' %>">
                            <span class="sub-bullet">•</span>
                            <span class="link-text">Pending Payout</span>
                        </a>
                    <% } %>
                </div>
            </div>
        <% } %>

        <!-- SECTION 3: TASK MANAGEMENT (T) -->
        <% const canAccessTasks = hasPerm('dailyTasks') || hasPerm('dailyChallenge') || hasPerm('dailyCheckinFollow') || hasPerm('diamondCatch') || hasPerm('giveaways') || hasPerm('offerwall') || hasPerm('games') || hasPerm('promoCodes') || hasPerm('readEarn') || hasPerm('superOffer') || hasPerm('survey') || hasPerm('watchEarn'); %>
        <% if (canAccessTasks) { %>
            <% const isTaskMgmtActive = ['daily-tasks', 'daily-challenge', 'watch-earn', 'giveaways', 'games', 'promo-codes', 'read-earn', 'super-offer', 'diamond-catch', 'offerwall', 'survey', 'daily-checkin-follow'].includes(activePage); %>
            <div class="side-menu-group <%= isTaskMgmtActive ? 'open' : '' %>" id="taskMgmtGroup">
                <button type="button" class="side-link side-group-btn" onclick="toggleSubMenu(event, 'taskMgmtGroup')">
                    <span class="link-icon">
                        <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/></svg>
                    </span>
                    <span class="link-text">Task Management</span>
                    <span class="sub-menu-chevron">▼</span>
                </button>

                <div class="sub-menu-list">
                    <!-- Daily Challenge -->
                    <% if (hasPerm('dailyChallenge')) { %>
                        <a href="/manage-daily-challenge" class="sub-side-link <%= activePage === 'daily-challenge' ? 'active' : '' %>">
                            <span class="sub-bullet">•</span>
                            <span class="link-text">Daily Challenge</span>
                        </a>
                    <% } %>

                    <!-- Daily Checkin & Follow -->
                    <% if (hasPerm('dailyCheckinFollow')) { %>
                        <a href="/manage-daily-checkin-follow" class="sub-side-link <%= activePage === 'daily-checkin-follow' ? 'active' : '' %>">
                            <span class="sub-bullet">•</span>
                            <span class="link-text">Check-in & Follow</span>
                        </a>
                    <% } %>

                    <!-- Daily Task -->
                    <% if (hasPerm('dailyTasks')) { %>
                        <a href="/manage-daily-task" class="sub-side-link <%= activePage === 'daily-tasks' ? 'active' : '' %>">
                            <span class="sub-bullet">•</span>
                            <span class="link-text">Daily Task</span>
                        </a>
                    <% } %>

                    <!-- Diamond Catch -->
                    <% if (hasPerm('diamondCatch')) { %>
                        <a href="/diamond-catch" class="sub-side-link <%= activePage === 'diamond-catch' ? 'active' : '' %>">
                            <span class="sub-bullet">•</span>
                            <span class="link-text">Diamond Catch</span>
                        </a>
                    <% } %>

                    <!-- Giveaway -->
                    <% if (hasPerm('giveaways')) { %>
                        <a href="/manage-giveaway" class="sub-side-link <%= activePage === 'giveaways' ? 'active' : '' %>">
                            <span class="sub-bullet">•</span>
                            <span class="link-text">Giveaway</span>
                        </a>
                    <% } %>

                    <!-- Offerwall -->
                    <% if (hasPerm('offerwall')) { %>
                        <a href="/manage-offerwall" class="sub-side-link <%= activePage === 'offerwall' ? 'active' : '' %>">
                            <span class="sub-bullet">•</span>
                            <span class="link-text">Offerwall</span>
                        </a>
                    <% } %>

                    <!-- Play Games -->
                    <% if (hasPerm('games')) { %>
                        <a href="/play-games" class="sub-side-link <%= activePage === 'games' ? 'active' : '' %>">
                            <span class="sub-bullet">•</span>
                            <span class="link-text">Play Games</span>
                        </a>
                    <% } %>

                    <!-- Promo Codes -->
                    <% if (hasPerm('promoCodes')) { %>
                        <a href="/promo-codes" class="sub-side-link <%= activePage === 'promo-codes' ? 'active' : '' %>">
                            <span class="sub-bullet">•</span>
                            <span class="link-text">Promo Codes</span>
                        </a>
                    <% } %>

                    <!-- Read & Earn -->
                    <% if (hasPerm('readEarn')) { %>
                        <a href="/read-earn" class="sub-side-link <%= activePage === 'read-earn' ? 'active' : '' %>">
                            <span class="sub-bullet">•</span>
                            <span class="link-text">Read & Earn</span>
                        </a>
                    <% } %>

                    <!-- Super Offer -->
                    <% if (hasPerm('superOffer')) { %>
                        <a href="/super-offer" class="sub-side-link <%= activePage === 'super-offer' ? 'active' : '' %>">
                            <span class="sub-bullet">•</span>
                            <span class="link-text">Super Offer</span>
                        </a>
                    <% } %>

                    <!-- Survey -->
                    <% if (hasPerm('survey')) { %>
                        <a href="/manage-survey" class="sub-side-link <%= activePage === 'survey' ? 'active' : '' %>">
                            <span class="sub-bullet">•</span>
                            <span class="link-text">Survey</span>
                        </a>
                    <% } %>

                    <!-- Watch & Earn -->
                    <% if (hasPerm('watchEarn')) { %>
                        <a href="/manage-watch-earn" class="sub-side-link <%= activePage === 'watch-earn' ? 'active' : '' %>">
                            <span class="sub-bullet">•</span>
                            <span class="link-text">Watch & Earn</span>
                        </a>
                    <% } %>
                </div>
            </div>
        <% } %>

        <!-- SECTION 4: USER SECTION (U) -->
        <% const canAccessUserSection = hasPerm('support') || hasPerm('unusualActivity') || hasPerm('userActivity') || hasPerm('rewardHistory') || hasPerm('superOfferHistory'); %>
        <% if (canAccessUserSection) { %>
            <% const isUserSectionActive = ['unusual-activity', 'user-activity', 'support', 'reward-history', 'super-offer-history', 'super-offer-verification'].includes(activePage); %>
            <div class="side-menu-group <%= isUserSectionActive ? 'open' : '' %>" id="group-user-section">
                <button type="button" class="side-link side-group-btn" onclick="toggleSubMenu(event, 'group-user-section')">
                    <span class="link-icon">
                        <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
                    </span>
                    <span class="link-text">User Section</span>
                    <span class="sub-menu-chevron">▼</span>
                </button>

                <div class="sub-menu-list">
                    <!-- Support Manager -->
                    <% if (hasPerm('support')) { %>
                        <a href="/manage-support" class="sub-side-link <%= activePage === 'support' ? 'active' : '' %>">
                            <span class="sub-bullet">•</span>
                            <span class="link-text">Support Manager</span>
                        </a>
                    <% } %>

                    <!-- Unusual Activity -->
                    <% if (hasPerm('unusualActivity')) { %>
                        <a href="/unusual-activity" class="sub-side-link <%= activePage === 'unusual-activity' ? 'active' : '' %>">
                            <span class="sub-bullet">•</span>
                            <span class="link-text">Unusual Activity</span>
                        </a>
                    <% } %>

                    <!-- User Activity -->
                    <% if (hasPerm('userActivity')) { %>
                        <a href="/user-activity" class="sub-side-link <%= activePage === 'user-activity' ? 'active' : '' %>">
                            <span class="sub-bullet">•</span>
                            <span class="link-text">User Activity</span>
                        </a>
                    <% } %>

                    <!-- Reward History -->
                    <% if (hasPerm('rewardHistory') || (isSuperAdmin && hasPerm('userActivity'))) { %>
                        <a href="/manage-reward-history" class="sub-side-link <%= activePage === 'reward-history' ? 'active' : '' %>">
                            <span class="sub-bullet">•</span>
                            <span class="link-text">Reward History</span>
                        </a>
                    <% } %>

                    <!-- Super Offer History -->
                    <% if (hasPerm('superOfferHistory') || (isSuperAdmin && hasPerm('superOffer'))) { %>
                        <a href="/manage-super-offer-history" class="sub-side-link <%= activePage === 'super-offer-history' ? 'active' : '' %>">
                            <span class="sub-bullet">•</span>
                            <span class="link-text">Super Offer History</span>
                        </a>
                    <% } %>

                    <!-- Super Offer Verification -->
                    <% if (hasPerm('superOfferHistory') || (isSuperAdmin && hasPerm('superOffer'))) { %>
                        <a href="/manage-super-offer-verification" class="sub-side-link <%= activePage === 'super-offer-verification' ? 'active' : '' %>">
                            <span class="sub-bullet">•</span>
                            <span class="link-text">Super Offer Verification</span>
                        </a>
                    <% } %>
                </div>
            </div>
        <% } %>

        <!-- OTHER SECTIONS -->
        <% const canAccessDevMode = hasPerm('devMode') || hasPerm('apiIntegrations') || hasPerm('postbackLogs') || hasPerm('redisManage'); %>
        <% const canAccessOther = canAccessDevMode || hasPerm('users') || hasPerm('promotions') || hasPerm('promoters') || hasPerm('notifications'); %>
        <% if (canAccessOther) { %>
            <div class="sidebar-section-header">OTHER SECTIONS</div>

            <!-- DEVELOPER MODE COLLAPSIBLE SUB-MENU -->
            <% if (canAccessDevMode) { %>
                <% const isDevModeGroupActive = ['app-tracking', 'postback-logs', 'redis-manage', 'api-integrations', 's2s-postbacks', 'cpa-docs'].includes(activePage); %>
                <div class="side-menu-group <%= isDevModeGroupActive ? 'open' : '' %>" id="group-dev-mode">
                    <button type="button" class="side-link side-group-btn" onclick="toggleSubMenu(event, 'group-dev-mode')">
                        <span class="link-icon">
                            <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>
                        </span>
                        <span class="link-text">Developer Mode</span>
                        <span class="sub-menu-chevron">▼</span>
                    </button>

                    <div class="sub-menu-list">
                        <!-- App Tracking & GA4 Analytics -->
                        <% if (hasPerm('devMode')) { %>
                            <a href="/app-tracking" class="sub-side-link <%= activePage === 'app-tracking' ? 'active' : '' %>">
                                <span class="sub-bullet">•</span>
                                <span class="link-text">App Tracking & GA4</span>
                                <span style="background: #0284c7; color: #ffffff; padding: 2px 6px; border-radius: 6px; font-size: 9px; font-weight: 800; margin-left: auto;">NEW</span>
                            </a>
                        <% } %>

                        <!-- Custom CPA Postback Docs -->
                        <% if (hasPerm('devMode')) { %>
                            <a href="/cpa-docs" class="sub-side-link <%= activePage === 'cpa-docs' ? 'active' : '' %>">
                                <span class="sub-bullet">•</span>
                                <span class="link-text">CPA & Offerwall Docs</span>
                                <span style="background: #10b981; color: #ffffff; padding: 2px 6px; border-radius: 6px; font-size: 9px; font-weight: 800; margin-left: auto;">DOCS</span>
                            </a>
                        <% } %>

                        <!-- S2S Callbacks -->
                        <% if (hasPerm('devMode')) { %>
                            <a href="/s2s-postbacks" class="sub-side-link <%= activePage === 's2s-postbacks' ? 'active' : '' %>">
                                <span class="sub-bullet">•</span>
                                <span class="link-text">S2S Callbacks</span>
                            </a>
                        <% } %>

                        <!-- API Integrations -->
                        <% if (hasPerm('apiIntegrations') || hasPerm('devMode')) { %>
                            <a href="/api-integrations" class="sub-side-link <%= activePage === 'api-integrations' ? 'active' : '' %>">
                                <span class="sub-bullet">•</span>
                                <span class="link-text">API Integrations</span>
                            </a>
                        <% } %>

                        <!-- Postback Logs -->
                        <% if (hasPerm('postbackLogs') || isSuperAdmin) { %>
                            <a href="/postback-logs" class="sub-side-link <%= activePage === 'postback-logs' ? 'active' : '' %>">
                                <span class="sub-bullet">•</span>
                                <span class="link-text">Postback Logs</span>
                            </a>
                        <% } %>

                        <!-- Redis Cache -->
                        <% if (hasPerm('redisManage') || isSuperAdmin) { %>
                            <a href="/redis-manage" class="sub-side-link <%= activePage === 'redis-manage' ? 'active' : '' %>">
                                <span class="sub-bullet">•</span>
                                <span class="link-text">Redis Cache</span>
                            </a>
                        <% } %>
                    </div>
                </div>
            <% } %>

            <!-- Delete Requests -->
            <% if (hasPerm('users')) { %>
                <a href="/manage-deletions" class="side-link <%= activePage === 'deletions' ? 'active' : '' %>">
                    <span class="link-icon">
                        <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                    </span>
                    <span class="link-text">Delete Requests</span>
                    <span class="link-arrow">›</span>
                </a>
            <% } %>

            <!-- Promotion Manager -->
            <% if (hasPerm('promotions')) { %>
                <a href="/manage-promotions" class="side-link <%= activePage === 'promotions' ? 'active' : '' %>">
                    <span class="link-icon">
                        <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z"/></svg>
                    </span>
                    <span class="link-text">Promotion Manager</span>
                    <span class="link-arrow">›</span>
                </a>
            <% } %>

            <!-- Promoters -->
            <% if (hasPerm('promoters') || hasPerm('users')) { %>
                <a href="/promoters" class="side-link <%= activePage === 'promoters' ? 'active' : '' %>">
                    <span class="link-icon">
                        <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z"/></svg>
                    </span>
                    <span class="link-text">Promoters</span>
                    <span class="link-arrow">›</span>
                </a>
            <% } %>

            <!-- Send Notification -->
            <% if (hasPerm('notifications')) { %>
                <button type="button" class="side-link side-link-btn" onclick="openNotificationComposer()">
                    <span class="link-icon">
                        <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/></svg>
                    </span>
                    <span class="link-text">Send Notification</span>
                    <span class="link-arrow">›</span>
                </button>
            <% } %>
        <% } %>
    </nav>

