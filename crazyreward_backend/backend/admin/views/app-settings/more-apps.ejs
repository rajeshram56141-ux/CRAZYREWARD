<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>More Apps Management - Admin</title>
    <link rel="stylesheet" href="/css/admin.css">
    <link rel="icon" href="/images/favicon.png">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg: #f8fafc;
            --surface: #ffffff;
            --border: #e2e8f0;
            --primary: #052e1f;
            --primary-hover: #042418;
            --text: #0f172a;
            --muted: #64748b;
        }

        * {
            box-sizing: border-box;
            font-family: 'Plus Jakarta Sans', sans-serif;
        }

        body {
            margin: 0;
            background: var(--bg);
            color: var(--text);
        }

        .glass-card {
            background: #ffffff;
            border-radius: 20px;
            padding: 24px;
            margin-bottom: 24px;
            box-shadow: 0 4px 16px rgba(0, 0, 0, 0.03);
            border: 1px solid var(--border);
        }

        .table-responsive {
            width: 100%;
            overflow-x: auto;
            border-radius: 12px;
            border: 1px solid #e2e8f0;
        }

        .apps-table {
            width: 100%;
            border-collapse: collapse;
            text-align: left;
            font-size: 14px;
            background: #ffffff;
        }

        .apps-table th {
            background: #f1f5f9;
            color: #334155;
            font-weight: 700;
            padding: 14px 16px;
            border-bottom: 1px solid #e2e8f0;
            white-space: nowrap;
        }

        .apps-table td {
            padding: 14px 16px;
            border-bottom: 1px solid #f1f5f9;
            vertical-align: middle;
        }

        .apps-table tr:hover {
            background: #f8fafc;
        }

        .app-icon-preview {
            width: 44px;
            height: 44px;
            border-radius: 10px;
            object-fit: cover;
            background: #e2e8f0;
            border: 1px solid #cbd5e1;
        }

        .btn-add {
            background: #10b981;
            color: white;
            border: none;
            padding: 10px 20px;
            border-radius: 10px;
            cursor: pointer;
            font-weight: 700;
            font-size: 14px;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            transition: background 0.2s;
        }

        .btn-add:hover {
            background: #059669;
        }

        .btn-action {
            padding: 6px 12px;
            border-radius: 6px;
            border: none;
            cursor: pointer;
            font-weight: 700;
            font-size: 12px;
            display: inline-flex;
            align-items: center;
            gap: 4px;
        }

        .btn-edit {
            background: #3b82f6;
            color: white;
        }
        .btn-edit:hover { background: #2563eb; }

        .btn-delete {
            background: #ef4444;
            color: white;
        }
        .btn-delete:hover { background: #dc2626; }

        .badge-type {
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 800;
            display: inline-block;
        }

        .badge-coin { background: #fef3c7; color: #b45309; border: 1px solid #fde68a; }
        .badge-download { background: #dbeafe; color: #1e40af; border: 1px solid #bfdbfe; }
        .badge-ad { background: #fce7f3; color: #be185d; border: 1px solid #fbcfe8; }

        /* Switch Toggle */
        .switch {
            position: relative;
            display: inline-block;
            width: 44px;
            height: 24px;
        }
        .switch input { opacity: 0; width: 0; height: 0; }
        .slider {
            position: absolute; cursor: pointer; top: 0; left: 0; right: 0; bottom: 0;
            background-color: #cbd5e1; transition: .3s; border-radius: 24px;
        }
        .slider:before {
            position: absolute; content: ""; height: 18px; width: 18px; left: 3px; bottom: 3px;
            background-color: white; transition: .3s; border-radius: 50%;
        }
        input:checked + .slider { background-color: #10b981; }
        input:checked + .slider:before { transform: translateX(20px); }

        /* Modal Overlay & Card */
        .modal-overlay {
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            background: rgba(15, 23, 42, 0.65);
            backdrop-filter: blur(4px);
            display: none;
            justify-content: center;
            align-items: center;
            z-index: 9999;
            padding: 16px;
        }
        .modal-card {
            background: #ffffff;
            width: 100%;
            max-width: 580px;
            border-radius: 18px;
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
            overflow: hidden;
            border: 1px solid #e2e8f0;
            animation: modalFadeIn 0.25s ease-out;
        }
        @keyframes modalFadeIn {
            from { opacity: 0; transform: scale(0.95); }
            to { opacity: 1; transform: scale(1); }
        }
        .modal-header {
            padding: 18px 24px;
            background: #f8fafc;
            border-bottom: 1px solid #e2e8f0;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .modal-header h3 { margin: 0; font-size: 18px; font-weight: 800; color: #052e1f; }
        .modal-close {
            background: transparent; border: none; font-size: 22px; cursor: pointer; color: #64748b; font-weight: 700;
        }
        .modal-body {
            padding: 24px;
            display: flex;
            flex-direction: column;
            gap: 14px;
            max-height: 80vh;
            overflow-y: auto;
        }
        .modal-footer {
            padding: 16px 24px;
            background: #f8fafc;
            border-top: 1px solid #e2e8f0;
            display: flex;
            justify-content: flex-end;
            gap: 10px;
        }
        .field-group {
            display: flex;
            flex-direction: column;
            gap: 5px;
            font-weight: 600;
            font-size: 13px;
        }
        .field-group input, .field-group select {
            padding: 10px 12px;
            border: 1px solid #cbd5e1;
            border-radius: 8px;
            font-size: 13px;
            background: white;
            outline: none;
        }
        .field-group input:focus, .field-group select:focus {
            border-color: #10b981;
            box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.15);
        }

        .status-toast {
            padding: 12px 16px;
            border-radius: 8px;
            font-weight: 600;
            margin-top: 14px;
            display: none;
        }
        .status-toast.success { background: #dcfce7; color: #15803d; border: 1px solid #bbf7d0; }
        .status-toast.error { background: #fee2e2; color: #b91c1c; border: 1px solid #fecaca; }
    </style>
</head>

<body class="dashboard-body">
    <div class="dashboard-shell">
        <%- include('../partials/sidebar', { activePage: 'more-apps' }) %>

        <div class="dashboard-main">
            <header class="navbar dashboard-navbar">
                <div class="nav-left" style="display: flex; align-items: center; gap: 12px; white-space: nowrap;">
                    <button type="button" class="sidebar-toggle-btn" onclick="toggleSidebar()">☰</button>
                    <h2 style="margin: 0; font-size: 18px; font-weight: 800; white-space: nowrap;">More Apps</h2>
                </div>

                <div class="nav-right" onclick="toggleDropdown()">
                    <div class="avatar"><%- typeof photo !== 'undefined' && photo ? photo : 'A' %></div>
                    <div class="dropdown" id="dropdown">
                        <a href="/logout">Logout</a>
                    </div>
                </div>
            </header>

            <main class="container dashboard-home">
                <!-- MAIN GLASS CARD -->
                <section class="glass-card">
                    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px; margin-bottom: 20px;">
                        <div>
                            <h2 style="margin: 0 0 4px 0; font-size: 22px; font-weight: 800; color: #052e1f;">More Apps Management</h2>
                            <p style="color: var(--muted); font-size: 13px; margin: 0;">Manage & arrange apps shown in the "More Apps" section of the Flutter App</p>
                        </div>
                        <div>
                            <button type="button" class="btn-add" onclick="openAppModal()"><i class="fa-solid fa-plus" style="margin-right: 4px;"></i> Add New App</button>
                        </div>
                    </div>

                    <div class="table-responsive">
                        <table class="apps-table">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>App Info</th>
                                    <th>Reward / Type</th>
                                    <th>AD Badge</th>
                                    <th>Redirection URL</th>
                                    <th>Enable</th>
                                    <th style="text-align: center;">Actions</th>
                                </tr>
                            </thead>
                            <tbody id="apps-table-body">
                                <!-- Rendered dynamically via JavaScript -->
                            </tbody>
                        </table>
                    </div>

                    <div id="no-apps-msg" style="text-align: center; color: var(--muted); padding: 40px; display: none;">
                        No apps added yet. Click <strong>"+ Add New App"</strong> above to create your first app!
                    </div>

                    <div id="save-status" class="status-toast"></div>
                </section>
            </main>
        </div>
    </div>

    <!-- ADD / EDIT APP MODAL POPUP -->
    <div class="modal-overlay" id="moreAppModal">
        <div class="modal-card">
            <div class="modal-header">
                <h3 id="modalTitle"><i class="fa-solid fa-plus" style="margin-right: 6px;"></i> Add New App</h3>
                <button type="button" class="modal-close" onclick="closeAppModal()">&times;</button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="modalAppIndex" value="-1" />
                
                <div style="display: flex; gap: 16px; align-items: center; background: #f8fafc; padding: 12px; border-radius: 10px; border: 1px solid #e2e8f0;">
                    <img id="modalIconPreview" src="/images/favicon.png" class="app-icon-preview" onerror="this.src='/images/favicon.png'" />
                    <div>
                        <span style="font-weight: 700; font-size: 13px; color: #334155;">Icon Live Preview</span>
                        <div style="font-size: 11px; color: #64748b;">Updates live as you paste image URL</div>
                    </div>
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                    <div class="field-group">
                        <label>App Name *</label>
                        <input id="modalAppName" type="text" placeholder="e.g. Ludo Supreme" required />
                    </div>
                    <div class="field-group">
                        <label>App Logo URL *</label>
                        <input id="modalAppLogo" type="text" placeholder="https://..." oninput="updateModalIconPreview(this.value)" required />
                    </div>
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                    <div class="field-group">
                        <label>Subtitle / Description</label>
                        <input id="modalAppSubtitle" type="text" placeholder="Play fun games daily!" />
                    </div>
                    <div class="field-group">
                        <label>Redirect Link (Play Store / Web) *</label>
                        <input id="modalAppUrl" type="text" placeholder="https://..." required />
                    </div>
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr 1fr 1fr; gap: 12px;">
                    <div class="field-group">
                        <label>Button Type</label>
                        <select id="modalButtonType">
                            <option value="download">Download / GET</option>
                            <option value="coin">Coin Reward</option>
                        </select>
                    </div>
                    <div class="field-group" id="coinsFieldGroup">
                        <label>Coins Amount</label>
                        <input id="modalCoins" type="number" min="0" value="0" />
                    </div>
                    <div class="field-group">
                        <label>Show AD Badge</label>
                        <select id="modalIsAd">
                            <option value="false">False</option>
                            <option value="true">True (AD Badge)</option>
                        </select>
                    </div>
                    <div class="field-group">
                        <label>Status</label>
                        <select id="modalEnabled">
                            <option value="true">Enabled</option>
                            <option value="false">Disabled</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" style="background: #e2e8f0; color: #334155; border: none; padding: 10px 18px; border-radius: 8px; font-weight: 700; cursor: pointer;" onclick="closeAppModal()">Cancel</button>
                <button type="button" style="background: #10b981; color: white; border: none; padding: 10px 22px; border-radius: 8px; font-weight: 700; cursor: pointer;" onclick="saveAppFromModal()"><i class="fa-solid fa-floppy-disk" style="margin-right: 4px;"></i> Save App</button>
            </div>
        </div>
    </div>

    <%- include('../partials/user_lookup') %>
    <script src="/js/admin.js"></script>
    <script src="/js/user_lookup.js"></script>

    <!-- SERVER DATA PASSED SAFELY FOR VALID HTML & JS LINTERS -->
    <script id="more-apps-json" type="application/json">
        <%- JSON.stringify(moreApps || []) %>
    </script>

    <script>
        // Initial Server Data
        let appsList = [];
        try {
            const rawData = document.getElementById('more-apps-json').textContent;
            appsList = JSON.parse(rawData);
        } catch (e) {
            appsList = [];
        }

        // Helper Functions
        function escapeHtml(str) {
            return String(str || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
        }

        // Render Table on Load
        document.addEventListener('DOMContentLoaded', () => {
            renderAppsTable();
        });

        function renderAppsTable() {
            const tbody = document.getElementById('apps-table-body');
            const noAppsMsg = document.getElementById('no-apps-msg');
            if (!tbody) return;
            tbody.innerHTML = '';

            if (!Array.isArray(appsList) || appsList.length === 0) {
                if (noAppsMsg) noAppsMsg.style.display = 'block';
                return;
            }
            if (noAppsMsg) noAppsMsg.style.display = 'none';

            appsList.forEach((app, index) => {
                const name = app.ourAppName || app.appName || app.name || 'Untitled App';
                const logo = app.ourAppLogo || app.appLogo || app.logo || '/images/favicon.png';
                const subtitle = app.ourAppSubtitle || app.subtitle || app.subTitle || 'No description';
                const url = app.ourAppUrl || app.redirectionUrl || app.url || '#';
                const buttonType = app.buttonType || 'download';
                const coins = Number(app.coins) || 0;
                const isAd = app.isAd === true;
                const enabled = app.enabled !== false;

                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td style="font-weight: 800; color: #64748b;">#${index + 1}</td>
                    <td>
                        <div style="display: flex; align-items: center; gap: 12px;">
                            <img src="${logo}" class="app-icon-preview" onerror="this.src='/images/favicon.png'" />
                            <div>
                                <div style="font-weight: 800; color: #0f172a; font-size: 14px;">${escapeHtml(name)}</div>
                                <div style="font-size: 12px; color: #64748b; max-width: 200px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">${escapeHtml(subtitle)}</div>
                            </div>
                        </div>
                    </td>
                    <td>
                        ${buttonType === 'coin' 
                            ? `<span class="badge-type badge-coin"><i class="fa-solid fa-coins" style="margin-right:3px;"></i> +${coins} Coins</span>` 
                            : `<span class="badge-type badge-download"><i class="fa-solid fa-download" style="margin-right:3px;"></i> DOWNLOAD</span>`}
                    </td>
                    <td>
                        ${isAd 
                            ? `<span class="badge-type badge-ad">AD</span>` 
                            : `<span style="color: #94a3b8; font-weight: 600;">-</span>`}
                    </td>
                    <td>
                        <a href="${escapeHtml(url)}" target="_blank" style="color: #2563eb; text-decoration: none; font-size: 13px; font-weight: 600; display: inline-flex; align-items: center; gap: 4px; max-width: 180px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                            <i class="fa-solid fa-link"></i> ${escapeHtml(url)}
                        </a>
                    </td>
                    <td>
                        <label class="switch">
                            <input type="checkbox" ${enabled ? 'checked' : ''} onchange="toggleAppEnable(${index}, this.checked)" />
                            <span class="slider"></span>
                        </label>
                    </td>
                    <td style="text-align: center; white-space: nowrap;">
                        <button type="button" class="btn-action btn-edit" onclick="openAppModal(${index})"><i class="fa-solid fa-pen-to-square"></i> Edit</button>
                        <button type="button" class="btn-action btn-delete" onclick="deleteApp(${index})"><i class="fa-solid fa-trash-can"></i> Delete</button>
                    </td>
                `;
                tbody.appendChild(tr);
            });
        }

        // Modal Functions
        function openAppModal(index = -1) {
            document.getElementById('modalAppIndex').value = index;
            const title = document.getElementById('modalTitle');
            const iconPreview = document.getElementById('modalIconPreview');

            if (index >= 0 && index < appsList.length) {
                if (title) title.innerHTML = '<i class="fa-solid fa-pen-to-square" style="margin-right:6px;"></i> Edit App #' + (index + 1);
                const app = appsList[index];
                document.getElementById('modalAppName').value = app.ourAppName || app.appName || app.name || '';
                document.getElementById('modalAppLogo').value = app.ourAppLogo || app.appLogo || app.logo || '';
                document.getElementById('modalAppSubtitle').value = app.ourAppSubtitle || app.subtitle || app.subTitle || '';
                document.getElementById('modalAppUrl').value = app.ourAppUrl || app.redirectionUrl || app.url || '';
                document.getElementById('modalButtonType').value = app.buttonType || 'download';
                document.getElementById('modalCoins').value = Number(app.coins) || 0;
                document.getElementById('modalIsAd').value = app.isAd === true ? 'true' : 'false';
                document.getElementById('modalEnabled').value = app.enabled !== false ? 'true' : 'false';
                if (iconPreview) iconPreview.src = app.ourAppLogo || app.appLogo || '/images/favicon.png';
            } else {
                if (title) title.innerHTML = '<i class="fa-solid fa-plus" style="margin-right:6px;"></i> Add New App';
                document.getElementById('modalAppName').value = '';
                document.getElementById('modalAppLogo').value = '';
                document.getElementById('modalAppSubtitle').value = '';
                document.getElementById('modalAppUrl').value = '';
                document.getElementById('modalButtonType').value = 'download';
                document.getElementById('modalCoins').value = '0';
                document.getElementById('modalIsAd').value = 'false';
                document.getElementById('modalEnabled').value = 'true';
                if (iconPreview) iconPreview.src = '/images/favicon.png';
            }

            const modal = document.getElementById('moreAppModal');
            if (modal) modal.style.display = 'flex';
        }

        function closeAppModal() {
            const modal = document.getElementById('moreAppModal');
            if (modal) modal.style.display = 'none';
        }

        function updateModalIconPreview(url) {
            const iconPreview = document.getElementById('modalIconPreview');
            if (iconPreview) iconPreview.src = url.trim() || '/images/favicon.png';
        }

        async function saveAppFromModal() {
            const index = parseInt(document.getElementById('modalAppIndex').value, 10);
            const name = document.getElementById('modalAppName').value.trim();
            const logo = document.getElementById('modalAppLogo').value.trim();
            const subtitle = document.getElementById('modalAppSubtitle').value.trim();
            const url = document.getElementById('modalAppUrl').value.trim();
            const buttonType = document.getElementById('modalButtonType').value;
            const coins = Number(document.getElementById('modalCoins').value || 0);
            const isAd = document.getElementById('modalIsAd').value === 'true';
            const enabled = document.getElementById('modalEnabled').value === 'true';

            if (!name) { alert('Please enter App Name'); return; }
            if (!logo) { alert('Please enter App Logo URL'); return; }
            if (!url) { alert('Please enter Redirect Link'); return; }

            const appData = {
                id: index >= 0 ? appsList[index].id : ('app_' + Date.now()),
                ourAppName: name,
                appName: name,
                ourAppLogo: logo,
                appLogo: logo,
                ourAppSubtitle: subtitle,
                subtitle: subtitle,
                ourAppUrl: url,
                redirectionUrl: url,
                buttonType: buttonType,
                coins: coins,
                isAd: isAd,
                enabled: enabled,
            };

            if (index >= 0 && index < appsList.length) {
                appsList[index] = appData;
            } else {
                appsList.push(appData);
            }

            closeAppModal();
            renderAppsTable();
            await persistAppsToBackend();
        }

        async function toggleAppEnable(index, isChecked) {
            if (index >= 0 && index < appsList.length) {
                appsList[index].enabled = isChecked;
                await persistAppsToBackend();
            }
        }

        async function deleteApp(index) {
            if (index >= 0 && index < appsList.length) {
                const name = appsList[index].ourAppName || appsList[index].appName || 'this app';
                if (!confirm(`Are you sure you want to delete "${name}"?`)) return;

                appsList.splice(index, 1);
                renderAppsTable();
                await persistAppsToBackend();
            }
        }

        async function persistAppsToBackend() {
            const statusDiv = document.getElementById('save-status');
            if (statusDiv) statusDiv.style.display = 'none';

            try {
                const res = await fetch('/more-apps-admin/save', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ moreApps: appsList }),
                });
                const json = await res.json();
                if (!res.ok || !json.success) throw new Error(json.message || 'Failed to save');

                if (statusDiv) {
                    statusDiv.className = 'status-toast success';
                    statusDiv.innerHTML = '<i class="fa-solid fa-circle-check" style="margin-right:4px;"></i> ' + (json.message || 'More Apps list updated successfully!');
                    statusDiv.style.display = 'block';
                    setTimeout(() => { statusDiv.style.display = 'none'; }, 4000);
                }
            } catch (err) {
                if (statusDiv) {
                    statusDiv.className = 'status-toast error';
                    statusDiv.innerHTML = '<i class="fa-solid fa-circle-xmark" style="margin-right:4px;"></i> ' + (err.message || 'Failed to update More Apps');
                    statusDiv.style.display = 'block';
                }
            }
        }
    </script>
</body>

</html>
