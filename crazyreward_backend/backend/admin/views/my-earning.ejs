<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Earnings - Crazyreward Admin</title>
    <link rel="stylesheet" href="/css/admin.css">
    <link rel="icon" href="/images/favicon.png">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        :root {
            --bg: #f8fafc;
            --surface: #ffffff;
            --border: #e2e8f0;
            --primary: #052e1f;
            --primary-hover: #042418;
            --text: #0f172a;
            --muted: #64748b;
        }

        * {
            box-sizing: border-box;
            font-family: 'Plus Jakarta Sans', sans-serif !important;
        }

        body {
            margin: 0;
            background: var(--bg);
            color: var(--text);
        }

        /* Glassmorphism Cards */
        .glass-card {
            background: #ffffff;
            border-radius: 20px;
            padding: 24px;
            margin-bottom: 24px;
            box-shadow: 0 4px 16px rgba(0, 0, 0, 0.03);
            border: 1px solid var(--border);
        }

        /* Overview Filter Bar */
        .overview-head {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 16px;
        }

        .overview-filters {
            display: flex;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
        }

        .overview-filters label {
            display: flex;
            flex-direction: column;
            gap: 4px;
            font-size: 11px;
            font-weight: 800;
            color: var(--muted);
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        .overview-filters select,
        .overview-filters input[type="date"] {
            padding: 8px 14px;
            border: 1px solid var(--border);
            border-radius: 10px;
            background: #ffffff;
            font-size: 13px;
            font-weight: 700;
            color: var(--text);
            outline: none;
            transition: all 0.2s ease;
        }

        .overview-filters select:focus,
        .overview-filters input[type="date"]:focus {
            border-color: #052e1f;
            box-shadow: 0 0 0 3px rgba(5, 46, 31, 0.1);
        }

        .btn-refresh-stats {
            background: #052e1f;
            color: #ffffff;
            font-weight: 700;
            font-size: 13px;
            padding: 10px 18px;
            border-radius: 10px;
            border: none;
            cursor: pointer;
            transition: all 0.2s ease;
            margin-top: 16px;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .btn-refresh-stats:hover {
            background: #042418;
            transform: translateY(-1px);
        }

        /* Dashboard Stat Cards */
        .me-grid-4 {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 16px;
            margin-bottom: 24px;
        }

        .me-grid-2 {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
            margin-bottom: 24px;
        }

        @media (max-width: 1024px) {
            .me-grid-4 { grid-template-columns: repeat(2, 1fr); }
            .me-grid-2 { grid-template-columns: 1fr; }
        }

        @media (max-width: 640px) {
            .me-grid-4 { grid-template-columns: 1fr; }
        }

        .dash-stat-card {
            background: #ffffff;
            border-radius: 18px;
            padding: 20px;
            display: flex;
            align-items: center;
            gap: 16px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.03);
            border: 1px solid #f1f5f9;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

        .dash-stat-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.06);
        }

        .stat-icon-circle {
            width: 48px;
            height: 48px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .stat-icon-circle.green { background: #ecfdf5; color: #052e1f; }
        .stat-icon-circle.orange { background: #fffbeb; color: #d97706; }
        .stat-icon-circle.teal { background: #f0fdf4; color: #059669; }
        .stat-icon-circle.red { background: #fef2f2; color: #ef4444; }

        .stat-label {
            font-size: 11px;
            font-weight: 800;
            color: #9ca3af;
            letter-spacing: 0.6px;
            text-transform: uppercase;
            margin-bottom: 4px;
        }

        .stat-value {
            font-size: 22px;
            font-weight: 800;
            color: #111827;
            letter-spacing: -0.02em;
        }

        /* Hero Balance Card */
        .dash-hero-card {
            border-radius: 20px;
            padding: 24px;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05);
            position: relative;
            overflow: hidden;
        }

        .hero-balance-card {
            background: linear-gradient(135deg, #052e1f 0%, #0a4731 100%);
            color: #ffffff;
        }

        .hero-balance-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .balance-label {
            font-size: 12px;
            font-weight: 800;
            letter-spacing: 0.8px;
            color: #a7f3d0;
            text-transform: uppercase;
        }

        .wallet-icon-badge {
            width: 38px;
            height: 38px;
            border-radius: 10px;
            background: rgba(255, 255, 255, 0.15);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #ffffff;
        }

        .hero-balance-amount {
            font-size: 34px;
            font-weight: 800;
            color: #ffffff;
            margin: 8px 0 2px;
            letter-spacing: -1px;
        }

        /* Main Grid: Chart + Table */
        .me-main-grid {
            display: grid;
            grid-template-columns: 1.8fr 1.2fr;
            gap: 20px;
            margin-bottom: 24px;
        }

        @media (max-width: 1024px) {
            .me-main-grid {
                grid-template-columns: 1fr;
            }
        }

        .chart-card {
            background: #ffffff;
            border-radius: 20px;
            padding: 24px;
            border: 1px solid var(--border);
            box-shadow: 0 4px 16px rgba(0,0,0,0.02);
        }

        .chart-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 20px;
        }

        .chart-header h3 {
            margin: 0 0 4px;
            font-size: 18px;
            font-weight: 800;
            color: #052e1f;
        }

        .chart-header span {
            font-size: 13px;
            color: var(--muted);
        }

        .chart-canvas-wrap {
            position: relative;
            height: 320px;
            width: 100%;
        }

        /* Source Breakdown Table */
        .breakdown-table {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0;
            font-size: 13px;
        }

        .breakdown-table th {
            padding: 12px 14px;
            font-size: 11px;
            font-weight: 800;
            color: #ffffff;
            background: #052e1f;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        .breakdown-table th:first-child {
            border-top-left-radius: 10px;
            border-bottom-left-radius: 10px;
        }

        .breakdown-table th:last-child {
            border-top-right-radius: 10px;
            border-bottom-right-radius: 10px;
        }

        .breakdown-table td {
            padding: 14px;
            border-bottom: 1px solid #f1f5f9;
            color: #1e293b;
        }

        .source-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: rgba(5, 46, 31, 0.08);
            color: #052e1f;
            font-weight: 700;
            font-size: 12px;
            padding: 6px 12px;
            border-radius: 8px;
            transition: all 0.2s ease;
        }

        .source-badge:hover {
            background: #052e1f;
            color: #ffffff;
        }

        .earnings-val {
            font-weight: 800;
            color: #052e1f;
        }

        /* Modal Overlay Styling */
        .modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(15, 23, 42, 0.6);
            backdrop-filter: blur(8px);
            z-index: 1000;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .modal.open {
            display: flex;
        }

        .modal-content {
            background: #ffffff;
            border-radius: 24px;
            width: 100%;
            max-width: 800px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
            border: 1px solid var(--border);
            overflow: hidden;
            animation: modalFadeUp 0.25s cubic-bezier(0.16, 1, 0.3, 1);
        }

        @keyframes modalFadeUp {
            from { opacity: 0; transform: translateY(12px) scale(0.98); }
            to { opacity: 1; transform: translateY(0) scale(1); }
        }

        .modal-head {
            background: linear-gradient(135deg, #052e1f 0%, #0a4731 100%);
            color: #ffffff;
            padding: 20px 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .modal-head h3 {
            margin: 0;
            font-size: 18px;
            font-weight: 800;
            color: #ffffff;
        }

        .modal-close-btn {
            background: rgba(255, 255, 255, 0.15);
            border: none;
            color: #ffffff;
            width: 32px;
            height: 32px;
            border-radius: 50%;
            font-size: 18px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: background 0.2s ease;
        }

        .modal-close-btn:hover {
            background: rgba(255, 255, 255, 0.25);
        }

        .modal-body {
            padding: 24px;
            max-height: 65vh;
            overflow-y: auto;
        }
    </style>
</head>

<body class="dashboard-body">
    <div class="dashboard-shell">
        <%- include('partials/sidebar', { activePage: 'my-earning' }) %>

        <div class="dashboard-main">
            <header class="navbar dashboard-navbar">
                <div class="nav-left" style="display: flex; align-items: center; gap: 12px; white-space: nowrap;">
                    <button type="button" class="sidebar-toggle-btn" onclick="toggleSidebar()">☰</button>
                    <h2 style="margin: 0; font-size: 18px; font-weight: 800; white-space: nowrap;">My Earnings</h2>

                    <select id="appSelect" onchange="onAppChange()" style="margin-left: 8px; padding: 6px 12px; border-radius: 10px; border: 1px solid #cbd5e1; font-weight: 700; background: #f8fafc; font-size: 13px; cursor: pointer;">
                        <% (typeof firebaseServices !== 'undefined' && firebaseServices ? firebaseServices : []).forEach(service => { %>
                            <option value="<%= service.appName %>">
                                <%= service.displayName %>
                            </option>
                        <% }) %>
                    </select>
                </div>

                <div class="nav-right" onclick="toggleDropdown()">
                    <div class="avatar"><%- typeof photo !== 'undefined' && photo ? photo : 'A' %></div>
                    <div class="dropdown" id="dropdown">
                        <a href="/logout">Logout</a>
                    </div>
                </div>
            </header>

            <main class="container dashboard-home">
                <!-- FILTER & OVERVIEW SECTION -->
                <section class="glass-card">
                    <div class="overview-head">
                        <div>
                            <h1 style="font-size: 22px; font-weight: 800; color: #052e1f; margin: 0 0 4px;">My Earning Analytics</h1>
                            <p style="color: var(--muted); font-size: 13px; margin: 0;">Track platform profit margins, ad impressions, and conversion trends</p>
                        </div>

                        <div class="overview-filters">
                            <label>Mode
                                <select id="modeSelect" onchange="onModeChange()">
                                    <option value="ads" selected>Ads Mode (Check-in, Super Offer, Diamond Catch)</option>
                                    <option value="offerwall">Offerwalls Mode (CPA / Surveys)</option>
                                    <option value="read_earn">Read & Earn Mode</option>
                                </select>
                            </label>

                            <label>Range
                                <select id="rangeSelect" onchange="onRangeChange()">
                                    <option value="today">Today</option>
                                    <option value="yesterday">Yesterday</option>
                                    <option value="last7" selected>Last 7 Days</option>
                                    <option value="last30">Last 30 Days</option>
                                    <option value="this_month">This Month</option>
                                    <option value="last_month">Last Month</option>
                                    <option value="lifetime">Lifetime</option>
                                    <option value="custom">Custom Range</option>
                                </select>
                            </label>

                            <label>Start Date
                                <input id="startDate" type="date" onchange="loadStats()" disabled>
                            </label>

                            <label>End Date
                                <input id="endDate" type="date" onchange="loadStats()" disabled>
                            </label>

                            <button class="btn-refresh-stats" onclick="loadStats()">🔄 Refresh</button>
                        </div>
                    </div>
                </section>

                <!-- DASHBOARD-STYLED SUMMARY STAT CARDS (4 COLUMNS) -->
                <div class="me-grid-4">
                    <div class="dash-stat-card">
                        <div class="stat-icon-circle green">
                            <svg width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V6m0 12v-2m0 0c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                        </div>
                        <div>
                            <div class="stat-label">TODAY'S EARNINGS</div>
                            <div class="stat-value" id="sum-today">$0.00</div>
                            <div style="font-size: 11px; color: #64748b; font-weight: 600; margin-top: 2px;">Calendar day profit</div>
                        </div>
                    </div>

                    <div class="dash-stat-card">
                        <div class="stat-icon-circle orange">
                            <svg width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                            </svg>
                        </div>
                        <div>
                            <div class="stat-label">YESTERDAY'S EARNINGS</div>
                            <div class="stat-value" id="sum-yesterday">$0.00</div>
                            <div style="font-size: 11px; color: #64748b; font-weight: 600; margin-top: 2px;">Previous day profit</div>
                        </div>
                    </div>

                    <div class="dash-stat-card">
                        <div class="stat-icon-circle teal">
                            <svg width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
                            </svg>
                        </div>
                        <div>
                            <div class="stat-label">THIS MONTH</div>
                            <div class="stat-value" id="sum-this-month">$0.00</div>
                            <div style="font-size: 11px; color: #64748b; font-weight: 600; margin-top: 2px;">Current month earnings</div>
                        </div>
                    </div>

                    <div class="dash-stat-card">
                        <div class="stat-icon-circle red">
                            <svg width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                            </svg>
                        </div>
                        <div>
                            <div class="stat-label">LAST MONTH</div>
                            <div class="stat-value" id="sum-last-month">$0.00</div>
                            <div style="font-size: 11px; color: #64748b; font-weight: 600; margin-top: 2px;">Previous month earnings</div>
                        </div>
                    </div>
                </div>

                <!-- RANGE STATS HIGHLIGHT GRID -->
                <div class="me-grid-2">
                    <div class="dash-hero-card hero-balance-card" style="min-height: 140px;">
                        <div class="hero-balance-header">
                            <span class="balance-label" id="range-earning-label">Selected Range Earnings</span>
                            <div class="wallet-icon-badge">
                                <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V6m0 12v-2m0 0c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                                </svg>
                            </div>
                        </div>
                        <div class="hero-balance-amount" id="range-total-earnings" style="font-size: 32px; margin: 8px 0 2px;">$0.00</div>
                        <div style="font-size: 12px; color: rgba(255,255,255,0.75); font-weight: 600;">Total net profit in this interval</div>
                    </div>

                    <div class="dash-stat-card" style="padding: 24px;">
                        <div class="stat-icon-circle teal" style="width: 54px; height: 54px;">
                            <svg width="26" height="26" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                            </svg>
                        </div>
                        <div>
                            <div class="stat-label" id="range-imp-label">SELECTED RANGE IMPRESSIONS</div>
                            <div class="stat-value" id="range-total-impressions" style="font-size: 32px;">0</div>
                            <div style="font-size: 12px; color: #64748b; font-weight: 600; margin-top: 2px;" id="range-imp-sub">Ads displayed in this interval</div>
                        </div>
                    </div>
                </div>

                <!-- MAIN GRAPH & BREAKDOWN GRID -->
                <div class="me-main-grid">
                    <!-- Earnings Trend Graph -->
                    <div class="chart-card">
                        <div class="chart-header">
                            <div>
                                <h3 id="chart-title">Earnings Trend Graph</h3>
                                <span id="chart-sub">Timeline progression of earnings in USD</span>
                            </div>
                            <span id="chart-interval-label" style="font-weight: 700; color: #052e1f; background: rgba(5, 46, 31, 0.08); padding: 4px 10px; border-radius: 8px; font-size: 11px;">Dynamic Intervals</span>
                        </div>
                        <div class="chart-canvas-wrap">
                            <canvas id="earnings-trend-chart"></canvas>
                        </div>
                    </div>

                    <!-- Source Breakdown Table -->
                    <div class="chart-card" style="display: flex; flex-direction: column;">
                        <div class="chart-header">
                            <div>
                                <h3 id="breakdown-title">Source Breakdown</h3>
                                <span id="breakdown-sub">Earnings by provider / offerwall</span>
                            </div>
                        </div>
                        <div style="flex: 1; overflow-y: auto; max-height: 320px;">
                            <table class="breakdown-table">
                                <thead>
                                    <tr>
                                        <th>Source</th>
                                        <th id="breakdown-count-header" style="text-align: right;">Impressions</th>
                                        <th style="text-align: right;">Earnings ($)</th>
                                    </tr>
                                </thead>
                                <tbody id="breakdown-table-body">
                                    <!-- Dynamic rows from JavaScript -->
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- PROVIDER USERS MODAL -->
                <div id="provider-users-modal" class="modal">
                    <div class="modal-content">
                        <div class="modal-head">
                            <h3 id="provider-users-title">User Contribution List</h3>
                            <button type="button" class="modal-close-btn" onclick="closeProviderUsersModal()">&times;</button>
                        </div>
                        <div class="modal-body">
                            <table class="breakdown-table">
                                <thead>
                                    <tr>
                                        <th>User ID / Email</th>
                                        <th>Name</th>
                                        <th id="modal-count-header" style="text-align: right;">Completions</th>
                                        <th style="text-align: right;">Coins</th>
                                        <th style="text-align: right;">Earnings ($)</th>
                                    </tr>
                                </thead>
                                <tbody id="provider-users-table-body">
                                    <!-- Dynamic rows from JavaScript -->
                                </tbody>
                            </table>
                        </div>
                        <div style="padding: 16px 24px; border-top: 1px solid var(--border); display: flex; justify-content: flex-end; background: #f8fafc;">
                            <button type="button" class="btn-refresh-stats" style="margin: 0;" onclick="closeProviderUsersModal()">Close</button>
                        </div>
                    </div>
                </div>
            </main>
        </div>
    </div>

    <!-- UI Controllers and AJAX Handler -->
    <%- include('partials/user_lookup') %>
    <script src="/js/admin.js"></script>
    <script src="/js/user_lookup.js"></script>
    <script>
        let earningsChart = null;

        document.addEventListener('DOMContentLoaded', () => {
            loadStats();
        });

        function onAppChange() {
            loadStats();
        }

        function onModeChange() {
            const mode = document.getElementById('modeSelect').value;

            // Adjust metric labels depending on the mode
            const impLabel = document.getElementById('range-imp-label');
            const impSub = document.getElementById('range-imp-sub');
            const breakdownCountHeader = document.getElementById('breakdown-count-header');

            if (mode === 'offerwall') {
                impLabel.innerText = 'SELECTED RANGE CONVERSIONS';
                impSub.innerText = 'Successful offer completions';
                if (breakdownCountHeader) breakdownCountHeader.innerText = 'Completions';
            } else if (mode === 'read_earn') {
                impLabel.innerText = 'SELECTED RANGE IMPRESSIONS';
                impSub.innerText = 'Read plays (2 impressions each)';
                if (breakdownCountHeader) breakdownCountHeader.innerText = 'Impressions';
            } else {
                impLabel.innerText = 'SELECTED RANGE IMPRESSIONS';
                impSub.innerText = 'Ads displayed (1 impression each)';
                if (breakdownCountHeader) breakdownCountHeader.innerText = 'Impressions';
            }

            loadStats();
        }

        function onRangeChange() {
            const range = document.getElementById('rangeSelect').value;
            const startInput = document.getElementById('startDate');
            const endInput = document.getElementById('endDate');

            if (range === 'custom') {
                startInput.disabled = false;
                endInput.disabled = false;
            } else {
                startInput.disabled = true;
                endInput.disabled = true;
                startInput.value = '';
                endInput.value = '';
                loadStats();
            }
        }

        async function loadStats() {
            showLoading();
            try {
                const app = document.getElementById('appSelect').value;
                const mode = document.getElementById('modeSelect').value;
                const range = document.getElementById('rangeSelect').value;
                const startDate = document.getElementById('startDate').value;
                const endDate = document.getElementById('endDate').value;

                if (range === 'custom' && (!startDate || !endDate)) {
                    hideLoading();
                    return;
                }

                const response = await fetch(`/api/my-earning/stats?app=${app}&mode=${mode}&range=${range}&startDate=${startDate}&endDate=${endDate}`);
                const data = await response.json();

                hideLoading();

                if (!data.success) {
                    alert('Error loading stats: ' + (data.message || 'Unknown error'));
                    return;
                }

                // Format values helper
                const formatUSD = val => '$' + Number(val || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 4 });
                const formatCount = val => Number(val || 0).toLocaleString();

                // Update Summary Cards
                document.getElementById('sum-today').innerText = formatUSD(data.summary.today);
                document.getElementById('sum-yesterday').innerText = formatUSD(data.summary.yesterday);
                document.getElementById('sum-this-month').innerText = formatUSD(data.summary.thisMonth);
                document.getElementById('sum-last-month').innerText = formatUSD(data.summary.lastMonth);

                // Update Range Stats
                document.getElementById('range-total-earnings').innerText = formatUSD(data.selected.totalEarnings);
                document.getElementById('range-total-impressions').innerText = formatCount(data.selected.totalImpressions);

                // Update Source Breakdown Table
                const tbody = document.getElementById('breakdown-table-body');
                tbody.innerHTML = '';

                if (!data.breakdown || data.breakdown.length === 0) {
                    tbody.innerHTML = `
                        <tr>
                            <td colspan="3" style="text-align: center; color: #94a3b8; padding: 40px 0;">No earnings in this interval</td>
                        </tr>
                    `;
                } else {
                    data.breakdown.forEach(item => {
                        const tr = document.createElement('tr');

                        const tdSource = document.createElement('td');
                        const spanBadge = document.createElement('span');
                        spanBadge.className = 'source-badge';
                        spanBadge.style.cursor = 'pointer';
                        spanBadge.title = 'Click to view user list';
                        spanBadge.onclick = () => showProviderUsers(item.name);
                        spanBadge.innerText = item.name;
                        tdSource.appendChild(spanBadge);

                        const tdCount = document.createElement('td');
                        tdCount.style.textAlign = 'right';
                        tdCount.style.fontWeight = '700';
                        tdCount.innerText = formatCount(item.count);

                        const tdEarnings = document.createElement('td');
                        tdEarnings.className = 'earnings-val';
                        tdEarnings.style.textAlign = 'right';
                        tdEarnings.innerText = formatUSD(item.earnings);

                        tr.appendChild(tdSource);
                        tr.appendChild(tdCount);
                        tr.appendChild(tdEarnings);
                        tbody.appendChild(tr);
                    });
                }

                // Update Chart
                renderGraph(data.graphData);

            } catch (err) {
                hideLoading();
                console.error('AJAX Load error:', err);
                alert('Network error. Failed to load earnings data.');
            }
        }

        function renderGraph(graphData) {
            const ctx = document.getElementById('earnings-trend-chart').getContext('2d');

            if (earningsChart) {
                earningsChart.destroy();
            }

            const labels = graphData.map(d => d.label);
            const values = graphData.map(d => d.earnings);

            const primaryColor = '#052e1f';

            // Styling gradient accent
            const gradient = ctx.createLinearGradient(0, 0, 0, 300);
            gradient.addColorStop(0, 'rgba(5, 46, 31, 0.35)');
            gradient.addColorStop(1, 'rgba(5, 46, 31, 0.01)');

            earningsChart = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Earnings ($)',
                        data: values,
                        borderColor: primaryColor,
                        borderWidth: 3,
                        backgroundColor: gradient,
                        fill: true,
                        tension: 0.35,
                        pointBackgroundColor: primaryColor,
                        pointHoverRadius: 6,
                        pointHoverBackgroundColor: '#ffffff',
                        pointHoverBorderColor: primaryColor,
                        pointHoverBorderWidth: 3
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                label: function (context) {
                                    let label = context.dataset.label || '';
                                    if (label) {
                                        label += ': ';
                                    }
                                    if (context.parsed.y !== null) {
                                        label += '$' + context.parsed.y.toFixed(4);
                                    }
                                    return label;
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            grid: { color: '#f1f5f9' },
                            ticks: {
                                color: '#64748b',
                                font: { weight: '600' },
                                callback: function (value) {
                                    return '$' + value.toFixed(2);
                                }
                            }
                        },
                        x: {
                            grid: { display: false },
                            ticks: { color: '#64748b', font: { weight: '600' } }
                        }
                    }
                }
            });
        }

        function closeProviderUsersModal() {
            closeModal('provider-users-modal');
        }

        async function showProviderUsers(providerName) {
            showLoading();
            try {
                const app = document.getElementById('appSelect').value;
                const mode = document.getElementById('modeSelect').value;
                const range = document.getElementById('rangeSelect').value;
                const startDate = document.getElementById('startDate').value;
                const endDate = document.getElementById('endDate').value;

                const response = await fetch(`/api/my-earning/provider-users?app=${app}&mode=${mode}&range=${range}&startDate=${startDate}&endDate=${endDate}&provider=${encodeURIComponent(providerName)}`);
                const data = await response.json();

                hideLoading();

                if (!data.success) {
                    alert('Error loading provider users: ' + (data.message || 'Unknown error'));
                    return;
                }

                // Update Modal Headers
                document.getElementById('provider-users-title').innerText = `User Contributions - ${providerName}`;

                const countHeader = document.getElementById('modal-count-header');
                if (mode === 'offerwall') {
                    if (countHeader) countHeader.innerText = 'Completions';
                } else {
                    if (countHeader) countHeader.innerText = 'Impressions';
                }

                // Format values helpers
                const formatUSD = val => '$' + Number(val || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 4 });
                const formatCount = val => Number(val || 0).toLocaleString();

                const tbody = document.getElementById('provider-users-table-body');
                tbody.innerHTML = '';

                if (!data.users || data.users.length === 0) {
                    tbody.innerHTML = `
                        <tr>
                            <td colspan="5" style="text-align: center; color: #94a3b8; padding: 40px 0;">No contributors found in this interval</td>
                        </tr>
                    `;
                } else {
                    data.users.forEach(user => {
                        const tr = document.createElement('tr');

                        const tdUser = document.createElement('td');
                        tdUser.innerHTML = `
                            <div style="font-weight: 700; color: #0f172a; font-size: 13px;">${user.userId}</div>
                            <div style="font-size: 11px; color: #64748b; margin-top: 2px;">${user.email}</div>
                        `;

                        const tdName = document.createElement('td');
                        tdName.innerText = user.name;

                        const tdCount = document.createElement('td');
                        tdCount.style.textAlign = 'right';
                        tdCount.style.fontWeight = '700';
                        tdCount.innerText = formatCount(user.count);

                        const tdCoins = document.createElement('td');
                        tdCoins.style.textAlign = 'right';
                        tdCoins.style.fontWeight = '700';
                        tdCoins.style.color = '#64748b';
                        tdCoins.innerText = formatCount(user.coins);

                        const tdEarnings = document.createElement('td');
                        tdEarnings.className = 'earnings-val';
                        tdEarnings.style.textAlign = 'right';
                        tdEarnings.innerText = formatUSD(user.earnings);

                        tr.appendChild(tdUser);
                        tr.appendChild(tdName);
                        tr.appendChild(tdCount);
                        tr.appendChild(tdCoins);
                        tr.appendChild(tdEarnings);

                        tbody.appendChild(tr);
                    });
                }

                openModal('provider-users-modal');

            } catch (err) {
                hideLoading();
                console.error('Fetch provider users error:', err);
                alert('Network error. Failed to load user list.');
            }
        }
    </script>
</body>

</html>