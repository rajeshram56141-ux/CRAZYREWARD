<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>Admin Dashboard</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300..800;1,300..800&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="/css/admin.css">
    <link rel="icon" href="/images/favicon.png">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        * {
            font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif !important;
        }

        body.dashboard-body {
            background-color: #f3f4f6 !important;
            font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif !important;
        }

        .dashboard-home {
            max-width: 1440px;
            margin: 0 auto;
            padding: 24px;
        }

        /* 1. Hero Grid (3 Cards) */
        .dash-hero-grid {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            gap: 20px;
            margin-bottom: 24px;
        }

        @media (max-width: 1024px) {
            .dash-hero-grid {
                grid-template-columns: 1fr;
            }
        }

        .dash-hero-card {
            border-radius: 20px;
            padding: 24px;
            min-height: 190px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05);
            position: relative;
            overflow: hidden;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

        .dash-hero-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 14px 30px -5px rgba(0, 0, 0, 0.08);
        }

        /* Hero Card 1: Welcome */
        .hero-welcome-card {
            background-size: cover;
            background-position: center;
            color: #ffffff;
        }

        .hero-top-badge {
            align-self: flex-start;
            background: rgba(255, 255, 255, 0.22);
            backdrop-filter: blur(8px);
            border: 1px solid rgba(255, 255, 255, 0.3);
            padding: 6px 14px;
            border-radius: 30px;
            font-size: 13px;
            font-weight: 600;
            color: #ffffff;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .hero-welcome-content {
            margin-top: auto;
        }

        .hero-greeting {
            font-size: 14px;
            font-weight: 500;
            color: rgba(255, 255, 255, 0.85);
        }

        .hero-username {
            font-size: 26px;
            font-weight: 800;
            margin-top: 4px;
            letter-spacing: -0.5px;
        }

        /* Hero Card 2: Main Balance */
        .hero-balance-card {
            background: #052e1f;
            color: #ffffff;
        }

        .hero-balance-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .balance-label {
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 0.8px;
            color: #a7f3d0;
            text-transform: uppercase;
        }

        .wallet-icon-badge {
            width: 38px;
            height: 38px;
            border-radius: 10px;
            background: rgba(255, 255, 255, 0.12);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #ffffff;
        }

        .hero-balance-amount {
            font-size: 36px;
            font-weight: 800;
            color: #ffffff;
            margin: 10px 0;
            letter-spacing: -1px;
        }

        .hero-action-btn {
            background: #d97706;
            color: #ffffff;
            border: none;
            padding: 12px;
            border-radius: 12px;
            font-weight: 700;
            font-size: 14px;
            cursor: pointer;
            width: 100%;
            transition: background 0.2s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        .hero-action-btn:hover {
            background: #b45309;
        }

        /* Hero Card 3: Promo */
        .hero-promo-card {
            background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
            color: #ffffff;
        }

        .hero-promo-badge {
            align-self: flex-start;
            background: #d97706;
            color: #ffffff;
            padding: 4px 10px;
            border-radius: 6px;
            font-size: 11px;
            font-weight: 800;
            letter-spacing: 0.5px;
        }

        .hero-promo-content {
            margin-top: auto;
        }

        .hero-promo-logo {
            font-size: 14px;
            font-weight: 700;
            color: #38bdf8;
            margin-bottom: 4px;
        }

        .hero-promo-title {
            font-size: 20px;
            font-weight: 700;
            line-height: 1.3;
        }

        /* 2. Stat Cards (4 Columns) */
        .dash-stats-row {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 16px;
            margin-bottom: 24px;
        }

        @media (max-width: 900px) {
            .dash-stats-row {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        .dash-stat-card {
            background: #ffffff;
            border-radius: 18px;
            padding: 20px;
            display: flex;
            align-items: center;
            gap: 16px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.03);
            border: 1px solid #f1f5f9;
        }

        .stat-icon-circle {
            width: 48px;
            height: 48px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .stat-icon-circle.green {
            background: #ecfdf5;
            color: #10b981;
        }

        .stat-icon-circle.red {
            background: #fef2f2;
            color: #ef4444;
        }

        .stat-icon-circle.teal {
            background: #f0fdf4;
            color: #059669;
        }

        .stat-icon-circle.orange {
            background: #fffbeb;
            color: #f59e0b;
        }

        .stat-label {
            font-size: 11px;
            font-weight: 700;
            color: #9ca3af;
            letter-spacing: 0.6px;
            margin-bottom: 4px;
        }

        .stat-value {
            font-size: 22px;
            font-weight: 800;
            color: #111827;
        }

        /* 3. Section Title */
        .dash-section-header {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 16px;
        }

        .dash-section-header h3 {
            font-size: 13px;
            font-weight: 800;
            color: #4b5563;
            letter-spacing: 0.6px;
            text-transform: uppercase;
        }

        /* 4. Pastel Cards Grid */
        .dash-pastel-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 16px;
            margin-bottom: 28px;
        }

        @media (max-width: 768px) {
            .dash-pastel-grid {
                grid-template-columns: 1fr;
            }
        }

        .dash-pastel-card {
            border-radius: 18px;
            padding: 22px;
            position: relative;
            overflow: hidden;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.02);
        }

        .dash-pastel-card.green {
            background: #f0fdf4;
            border: 1px solid #dcfce7;
        }

        .dash-pastel-card.yellow {
            background: #fffbeb;
            border: 1px solid #fef3c7;
        }

        .dash-pastel-card.red {
            background: #fef2f2;
            border: 1px solid #fee2e2;
        }

        .pastel-title {
            font-size: 12px;
            font-weight: 800;
            letter-spacing: 0.6px;
        }

        .text-green {
            color: #166534;
        }

        .text-yellow {
            color: #92400e;
        }

        .text-red {
            color: #991b1b;
        }

        .pastel-number {
            font-size: 32px;
            font-weight: 900;
            color: #111827;
            margin: 8px 0 4px;
        }

        .pastel-subtext {
            font-size: 12px;
            font-weight: 600;
        }

        .text-green-sub {
            color: #15803d;
        }

        .text-yellow-sub {
            color: #b45309;
        }

        .text-red-sub {
            color: #b91c1c;
        }

        .pastel-corner-circle {
            position: absolute;
            right: -20px;
            bottom: -20px;
            width: 80px;
            height: 80px;
            border-radius: 50%;
            opacity: 0.4;
        }

        .pastel-corner-circle.green {
            background: #86efac;
        }

        .pastel-corner-circle.yellow {
            background: #fde68a;
        }

        .pastel-corner-circle.red {
            background: #fca5a5;
        }

        /* Table Card Customization */
        .table-dark-header {
            background: #052e1f;
            color: #ffffff;
            padding: 16px 20px;
            border-top-left-radius: 18px;
            border-top-right-radius: 18px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .table-header-title {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .table-header-title h3 {
            font-size: 14px;
            font-weight: 700;
            letter-spacing: 0.6px;
            margin: 0;
            color: #ffffff;
        }

        .accent-bar {
            width: 4px;
            height: 16px;
            background: #d97706;
            border-radius: 2px;
        }

        .view-all-outline-btn {
            border: 1px solid rgba(255, 255, 255, 0.3);
            background: transparent;
            color: #ffffff;
            padding: 6px 14px;
            border-radius: 8px;
            font-size: 12px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .view-all-outline-btn:hover {
            background: rgba(255, 255, 255, 0.1);
            border-color: #ffffff;
        }

        .directory-card {
            border-radius: 18px !important;
            overflow: hidden;
            border: 1px solid #e5e7eb;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
            background: #ffffff;
        }
    </style>
</head>

<body class="dashboard-body">

    <%- include('partials/user_lookup') %>

        <div class="dashboard-shell">
            <%- include('partials/sidebar', { activePage: 'dashboard' }) %>

                <div class="dashboard-main">
                    <header class="navbar dashboard-navbar">
                        <div class="nav-left">
                            <button type="button" class="sidebar-toggle-btn" onclick="toggleSidebar()">
                                ☰
                            </button>
                            <h2>Analytics Overview</h2>

                            <select id="appSelect">
                                <% firebaseServices.forEach(service=> { %>
                                    <option value="<%= service.appName %>">
                                        <%= service.displayName %>
                                    </option>
                                    <% }) %>
                            </select>
                        </div>

                        <div class="nav-right" onclick="toggleDropdown()">
                            <div class="avatar">
                                <%= photo %>
                            </div>

                            <div class="dropdown" id="dropdown">
                                <a href="/logout">Logout</a>
                            </div>
                        </div>
                    </header>

                    <main class="container dashboard-home">
                        <% if (admin.role==='superadmin' || admin.permissions.dashboard) { %>

                            <!-- 1. Hero Grid Banners -->
                            <div class="dash-hero-grid">
                                <!-- Welcome Card -->
                                <div class="dash-hero-card hero-welcome-card"
                                    style="background-image: linear-gradient(180deg, rgba(0,0,0,0.3) 0%, rgba(5,46,31,0.85) 100%), url('https://images.unsplash.com/photo-1506744038136-46273834b3fb?q=80&w=1000');">
                                    <div class="hero-top-badge">
                                        <svg width="14" height="14" fill="none" viewBox="0 0 24 24"
                                            stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                        </svg>
                                        <span id="hero-current-date"></span>
                                    </div>
                                    <div class="hero-welcome-content">
                                        <div class="hero-greeting">Good Morning</div>
                                        <div class="hero-username">
                                            <%= name %>
                                        </div>
                                    </div>
                                </div>

                                <!-- Main Balance / Payout Card -->
                                <div class="dash-hero-card hero-balance-card">
                                    <div class="hero-balance-header">
                                        <span class="balance-label" id="stat-payout-label">TOTAL PAYOUT (INR)</span>
                                        <div class="wallet-icon-badge">
                                            <svg width="20" height="20" fill="none" viewBox="0 0 24 24"
                                                stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                    d="M3 10h18M7 15h1m4 0h1m-7 4h12a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                                            </svg>
                                        </div>
                                    </div>
                                    <div class="hero-balance-amount" id="hero-main-balance">₹0.00</div>
                                    <button type="button" class="hero-action-btn" onclick="loadHomeStats()">
                                        <svg width="16" height="16" fill="none" viewBox="0 0 24 24"
                                            stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                                        </svg>
                                        <span>Refresh Stats</span>
                                    </button>
                                </div>

                                <!-- Featured Banner Card -->
                                <div class="dash-hero-card hero-promo-card">
                                    <div class="hero-promo-badge">100% SECURE</div>
                                    <div class="hero-promo-content">
                                        <div class="hero-promo-logo">CRAZYREWARD ADMIN</div>
                                        <div class="hero-promo-title">Live App Performance & User Growth</div>
                                    </div>
                                </div>
                            </div>

                            <!-- 2. Stat Cards (4 Columns) -->
                            <div class="dash-stats-row">
                                <div class="dash-stat-card">
                                    <div class="stat-icon-circle green">
                                        <svg width="20" height="20" fill="none" viewBox="0 0 24 24"
                                            stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                d="M19 14l-7 7m0 0l-7-7m7 7V3" />
                                        </svg>
                                    </div>
                                    <div class="stat-info">
                                        <div class="stat-label">TOTAL USERS</div>
                                        <div class="stat-value" id="stat-total-users">0</div>
                                    </div>
                                </div>

                                <div class="dash-stat-card">
                                    <div class="stat-icon-circle red">
                                        <svg width="20" height="20" fill="none" viewBox="0 0 24 24"
                                            stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                d="M5 10l7-7m0 0l7 7m-7-7v18" />
                                        </svg>
                                    </div>
                                    <div class="stat-info">
                                        <div class="stat-label">BLOCKED USERS</div>
                                        <div class="stat-value" id="stat-blocked-users">0</div>
                                    </div>
                                </div>

                                <div class="dash-stat-card">
                                    <div class="stat-icon-circle teal">
                                        <svg width="20" height="20" fill="none" viewBox="0 0 24 24"
                                            stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                d="M5 13l4 4L19 7" />
                                        </svg>
                                    </div>
                                    <div class="stat-info">
                                        <div class="stat-label">ACTIVE USERS</div>
                                        <div class="stat-value" id="stat-active-users">0</div>
                                    </div>
                                </div>

                                <div class="dash-stat-card">
                                    <div class="stat-icon-circle orange">
                                        <svg width="20" height="20" fill="none" viewBox="0 0 24 24"
                                            stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                                        </svg>
                                    </div>
                                    <div class="stat-info">
                                        <div class="stat-label">PAYOUT (SELECTED)</div>
                                        <div class="stat-value" id="stat-payout-val">₹0.00</div>
                                    </div>
                                </div>
                            </div>

                            <!-- 3. Section Title & 3 Pastel Summary Cards -->
                            <div class="dash-section-header">
                                <span class="accent-bar"></span>
                                <h3>SYSTEM SUMMARY & AUDIENCE</h3>
                            </div>

                            <div class="dash-pastel-grid">
                                <div class="dash-pastel-card green">
                                    <div class="pastel-header">
                                        <span class="pastel-title text-green" id="pastel-reg-title">SUCCESS &
                                            REGISTERED</span>
                                    </div>
                                    <div class="pastel-number" id="pastel-reg-val">0</div>
                                    <div class="pastel-subtext text-green-sub">New Users in Range</div>
                                    <div class="pastel-corner-circle green"></div>
                                </div>

                                <div class="dash-pastel-card yellow">
                                    <div class="pastel-header">
                                        <span class="pastel-title text-yellow">TOTAL COINS AGGREGATE</span>
                                    </div>
                                    <div class="pastel-number" id="pastel-coins-val">0</div>
                                    <div class="pastel-subtext text-yellow-sub" id="pastel-coins-sub">Live Aggregate
                                        Balance</div>
                                    <div class="pastel-corner-circle yellow"></div>
                                </div>

                                <div class="dash-pastel-card red">
                                    <div class="pastel-header">
                                        <span class="pastel-title text-red">BLOCKED ACCOUNTS</span>
                                    </div>
                                    <div class="pastel-number" id="pastel-blocked-val">0</div>
                                    <div class="pastel-subtext text-red-sub">Accounts Restricted</div>
                                    <div class="pastel-corner-circle red"></div>
                                </div>
                            </div>

                            <!-- Standard Filter Header (Clean Container) -->
                            <section class="overview-card"
                                style="border-radius: 18px; padding: 20px; margin-bottom: 24px;">
                                <div class="overview-head">
                                    <div>
                                        <h2 style="font-size: 18px; font-weight: 700;">Analytics Range & Filters</h2>
                                        <p id="home-stats-meta" style="font-size: 13px; color: #64748b;">Fetching latest
                                            app stats...</p>
                                    </div>

                                    <div class="overview-filters">
                                        <label>Range
                                            <select id="home-range" onchange="onHomeRangeChange()">
                                                <option value="today">Today</option>
                                                <option value="yesterday">Yesterday</option>
                                                <option value="last7">Last 7 Days</option>
                                                <option value="custom">Custom</option>
                                            </select>
                                        </label>

                                        <label>Start
                                            <input id="home-start-date" type="date" disabled>
                                        </label>

                                        <label>End
                                            <input id="home-end-date" type="date" disabled>
                                        </label>

                                        <button class="btn-primary" onclick="loadHomeStats()">Refresh</button>
                                    </div>
                                </div>

                                <div id="home-kpi-grid" class="home-kpi-grid" style="display: none;"></div>

                                <div class="home-chart-wrap" style="margin-top: 16px;">
                                    <div class="home-chart-head">
                                        <h3>Growth & Retention</h3>
                                        <span>New Registrations vs Active Users</span>
                                    </div>
                                    <div class="home-chart-canvas-wrap">
                                        <canvas id="home-growth-chart"></canvas>
                                    </div>
                                </div>
                            </section>
                            <% } %>

                                <% if (admin.role==='superadmin' || admin.permissions.users) { %>
                                    <section id="user-directory" class="directory-card">
                                        <div class="table-dark-header">
                                            <div class="table-header-title">
                                                <span class="accent-bar"></span>
                                                <h3>RECENT USER DIRECTORY</h3>
                                            </div>
                                            <button type="button" class="view-all-outline-btn"
                                                onclick="refreshUserDirectory()">Refresh List</button>
                                        </div>

                                        <div style="padding: 20px;">
                                            <div class="directory-toolbar" style="display: flex; gap: 8px; align-items: center;">
                                                <input id="directory-search" type="text"
                                                    placeholder="Search by Email / User ID / Refer Code"
                                                    onkeyup="if(event.key==='Enter') searchUserDirectory()">
                                                <button class="btn-primary"
                                                    onclick="searchUserDirectory()">Search</button>
                                                <button class="btn-ghost"
                                                    onclick="clearUserDirectorySearch()">Clear</button>
                                                <button class="btn-danger-lg" style="background: #ef4444; color: white; border: none; padding: 8px 16px; border-radius: 8px; font-weight: 700; cursor: pointer; display: none; margin-left: auto;" id="bulkDeleteBtn" onclick="performBulkDeleteUsers()">Delete Selected (<span id="selectedCount">0</span>)</button>
                                            </div>

                                            <div class="directory-table-wrap">
                                                <table class="directory-table">
                                                    <thead>
                                                        <tr>
                                                            <th style="width: 40px; text-align: center; vertical-align: middle;">
                                                                <input type="checkbox" id="selectAllUsers" onchange="toggleSelectAllUsers(this)" style="cursor: pointer; transform: scale(1.2);">
                                                            </th>
                                                            <th>#</th>
                                                            <th class="sortable" onclick="sortUserDirectory('name')">
                                                                User Info <span class="sort-icon">↕</span></th>
                                                            <th class="sortable" onclick="sortUserDirectory('email')">
                                                                Handle <span class="sort-icon">↕</span></th>
                                                            <th class="sortable" onclick="sortUserDirectory('coins')">
                                                                Coins <span class="sort-icon">↕</span></th>
                                                            <th class="sortable"
                                                                onclick="sortUserDirectory('firstLogin')">Joined Date
                                                                <span class="sort-icon">↕</span>
                                                            </th>
                                                            <th class="sortable" onclick="sortUserDirectory('blocked')">
                                                                Status <span class="sort-icon">↕</span></th>
                                                            <th style="text-align: right;">Actions</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody id="directory-body">
                                                        <tr>
                                                            <td colspan="8" class="directory-empty">Loading users...
                                                            </td>
                                                        </tr>
                                                    </tbody>
                                                </table>
                                            </div>

                                            <div class="directory-pagination">
                                                <button id="directory-prev" class="btn-ghost"
                                                    onclick="loadPrevUserPage()" disabled>Previous</button>
                                                <span id="directory-page-info">Page 1</span>
                                                <button id="directory-next" class="btn-ghost"
                                                    onclick="loadNextUserPage()" disabled>Next</button>
                                            </div>
                                        </div>
                                    </section>
                                    <% } %>

                                        <% if (admin.role !=='superadmin' && !admin.permissions.dashboard &&
                                            !admin.permissions.users) { %>
                                            <section class="overview-card"
                                                style="padding: 40px; text-align: center; border-radius: 16px; background: #fff; box-shadow: 0 10px 30px rgba(0,0,0,0.05); margin-bottom: 24px;">
                                                <div style="font-size: 48px; margin-bottom: 20px;">👋</div>
                                                <h2
                                                    style="margin: 0 0 10px; color: #0f172a; font-size: 24px; font-weight: 700;">
                                                    Welcome, <%= name %>!</h2>
                                                <p
                                                    style="margin: 0; color: #64748b; font-size: 14px; line-height: 1.6;">
                                                    You have successfully logged into the Crazyreward Admin
                                                    Panel.<br>Please select an option from the sidebar to manage your
                                                    assigned tasks.</p>
                                            </section>
                                            <% } %>
                    </main>
                </div>
        </div>

        <script>
            // Set current date in top badge
            document.addEventListener('DOMContentLoaded', () => {
                const dateEl = document.getElementById('hero-current-date');
                if (dateEl) {
                    dateEl.textContent = new Date().toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
                }
            });
        </script>
        <script src="/js/admin.js?v=<%= Date.now() %>"></script>
        <script src="/js/user_lookup.js?v=<%= Date.now() %>"></script>
</body>

</html>