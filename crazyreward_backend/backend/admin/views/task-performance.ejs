<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Task Performance - Crazyreward Admin</title>
    <link rel="stylesheet" href="/css/admin.css">
    <link rel="icon" href="/images/favicon.png">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        :root {
            --bg: #f8fafc;
            --surface: #ffffff;
            --border: #e2e8f0;
            --primary: #052e1f;
            --primary-hover: #042418;
            --text: #0f172a;
            --muted: #64748b;
        }

        * {
            box-sizing: border-box;
            font-family: 'Plus Jakarta Sans', sans-serif !important;
        }

        body {
            margin: 0;
            background: var(--bg);
            color: var(--text);
        }

        /* Glassmorphism Cards */
        .glass-card {
            background: #ffffff;
            border-radius: 20px;
            padding: 24px;
            margin-bottom: 24px;
            box-shadow: 0 4px 16px rgba(0, 0, 0, 0.03);
            border: 1px solid var(--border);
        }

        /* Overview Filter Bar */
        .overview-head {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 16px;
        }

        .overview-filters {
            display: flex;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
        }

        .overview-filters label {
            display: flex;
            flex-direction: column;
            gap: 4px;
            font-size: 11px;
            font-weight: 800;
            color: var(--muted);
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        .overview-filters select,
        .overview-filters input[type="date"] {
            padding: 8px 14px;
            border: 1px solid var(--border);
            border-radius: 10px;
            background: #ffffff;
            font-size: 13px;
            font-weight: 700;
            color: var(--text);
            outline: none;
            transition: all 0.2s ease;
        }

        .overview-filters select:focus,
        .overview-filters input[type="date"]:focus {
            border-color: #052e1f;
            box-shadow: 0 0 0 3px rgba(5, 46, 31, 0.1);
        }

        .btn-refresh-stats {
            background: #052e1f;
            color: #ffffff;
            font-weight: 700;
            font-size: 13px;
            padding: 10px 18px;
            border-radius: 10px;
            border: none;
            cursor: pointer;
            transition: all 0.2s ease;
            margin-top: 16px;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .btn-refresh-stats:hover {
            background: #042418;
            transform: translateY(-1px);
        }

        /* Dashboard Stat Cards */
        .me-grid-4 {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 16px;
            margin-bottom: 24px;
        }

        .tp-grid-2 {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-bottom: 24px;
        }

        @media (max-width: 1024px) {
            .me-grid-4 { grid-template-columns: repeat(2, 1fr); }
            .tp-grid-2 { grid-template-columns: 1fr; }
        }

        @media (max-width: 640px) {
            .me-grid-4 { grid-template-columns: 1fr; }
        }

        .dash-stat-card {
            background: #ffffff;
            border-radius: 18px;
            padding: 20px;
            display: flex;
            align-items: center;
            gap: 16px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.03);
            border: 1px solid #f1f5f9;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

        .dash-stat-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.06);
        }

        .stat-icon-circle {
            width: 48px;
            height: 48px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .stat-icon-circle.green { background: #ecfdf5; color: #052e1f; }
        .stat-icon-circle.orange { background: #fffbeb; color: #d97706; }
        .stat-icon-circle.teal { background: #f0fdf4; color: #059669; }
        .stat-icon-circle.red { background: #fef2f2; color: #ef4444; }

        .stat-label {
            font-size: 11px;
            font-weight: 800;
            color: #9ca3af;
            letter-spacing: 0.6px;
            text-transform: uppercase;
            margin-bottom: 4px;
        }

        .stat-value {
            font-size: 22px;
            font-weight: 800;
            color: #111827;
            letter-spacing: -0.02em;
        }

        /* Chart & Card Wrap */
        .chart-card {
            background: #ffffff;
            border-radius: 20px;
            padding: 24px;
            border: 1px solid var(--border);
            box-shadow: 0 4px 16px rgba(0,0,0,0.02);
            margin-bottom: 24px;
        }

        .chart-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 20px;
        }

        .chart-header h3 {
            margin: 0 0 4px;
            font-size: 18px;
            font-weight: 800;
            color: #052e1f;
        }

        .chart-header span {
            font-size: 13px;
            color: var(--muted);
        }

        .chart-canvas-wrap {
            position: relative;
            height: 320px;
            width: 100%;
        }

        /* Leaderboard & Task Tables */
        .tp-table {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0;
            font-size: 13px;
        }

        .tp-table th {
            padding: 12px 14px;
            font-size: 11px;
            font-weight: 800;
            color: #ffffff;
            background: #052e1f;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        .tp-table th:first-child {
            border-top-left-radius: 10px;
            border-bottom-left-radius: 10px;
        }

        .tp-table th:last-child {
            border-top-right-radius: 10px;
            border-bottom-right-radius: 10px;
        }

        .tp-table td {
            padding: 14px;
            border-bottom: 1px solid #f1f5f9;
            color: #1e293b;
        }

        .tp-table-hover tbody tr {
            cursor: pointer;
            transition: background 0.15s ease;
        }

        .tp-table-hover tbody tr:hover {
            background: rgba(5, 46, 31, 0.04);
        }

        .tp-tabs {
            display: flex;
            background: #f1f5f9;
            padding: 4px;
            border-radius: 12px;
            margin-bottom: 16px;
            gap: 4px;
        }

        .tp-tab {
            flex: 1;
            padding: 10px 16px;
            border: none;
            background: transparent;
            font-size: 13px;
            font-weight: 700;
            color: var(--muted);
            cursor: pointer;
            border-radius: 10px;
            transition: all 0.2s ease;
            text-align: center;
        }

        .tp-tab.active {
            background: #052e1f;
            color: #ffffff;
            box-shadow: 0 4px 12px rgba(5, 46, 31, 0.15);
        }

        .tp-avatar {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: rgba(5, 46, 31, 0.1);
            color: #052e1f;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 14px;
            font-weight: 800;
            flex-shrink: 0;
        }

        .tp-user-cell {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .tp-user-name {
            font-weight: 700;
            color: #0f172a;
        }

        .tp-user-id-sub {
            font-size: 11px;
            color: var(--muted);
        }

        .tp-badge {
            display: inline-flex;
            align-items: center;
            padding: 4px 10px;
            border-radius: 8px;
            font-size: 11px;
            font-weight: 800;
        }

        .tp-badge-primary { background: rgba(5, 46, 31, 0.1); color: #052e1f; }
        .tp-badge-success { background: #dcfce7; color: #15803d; }

        /* Modal Overlay */
        .modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(15, 23, 42, 0.6);
            backdrop-filter: blur(8px);
            z-index: 1000;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .modal.open {
            display: flex;
        }

        .modal-content {
            background: #ffffff;
            border-radius: 24px;
            width: 100%;
            max-width: 600px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
            border: 1px solid var(--border);
            overflow: hidden;
            animation: modalFadeUp 0.25s cubic-bezier(0.16, 1, 0.3, 1);
        }

        @keyframes modalFadeUp {
            from { opacity: 0; transform: translateY(12px) scale(0.98); }
            to { opacity: 1; transform: translateY(0) scale(1); }
        }

        .modal-head {
            background: linear-gradient(135deg, #052e1f 0%, #0a4731 100%);
            color: #ffffff;
            padding: 20px 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .modal-head h3 {
            margin: 0;
            font-size: 18px;
            font-weight: 800;
            color: #ffffff;
        }

        .modal-close-btn {
            background: rgba(255, 255, 255, 0.15);
            border: none;
            color: #ffffff;
            width: 32px;
            height: 32px;
            border-radius: 50%;
            font-size: 18px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: background 0.2s ease;
        }

        .modal-close-btn:hover {
            background: rgba(255, 255, 255, 0.25);
        }

        .modal-body {
            padding: 24px;
            max-height: 65vh;
            overflow-y: auto;
        }
    </style>
</head>

<body class="dashboard-body">
    <!-- BREAKDOWN USER MODAL -->
    <div id="breakdown-modal" class="modal">
        <div class="modal-content">
            <div class="modal-head">
                <h3>User Task Contribution</h3>
                <button type="button" class="modal-close-btn" onclick="closeBreakdownModal()">&times;</button>
            </div>
            <div class="modal-body">
                <div style="display: flex; align-items: center; gap: 16px; margin-bottom: 20px; padding: 16px; background: #f8fafc; border-radius: 16px; border: 1px solid var(--border);">
                    <div id="modal-user-avatar" class="tp-avatar" style="width: 48px; height: 48px; font-size: 18px;">U</div>
                    <div>
                        <div id="modal-user-name" style="font-size: 16px; font-weight: 800; color: #052e1f;">Loading User...</div>
                        <div id="modal-user-email" style="font-size: 12px; color: var(--muted); margin-top: 2px;">user@example.com</div>
                        <div style="font-size: 11px; color: var(--muted); margin-top: 2px;">User ID: <strong id="modal-user-id" style="color: #0f172a;">-</strong></div>
                    </div>
                </div>

                <h4 style="margin: 0 0 12px; font-size: 14px; font-weight: 800; color: #052e1f;">Earned Coins Breakdown</h4>
                <table class="tp-table">
                    <thead>
                        <tr>
                            <th>Task Provider / Activity</th>
                            <th style="text-align: right;">Total Coins Earned</th>
                        </tr>
                    </thead>
                    <tbody id="modal-breakdown-body">
                        <tr>
                            <td colspan="2" style="text-align: center; color: #94a3b8; padding: 20px;">Loading details...</td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <div style="padding: 16px 24px; border-top: 1px solid var(--border); display: flex; justify-content: flex-end; background: #f8fafc;">
                <button type="button" class="btn-refresh-stats" style="margin: 0;" onclick="closeBreakdownModal()">Close</button>
            </div>
        </div>
    </div>

    <div class="dashboard-shell">
        <%- include('partials/sidebar', { activePage: 'task-performance' }) %>

        <div class="dashboard-main">
            <header class="navbar dashboard-navbar">
                <div class="nav-left" style="display: flex; align-items: center; gap: 12px; white-space: nowrap;">
                    <button type="button" class="sidebar-toggle-btn" onclick="toggleSidebar()">☰</button>
                    <h2 style="margin: 0; font-size: 18px; font-weight: 800; white-space: nowrap;">Task Performance</h2>

                    <select id="appSelect" onchange="onAppChange()" style="margin-left: 8px; padding: 6px 12px; border-radius: 10px; border: 1px solid #cbd5e1; font-weight: 700; background: #f8fafc; font-size: 13px; cursor: pointer;">
                        <% (typeof firebaseServices !== 'undefined' && firebaseServices ? firebaseServices : []).forEach(service => { %>
                            <option value="<%= service.appName %>">
                                <%= service.displayName %>
                            </option>
                        <% }) %>
                    </select>
                </div>

                <div class="nav-right" onclick="toggleDropdown()">
                    <div class="avatar"><%- typeof photo !== 'undefined' && photo ? photo : 'A' %></div>
                    <div class="dropdown" id="dropdown">
                        <a href="/logout">Logout</a>
                    </div>
                </div>
            </header>

            <main class="container dashboard-home">
                <!-- FILTER & OVERVIEW SECTION -->
                <section class="glass-card">
                    <div class="overview-head">
                        <div>
                            <h1 style="font-size: 22px; font-weight: 800; color: #052e1f; margin: 0 0 4px;">Task Performance Analytics</h1>
                            <p style="color: var(--muted); font-size: 13px; margin: 0;" id="stats-meta-info">Track task coins, volume and live leaderboard sync</p>
                        </div>

                        <div class="overview-filters">
                            <label>Range
                                <select id="rangeSelect" onchange="onRangeChange()">
                                    <option value="today" selected>Today</option>
                                    <option value="yesterday">Yesterday</option>
                                    <option value="last7">Last 7 Days</option>
                                    <option value="lifetime">Lifetime</option>
                                    <option value="custom">Custom Range</option>
                                </select>
                            </label>

                            <label>Start Date
                                <input id="startDate" type="date" onchange="loadDashboardData()" disabled>
                            </label>

                            <label>End Date
                                <input id="endDate" type="date" onchange="loadDashboardData()" disabled>
                            </label>

                            <button class="btn-refresh-stats" onclick="loadDashboardData()">🔄 Refresh</button>
                        </div>
                    </div>
                </section>

                <!-- DASHBOARD-STYLED SUMMARY STAT CARDS (4 COLUMNS) -->
                <div class="me-grid-4">
                    <div class="dash-stat-card">
                        <div class="stat-icon-circle green">
                            <svg width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V6m0 12v-2m0 0c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                        </div>
                        <div>
                            <div class="stat-label">COINS DISTRIBUTED</div>
                            <div class="stat-value" id="kpi-total-coins">0</div>
                            <div style="font-size: 11px; color: #64748b; font-weight: 600; margin-top: 2px;">Total user task earnings</div>
                        </div>
                    </div>

                    <div class="dash-stat-card">
                        <div class="stat-icon-circle orange">
                            <svg width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2V7a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z" />
                            </svg>
                        </div>
                        <div>
                            <div class="stat-label">DISTRIBUTED CASH VALUE</div>
                            <div class="stat-value" id="kpi-total-inr">₹0.00</div>
                            <div style="font-size: 11px; color: #64748b; font-weight: 600; margin-top: 2px;">Converted value (150 coins = ₹1)</div>
                        </div>
                    </div>

                    <div class="dash-stat-card">
                        <div class="stat-icon-circle teal">
                            <svg width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                        </div>
                        <div>
                            <div class="stat-label">TASK COMPLETIONS</div>
                            <div class="stat-value" id="kpi-total-completions">0</div>
                            <div style="font-size: 11px; color: #64748b; font-weight: 600; margin-top: 2px;">Successful postbacks/rewards</div>
                        </div>
                    </div>

                    <div class="dash-stat-card">
                        <div class="stat-icon-circle red">
                            <svg width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
                            </svg>
                        </div>
                        <div>
                            <div class="stat-label">ACTIVE EARNERS</div>
                            <div class="stat-value" id="kpi-unique-earners">0</div>
                            <div style="font-size: 11px; color: #64748b; font-weight: 600; margin-top: 2px;">Unique earning users in timeframe</div>
                        </div>
                    </div>
                </div>

                <!-- COINS DISTRIBUTION GRAPH -->
                <div class="chart-card">
                    <div class="chart-header">
                        <div>
                            <h3>Coins Distribution Graph</h3>
                            <span>Timeline progression of coins issued by tasks</span>
                        </div>
                        <span style="font-weight: 700; color: #052e1f; background: rgba(5, 46, 31, 0.08); padding: 4px 10px; border-radius: 8px; font-size: 11px;">Timeline Sync</span>
                    </div>
                    <div class="chart-canvas-wrap">
                        <canvas id="task-trend-chart"></canvas>
                    </div>
                </div>

                <!-- GRID: TASK STATS TABLE & LIVE LEADERBOARD -->
                <div class="tp-grid-2">
                    <!-- Task Stats Table -->
                    <div class="chart-card" style="margin-bottom: 0;">
                        <div class="chart-header">
                            <div>
                                <h3>Task Statistics</h3>
                                <span>Overview of completed tasks per provider</span>
                            </div>
                            <span class="tp-badge tp-badge-primary" id="tasks-count-badge">0 Tasks</span>
                        </div>
                        <div style="overflow-x: auto; max-height: 400px; overflow-y: auto;">
                            <table class="tp-table">
                                <thead>
                                    <tr>
                                        <th>Task / Provider</th>
                                        <th>Completions</th>
                                        <th>Coins</th>
                                        <th>INR Value</th>
                                    </tr>
                                </thead>
                                <tbody id="tasks-table-body">
                                    <tr>
                                        <td colspan="4" style="text-align: center; color: #94a3b8; padding: 30px;">Loading stats...</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Live App Leaderboard -->
                    <div class="chart-card" style="margin-bottom: 0;">
                        <div class="chart-header">
                            <div>
                                <h3>Live App Leaderboard</h3>
                                <span>Top performing users ranking list</span>
                            </div>
                            <span class="tp-badge tp-badge-success">Daily Sync</span>
                        </div>
                        
                        <!-- Leaderboard Tabs -->
                        <div class="tp-tabs">
                            <button id="tab-coins" class="tp-tab active" onclick="switchLeaderboardTab('coins')">Coins Leaderboard</button>
                            <button id="tab-referral" class="tp-tab" onclick="switchLeaderboardTab('referral')">Referral Leaderboard</button>
                        </div>

                        <!-- Coins Leaderboard Table -->
                        <div id="pane-coins" class="leaderboard-pane" style="overflow-x: auto; max-height: 350px; overflow-y: auto;">
                            <table class="tp-table tp-table-hover">
                                <thead>
                                    <tr>
                                        <th>Rank</th>
                                        <th>User Details</th>
                                        <th style="text-align: right;">Total Coins</th>
                                    </tr>
                                </thead>
                                <tbody id="coins-leaderboard-body">
                                    <tr>
                                        <td colspan="3" style="text-align: center; color: #94a3b8; padding: 30px;">Loading coins leaderboard...</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <!-- Referral Leaderboard Table -->
                        <div id="pane-referral" class="leaderboard-pane" style="display: none; overflow-x: auto; max-height: 350px; overflow-y: auto;">
                            <table class="tp-table tp-table-hover">
                                <thead>
                                    <tr>
                                        <th>Rank</th>
                                        <th>User Details</th>
                                        <th style="text-align: right;">Total Referrals</th>
                                    </tr>
                                </thead>
                                <tbody id="referral-leaderboard-body">
                                    <tr>
                                        <td colspan="3" style="text-align: center; color: #94a3b8; padding: 30px;">Loading referral leaderboard...</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </main>
        </div>
    </div>

    <!-- UI Controllers and AJAX Handler -->
    <%- include('partials/user_lookup') %>
    <script src="/js/admin.js"></script>
    <script src="/js/user_lookup.js"></script>
    <script>
        let trendChart = null;
        let activeLeaderboardTab = 'coins';

        document.addEventListener('DOMContentLoaded', () => {
            const today = new Date().toISOString().split('T')[0];
            document.getElementById('startDate').value = today;
            document.getElementById('endDate').value = today;

            loadDashboardData();
        });

        function onAppChange() {
            loadDashboardData();
        }

        function onRangeChange() {
            const range = document.getElementById('rangeSelect').value;
            const startInput = document.getElementById('startDate');
            const endInput = document.getElementById('endDate');

            if (range === 'custom') {
                startInput.disabled = false;
                endInput.disabled = false;
            } else {
                startInput.disabled = true;
                endInput.disabled = true;

                if (range === 'lifetime') {
                    startInput.value = '';
                    endInput.value = '';
                } else {
                    const now = new Date();
                    let start = new Date();
                    let end = new Date();

                    if (range === 'yesterday') {
                        start.setDate(now.getDate() - 1);
                        end.setDate(now.getDate() - 1);
                    } else if (range === 'last7') {
                        start.setDate(now.getDate() - 6);
                    }

                    startInput.value = start.toISOString().split('T')[0];
                    endInput.value = end.toISOString().split('T')[0];
                }
            }
            loadDashboardData();
        }

        async function loadDashboardData() {
            showLoading();
            try {
                const app = document.getElementById('appSelect').value;
                const range = document.getElementById('rangeSelect').value;
                const startDate = document.getElementById('startDate').value;
                const endDate = document.getElementById('endDate').value;

                const response = await fetch('/api/task-performance/stats', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ app, range, startDate, endDate })
                });

                const resJson = await response.json();
                hideLoading();

                if (!resJson.success) {
                    showAlert(resJson.message || 'Failed to fetch dashboard stats');
                    return;
                }

                // Update KPIs
                document.getElementById('kpi-total-coins').innerText = Number(resJson.totalCoins || 0).toLocaleString();
                document.getElementById('kpi-total-inr').innerText = '₹' + Number(resJson.revenueInRs || 0).toFixed(2);
                document.getElementById('kpi-total-completions').innerText = Number(resJson.totalCompletions || 0).toLocaleString();
                document.getElementById('kpi-unique-earners').innerText = Number(resJson.activeEarners || 0).toLocaleString();

                // Update Tasks Table
                const tableBody = document.getElementById('tasks-table-body');
                document.getElementById('tasks-count-badge').innerText = `${resJson.tasks.length} Tasks`;
                if (!resJson.tasks || resJson.tasks.length === 0) {
                    tableBody.innerHTML = `<tr><td colspan="4" style="text-align: center; color: #94a3b8; padding: 30px;">No task activities found in this range.</td></tr>`;
                } else {
                    tableBody.innerHTML = resJson.tasks.map(task => `
                        <tr>
                            <td><strong>${escapeHtml(task.provider)}</strong></td>
                            <td><span class="tp-badge tp-badge-primary">${task.count}</span></td>
                            <td><span class="tp-badge" style="background: #052e1f; color: #ffffff; font-weight: 700;">${Number(task.coins).toLocaleString()} coins</span></td>
                            <td><strong>₹${Number(task.coinsInRs).toFixed(2)}</strong></td>
                        </tr>
                    `).join('');
                }

                // Render Chart
                renderTrendChart(resJson.graphData || []);

                // Fetch Leaderboard Data
                await loadLeaderboards(app);

            } catch (err) {
                hideLoading();
                console.error(err);
                showAlert('Network error. Failed to load dashboard data.');
            }
        }

        async function loadLeaderboards(app) {
            try {
                const range = document.getElementById('rangeSelect').value;
                const startDate = document.getElementById('startDate').value;
                const endDate = document.getElementById('endDate').value;
                const response = await fetch(`/api/task-performance/leaderboard?app=${app}&range=${range}&startDate=${startDate}&endDate=${endDate}`);
                const data = await response.json();

                if (!data.success) return;

                // Ingest coins toppers
                const coinsBody = document.getElementById('coins-leaderboard-body');
                if (!data.coinsToppers || data.coinsToppers.length === 0) {
                    coinsBody.innerHTML = `<tr><td colspan="3" style="text-align: center; color: #94a3b8; padding: 20px;">No coins toppers available.</td></tr>`;
                } else {
                    coinsBody.innerHTML = data.coinsToppers.map((topper, i) => `
                        <tr onclick="viewUserBreakdown('${topper.userId}')">
                            <td><strong>#${i + 1}</strong></td>
                            <td>
                                <div class="tp-user-cell">
                                    <div class="tp-avatar">
                                        ${topper.photoUrl ? `<img src="${escapeHtml(topper.photoUrl)}" style="width: 100%; height: 100%; border-radius: 50%;" />` : escapeHtml(topper.name ? topper.name[0].toUpperCase() : 'U')}
                                    </div>
                                    <div>
                                        <div class="tp-user-name">${escapeHtml(topper.name || 'Unknown')}</div>
                                        <div class="tp-user-id-sub">ID: ${escapeHtml(topper.userId)}</div>
                                    </div>
                                </div>
                            </td>
                            <td style="text-align: right;"><span class="tp-badge" style="background: #052e1f; color: #ffffff; font-weight: 700;">${Number(topper.totalCoins).toLocaleString()} coins</span></td>
                        </tr>
                    `).join('');
                }

                // Ingest referral toppers
                const refBody = document.getElementById('referral-leaderboard-body');
                if (!data.referralToppers || data.referralToppers.length === 0) {
                    refBody.innerHTML = `<tr><td colspan="3" style="text-align: center; color: #94a3b8; padding: 20px;">No referral toppers available.</td></tr>`;
                } else {
                    refBody.innerHTML = data.referralToppers.map((topper, i) => `
                        <tr onclick="viewUserBreakdown('${topper.userId}')">
                            <td><strong>#${i + 1}</strong></td>
                            <td>
                                <div class="tp-user-cell">
                                    <div class="tp-avatar">
                                        ${topper.photoUrl ? `<img src="${escapeHtml(topper.photoUrl)}" style="width: 100%; height: 100%; border-radius: 50%;" />` : escapeHtml(topper.name ? topper.name[0].toUpperCase() : 'U')}
                                    </div>
                                    <div>
                                        <div class="tp-user-name">${escapeHtml(topper.name || 'Unknown')}</div>
                                        <div class="tp-user-id-sub">ID: ${escapeHtml(topper.userId)}</div>
                                    </div>
                                </div>
                            </td>
                            <td style="text-align: right;"><span class="tp-badge" style="background: #10b981; color: #ffffff; font-weight: 700;">${Number(topper.totalReferrals).toLocaleString()} invites</span></td>
                        </tr>
                    `).join('');
                }

            } catch (err) {
                console.error('Leaderboards load error:', err);
            }
        }

        function switchLeaderboardTab(tab) {
            activeLeaderboardTab = tab;
            document.getElementById('tab-coins').classList.remove('active');
            document.getElementById('tab-referral').classList.remove('active');
            document.getElementById('pane-coins').style.display = 'none';
            document.getElementById('pane-referral').style.display = 'none';

            if (tab === 'coins') {
                document.getElementById('tab-coins').classList.add('active');
                document.getElementById('pane-coins').style.display = 'block';
            } else {
                document.getElementById('tab-referral').classList.add('active');
                document.getElementById('pane-referral').style.display = 'block';
            }
        }

        async function viewUserBreakdown(userId) {
            showLoading();
            try {
                const app = document.getElementById('appSelect').value;
                const range = document.getElementById('rangeSelect').value;
                const startDate = document.getElementById('startDate').value;
                const endDate = document.getElementById('endDate').value;
                
                const response = await fetch(`/api/task-performance/user-breakdown?app=${app}&userId=${userId}&range=${range}&startDate=${startDate}&endDate=${endDate}`);
                const data = await response.json();
                hideLoading();

                if (!data.success) {
                    showAlert(data.message || 'Failed to fetch user breakdown details');
                    return;
                }

                // Ingest user details in modal
                document.getElementById('modal-user-name').innerText = data.user.name || 'Unknown User';
                document.getElementById('modal-user-email').innerText = data.user.email || 'No email registered';
                document.getElementById('modal-user-id').innerText = data.user.userId;

                const avatarDiv = document.getElementById('modal-user-avatar');
                if (data.user.photoUrl) {
                    avatarDiv.innerHTML = `<img src="${escapeHtml(data.user.photoUrl)}" style="width:100%; height:100%; border-radius:50%; object-fit:cover;" />`;
                } else {
                    avatarDiv.innerHTML = (data.user.name ? data.user.name[0].toUpperCase() : 'U');
                }

                // Ingest breakdown table
                const breakdownBody = document.getElementById('modal-breakdown-body');
                if (!data.breakdown || data.breakdown.length === 0) {
                    breakdownBody.innerHTML = `<tr><td colspan="2" style="text-align: center; color:#94a3b8; padding: 20px;">This user has not earned any coins from tasks yet.</td></tr>`;
                } else {
                    breakdownBody.innerHTML = data.breakdown.map(item => `
                        <tr>
                            <td><strong>${escapeHtml(item.name)}</strong></td>
                            <td style="text-align: right;"><span class="tp-badge" style="background: #052e1f; color: #ffffff; font-weight: 700;">${Number(item.coins).toLocaleString()} coins</span></td>
                        </tr>
                    `).join('');
                }

                openModal('breakdown-modal');

            } catch (err) {
                hideLoading();
                console.error(err);
                showAlert('Failed to query user task breakdown.');
            }
        }

        function closeBreakdownModal() {
            closeModal('breakdown-modal');
        }

        function renderTrendChart(data) {
            const ctx = document.getElementById('task-trend-chart').getContext('2d');
            
            if (trendChart) {
                trendChart.destroy();
            }

            const labels = data.map(d => d.label);
            const values = data.map(d => d.coins);

            const primaryColor = '#052e1f';

            // Styling gradient accent
            const gradient = ctx.createLinearGradient(0, 0, 0, 300);
            gradient.addColorStop(0, 'rgba(5, 46, 31, 0.35)');
            gradient.addColorStop(1, 'rgba(5, 46, 31, 0.01)');

            trendChart = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Coins Issued',
                        data: values,
                        borderColor: primaryColor,
                        borderWidth: 3,
                        backgroundColor: gradient,
                        fill: true,
                        tension: 0.35,
                        pointBackgroundColor: primaryColor,
                        pointHoverRadius: 7,
                        pointHoverBackgroundColor: '#ffffff',
                        pointHoverBorderColor: primaryColor,
                        pointHoverBorderWidth: 3
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            grid: { color: '#f1f5f9' },
                            ticks: {
                                color: '#64748b',
                                font: { size: 11, weight: '600' }
                            }
                        },
                        x: {
                            grid: { display: false },
                            ticks: {
                                color: '#64748b',
                                font: { size: 11, weight: '600' }
                            }
                        }
                    }
                }
            });
        }

        function escapeHtml(str) {
            if (!str) return '';
            return str
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#039;');
        }
    </script>
</body>

</html>
