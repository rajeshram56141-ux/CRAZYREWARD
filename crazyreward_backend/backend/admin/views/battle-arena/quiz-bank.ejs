<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Battle Game - Quiz Question Bank Manager</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/admin.css">
    <style>
        :root {
            --bg: #f8fafc;
            --surface: #ffffff;
            --border: #e2e8f0;
            --primary: #052e1f;
            --primary-hover: #042418;
            --text: #0f172a;
            --muted: #64748b;
        }

        * {
            box-sizing: border-box;
            font-family: 'Plus Jakarta Sans', sans-serif !important;
        }

        .glass-card {
            background: #ffffff;
            border-radius: 20px;
            padding: 24px;
            margin-bottom: 24px;
            box-shadow: 0 4px 16px rgba(0, 0, 0, 0.03);
            border: 1px solid var(--border);
        }

        .overview-head {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 16px;
        }

        .btn-action { background: #052e1f; color: #ffffff; font-weight: 700; padding: 12px 24px; border-radius: 12px; border: none; cursor: pointer; display: inline-flex; align-items: center; gap: 8px; font-size: 14px; transition: all 0.2s ease; }
        .btn-action:hover { background: #042418; transform: translateY(-1px); }

        .tp-table { width: 100%; border-collapse: separate; border-spacing: 0; font-size: 13px; margin-top: 16px; }
        .tp-table th { padding: 12px 14px; font-size: 11px; font-weight: 800; color: #ffffff; background: #052e1f; text-transform: uppercase; letter-spacing: 0.05em; }
        .tp-table th:first-child { border-top-left-radius: 10px; border-bottom-left-radius: 10px; }
        .tp-table th:last-child { border-top-right-radius: 10px; border-bottom-right-radius: 10px; }
        .tp-table td { padding: 14px; border-bottom: 1px solid #f1f5f9; color: #1e293b; font-weight: 600; vertical-align: middle; }

        .json-textarea { width: 100%; height: 100px; font-family: monospace; font-size: 13px; border: 1px solid var(--border); border-radius: 12px; padding: 12px; outline: none; }
        .json-textarea:focus { border-color: #052e1f; box-shadow: 0 0 0 3px rgba(5, 46, 31, 0.1); }

        /* Modal Popup */
        .modal-overlay { position: fixed; inset: 0; background: rgba(15, 23, 42, 0.6); backdrop-filter: blur(8px); display: none; align-items: center; justify-content: center; z-index: 99999; padding: 20px; }
        .modal-overlay.open { display: flex; }
        .modal-card { width: min(680px, 94vw); background: #ffffff; border-radius: 24px; overflow: hidden; box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25); border: 1px solid #e2e8f0; }
        .modal-header { padding: 20px 24px; background: #052e1f; color: #ffffff; display: flex; align-items: center; justify-content: space-between; }
        .modal-header h3 { margin: 0; font-size: 18px; font-weight: 800; display: flex; align-items: center; gap: 10px; }
        .modal-close-btn { background: rgba(255, 255, 255, 0.15); border: none; color: #ffffff; width: 32px; height: 32px; border-radius: 8px; cursor: pointer; font-size: 18px; font-weight: 800; display: flex; align-items: center; justify-content: center; }
        .modal-body { padding: 24px; max-height: 80vh; overflow-y: auto; }
        .form-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; }
        .form-group { display: flex; flex-direction: column; gap: 6px; }
        .form-group label { font-size: 11px; font-weight: 800; color: var(--muted); text-transform: uppercase; letter-spacing: 0.05em; }
        .form-control { width: 100%; padding: 12px 16px; border: 1px solid var(--border); border-radius: 12px; font-size: 13px; font-weight: 700; color: var(--text); background: #ffffff; outline: none; transition: all 0.2s ease; }
        .form-control:focus { border-color: #052e1f; box-shadow: 0 0 0 3px rgba(5, 46, 31, 0.1); }
    </style>
</head>
<body class="dashboard-body">
    <div class="dashboard-shell">
        <%- include('../partials/sidebar', { activePage: 'battle-game' }) %>

        <div class="dashboard-main">
            <header class="navbar dashboard-navbar">
                <div class="nav-left" style="display: flex; align-items: center; gap: 12px; white-space: nowrap;">
                    <button type="button" class="sidebar-toggle-btn" onclick="toggleSidebar()">☰</button>
                    <h2 style="margin: 0; font-size: 18px; font-weight: 800; white-space: nowrap;">Battle Quiz Bank</h2>
                </div>

                <div class="nav-right" onclick="toggleDropdown()">
                    <div class="avatar"><%= (admin && (admin.name || admin.username || admin.email)) ? (admin.name || admin.username || admin.email).charAt(0).toUpperCase() : 'A' %></div>
                    <div class="dropdown" id="dropdown">
                        <a href="/logout">Logout</a>
                    </div>
                </div>
            </header>

            <main class="container wrap" style="padding: 24px;">
                <!-- Header Card -->
                <section class="glass-card overview-head">
                    <div>
                        <h1 style="font-size: 22px; font-weight: 800; color: #052e1f; margin: 0 0 4px; display: flex; align-items: center; gap: 10px;">
                            <svg width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                            </svg>
                            Battle Game - Quiz Question Bank
                        </h1>
                        <p style="color: var(--muted); font-size: 13px; margin: 0;">Create quiz game sets with custom questions, options, and timers</p>
                    </div>
                    <button type="button" class="btn-action" onclick="openAddGameModal()">
                        <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
                        </svg>
                        Add Quiz Game Question
                    </button>
                </section>

                <!-- Question Bank Table Card -->
                <div class="glass-card">
                    <div style="font-size: 17px; font-weight: 800; color: #052e1f; margin-bottom: 16px; display: flex; align-items: center; gap: 10px;">
                        <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
                        </svg>
                        Question Bank (<%= questions ? questions.length : 0 %> Questions)
                    </div>
                    <table class="tp-table">
                        <thead>
                            <tr>
                                <th>Game Title / Set</th>
                                <th>Category</th>
                                <th>Question</th>
                                <th>Options</th>
                                <th>Correct Ans</th>
                                <th>Time</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (questions && questions.length) { %>
                                <% questions.forEach(q => { %>
                                    <tr>
                                        <td style="font-weight: 800; color: #052e1f;"><%= q.gameTitle || 'General Quiz Clash' %></td>
                                        <td><span style="background: #e2e8f0; padding: 4px 8px; border-radius: 6px; font-weight: 700; font-size: 11px;"><%= q.category %></span></td>
                                        <td style="font-weight: 700;"><%= q.question %></td>
                                        <td>1. <%= q.options[0] %> | 2. <%= q.options[1] %> | 3. <%= q.options[2] %> | 4. <%= q.options[3] %></td>
                                        <td><span style="background: #dcfce7; color: #15803d; padding: 4px 8px; border-radius: 6px; font-weight: 800;"><%= q.options[q.correctIndex] %></span></td>
                                        <td><%= q.timeLimitSec %>s</td>
                                        <td>
                                            <a href="/admin/battle-arena/quiz-bank/delete/<%= q.questionId || q._id %>" style="color: #ef4444; font-weight: 800; text-decoration: none;" onclick="return confirm('Delete question?')">Delete</a>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr><td colspan="7" style="text-align: center; color: #94a3b8; padding: 24px;">No quiz questions found. Click "+ Add Quiz Game Question" above!</td></tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>

                <!-- Bulk JSON Import Card -->
                <div class="glass-card">
                    <div style="font-size: 17px; font-weight: 800; color: #052e1f; margin-bottom: 16px; display: flex; align-items: center; gap: 10px;">
                        <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/>
                        </svg>
                        Bulk Upload Quiz JSON
                    </div>
                    <form action="/admin/battle-arena/quiz-bank/bulk-upload" method="POST">
                        <textarea class="json-textarea" name="jsonContent" placeholder='[{"gameTitle":"Math Speed Clash","category":"Math","question":"10+10","options":["20","30","40","50"],"correctIndex":0,"timeLimitSec":20}]'></textarea>
                        <div style="margin-top: 12px; text-align: right;">
                            <button type="submit" class="btn-action">Upload Quiz JSON</button>
                        </div>
                    </form>
                </div>
            </main>
        </div>
    </div>

    <!-- Add Quiz Game Modal Popup -->
    <div id="addQuizModal" class="modal-overlay">
        <div class="modal-card">
            <div class="modal-header">
                <h3>
                    <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
                    </svg>
                    Add New Quiz Game Question
                </h3>
                <button type="button" class="modal-close-btn" onclick="closeAddGameModal()">✕</button>
            </div>
            <div class="modal-body">
                <form action="/admin/battle-arena/quiz-bank/add" method="POST">
                    <div class="form-grid">
                        <div class="form-group" style="grid-column: 1 / -1;">
                            <label>Game Title / Set Name</label>
                            <input type="text" class="form-control" name="gameTitle" placeholder="e.g. Math Speed Clash 10+10" required />
                        </div>
                        <div class="form-group">
                            <label>Category</label>
                            <input type="text" class="form-control" name="category" value="General Knowledge" required />
                        </div>
                        <div class="form-group">
                            <label>Time Limit Per Question (Sec)</label>
                            <input type="number" class="form-control" name="timeLimitSec" value="20" required />
                        </div>
                        <div class="form-group" style="grid-column: 1 / -1;">
                            <label>Question Text</label>
                            <input type="text" class="form-control" name="question" placeholder="e.g. What is 10 + 10?" required />
                        </div>
                        <div class="form-group">
                            <label>Option 1</label>
                            <input type="text" class="form-control" name="opt1" placeholder="20" required />
                        </div>
                        <div class="form-group">
                            <label>Option 2</label>
                            <input type="text" class="form-control" name="opt2" placeholder="30" required />
                        </div>
                        <div class="form-group">
                            <label>Option 3</label>
                            <input type="text" class="form-control" name="opt3" placeholder="40" required />
                        </div>
                        <div class="form-group">
                            <label>Option 4</label>
                            <input type="text" class="form-control" name="opt4" placeholder="50" required />
                        </div>
                        <div class="form-group" style="grid-column: 1 / -1;">
                            <label>Select Correct Option</label>
                            <select class="form-control" name="correctIndex">
                                <option value="0">Option 1 (Index 0)</option>
                                <option value="1">Option 2 (Index 1)</option>
                                <option value="2">Option 3 (Index 2)</option>
                                <option value="3">Option 4 (Index 3)</option>
                            </select>
                        </div>
                    </div>
                    <div style="margin-top: 24px; text-align: right; display: flex; gap: 12px; justify-content: flex-end;">
                        <button type="button" style="background: #e2e8f0; color: #475569; font-weight: 700; padding: 12px 24px; border-radius: 12px; border: none; cursor: pointer;" onclick="closeAddGameModal()">Cancel</button>
                        <button type="submit" class="btn-action">Save Quiz Game Question</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script>
        function openAddGameModal() {
            document.getElementById('addQuizModal').classList.add('open');
        }
        function closeAddGameModal() {
            document.getElementById('addQuizModal').classList.remove('open');
        }
    </script>
    <script src="/js/admin.js"></script>
</body>
</html>
