                    <script id="offersData" type="application/json"><%- JSON.stringify(offers || []) %></script>
                    <script id="categoriesData" type="application/json"><%- JSON.stringify(categories || []) %></script>

                    <script>
                        let allCategories = JSON.parse(document.getElementById('categoriesData').textContent);

                        async function openCategoryModal() {
                            document.getElementById('categoryBackdrop').classList.add('show');
                            renderCategoriesList();
                            await fetchCategories();
                        }

                        async function fetchCategories() {
                            try {
                                const res = await fetch('/daily-task-categories');
                                const data = await res.json();
                                if (data.success) {
                                    allCategories = data.categories;
                                    renderCategoriesList();
                                    updateCategoryDropdowns();
                                } else {
                                    alert('Failed to fetch categories: ' + data.message);
                                }
                            } catch (err) {
                                console.error(err);
                                alert('Error fetching categories');
                            }
                        }

                        function renderCategoriesList() {
                            const container = document.getElementById('categoriesListContainer');
                            container.innerHTML = '';
                            if (allCategories.length === 0) {
                                container.innerHTML = '<p style="color:var(--text-muted); text-align:center; margin:16px 0;">No categories found.</p>';
                                return;
                            }
                            allCategories.forEach(cat => {
                                const item = document.createElement('div');
                                item.style.display = 'flex';
                                item.style.justifyContent = 'space-between';
                                item.style.alignItems = 'center';
                                item.style.padding = '8px 12px';
                                item.style.borderBottom = '1px solid #f1f5f9';
                                item.innerHTML = `
                    <span style="font-weight: 500;">${cat.name}</span>
                    <button class="head-btn" style="border:1px solid #fecaca; background:#fff; color:#ef4444; padding: 4px 8px; font-size:12px; border-radius: 4px; cursor: pointer;" onclick="deleteCategory('${cat._id}')">Delete</button>
                `;
                                container.appendChild(item);
                            });
                        }

                        async function addCategory() {
                            const input = document.getElementById('newCategoryName');
                            const name = input.value.trim();
                            if (!name) return alert('Category name cannot be empty');
                            try {
                                const res = await fetch('/daily-task-categories', {
                                    method: 'POST',
                                    headers: { 'Content-Type': 'application/json' },
                                    body: JSON.stringify({ name })
                                });
                                const data = await res.json();
                                if (data.success) {
                                    input.value = '';
                                    await fetchCategories();
                                } else {
                                    alert('Error: ' + data.message);
                                }
                            } catch (err) {
                                console.error(err);
                                alert('Error adding category');
                            }
                        }

                        async function deleteCategory(id) {
                            if (!confirm('Are you sure you want to delete this category?')) return;
                            try {
                                const res = await fetch(`/daily-task-categories/${id}`, {
                                    method: 'DELETE'
                                });
                                const data = await res.json();
                                if (data.success) {
                                    await fetchCategories();
                                } else {
                                    alert('Error: ' + data.message);
                                }
                            } catch (err) {
                                console.error(err);
                                alert('Error deleting category');
                            }
                        }

                        function updateCategoryDropdowns(selectedCategory) {
                            const select = document.getElementById('f_category');
                            if (!select) return;
                            const currentSelected = selectedCategory || select.value;
                            select.innerHTML = '<option value="" disabled>Select Category</option>';

                            const defaults = [
                                "Multi Task",
                                "Youtube Video",
                                "Youtube Shorts",
                                "Instagram Reels",
                                "Install",
                                "Register",
                                "Other"
                            ];

                            const names = new Set(defaults);
                            allCategories.forEach(cat => {
                                if (cat.name) names.add(cat.name);
                            });

                            names.forEach(name => {
                                const opt = document.createElement('option');
                                opt.value = name;
                                opt.textContent = name;
                                select.appendChild(opt);
                            });

                            if (currentSelected && !names.has(currentSelected)) {
                                const opt = document.createElement('option');
                                opt.value = currentSelected;
                                opt.textContent = currentSelected;
                                select.appendChild(opt);
                            }

                            select.value = currentSelected;
                        }

                        const allOffers = JSON.parse(document.getElementById('offersData').textContent);
                        const container = document.getElementById('offersContainer');
                        let chart = null;
                        let activeStatsOfferId = '';

                        function render(list) {
                            container.innerHTML = '';

                            list.forEach(o => {
                                const dailyCap = o.dailyCapLimit || 0;
                                const dailyCount = o.dailyCapCount || 0;
                                const pct = dailyCap > 0 ? Math.min((dailyCount / dailyCap) * 100, 100) : 0;

                                const card = document.createElement('div');
                                card.className = 'card';
                                card.innerHTML = `
                    <div class="card-head">
                        <img src="${o.imagePath || 'https://placehold.co/100x100/fff/000?text=Icon'}" class="card-logo">
                        <div class="card-title-grp">
                            <h3 class="card-title">${o.offerName}</h3>
                            <div class="badge-row">
                                <span class="badge">ID: ${o.offerId}</span>
                                <span class="badge">Provider: ${o.provider}</span>
                            </div>
                        </div>
                        <div class="card-payout">${Number(o.coins || o.payout || 0)} Coins</div>
                    </div>
                    <div class="card-stats-grid">
                        <div class="stat-item">Category <b>${o.offerCategory}</b></div>
                        <div class="stat-item">Type <b>${o.offerType}</b></div>
                        <div class="stat-item">Postbacks<span><b>${o.postbackCount}</b></span></div>
                        <div class="stat-item">Tracking Time <b>${formatTime(o.trackingTime)}</b></div>
                    </div>
                    <div class="card-body">
                        <div class="progress-label"><span>Daily Cap</span> <span>${dailyCount} / ${dailyCap || '∞'}</span></div>
                        <div class="progress-track"><div class="progress-bar" style="width:${pct}%"></div></div>
                    </div>
                    <div class="card-footer">
                        <span class="status-pill ${o.enabled ? 'active' : 'disabled'}">${o.enabled ? 'Active' : 'Disabled'}</span>
                        <div class="actions">
                            <button class="btn-round" onclick="openTestModal('${o._id}')" title="Test CPA Postback" style="color: #6366f1;">
                                <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"/></svg>
                            </button>
                            <button class="btn-round" onclick="openStats('${o.offerId}')" title="Performance">
                                <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
                            </button>
                            <button class="btn-round" onclick="openEdit('${o._id}')" title="Edit Full Details">
                                <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                            </button>
                            <button class="btn-round copy" onclick="duplicateOffer('${o._id}')" title="Duplicate Task">
                                <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7v8a2 2 0 002 2h6M8 7V5a2 2 0 012-2h4.586a1 1 0 01.707.293l4.414 4.414a1 1 0 01.293.707V15a2 2 0 01-2 2h-2M8 7H6a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2v-2"/></svg>
                            </button>
                            <button class="btn-round danger" onclick="deleteOffer('${o._id}')" title="Delete Task">
                                <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                            </button>
                        </div>
                    </div>
                `;
                                container.appendChild(card);
                            });
                        }

                        async function deleteOffer(id) {
                            const target = allOffers.find(x => String(x._id || '') === String(id || ''));
                            const offerName = target?.offerName || 'this task';
                            const ok = window.confirm(`Delete "${offerName}"? This action cannot be undone.`);
                            if (!ok) return;

                            try {
                                const res = await fetch(`/daily-task/${id}`, { method: 'DELETE' });
                                const json = await res.json();
                                if (!res.ok || !json.success) {
                                    throw new Error(json.message || 'Delete failed');
                                }
                                location.reload();
                            } catch (err) {
                                window.alert(`❌ ${err.message || 'Failed to delete task'}`);
                            }
                        }

                        function duplicateOffer(id) {
                            const o = allOffers.find(x => String(x._id || '') === String(id || ''));
                            if (!o) return;
                            const isVideoVerif = (o.videoVerificationEnabled === true || o.videoVerificationEnabled === 'true' || o.videoVerificationEnabled === 1 || o.videoVerificationEnabled === '1');
                            const isPackage = (o.packageEnabled === true || o.packageEnabled === 'true' || o.packageEnabled === 1 || o.packageEnabled === '1');
                            const isTimer = (o.timerEnabled === true || o.timerEnabled === 'true' || o.timerEnabled === 1 || o.timerEnabled === '1');
                            const isDailyReward = (o.dailyRewardEnabled === true || o.dailyRewardEnabled === 'true' || o.dailyRewardEnabled === 1 || o.dailyRewardEnabled === '1');
                            const hasMultiEvents = Array.isArray(o.events) && o.events.length > 0;

                            let method = 'SingleEvent';
                            if (hasMultiEvents && isPackage && isTimer) method = 'All';
                            else if (hasMultiEvents && isPackage) method = 'MultiPackage';
                            else if (hasMultiEvents && isTimer) method = 'MultiTimer';
                            else if (hasMultiEvents) method = 'MultiEvent';
                            else if (isPackage && isTimer) method = 'PackageTimer';
                            else if (isPackage) method = 'Package';
                            else if (isTimer) method = 'PackageTimer';

                            const params = new URLSearchParams({
                                prefill: '1',
                                method: method,
                                offerName: (o.offerName || '') + ' (Copy)',
                                provider: o.provider || '',
                                payout: o.payout || '',
                                offerCategory: o.offerCategory || '',
                                offerType: o.offerType || '',
                                imagePath: o.imagePath || '',
                                bannerPath: o.bannerPath || '',
                                watchTutorial: o.watchTutorial || '',
                                subDescription: o.subDescription || '',
                                redirectionUrl: o.redirectionUrl || '',
                                dailyCapLimit: o.dailyCapLimit || '',
                                lifetimeCapLimit: o.lifetimeCapLimit || '',
                                perUserDailyCap: (o.perUserDailyCap !== null && o.perUserDailyCap !== undefined) ? o.perUserDailyCap : '',
                                trackingTime: o.trackingTime || '',
                                color: o.color || '#ffffff',
                                packageEnabled: isPackage ? 'true' : 'false',
                                packageName: o.packageName || '',
                                timerEnabled: isTimer ? 'true' : 'false',
                                timerDuration: o.timerDuration || '',
                                dailyRewardEnabled: isDailyReward ? 'true' : 'false',
                                dailyRewards: JSON.stringify(o.dailyRewards || []),
                                events: JSON.stringify(o.events || []),
                                videoVerificationEnabled: isVideoVerif ? 'true' : 'false',
                                videoVerificationId: o.videoVerificationId || '',
                                countries: (() => {
                                    let cVal = '';
                                    if (Array.isArray(o.countries)) {
                                        cVal = o.countries.map(c => typeof c === 'object' && c !== null ? (c.code || c.name || '') : String(c || '')).filter(Boolean).join(',');
                                    } else if (typeof o.countries === 'string') {
                                        try {
                                            const p = JSON.parse(o.countries);
                                            if (Array.isArray(p)) {
                                                cVal = p.map(c => typeof c === 'object' && c !== null ? (c.code || c.name || '') : String(c || '')).filter(Boolean).join(',');
                                            } else {
                                                cVal = o.countries;
                                            }
                                        } catch {
                                            cVal = o.countries;
                                        }
                                    }
                                    cVal = (cVal || '').replace(/[\[\]"']/g, '').trim();
                                    return cVal || 'GLOBAL';
                                })(),
                                offerDescription: JSON.stringify(o.offerDescription || []),
                                offerDisclaimer: JSON.stringify(o.offerDisclaimer || []),
                                dailyReset: o.dailyReset || false,
                            });
                            window.location.href = '/add-daily-task?' + params.toString();
                        }

                        function formatTime(totalSeconds) {
                            if (!totalSeconds || isNaN(totalSeconds) || totalSeconds <= 0) return "0s";

                            const hrs = Math.floor(totalSeconds / 3600);
                            const mins = Math.floor((totalSeconds % 3600) / 60);
                            const secs = totalSeconds % 60;

                            let parts = [];

                            if (hrs > 0) parts.push(`${hrs}h`);
                            if (mins > 0) parts.push(`${mins}m`);
                            if (secs > 0 || parts.length === 0) parts.push(`${secs}s`);

                            return parts.join(' ');
                        }

                        let currentCategoryTab = '<%= typeof isWatchEarnPage !== "undefined" && isWatchEarnPage ? "watch" : "daily" %>';

                        function switchCategoryTab(tab) {
                            currentCategoryTab = tab;
                            document.getElementById('tab-daily-task')?.classList.toggle('active', tab === 'daily');
                            document.getElementById('tab-watch-earn')?.classList.toggle('active', tab === 'watch');
                            filter();
                        }

                        function isWatchAndEarnOffer(o) {
                            const cat = String(o.offerCategory || '').toLowerCase();
                            const type = String(o.offerType || '').toLowerCase();
                            const name = String(o.offerName || '').toLowerCase();
                            return cat.includes('watch') || type.includes('watch') || name.includes('watch') || cat.includes('youtube') || cat.includes('reels') || cat.includes('shorts') || cat.includes('video');
                        }

                        function updateCategoryCounts() {
                            let dailyCount = 0;
                            let watchCount = 0;
                            (allOffers || []).forEach(o => {
                                if (isWatchAndEarnOffer(o)) watchCount++;
                                else dailyCount++;
                            });
                            const cDaily = document.getElementById('count-daily-task');
                            const cWatch = document.getElementById('count-watch-earn');
                            if (cDaily) cDaily.textContent = String(dailyCount);
                            if (cWatch) cWatch.textContent = String(watchCount);
                        }

                        function filter() {
                            updateCategoryCounts();

                            let filtered = allOffers.filter(o => {
                                const q = document.getElementById('searchBox').value.toLowerCase();
                                const mSearch = o.offerName.toLowerCase().includes(q) || o.offerId.toLowerCase().includes(q) || o.provider.toLowerCase().includes(q);
                                const mStatus = document.getElementById('statusFilter').value === 'all' ? true : (document.getElementById('statusFilter').value === 'active' ? o.enabled : !o.enabled);

                                const mCategory = true;

                                return mSearch && mStatus && mCategory;
                            });

                            const sort = document.getElementById('sortKey').value;
                            filtered.sort((a, b) => {
                                if (sort === 'payout') return b.payout - a.payout;
                                return new Date(b.createdAt) - new Date(a.createdAt);
                            });
                            render(filtered);
                        }

                        function addDescField(value = '', subtitle = '') {
                            if (typeof value === 'object' && value !== null) {
                                subtitle = value.subtitle || '';
                                value = value.title || '';
                            } else if (typeof value === 'string' && value.includes(':::')) {
                                const parts = value.split(':::');
                                value = parts[0].trim();
                                subtitle = (parts[1] || '').trim();
                            }
                            const container = document.getElementById('descContainer');
                            const row = document.createElement('div');
                            row.className = 'desc-step-row';
                            row.style.display = 'flex';
                            row.style.gap = '8px';
                            row.style.marginBottom = '8px';
                            row.style.alignItems = 'center';

                            row.innerHTML = `
                <input type="text" class="desc-step-title" value="${value}" placeholder="Step Title (e.g. Download & Install)" style="flex:1.2; padding:8px 12px; border:1px solid var(--border); border-radius:8px;">
                <input type="text" class="desc-step-subtitle" value="${subtitle}" placeholder="Step Subtitle (e.g. Install & open the app)" style="flex:1.8; padding:8px 12px; border:1px solid var(--border); border-radius:8px;">
                <button type="button" onclick="this.parentElement.remove()"
                    style="border:none; background:#fee2e2; color:#ef4444; padding:0 10px; height:36px; border-radius:8px; cursor:pointer;">
                    ✕
                </button>
            `;
                            container.appendChild(row);
                        }

                        function addDisclaimerField(value = '') {

                            const container = document.getElementById('disclaimerContainer');

                            const row = document.createElement('div');
                            row.style.display = 'flex';
                            row.style.gap = '8px';
                            row.style.marginBottom = '8px';

                            row.innerHTML = `
        <input type="text" value="${value}" style="flex:1; padding:8px; border:1px solid var(--border); border-radius:8px;">
        <button type="button" onclick="this.parentElement.remove()"
            style="border:none; background:#fee2e2; color:#ef4444; padding:0 10px; border-radius:8px; cursor:pointer;">
            ✕
        </button>
    `;

                            container.appendChild(row);
                        }

                        function openEdit(id) {
                            const o = allOffers.find(x => String(x._id || '') === String(id || ''));
                            if (!o) {
                                if (typeof showAlert === 'function') showAlert('Task details not found');
                                else alert('Task details not found');
                                return;
                            }

                            // Reset Save Button state
                            const saveBtn = document.getElementById('btnSaveAllChanges');
                            if (saveBtn) {
                                saveBtn.disabled = false;
                                saveBtn.innerHTML = '<i class="fa-solid fa-floppy-disk" style="margin-right: 6px;"></i>Save All Changes';
                                saveBtn.style.opacity = '1';
                                saveBtn.style.pointerEvents = 'auto';
                                saveBtn.style.background = '';
                                saveBtn.style.borderColor = '';
                            }

                            document.getElementById('f_id').value = o._id;
                            document.getElementById('f_name').value = o.offerName;
                            if (document.getElementById('f_rating')) document.getElementById('f_rating').value = o.rating || '';
                            if (document.getElementById('f_downloads')) document.getElementById('f_downloads').value = o.downloads || '';
                            document.getElementById('f_provider').value = o.provider;
                            document.getElementById('f_payout').value = o.payout;

                            // Populate category select options dynamically and select the current offer's category
                            updateCategoryDropdowns(o.offerCategory);

                            document.getElementById('f_type').value = o.offerType;
                            document.getElementById('f_image').value = o.imagePath || '';
                            document.getElementById('f_banner').value = o.bannerPath || '';
                            document.getElementById('f_watch_tutorial').value = o.watchTutorial || '';
                            document.getElementById('f_sub_description').value = o.subDescription || '';
                            document.getElementById('f_redir').value = o.redirectionUrl || '';
                            document.getElementById('f_daily_cap').value = o.dailyCapLimit || '';
                            document.getElementById('f_tracking_time').value = o.trackingTime || 0;
                            document.getElementById('f_color').value = o.color || '#ffffff';
                            document.getElementById('f_life_cap').value = o.lifetimeCapLimit || '';
                            document.getElementById('f_enabled').value = o.enabled.toString();

                            // Daily Reset toggle
                            document.getElementById('f_daily_reset').checked = o.dailyReset === true;
                            const fScreenshotEnabled = o.screenshotVerificationEnabled === true;
                            if (document.getElementById('f_screenshot_verification')) document.getElementById('f_screenshot_verification').checked = fScreenshotEnabled;

                            // Multi-Event Mode prefill
                            const fMultiEventEnabled = Array.isArray(o.events) && o.events.length > 0;
                            document.getElementById('f_multi_event_enabled').checked = fMultiEventEnabled;
                            document.getElementById('f_multi_event_group').style.display = fMultiEventEnabled ? 'block' : 'none';

                            const fPackageEnabled = o.packageEnabled === true;
                            const fTimerEnabled = o.timerEnabled === true;

                            const fMethodSelect = document.getElementById('f_daily_task_method_select');
                            let editMethod = 'SingleEvent';
                            if (fScreenshotEnabled) editMethod = 'Screenshot';
                            else if (fMultiEventEnabled && fPackageEnabled && fTimerEnabled) editMethod = 'All';
                            else if (fMultiEventEnabled && fPackageEnabled) editMethod = 'MultiPackage';
                            else if (fMultiEventEnabled && fTimerEnabled) editMethod = 'MultiTimer';
                            else if (fMultiEventEnabled) editMethod = 'MultiEvent';
                            else if (fPackageEnabled && fTimerEnabled) editMethod = 'PackageTimer';
                            else if (fPackageEnabled) editMethod = 'Package';

                            fMethodSelect.value = editMethod;

                            // Package / Timer fields populate
                            document.getElementById('f_package_enabled').checked = fPackageEnabled;
                            document.getElementById('f_package_name').value = o.packageName || '';
                            document.getElementById('f_package_name_group').style.display = fPackageEnabled ? 'block' : 'none';

                            document.getElementById('f_timer_enabled').checked = fTimerEnabled;
                            const timerDurationMinutes = o.timerDuration ? Math.round(o.timerDuration / 60) : '';
                            document.getElementById('f_timer_duration').value = timerDurationMinutes;

                            // Daily Reward Mode prefill
                            const fDailyRewardEnabled = o.dailyRewardEnabled === true;
                            document.getElementById('f_daily_reward_enabled').checked = fDailyRewardEnabled;
                            document.getElementById('f_daily_reward_toggle_group').style.display = fTimerEnabled ? 'flex' : 'none';

                            fDailyRewards = [];
                            if (fDailyRewardEnabled && o.dailyRewards) {
                                fDailyRewards = o.dailyRewards.map(r => ({
                                    day: r.day,
                                    timerDurationMinutes: r.timerDuration ? Math.round(r.timerDuration / 60) : 0,
                                    coins: r.coins
                                }));
                            }
                            renderEditDailyRewards();

                            if (fTimerEnabled && fDailyRewardEnabled) {
                                document.getElementById('f_daily_rewards_section').style.display = 'block';
                                document.getElementById('f_timer_duration_group').style.display = 'none';
                            } else if (fTimerEnabled) {
                                document.getElementById('f_daily_rewards_section').style.display = 'none';
                                document.getElementById('f_timer_duration_group').style.display = 'block';
                            } else {
                                document.getElementById('f_daily_rewards_section').style.display = 'none';
                                document.getElementById('f_timer_duration_group').style.display = 'none';
                            }

                            function updateEditRedirRequiredState() {
                                const isPackage = document.getElementById('f_package_enabled').checked;
                                const isMulti = document.getElementById('f_multi_event_enabled').checked;
                                if (isPackage || isMulti) {
                                    document.getElementById('f_redir_label').textContent = 'Redirection URL (Optional)';
                                } else {
                                    document.getElementById('f_redir_label').textContent = 'Redirection URL';
                                }
                            }
                            updateEditRedirRequiredState();

                            // Secret Key
                            const secretKey = o.secretKey || 'Not Generated';
                            document.getElementById('f_secret_key').textContent = secretKey;
                            document.getElementById('f_secret_key_input').value = secretKey;

                            // Video Verification populate
                            const isDailyTask = document.getElementById('f_type').value === 'DailyTask';
                            const fMethodGroup = document.getElementById('f_daily_task_method_group');

                            if (isDailyTask) {
                                fMethodGroup.style.display = 'block';
                            } else {
                                fMethodGroup.style.display = 'none';
                            }

                            // Field visibility is fully coordinated by updateEditFormFieldsVisibility below

                            // Video Verification populate
                            const isWatchEarn = o.offerType === 'WatchEarn';
                            const fVideoVerificationEnabled = o.videoVerificationEnabled === true;

                            const videoVerifCheckbox = document.getElementById('f_video_verification_enabled');
                            if (videoVerifCheckbox) videoVerifCheckbox.checked = fVideoVerificationEnabled;

                            const videoVerifIdInput = document.getElementById('f_video_verification_id');
                            if (videoVerifIdInput) videoVerifIdInput.value = o.videoVerificationId || '';

                            const statusText = document.getElementById('f_video_verification_status');
                            if (statusText) {
                                statusText.textContent = fVideoVerificationEnabled ? 'ON' : 'OFF';
                                statusText.style.color = fVideoVerificationEnabled ? '#10b981' : '#ef4444';
                            }

                            // Per User Daily Cap populate
                            const perUserCapGroup = document.getElementById('f_per_user_daily_cap_group');
                            if (perUserCapGroup) perUserCapGroup.style.display = isWatchEarn ? 'block' : 'none';
                            const perUserCapInput = document.getElementById('f_per_user_daily_cap');
                            if (perUserCapInput) perUserCapInput.value = (isWatchEarn && o.perUserDailyCap !== null && o.perUserDailyCap !== undefined) ? o.perUserDailyCap : '';

                            if (typeof updateEditThumbnailButtonVisibility === 'function') {
                                updateEditThumbnailButtonVisibility();
                            }

                            // Description
                            const descContainer = document.getElementById('descContainer');
                            if (descContainer) {
                                descContainer.innerHTML = '';
                                if (Array.isArray(o.offerDescription)) {
                                    o.offerDescription.forEach(d => addDescField(d));
                                } else {
                                    addDescField('');
                                }
                            }

                            // Disclaimer
                            const disclaimerContainer = document.getElementById('disclaimerContainer');
                            if (disclaimerContainer) {
                                disclaimerContainer.innerHTML = '';
                                if (Array.isArray(o.offerDisclaimer)) {
                                    o.offerDisclaimer.forEach(d => addDisclaimerField(d));
                                }
                            }

                            // Events
                            renderEditEvents(o.events || []);

                            if (typeof updateEditFormFieldsVisibility === 'function') {
                                updateEditFormFieldsVisibility();
                            }

                            if (typeof syncAllEditToggleVisuals === 'function') {
                                syncAllEditToggleVisuals();
                            }

                            document.getElementById('editBackdrop').classList.add('show');
                        }

                        // -------- EDIT DAILY REWARDS LIST LOGIC --------
                        let fDailyRewards = [];

                        function renderEditDailyRewards() {
                            const container = document.getElementById('f_daily_rewards_list');
                            container.innerHTML = '';

                            if (fDailyRewards.length === 0) {
                                container.innerHTML = '<p class="no-events-note" style="color: #15803d; text-align: center; font-size: 13px;">No days added yet. Click "Add Daily Step" to create progression milestones.</p>';
