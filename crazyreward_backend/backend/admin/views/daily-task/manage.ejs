                                document.getElementById('f_multi_event_group').style.display = 'none';
                                editEvents = [];
                                updateEventsEditUI();
                            }
                            updateEditRedirRequiredState();
                            syncAllEditToggleVisuals();
                        });

                        document.getElementById('f_timer_enabled').addEventListener('change', (e) => {
                            const timerEnabled = e.target.checked;
                            const dailyRewardToggleGroup = document.getElementById('f_daily_reward_toggle_group');
                            const dailyRewardsSection = document.getElementById('f_daily_rewards_section');
