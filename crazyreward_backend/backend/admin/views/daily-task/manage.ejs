                    <input type="text" id="rejectReasonInput" placeholder="Reason (e.g. Invalid screenshot or fake image)" style="width: 100%; padding: 10px 14px; border-radius: 10px; border: 1px solid #cbd5e1; font-size: 13px; margin-bottom: 20px; outline: none; box-sizing: border-box;" />

                    <div style="display: flex; flex-direction: column; gap: 10px;">
                        <button type="button" id="rejectReuploadBtn" onclick="submitRejectProof('normal')" style="width: 100%; padding: 11px; border-radius: 10px; border: 1px solid #f87171; background: #fff5f5; color: #dc2626; font-weight: 700; font-size: 13px; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 6px;">
