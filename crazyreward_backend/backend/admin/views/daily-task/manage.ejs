                        document.getElementById('addEventEditBtn').addEventListener('click', () => {
                            editEvents.push({
                                eventId: `event_${Date.now()}`,
                                name: '',
                                label: '',
                                coins: 0
                            });
                            updateEventsEditUI();
                        });

                        document.getElementById('eventsEditContainer').addEventListener('input', (e) => {
                            const idx = parseInt(e.target.dataset.idx);
                            if (isNaN(idx)) return;
                            if (e.target.classList.contains('evt-label')) {
                                editEvents[idx].label = e.target.value;
                            } else if (e.target.classList.contains('evt-name')) {
                                editEvents[idx].name = e.target.value;
                            } else if (e.target.classList.contains('evt-coins')) {
                                editEvents[idx].coins = parseInt(e.target.value) || 0;
                            }
                        });

                        function removeEditEvent(index) {
                            editEvents.splice(index, 1);
                            updateEventsEditUI();
                        }

                        // ========= SECRET KEY FUNCTIONS =========
                        function copySecret() {
                            const secret = document.getElementById('f_secret_key').textContent;
                            navigator.clipboard.writeText(secret).then(() => {
                                alert('Secret key copied!');
                            });
                        }

                        function regenerateSecret() {
                            if (confirm('Are you sure you want to regenerate the secret key? Advertisers will need the new key.')) {
                                // Mark that we want to regenerate
                                document.getElementById('f_secret_key_input').value = '__REGENERATE__';
                                // Show loading state
                                document.getElementById('f_secret_key').textContent = 'Regenerating...';
                            }
                        }

                        // IST Date Helper
                        function getISTDateString(daysAgo = 0) {
                            const now = new Date();
                            now.setDate(now.getDate() - daysAgo);
                            return now.toLocaleDateString('en-CA', { timeZone: 'Asia/Kolkata' });
                        }

                        async function openStats(offerId) {
                            const backdrop = document.getElementById('statsBackdrop');
                            const convEl = document.getElementById('s_conversions');
                            const revEl = document.getElementById('s_revenue');
                            const startInput = document.getElementById('statsStart');
                            const endInput = document.getElementById('statsEnd');
                            const offerMeta = document.getElementById('statsOfferMeta');

                            if (!backdrop || !convEl || !revEl || !startInput || !endInput || !offerMeta) {
                                return;
                            }

                            activeStatsOfferId = String(offerId || '').trim();
                            offerMeta.textContent = `Offer ID: ${activeStatsOfferId || '-'}`;
                            if (!startInput.value) startInput.value = getISTDateString(7);
                            if (!endInput.value) endInput.value = getISTDateString(0);

                            backdrop.classList.add('show');
                            switchPerfTab('stats');
                        }

                        let currentPerfTab = 'stats';

                        function switchPerfTab(tabName) {
                            currentPerfTab = tabName;
                            ['stats', 'pending', 'completed'].forEach(t => {
                                const btn = document.getElementById(`tab_btn_${t}`);
                                const content = document.getElementById(`perf_tab_content_${t}`);
                                if (btn && content) {
                                    if (t === tabName) {
                                        btn.style.color = '#9333ea';
                                        btn.style.borderBottom = '2px solid #9333ea';
                                        btn.style.fontWeight = '700';
                                        content.style.display = 'block';
                                    } else {
                                        btn.style.color = '#64748b';
                                        btn.style.borderBottom = '2px solid transparent';
                                        btn.style.fontWeight = '600';
                                        content.style.display = 'none';
                                    }
                                }
                            });
                            refreshActiveStatsTab();
                        }

                        async function refreshActiveStatsTab() {
                            if (currentPerfTab === 'stats') {
                                await reloadDailyTaskStats();
                            } else if (currentPerfTab === 'pending') {
                                await loadPendingScreenshots();
                            } else if (currentPerfTab === 'completed') {
                                await loadCompletedConversions();
                            }
                        }

                        function formatImageUrl(rawUrl) {
                            if (!rawUrl) return '';
                            let url = String(rawUrl).trim();
                            if (url.includes('/uploads/screenshots/')) {
                                return url.substring(url.indexOf('/uploads/screenshots/'));
                            }
                            return url;
                        }

                        function openLightboxModal(rawImgUrl, e) {
                            if (e && typeof e.stopPropagation === 'function') {
                                e.stopPropagation();
                            }
                            const modal = document.getElementById('imageLightboxModal');
                            const img = document.getElementById('lightboxImg');
                            const dl = document.getElementById('lightboxDownloadBtn');
                            const cleanUrl = formatImageUrl(rawImgUrl);
                            if (modal && img) {
                                img.src = cleanUrl;
                                if (dl) dl.href = cleanUrl;
                                modal.classList.add('show');
                            }
                        }

                        function closeLightboxModal() {
                            const modal = document.getElementById('imageLightboxModal');
                            if (modal) modal.classList.remove('show');
                        }

                        async function loadPendingScreenshots() {
                            const container = document.getElementById('pendingScreenshotsContainer');
                            const badge = document.getElementById('pending_badge_count');
                            if (!container) return;
                            container.innerHTML = '<p style="text-align: center; color: #64748b; font-size: 13px;">Loading pending screenshot submissions...</p>';
                            
                            const start = String(document.getElementById('statsStart')?.value || '').trim();
                            const end = String(document.getElementById('statsEnd')?.value || '').trim();
                            const searchUserId = String(document.getElementById('statsUserId')?.value || '').trim();

                            try {
                                let url = `/admin/screenshot-proofs?status=pending`;
                                if (activeStatsOfferId) url += `&offerId=${encodeURIComponent(activeStatsOfferId)}`;
                                if (searchUserId) url += `&userId=${encodeURIComponent(searchUserId)}`;
                                if (start && end) url += `&start=${encodeURIComponent(start)}&end=${encodeURIComponent(end)}`;

                                const res = await fetch(url);
                                const json = await res.json();
                                if (!res.ok || !json.success) {
                                    container.innerHTML = '<p style="text-align: center; color: #ef4444; font-size: 13px;">Failed to load screenshot proofs</p>';
                                    return;
                                }

                                const proofs = json.proofs || [];
                                if (badge) {
                                    badge.textContent = proofs.length;
                                    badge.style.display = proofs.length > 0 ? 'inline-block' : 'none';
                                }

                                if (!proofs.length) {
                                    container.innerHTML = '<p style="text-align: center; color: #64748b; font-size: 13px; margin: 12px 0;">No pending screenshot verifications.</p>';
                                    return;
                                }

                                let html = `
                                    <table style="width: 100%; border-collapse: collapse; font-size: 12px; text-align: left;">
                                        <thead>
                                            <tr style="border-bottom: 1px solid #cbd5e1; color: #475569;">
                                                <th style="padding: 8px;">User ID</th>
                                                <th style="padding: 8px;">Offer</th>
                                                <th style="padding: 8px;">Screenshot Proof</th>
                                                <th style="padding: 8px;">Date</th>
                                                <th style="padding: 8px; text-align: right;">Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                `;

                                proofs.forEach(p => {
                                    const cleanUrl = formatImageUrl(p.imageUrl);
                                    const offerTitle = (p.offerName || p.offerId).replace(/'/g, "\\'");
                                    html += `
                                        <tr style="border-bottom: 1px solid #f1f5f9;">
                                            <td style="padding: 10px 8px; font-weight: 600; color: #1e1b4b;">${p.userId}<br><small style="color:#64748b">${p.userEmail || ''}</small></td>
                                            <td style="padding: 10px 8px;">${p.offerName || p.offerId}</td>
                                            <td style="padding: 10px 8px;">
                                                <img src="${cleanUrl}" onclick="openLightboxModal('${cleanUrl}', event)" style="width: 52px; height: 52px; object-fit: cover; border-radius: 8px; border: 2px solid #9333ea; cursor: pointer; box-shadow: 0 2px 6px rgba(0,0,0,0.15);" title="Click to view full image" />
                                            </td>
                                            <td style="padding: 10px 8px; color: #64748b;">${new Date(p.createdAt).toLocaleString('en-IN')}</td>
                                            <td style="padding: 10px 8px; text-align: right;">
                                                <button type="button" onclick="approveScreenshotProof('${p._id}', '${p.userId}', '${offerTitle}', ${p.coins || 0})" style="background: linear-gradient(135deg, #10b981, #059669); color: white; border: none; padding: 6px 14px; border-radius: 8px; cursor: pointer; font-weight: 700; font-size: 12px; margin-right: 6px; box-shadow: 0 2px 6px rgba(16, 185, 129, 0.3); transition: all 0.2s;">Approve</button>
                                                <button type="button" onclick="rejectScreenshotProof('${p._id}', '${p.userId}', '${offerTitle}')" style="background: linear-gradient(135deg, #ef4444, #dc2626); color: white; border: none; padding: 6px 14px; border-radius: 8px; cursor: pointer; font-weight: 700; font-size: 12px; box-shadow: 0 2px 6px rgba(239, 68, 68, 0.3); transition: all 0.2s;">Reject</button>
                                            </td>
                                        </tr>
                                    `;
                                });

                                html += `</tbody></table>`;
                                container.innerHTML = html;
                            } catch (err) {
                                console.error(err);
                                container.innerHTML = '<p style="text-align: center; color: #ef4444; font-size: 13px;">Error loading screenshot proofs</p>';
                            }
                        }

                        async function loadCompletedConversions() {
                            const container = document.getElementById('completedConversionsContainer');
                            const badge = document.getElementById('completed_badge_count');
                            if (!container) return;
                            container.innerHTML = '<p style="text-align: center; color: #64748b; font-size: 13px;">Loading completed conversions...</p>';

                            const start = String(document.getElementById('statsStart')?.value || '').trim();
                            const end = String(document.getElementById('statsEnd')?.value || '').trim();
                            const searchUserId = String(document.getElementById('statsUserId')?.value || '').trim();

                            try {
                                let url = `/admin/task-completed-conversions?`;
                                if (activeStatsOfferId) url += `offerId=${encodeURIComponent(activeStatsOfferId)}&`;
                                if (searchUserId) url += `userId=${encodeURIComponent(searchUserId)}&`;
                                if (start && end) url += `start=${encodeURIComponent(start)}&end=${encodeURIComponent(end)}`;

                                const res = await fetch(url);
                                const json = await res.json();
                                if (!res.ok || !json.success) {
                                    container.innerHTML = '<p style="text-align: center; color: #ef4444; font-size: 13px;">Failed to load completed conversions</p>';
                                    return;
                                }

                                const logs = json.logs || [];
                                if (badge) {
                                    badge.textContent = logs.length;
                                    badge.style.display = logs.length > 0 ? 'inline-block' : 'none';
                                }

                                if (!logs.length) {
                                    container.innerHTML = '<p style="text-align: center; color: #64748b; font-size: 13px; margin: 12px 0;">No completed conversions found for this period.</p>';
                                    return;
                                }

                                let html = `
                                    <table style="width: 100%; border-collapse: collapse; font-size: 12px; text-align: left;">
                                        <thead>
                                            <tr style="border-bottom: 1px solid #cbd5e1; color: #475569;">
                                                <th style="padding: 8px;">User ID</th>
                                                <th style="padding: 8px;">Offer / Step</th>
                                                <th style="padding: 8px;">Coins Earned</th>
                                                <th style="padding: 8px;">Completed Date</th>
                                                <th style="padding: 8px;">Source</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                `;

                                logs.forEach(l => {
                                    html += `
                                        <tr style="border-bottom: 1px solid #f1f5f9;">
                                            <td style="padding: 8px; font-weight: 600; color: #1e1b4b;">${l.userId}</td>
                                            <td style="padding: 8px;">${l.offerId} ${l.eventId ? '(' + l.eventId + ')' : ''}</td>
                                            <td style="padding: 8px; font-weight: 700; color: #10b981;">+${l.coins || l.payout || 0} Coins</td>
                                            <td style="padding: 8px; color: #64748b;">${new Date(l.completedAt || l.createdAt).toLocaleString('en-IN')}</td>
                                            <td style="padding: 8px;"><span style="background: #e0e7ff; color: #4338ca; padding: 2px 8px; border-radius: 6px; font-size: 11px; font-weight: 600;">${l.ipAddress || 'POSTBACK'}</span></td>
                                        </tr>
                                    `;
                                });

                                html += `</tbody></table>`;
                                container.innerHTML = html;
                            } catch (err) {
                                console.error(err);
                                container.innerHTML = '<p style="text-align: center; color: #ef4444; font-size: 13px;">Error loading completed conversions</p>';
                            }
                        }

                        let pendingApproveId = null;
                        let pendingRejectId = null;

                        function approveScreenshotProof(id, userId, offerName, coins) {
                            pendingApproveId = id;
                            const modal = document.getElementById('approveProofModal');
                            const subtext = document.getElementById('approveModalSubtext');
                            if (subtext) {
                                subtext.innerHTML = `Are you sure you want to approve submission for <b>User ${userId}</b> (Offer: ${offerName})?<br><span style="color: #10b981; font-weight: 700; display: inline-block; margin-top: 6px;">Coins to credit: ${coins || 'Offer Coins'}</span>`;
                            }
                            if (modal) modal.classList.add('show');
                        }

                        function closeApproveModal() {
                            pendingApproveId = null;
                            const modal = document.getElementById('approveProofModal');
                            if (modal) modal.classList.remove('show');
                        }

                        async function submitApproveProof() {
                            if (!pendingApproveId) return;
                            const btn = document.getElementById('confirmApproveBtn');
                            if (btn) { btn.disabled = true; btn.textContent = 'Approving...'; }
                            try {
                                const res = await fetch(`/admin/approve-task-screenshot/${pendingApproveId}`, { method: 'POST' });
                                const json = await res.json();
                                closeApproveModal();
                                if (res.ok && json.success) {
                                    alert(json.message || 'Proof approved & coins credited!');
                                    await loadPendingScreenshots();
                                    await loadCompletedConversions();
                                } else {
                                    alert(json.message || 'Failed to approve proof');
                                }
                            } catch (err) {
                                alert('Server error approving proof');
                            } finally {
                                if (btn) { btn.disabled = false; btn.textContent = 'Confirm Approve'; }
                            }
                        }

                        function rejectScreenshotProof(id, userId, offerName) {
                            pendingRejectId = id;
                            const input = document.getElementById('rejectReasonInput');
                            if (input) input.value = '';
                            const modal = document.getElementById('rejectProofModal');
                            if (modal) modal.classList.add('show');
                        }

                        function closeRejectModal() {
                            pendingRejectId = null;
                            const modal = document.getElementById('rejectProofModal');
                            if (modal) modal.classList.remove('show');
                        }

                        async function submitRejectProof(mode) {
                            if (!pendingRejectId) return;
                            const input = document.getElementById('rejectReasonInput');
                            const reason = String(input?.value || 'Invalid proof submission').trim();
                            const normalBtn = document.getElementById('rejectReuploadBtn');
                            const finalBtn = document.getElementById('rejectFinalBtn');
                            if (normalBtn) normalBtn.disabled = true;
                            if (finalBtn) finalBtn.disabled = true;

                            try {
                                const res = await fetch(`/admin/reject-task-screenshot/${pendingRejectId}`, {
                                    method: 'POST',
                                    headers: { 'Content-Type': 'application/json' },
                                    body: JSON.stringify({ reason, mode: mode || 'normal' })
                                });
                                const json = await res.json();
                                closeRejectModal();
                                if (res.ok && json.success) {
                                    alert(json.message || 'Proof rejection updated!');
                                    await loadPendingScreenshots();
                                    await loadCompletedConversions();
                                } else {
                                    alert(json.message || 'Failed to reject proof');
                                }
                            } catch (err) {
                                alert('Server error rejecting proof');
                            } finally {
                                if (normalBtn) normalBtn.disabled = false;
                                if (finalBtn) finalBtn.disabled = false;
                            }
                        }

                        async function reloadDailyTaskStats() {
                            const convEl = document.getElementById('s_conversions');
                            const revEl = document.getElementById('s_revenue');
                            const start = String(document.getElementById('statsStart')?.value || '').trim();
                            const end = String(document.getElementById('statsEnd')?.value || '').trim();

                            if (!convEl || !revEl) return;
                            if (!activeStatsOfferId) return;
                            if (!start || !end) {
                                window.alert('Please select start and end date.');
                                return;
                            }
                            if (start > end) {
                                window.alert('Start date cannot be greater than end date.');
                                return;
                            }

                            convEl.textContent = '...';
                            revEl.textContent = '...';

                            try {
                                const res = await fetch('/daily-task-stats', {
                                    method: 'POST',
                                    headers: { 'Content-Type': 'application/json' },
                                    body: JSON.stringify({
                                        offerIds: [activeStatsOfferId],
                                        start: start,
                                        end: end,
                                    }),
                                });
                                const json = await res.json();
                                if (!res.ok || !json.success) {
                                    throw new Error(json.message || 'Failed to load stats');
                                }
                                const totalCount = Number(json.totals?.count || 0);
                                const totalPayout = Number(json.totals?.payout || 0);
                                convEl.textContent = totalCount.toLocaleString('en-IN');
                                revEl.textContent = `${totalPayout.toLocaleString('en-IN', { maximumFractionDigits: 2 })}`;
                                updateChart(Array.isArray(json.graphData) ? json.graphData : []);
                            } catch (e) {
                                convEl.textContent = '0';
                                revEl.textContent = '0';
                                updateChart([]);
                                window.alert(e.message || 'Failed to fetch stats');
                            }
                        }

                        let perfChart = null; // Global variable to store the chart instance

                        function updateChart(data) {
                            const ctx = document.getElementById('perfChart').getContext('2d');

                            // Check if perfChart is a valid Chart.js instance before calling destroy
                            if (perfChart && typeof perfChart.destroy === 'function') {
                                perfChart.destroy();
                            }

                            const points = Array.isArray(data) ? data : [];
                            if (!points.length) {
                                perfChart = new Chart(ctx, {
                                    type: 'line',
                                    data: { labels: [], datasets: [] },
                                    options: {
                                        responsive: true,
                                        maintainAspectRatio: false,
                                        plugins: { legend: { display: false } },
                                        scales: { y: { beginAtZero: true } },
                                    },
                                });
                                return;
                            }

                            perfChart = new Chart(ctx, {
                                type: 'line',
                                data: {
                                    labels: points.map(d => d.date),
                                    datasets: [{
                                        label: 'Conversions',
                                        data: points.map(d => Number(d.count) || 0),
                                        borderColor: '#052e1f',
                                        backgroundColor: 'rgba(5, 46, 31, 0.1)',
                                        fill: true,
                                        tension: 0.4,
                                        borderWidth: 3,
                                        pointRadius: 4,
                                        pointBackgroundColor: '#052e1f'
                                    }]
                                },
                                options: {
                                    responsive: true,
                                    maintainAspectRatio: false,
                                    plugins: {
                                        legend: { display: false },
                                        tooltip: {
                                            mode: 'index',
                                            intersect: false,
                                            backgroundColor: '#1e293b',
                                            titleColor: '#fff',
                                            bodyColor: '#fff',
                                            padding: 10,
                                            cornerRadius: 8
                                        }
                                    },
                                    scales: {
                                        y: {
                                            beginAtZero: true,
                                            grid: { color: '#f1f5f9' },
                                            ticks: { font: { size: 11 } }
                                        },
                                        x: {
                                            grid: { display: false },
                                            ticks: { font: { size: 11 } }
                                        }
                                    }
                                }
                            });
                        }

                        function closeModals() {
                            document.querySelectorAll('.backdrop').forEach(b => b.classList.remove('show'));
                        }

                        function closeAll() { document.querySelectorAll('.backdrop').forEach(b => b.classList.remove('show')); }

                        function updateEditFormFieldsVisibility() {
                            const offerType = document.getElementById('f_type').value;
                            const trackingTimeGroup = document.getElementById('f_tracking_time_group');
                            const colorGroup = document.getElementById('f_color_group');
                            const packageToggleGroup = document.getElementById('f_package_toggle_group');
                            const timerToggleGroup = document.getElementById('f_timer_toggle_group');
                            const multiEventToggleGroup = document.getElementById('f_multi_event_toggle_group');
                            const videoVerificationToggleGroup = document.getElementById('f_video_verification_toggle_group');
                            const videoVerificationEnabledToggle = document.getElementById('f_video_verification_enabled');
                            const videoVerificationIdGroup = document.getElementById('f_video_verification_id_group');
                            const perUserDailyCapGroup = document.getElementById('f_per_user_daily_cap_group');

                            const fMethodGroup = document.getElementById('f_daily_task_method_group');
                            const fMethodSelect = document.getElementById('f_daily_task_method_select');
                            const isDailyTask = offerType === 'DailyTask';

                            if (isDailyTask) {
                                if (fMethodGroup) fMethodGroup.style.display = 'block';
                            } else {
                                if (fMethodGroup) fMethodGroup.style.display = 'none';
                            }

                            if (offerType === 'WatchEarn') {
                                if (multiEventToggleGroup) multiEventToggleGroup.style.display = 'none';
                                if (timerToggleGroup) timerToggleGroup.style.display = 'none';
                                if (packageToggleGroup) packageToggleGroup.style.display = 'none';
                                if (colorGroup) colorGroup.style.display = 'none';

                                const descStepsGrp = document.getElementById('f_description_steps_group');
                                const coinsGrp = document.getElementById('f_coins_group');
                                const payoutInput = document.getElementById('f_payout');
                                if (descStepsGrp) descStepsGrp.style.display = 'block';
                                if (coinsGrp) coinsGrp.style.display = 'block';
                                if (payoutInput) payoutInput.setAttribute('required', 'required');

                                document.getElementById('f_package_name_group').style.display = 'none';
                                document.getElementById('f_timer_duration_group').style.display = 'none';
                                document.getElementById('f_daily_reward_toggle_group').style.display = 'none';
                                document.getElementById('f_daily_rewards_section').style.display = 'none';
                                document.getElementById('f_multi_event_group').style.display = 'none';

                                if (trackingTimeGroup) trackingTimeGroup.style.display = 'block';

                                if (videoVerificationToggleGroup) videoVerificationToggleGroup.style.display = 'flex';
                                if (perUserDailyCapGroup) perUserDailyCapGroup.style.display = 'block';
                                if (videoVerificationEnabledToggle && videoVerificationEnabledToggle.checked) {
                                    if (videoVerificationIdGroup) videoVerificationIdGroup.style.display = 'block';
                                } else {
                                    if (videoVerificationIdGroup) videoVerificationIdGroup.style.display = 'none';
                                }
                            } else {
                                if (colorGroup) colorGroup.style.display = 'block';
                                if (trackingTimeGroup) trackingTimeGroup.style.display = 'none';

                                if (videoVerificationToggleGroup) videoVerificationToggleGroup.style.display = 'none';
                                if (videoVerificationIdGroup) videoVerificationIdGroup.style.display = 'none';
                                if (perUserDailyCapGroup) perUserDailyCapGroup.style.display = 'none';

                                const method = fMethodSelect ? fMethodSelect.value : 'SingleEvent';
                                const isStrictMulti = (method === 'MultiEvent' || method === 'MultiTimer' || method === 'MultiPackage');
                                const isAll = (method === 'All');
                                const isScreenshot = (method === 'Screenshot');
                                const showPackage = (method === 'MultiPackage' || method === 'All' || method === 'Package' || method === 'PackageTimer');
                                const showTimer = (method === 'MultiTimer' || method === 'All' || method === 'PackageTimer');

                                const descStepsGrp = document.getElementById('f_description_steps_group');
                                const coinsGrp = document.getElementById('f_coins_group');
                                const payoutInput = document.getElementById('f_payout');
                                const multiHeading = document.getElementById('f_multi_event_heading');
                                const screenshotGroup = document.getElementById('f_screenshot_group');
                                const screenshotToggle = document.getElementById('f_screenshot_verification');

                                if (screenshotGroup) {
                                    screenshotGroup.style.display = isScreenshot ? 'block' : 'none';
                                }
                                if (!isScreenshot && screenshotToggle) {
                                    screenshotToggle.checked = false;
                                }

                                if (isStrictMulti) {
                                    if (descStepsGrp) descStepsGrp.style.display = 'none';
                                    if (coinsGrp) coinsGrp.style.display = 'none';
                                    if (payoutInput) payoutInput.removeAttribute('required');
                                    if (multiHeading) multiHeading.innerHTML = 'Multi-Events <span style="color:#ef4444;">* (Required)</span>';
                                } else {
                                    if (descStepsGrp) descStepsGrp.style.display = 'block';
                                    if (coinsGrp) coinsGrp.style.display = 'block';
                                    if (payoutInput) payoutInput.setAttribute('required', 'required');
                                    if (multiHeading) multiHeading.textContent = 'Multi-Events (Optional)';
                                }

                                if (multiEventToggleGroup) multiEventToggleGroup.style.display = (isStrictMulti || isAll) ? 'block' : 'none';
                                if (packageToggleGroup) packageToggleGroup.style.display = showPackage ? 'block' : 'none';
                                if (timerToggleGroup) timerToggleGroup.style.display = showTimer ? 'block' : 'none';

                                if (isStrictMulti) {
                                    document.getElementById('f_multi_event_enabled').checked = true;
                                    document.getElementById('f_multi_event_group').style.display = 'block';
                                } else if (isAll) {
                                    document.getElementById('f_multi_event_group').style.display = document.getElementById('f_multi_event_enabled').checked ? 'block' : 'none';
                                } else {
                                    document.getElementById('f_multi_event_enabled').checked = false;
                                    document.getElementById('f_multi_event_group').style.display = 'none';
                                }

                                if (showPackage) {
                                    document.getElementById('f_package_name_group').style.display = document.getElementById('f_package_enabled').checked ? 'block' : 'none';
                                } else {
                                    document.getElementById('f_package_enabled').checked = false;
                                    document.getElementById('f_package_name_group').style.display = 'none';
                                }

                                if (showTimer) {
                                    if (document.getElementById('f_timer_enabled').checked) {
                                        document.getElementById('f_daily_reward_toggle_group').style.display = 'flex';
                                        if (document.getElementById('f_daily_reward_enabled').checked) {
                                            document.getElementById('f_daily_rewards_section').style.display = 'block';
                                            document.getElementById('f_timer_duration_group').style.display = 'none';
                                        } else {
                                            document.getElementById('f_daily_rewards_section').style.display = 'none';
                                            document.getElementById('f_timer_duration_group').style.display = 'block';
                                        }
                                    } else {
                                        document.getElementById('f_daily_reward_toggle_group').style.display = 'flex';
                                        document.getElementById('f_timer_duration_group').style.display = 'none';
                                        document.getElementById('f_daily_rewards_section').style.display = 'none';
                                    }
                                } else {
                                    document.getElementById('f_timer_enabled').checked = false;
                                    document.getElementById('f_daily_reward_toggle_group').style.display = 'none';
                                    document.getElementById('f_timer_duration_group').style.display = 'none';
                                    document.getElementById('f_daily_rewards_section').style.display = 'none';
                                }
                            }
                        }

                        function getEditDailyTaskMethod() {
                            const sel = document.getElementById('f_daily_task_method_select');
                            return sel ? sel.value : 'SingleEvent';
                        }

                        document.getElementById('f_daily_task_method_select').addEventListener('change', () => {
                            const method = getEditDailyTaskMethod();
                            const isStrictMulti = (method === 'MultiEvent' || method === 'MultiTimer' || method === 'MultiPackage');
                            const isAll = (method === 'All');
                            const isScreenshot = (method === 'Screenshot');
                            const showPackage = (method === 'MultiPackage' || method === 'All' || method === 'Package' || method === 'PackageTimer');
                            const showTimer = (method === 'MultiTimer' || method === 'All' || method === 'PackageTimer');

                            if (isStrictMulti) {
                                document.getElementById('f_multi_event_enabled').checked = true;
                            } else if (isAll) {
                                const hasEvts = Array.isArray(editEvents) && editEvents.length > 0;
                                document.getElementById('f_multi_event_enabled').checked = hasEvts;
                            } else {
                                document.getElementById('f_multi_event_enabled').checked = false;
                            }

                            if (showPackage) {
                                document.getElementById('f_package_enabled').checked = true;
                            } else {
                                document.getElementById('f_package_enabled').checked = false;
                            }

                            if (showTimer) {
                                document.getElementById('f_timer_enabled').checked = true;
                            } else {
                                document.getElementById('f_timer_enabled').checked = false;
                            }

                            const sCheck = document.getElementById('f_screenshot_verification');
                            if (isScreenshot && sCheck) {
                                sCheck.checked = true;
                            } else if (sCheck) {
                                sCheck.checked = false;
                            }

                            updateEditFormFieldsVisibility();
                            updateEditRedirRequiredState();
                            if (typeof syncAllEditToggleVisuals === 'function') {
                                syncAllEditToggleVisuals();
                            }
                        });

                        async function saveEditTask(e) {
                            if (e && typeof e.preventDefault === 'function') {
                                e.preventDefault();
                            }
                            const saveBtn = document.getElementById('btnSaveAllChanges') || document.querySelector('button[form="editForm"]');
                            const originalBtnHtml = saveBtn ? saveBtn.innerHTML : '<i class="fa-solid fa-floppy-disk" style="margin-right: 6px;"></i>Save All Changes';

                            const id = document.getElementById('f_id').value;
                            if (!id) {
                                alert('❌ Offer ID is missing.');
                                return;
                            }

                            const offerName = document.getElementById('f_name').value.trim();
                            if (!offerName) {
                                alert('❌ Offer Name is required.');
                                document.getElementById('f_name').focus();
                                return;
                            }

                            const packageEnabled = document.getElementById('f_package_enabled').checked;
                            const multiEventEnabled = document.getElementById('f_multi_event_enabled').checked;
                            const timerEnabled = document.getElementById('f_timer_enabled').checked;
                            const dailyRewardEnabled = timerEnabled && document.getElementById('f_daily_reward_enabled').checked;
                            const packageName = document.getElementById('f_package_name').value.trim();
                            const timerDurationMinutes = Number(document.getElementById('f_timer_duration').value) || 0;
                            const redirectionUrl = document.getElementById('f_redir').value.trim();
                            const offerType = document.getElementById('f_type').value;
                            const videoVerificationEnabled = offerType === 'WatchEarn' && document.getElementById('f_video_verification_enabled').checked;
                            const videoVerificationId = offerType === 'WatchEarn' ? document.getElementById('f_video_verification_id').value.trim() : '';

                            const method = getEditDailyTaskMethod();
                            const isStrictMultiMethod = (method === 'MultiEvent' || method === 'MultiTimer' || method === 'MultiPackage');
                            const isScreenshot = (method === 'Screenshot');

                            if (packageEnabled && !packageName) {
                                alert('❌ Package Name / App Package ID is required when Package verification is ON.');
                                document.getElementById('f_package_name').focus();
                                return;
                            }

                            if (videoVerificationEnabled && !videoVerificationId) {
                                alert('❌ Video Verification ID is required when Video Verification is ON.');
                                document.getElementById('f_video_verification_id').focus();
                                return;
                            }

                            if (timerEnabled && !dailyRewardEnabled && timerDurationMinutes <= 0) {
                                alert('❌ Timer Duration must be a positive number of minutes when Timer is ON.');
                                document.getElementById('f_timer_duration').focus();
                                return;
                            }

                            const isRedirOptional = packageEnabled || multiEventEnabled || isStrictMultiMethod;
                            if (!isRedirOptional && !redirectionUrl) {
                                alert('❌ Redirection URL is required.');
                                document.getElementById('f_redir').focus();
                                return;
                            }

                            let dailyRewardsData = [];
                            if (dailyRewardEnabled) {
                                dailyRewardsData = fDailyRewards.map(r => ({
                                    day: r.day,
                                    timerDuration: (Number(r.timerDurationMinutes) || 0) * 60,
                                    coins: Number(r.coins) || 0
                                }));
                                if (dailyRewardsData.length === 0) {
                                    alert('❌ Please add at least one step for Daily Reward Mode.');
                                    return;
                                }
                                for (const r of dailyRewardsData) {
                                    if (r.timerDuration <= 0 || r.coins <= 0) {
                                        alert('❌ Duration and Coins for all Daily Steps must be greater than zero.');
                                        return;
                                    }
                                }
                            }

                            let finalPayout = Number(document.getElementById('f_payout').value) || 0;
                            let finalEvents = [];

                            if (multiEventEnabled || isStrictMultiMethod) {
                                // Extract events directly from DOM items to guarantee latest edits
                                const eventRows = document.querySelectorAll('#eventsEditContainer .event-edit-item');
                                if (eventRows.length > 0) {
                                    finalEvents = Array.from(eventRows).map((row, i) => {
                                        const originalEvt = editEvents[i] || {};
                                        const label = row.querySelector('.evt-label')?.value.trim() || originalEvt.label || '';
                                        const name = row.querySelector('.evt-name')?.value.trim() || originalEvt.name || `Event ${i + 1}`;
                                        const coins = Number(row.querySelector('.evt-coins')?.value) || Number(originalEvt.coins) || 0;
                                        return {
                                            eventId: originalEvt.eventId || `event_${i + 1}`,
                                            name: name,
                                            label: label,
                                            coins: coins
                                        };
                                    }).filter(e => e.name || e.label || e.coins > 0);
                                } else if (editEvents && editEvents.length > 0) {
                                    finalEvents = editEvents.map((e, i) => ({
                                        eventId: e.eventId || `event_${i + 1}`,
                                        name: e.name || `Event ${i + 1}`,
                                        label: e.label || '',
                                        coins: Number(e.coins) || 0
                                    }));
                                }

                                if (isStrictMultiMethod) {
                                    if (!finalEvents || finalEvents.length === 0) {
                                        alert('❌ Please add at least one event in Multi-Events.');
                                        return;
                                    }
                                }

                                if (finalEvents && finalEvents.length > 0) {
                                    const sumCoins = finalEvents.reduce((sum, e) => sum + (Number(e.coins) || 0), 0);
                                    if (sumCoins <= 0) {
                                        alert('❌ Total coins for Multi-Events must be greater than zero.');
                                        return;
                                    }
                                    finalPayout = sumCoins;
                                } else {
                                    finalEvents = [];
                                    if (finalPayout <= 0) {
                                        alert('❌ Coins (Reward Coins) is required and must be greater than zero.');
                                        document.getElementById('f_payout').focus();
                                        return;
                                    }
                                }
                            } else {
                                finalEvents = [];
                                if (finalPayout <= 0) {
                                    alert('❌ Coins (Reward Coins) is required and must be greater than zero.');
                                    document.getElementById('f_payout').focus();
                                    return;
                                }
                            }

                            let finalOfferDesc = Array.from(document.querySelectorAll('#descContainer .desc-step-row'))
                                .map(row => {
                                    const title = row.querySelector('.desc-step-title')?.value.trim() || '';
                                    const sub = row.querySelector('.desc-step-subtitle')?.value.trim() || '';
                                    if (!title && !sub) return null;
                                    if (sub) return `${title}:::${sub}`;
                                    return title;
                                })
                                .filter(Boolean);

                            if (finalOfferDesc.length === 0) {
                                if (finalEvents.length > 0) {
                                    finalOfferDesc = finalEvents.map(e => e.name || e.label || 'Complete task');
                                } else {
                                    finalOfferDesc = [offerName || 'Complete task to earn rewards'];
                                }
                            }

                            const secretKeyVal = document.getElementById('f_secret_key_input').value.trim();

                            const data = {
                                offerName: offerName,
                                rating: document.getElementById('f_rating') ? document.getElementById('f_rating').value.trim() : '',
                                downloads: document.getElementById('f_downloads') ? document.getElementById('f_downloads').value.trim() : '',
                                payout: finalPayout,
                                coins: finalPayout,
                                trackingTime: Number(document.getElementById('f_tracking_time').value) || 0,
                                color: document.getElementById('f_color') ? document.getElementById('f_color').value.trim() : '#ffffff',
                                offerCategory: document.getElementById('f_category').value,
                                offerType: offerType,
                                imagePath: document.getElementById('f_image').value.trim(),
                                bannerPath: document.getElementById('f_banner').value.trim(),
                                watchTutorial: document.getElementById('f_watch_tutorial').value.trim(),
                                subDescription: document.getElementById('f_sub_description').value.trim(),
                                redirectionUrl: redirectionUrl,
                                packageEnabled: isScreenshot ? false : packageEnabled,
                                packageName: (isScreenshot || !packageEnabled) ? '' : packageName,
                                timerEnabled: isScreenshot ? false : timerEnabled,
                                timerDuration: (isScreenshot || !timerEnabled || dailyRewardEnabled) ? 0 : timerDurationMinutes * 60,
                                dailyRewardEnabled: isScreenshot ? false : dailyRewardEnabled,
                                dailyRewards: isScreenshot ? [] : dailyRewardsData,
                                videoVerificationEnabled: videoVerificationEnabled,
                                videoVerificationId: videoVerificationId,
                                screenshotVerificationEnabled: isScreenshot && document.getElementById('f_screenshot_verification') ? document.getElementById('f_screenshot_verification').checked : false,
                                multiEventEnabled: isScreenshot ? false : (finalEvents.length > 0),
                                dailyCapLimit: Number(document.getElementById('f_daily_cap').value) || null,
                                lifetimeCapLimit: Number(document.getElementById('f_life_cap').value) || null,
                                perUserDailyCap: (offerType === 'WatchEarn' && document.getElementById('f_per_user_daily_cap').value !== '') ? Number(document.getElementById('f_per_user_daily_cap').value) : null,
                                enabled: document.getElementById('f_enabled').value === 'true',
                                offerDescription: finalOfferDesc,
                                offerDisclaimer: Array.from(document.querySelectorAll('#disclaimerContainer input'))
                                    .map(i => i.value.trim())
                                    .filter(Boolean),
                                dailyReset: (!isScreenshot && finalEvents.length > 0) ? document.getElementById('f_daily_reset').checked : false,
                                events: isScreenshot ? [] : finalEvents,
                                secretKey: secretKeyVal === 'Not Generated' ? '' : secretKeyVal,
                                regenerateSecret: secretKeyVal === '__REGENERATE__',
                            };

                            // Instant button saving state
                            if (saveBtn) {
                                saveBtn.disabled = true;
                                saveBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin" style="margin-right: 6px;"></i>Saving...';
                                saveBtn.style.opacity = '0.85';
                                saveBtn.style.pointerEvents = 'none';
                            }

                            try {
                                const res = await fetch(`/daily-task/${id}`, {
                                    method: 'PATCH',
                                    headers: { 'Content-Type': 'application/json' },
                                    body: JSON.stringify(data)
                                });
                                const json = await res.json();
                                if (res.ok && json.success) {
                                    if (saveBtn) {
                                        saveBtn.innerHTML = '<i class="fa-solid fa-circle-check" style="margin-right: 6px;"></i>Saved!';
                                        saveBtn.style.background = '#10b981';
                                        saveBtn.style.borderColor = '#059669';
                                        saveBtn.style.opacity = '1';
                                    }
                                    setTimeout(() => {
                                        location.reload();
                                    }, 350);
                                } else {
                                    if (saveBtn) {
                                        saveBtn.disabled = false;
                                        saveBtn.innerHTML = originalBtnHtml;
                                        saveBtn.style.opacity = '1';
                                        saveBtn.style.pointerEvents = 'auto';
                                        saveBtn.style.background = '';
                                        saveBtn.style.borderColor = '';
                                    }
                                    alert(json.message || '❌ Failed to update offer.');
                                }
                            } catch (err) {
                                console.error('Save error:', err);
                                if (saveBtn) {
                                    saveBtn.disabled = false;
                                    saveBtn.innerHTML = originalBtnHtml;
                                    saveBtn.style.opacity = '1';
                                    saveBtn.style.pointerEvents = 'auto';
                                    saveBtn.style.background = '';
                                    saveBtn.style.borderColor = '';
                                }
                                alert('❌ Network error while saving. Please try again.');
                            }
                        }

                        window.saveEditTask = saveEditTask;
                        document.getElementById('editForm').onsubmit = saveEditTask;

                        function updateEditRedirRequiredState() {
                            const packageEnabled = document.getElementById('f_package_enabled').checked;
                            const multiEventEnabled = document.getElementById('f_multi_event_enabled').checked;
                            if (packageEnabled || multiEventEnabled) {
                                document.getElementById('f_redir_label').textContent = 'Redirection URL (Optional)';
                            } else {
                                document.getElementById('f_redir_label').textContent = 'Redirection URL';
                            }
                        }

                        function syncAllEditToggleVisuals() {
                            function syncSingleToggle(chkId, tagId, wrapId, customOnText, customOffText) {
                                const chk = document.getElementById(chkId);
                                const tag = document.getElementById(tagId);
                                const wrap = document.getElementById(wrapId);
                                if (!chk) return;
                                const isChecked = chk.checked;
                                if (tag) {
                                    tag.textContent = isChecked ? (customOnText || 'ON') : (customOffText || 'OFF');
                                    tag.className = 'toggle-status-tag ' + (isChecked ? 'tag-on' : 'tag-off');
                                }
                                if (wrap) {
                                    if (isChecked) {
                                        wrap.classList.add('active-on');
                                    } else {
                                        wrap.classList.remove('active-on');
                                    }
                                }
                            }
                            syncSingleToggle('f_package_enabled', 'f_package_status_tag', 'f_package_toggle_group');
                            syncSingleToggle('f_timer_enabled', 'f_timer_status_tag', 'f_timer_toggle_group');
                            syncSingleToggle('f_video_verification_enabled', 'f_video_verification_status', 'f_video_verification_toggle_group');
                            syncSingleToggle('f_daily_reward_enabled', 'f_daily_reward_status_tag', 'f_daily_reward_toggle_group');
                            syncSingleToggle('f_multi_event_enabled', 'f_multi_event_status_tag', 'f_multi_event_toggle_group');
                            syncSingleToggle('f_daily_reset', 'f_daily_reset_status_tag', 'f_daily_reset_toggle_group', 'ON (DAILY)', 'OFF (ONE-TIME)');
                            syncSingleToggle('f_screenshot_verification', 'f_screenshot_status_tag', 'f_screenshot_group');
                        }

                        const dResetCheck = document.getElementById('f_daily_reset');
                        if (dResetCheck) {
                            dResetCheck.addEventListener('change', () => {
                                syncAllEditToggleVisuals();
                            });
                        }

                        const sVerifyCheck = document.getElementById('f_screenshot_verification');
                        if (sVerifyCheck) {
                            sVerifyCheck.addEventListener('change', () => {
                                syncAllEditToggleVisuals();
                            });
                        }

                        document.getElementById('f_package_enabled').addEventListener('change', (e) => {
                            document.getElementById('f_package_name_group').style.display = e.target.checked ? 'block' : 'none';
                            updateEditRedirRequiredState();
                            syncAllEditToggleVisuals();
                        });

                        document.getElementById('f_multi_event_enabled').addEventListener('change', (e) => {
                            if (e.target.checked) {
                                document.getElementById('f_multi_event_group').style.display = 'block';
