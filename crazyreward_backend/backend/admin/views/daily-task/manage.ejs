                        });

                        document.getElementById('f_daily_rewards_list').addEventListener('input', (e) => {
                            const index = parseInt(e.target.dataset.index);
                            if (e.target.classList.contains('f-daily-reward-duration')) {
                                fDailyRewards[index].timerDurationMinutes = parseInt(e.target.value) || 0;
                            } else if (e.target.classList.contains('f-daily-reward-coins')) {
                                fDailyRewards[index].coins = parseInt(e.target.value) || 0;
                            }
                        });

                        document.getElementById('f_daily_rewards_list').addEventListener('click', (e) => {
                            if (e.target.classList.contains('remove-f-daily-reward-btn')) {
                                const index = parseInt(e.target.dataset.index);
                                fDailyRewards.splice(index, 1);
                                renderEditDailyRewards();
                            }
                        });

                        // ========= EVENTS EDIT FUNCTIONS =========
