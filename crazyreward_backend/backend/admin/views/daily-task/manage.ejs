                                <button type="button" class="btn-save" onclick="executeModalPostbackTest()"
                                    style="background: linear-gradient(135deg, #052e1f, #0f172a); padding: 10px 24px; border-radius: 10px; color: #fff; font-weight: 700; border: none; cursor: pointer; display: inline-flex; align-items: center; gap: 6px;">
                                    <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor">
