                        <button type="button" id="confirmApproveBtn" onclick="submitApproveProof()" style="flex: 1; padding: 10px; border-radius: 10px; border: none; background: #10b981; color: white; font-weight: 700; font-size: 13px; cursor: pointer; box-shadow: 0 4px 12px rgba(16, 185, 129, 0.3);">Confirm Approve</button>
