                            <button type="button" class="perf-tab-btn active" id="tab_btn_stats" onclick="switchPerfTab('stats')" style="padding: 8px 16px; border: none; background: none; font-weight: 700; font-size: 13px; color: #9333ea; border-bottom: 2px solid #9333ea; cursor: pointer;">
                                Stats Overview
                            </button>
                            <button type="button" class="perf-tab-btn" id="tab_btn_pending" onclick="switchPerfTab('pending')" style="padding: 8px 16px; border: none; background: none; font-weight: 600; font-size: 13px; color: #64748b; border-bottom: 2px solid transparent; cursor: pointer;">
                                Pending Verification <span id="pending_badge_count" style="background: #f59e0b; color: white; border-radius: 10px; padding: 2px 6px; font-size: 11px; margin-left: 4px; display: none;">0</span>
                            </button>
                            <button type="button" class="perf-tab-btn" id="tab_btn_completed" onclick="switchPerfTab('completed')" style="padding: 8px 16px; border: none; background: none; font-weight: 600; font-size: 13px; color: #64748b; border-bottom: 2px solid transparent; cursor: pointer;">
                                Completed Conversions <span id="completed_badge_count" style="background: #10b981; color: white; border-radius: 10px; padding: 2px 6px; font-size: 11px; margin-left: 4px; display: none;">0</span>
                            </button>
                        </div>

                        <!-- TAB 1: STATS OVERVIEW -->
