                        const vCheckEdit = document.getElementById('f_video_verification_enabled');
                        if (vCheckEdit) {
                            vCheckEdit.addEventListener('change', (e) => {
                                document.getElementById('f_video_verification_id_group').style.display = e.target.checked ? 'block' : 'none';
                                syncAllEditToggleVisuals();
                            });
                        }

                        // YouTube Thumbnail Auto-Fetch logic
                        const fRedirInput = document.getElementById('f_redir');
                        const fFetchThumbnailGroup = document.getElementById('f_fetch_thumbnail_group');
                        const fFetchThumbnailBtn = document.getElementById('f_fetch_thumbnail_btn');
                        const fBannerInput = document.getElementById('f_banner');

                        function checkYoutubeUrl(url) {
                            if (!url) return false;
                            const ytRegex = /^(?:https?:\/\/)?(?:www\.|m\.)?(?:youtu\.be\/|youtube\.com\/(?:embed\/|v\/|watch\?v=|watch\?.+&v=|shorts\/))((?:\w|-){11})(?:\S+)?$/;
                            return ytRegex.test(url.trim());
                        }

                        function getYoutubeId(url) {
                            if (!url) return null;
                            const ytRegex = /^(?:https?:\/\/)?(?:www\.|m\.)?(?:youtu\.be\/|youtube\.com\/(?:embed\/|v\/|watch\?v=|watch\?.+&v=|shorts\/))((?:\w|-){11})(?:\S+)?$/;
                            const match = url.trim().match(ytRegex);
                            return match ? match[1] : null;
                        }

                        function updateEditThumbnailButtonVisibility() {
                            if (checkYoutubeUrl(fRedirInput.value)) {
                                fFetchThumbnailGroup.style.display = 'block';
                            } else {
                                fFetchThumbnailGroup.style.display = 'none';
                            }
                        }

                        fRedirInput.addEventListener('input', updateEditThumbnailButtonVisibility);
                        fRedirInput.addEventListener('change', updateEditThumbnailButtonVisibility);

                        fFetchThumbnailBtn.addEventListener('click', () => {
                            const ytId = getYoutubeId(fRedirInput.value);
                            if (ytId) {
                                const thumbnailUrl = `https://img.youtube.com/vi/${ytId}/maxresdefault.jpg`;
                                fBannerInput.value = thumbnailUrl;

                                fBannerInput.style.backgroundColor = '#dcfce7';
                                setTimeout(() => {
                                    fBannerInput.style.backgroundColor = '';
                                }, 1000);
                            }
                        });

                        // -------- TEST POSTBACK MODAL LOGIC --------
                        function openTestModal(targetOfferId) {
                            const backdrop = document.getElementById('testPostbackBackdrop');
                            const select = document.getElementById('modal_test_task_select');

                            // Populate tasks dropdown
                            select.innerHTML = '<option value="">-- Choose Task --</option>';
                            allOffers.forEach(o => {
                                const opt = document.createElement('option');
                                opt.value = o._id;
                                opt.textContent = `${o.offerName || 'Untitled'} (${o.offerId || ''})`;
                                select.appendChild(opt);
                            });

                            // Reset fields
                            document.getElementById('modal_test_offer_id').value = '';
                            document.getElementById('modal_test_secret').value = '';
                            document.getElementById('modal_test_event_select').innerHTML = '';
                            document.getElementById('modal_test_event_group').style.display = 'none';
                            document.getElementById('modal_test_response_box').style.display = 'none';

                            if (targetOfferId) {
                                select.value = targetOfferId;
                                onModalTaskChange();
                            } else {
                                updateModalTestUrlPreview();
                            }

                            backdrop.classList.add('show');
                        }

                        function closeTestModal() {
                            document.getElementById('testPostbackBackdrop').classList.remove('show');
                        }

                        function onModalTaskChange() {
                            const select = document.getElementById('modal_test_task_select');
                            const selectedId = select.value;
                            const target = allOffers.find(x => String(x._id || '') === String(selectedId || ''));

                            const offerIdInput = document.getElementById('modal_test_offer_id');
                            const secretInput = document.getElementById('modal_test_secret');
                            const eventGroup = document.getElementById('modal_test_event_group');
                            const eventSelect = document.getElementById('modal_test_event_select');

                            if (!target) {
                                offerIdInput.value = '';
                                secretInput.value = '';
                                eventGroup.style.display = 'none';
                                updateModalTestUrlPreview();
                                return;
                            }

                            offerIdInput.value = target.offerId || '';
                            secretInput.value = target.secretKey || '';

                            // Check multi-event
                            if (Array.isArray(target.events) && target.events.length > 0) {
                                eventSelect.innerHTML = '';
                                target.events.forEach((ev, idx) => {
                                    const opt = document.createElement('option');
                                    opt.value = ev.eventId || `event_${idx + 1}`;
                                    opt.textContent = `Event ${idx + 1}: ${ev.label || ev.name || 'Event'} (+${ev.coins || 0} Coins) [ID: ${opt.value}]`;
                                    eventSelect.appendChild(opt);
                                });
                                eventGroup.style.display = 'block';
                            } else {
                                eventGroup.style.display = 'none';
                                eventSelect.innerHTML = '';
                            }

                            updateModalTestUrlPreview();
                        }

                        function updateModalTestUrlPreview() {
                            const offerId = document.getElementById('modal_test_offer_id').value.trim() || '{offerId}';
                            const secret = document.getElementById('modal_test_secret').value.trim() || '{secretKey}';
                            const userId = document.getElementById('modal_test_user_id').value.trim() || '{userId}';
                            const eventGroup = document.getElementById('modal_test_event_group');
                            const eventSelect = document.getElementById('modal_test_event_select');

                            let url = `https://crazyreward.zodplaygames.com/cpa-postback?userId=${userId}&appName=crazyreward&offerId=${offerId}&secret=${secret}`;
                            if (eventGroup.style.display !== 'none' && eventSelect.value) {
                                url += `&eventId=${eventSelect.value}`;
                            }

                            document.getElementById('modal_test_url_preview').textContent = url;
                        }

                        function copyModalTestUrl() {
                            const url = document.getElementById('modal_test_url_preview').textContent.trim();
                            navigator.clipboard.writeText(url).then(() => {
                                alert('Postback URL copied to clipboard.');
                            });
                        }

                        async function executeModalPostbackTest() {
                            const offerId = document.getElementById('modal_test_offer_id').value.trim();
                            const secret = document.getElementById('modal_test_secret').value.trim();
                            const userId = document.getElementById('modal_test_user_id').value.trim();
                            const eventGroup = document.getElementById('modal_test_event_group');
                            const eventSelect = document.getElementById('modal_test_event_select');
                            const resBox = document.getElementById('modal_test_response_box');
                            const btnText = document.getElementById('modal_test_btn_text');

                            if (!offerId) {
                                alert('Please select a Daily Task first.');
                                return;
                            }
                            if (!userId) {
                                alert('Please enter a target User ID.');
                                return;
                            }
                            if (!secret) {
                                alert('Please enter or verify the Secret Key.');
                                return;
                            }

                            btnText.textContent = 'Processing...';
                            resBox.style.display = 'none';

                            const queryParams = new URLSearchParams({
                                userId: userId,
                                appName: 'crazyreward',
                                offerId: offerId,
                                secret: secret
                            });
                            if (eventGroup.style.display !== 'none' && eventSelect.value) {
                                queryParams.set('eventId', eventSelect.value);
                            }

                            const testUrl = '/cpa-postback?' + queryParams.toString();

                            try {
                                const response = await fetch(testUrl, { method: 'GET' });
                                const text = await response.text();
                                btnText.textContent = 'Dispatch Postback';
                                resBox.style.display = 'block';

                                if (response.ok && (text === '1' || text.includes('success'))) {
                                    resBox.style.background = '#ecfdf5';
                                    resBox.style.border = '1.5px solid #a7f3d0';
                                    resBox.style.color = '#065f46';
                                    resBox.innerHTML = `<b>SUCCESS (HTTP ${response.status}):</b> Postback verified and processed. Server response: <code>${text}</code>.<br/>Coins credited to User ID <code>${userId}</code>.`;
                                } else {
                                    resBox.style.background = '#fef2f2';
                                    resBox.style.border = '1.5px solid #fecaca';
                                    resBox.style.color = '#991b1b';
                                    resBox.innerHTML = `<b>EXECUTION FAILED (HTTP ${response.status}):</b> Server response: <code>${text}</code>.<br/><small>Please verify that User ID exists, Task is active, and Secret Key is valid.</small>`;
                                }
                            } catch (err) {
                                btnText.textContent = 'Dispatch Postback';
                                resBox.style.display = 'block';
                                resBox.style.background = '#fef2f2';
                                resBox.style.border = '1.5px solid #fecaca';
                                resBox.style.color = '#991b1b';
                                resBox.innerHTML = `<b>ERROR:</b> ${err.message}`;
                            }
                        }

                        async function saveDailyTaskTitle() {
                            const btn = document.getElementById('btnSaveDailyTaskTitle');
                            const input = document.getElementById('dailyTaskTitleInput');
                            const titleVal = input ? input.value.trim() : '';

                            if (btn) {
                                btn.disabled = true;
                                btn.innerText = 'Saving...';
                            }

                            try {
                                const res = await fetch('/update-daily-task-title', {
                                    method: 'POST',
                                    headers: { 'Content-Type': 'application/json' },
                                    body: JSON.stringify({ title: titleVal })
                                });
                                const data = await res.json();
                                if (data.success) {
                                    if (window.showToast) {
                                        showToast('Title saved! Home Screen will show: ' + (data.title || 'Daily Task'), 'success');
                                    } else {
                                        alert('Title saved successfully: ' + (data.title || 'Daily Task'));
                                    }
                                } else {
                                    alert(data.message || 'Failed to save title');
                                }
                            } catch (err) {
                                console.error(err);
                                alert('Server error saving title');
                            } finally {
                                if (btn) {
                                    btn.disabled = false;
                                    btn.innerText = 'Save Title';
                                }
                            }
                        }

                        document.getElementById('searchBox').oninput = filter;
                        document.getElementById('statusFilter').onchange = filter;
                        document.getElementById('sortKey').onchange = filter;
                        document.getElementById('statsStart')?.addEventListener('change', reloadDailyTaskStats);
                        document.getElementById('statsEnd')?.addEventListener('change', reloadDailyTaskStats);
                        filter();
                    </script>
                    </main>
                </div>
            </div>

            <script src="/js/admin.js"></script>
</body>

</html>