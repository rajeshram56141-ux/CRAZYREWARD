                                <input id="statsUserId" type="text" placeholder="Type User ID..." oninput="refreshActiveStatsTab()" style="padding: 6px 12px; border-radius: 8px; border: 1px solid #cbd5e1; font-size: 13px;" />
                            </label>
                            <button class="stats-refresh-btn" type="button" onclick="refreshActiveStatsTab()" style="height: 34px;">Refresh Data</button>
                        </div>
