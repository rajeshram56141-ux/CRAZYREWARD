                    <button type="button" onclick="closeLightboxModal()" style="position: absolute; top: 10px; right: 10px; width: 36px; height: 36px; border-radius: 50%; background: #ef4444; color: white; border: none; font-size: 20px; font-weight: bold; cursor: pointer; display: flex; align-items: center; justify-content: center; z-index: 100;">&times;</button>
                    
