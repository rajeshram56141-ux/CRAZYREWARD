                    <div class="doc-card" style="margin-bottom: 24px;">
                        <div class="card-header-flex">
                            <h3 class="card-title">
                                <span class="card-title-icon icon-orange">
                                    <svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                                </span>
                                Universal S2S Postback Verification Simulator
                            </h3>
                            <span class="method-badge" style="background: #ffedd5; color: #c2410c;">INTERACTIVE TESTER</span>
                        </div>
                        <p style="font-size: 13px; color: #64748b; margin: 0 0 16px 0;">
                            Simulate incoming postbacks from any Direct CPA Advertiser, Offerwall Partner, or Survey Network. 
                            Verifies authentication, updates database records, prevents duplicate replay, and credits test coins instantly.
                        </p>

                        <!-- Tester Mode Selector -->
                        <div style="display: flex; gap: 10px; margin-bottom: 16px;">
                            <label style="display: flex; align-items: center; gap: 6px; font-size: 13px; font-weight: 700; cursor: pointer;">
                                <input type="radio" name="testerMode" value="cpa" checked onchange="toggleTesterMode()" />
                                Direct CPA Daily Task
                            </label>
                            <label style="display: flex; align-items: center; gap: 6px; font-size: 13px; font-weight: 700; cursor: pointer; margin-left: 12px;">
                                <input type="radio" name="testerMode" value="offerwall" onchange="toggleTesterMode()" />
                                Offerwall / Survey Partner
                            </label>
                        </div>

                        <!-- CPA Task Form Section -->
                        <div id="testerCpaSection">
                            <div class="tester-grid">
                                <div class="form-group">
                                    <label>Select Daily Task *</label>
                                    <select id="testTaskSelect" class="form-control" onchange="onTaskSelectChange()">
                                        <option value="">-- Select Active Task --</option>
                                        <% (dailyTasks || []).forEach(t => { %>
                                            <option value="<%= t.offerId %>" data-secret="<%= t.secretKey || '' %>" data-events='<%- JSON.stringify(t.events || []) %>'>
                                                <%= t.offerName %> (<%= t.offerId %>)
                                            </option>
                                        <% }); %>
                                    </select>
                                </div>

                                <div class="form-group">
                                    <label>Target User ID *</label>
                                    <input type="text" id="testUserId" class="form-control" placeholder="Enter user ID (e.g. 66bc...)" />
                                </div>

                                <div class="form-group">
                                    <label>Offer ID</label>
                                    <input type="text" id="testOfferId" class="form-control" readonly style="background: #f1f5f9; color: #475569;" placeholder="Task Offer ID" />
                                </div>

                                <div class="form-group">
                                    <label>Secret Key</label>
                                    <input type="text" id="testSecret" class="form-control" placeholder="Task Secret Key" />
                                </div>

                                <div class="form-group" id="testEventGroup" style="display: none;">
                                    <label style="color: #7c3aed; font-weight: 800;">Target Milestone *</label>
                                    <select id="testEventSelect" class="form-control" style="background: #faf5ff; border-color: #c4b5fd; color: #5b21b6; font-weight: 600;">
                                        <!-- Populated dynamically -->
                                    </select>
                                </div>
                            </div>
                        </div>

                        <!-- Offerwall / Survey Form Section -->
                        <div id="testerOfferwallSection" style="display: none;">
                            <div class="tester-grid">
                                <div class="form-group">
                                    <label>Select Provider *</label>
                                    <select id="testProviderSelect" class="form-control" onchange="onProviderSelectChange()">
                                        <option value="pubscale">PubScale</option>
                                        <option value="playtimeads">Playtime Ads</option>
                                        <option value="growdeck">GrowDeck</option>
                                        <option value="notik">Notik</option>
                                        <option value="tapjoy">Tapjoy</option>
                                        <option value="taskwall">Taskwall</option>
                                        <option value="adjoe">Adjoe</option>
                                        <option value="cpx">CPX Research</option>
                                        <option value="bitlabs">BitLabs</option>
                                        <option value="timewall">TimeWall</option>
                                        <option value="wannads">Wannads</option>
                                        <option value="theoremreach">TheoremReach</option>
                                        <option value="cpidroid">CPIDroid</option>
                                        <option value="custom">Custom Partner</option>
                                    </select>
                                </div>

                                <div class="form-group" id="customProviderInputGroup" style="display: none;">
                                    <label>Custom Partner Name *</label>
                                    <input type="text" id="testCustomProvider" class="form-control" placeholder="e.g. monlix" />
                                </div>

                                <div class="form-group">
                                    <label>Target User ID *</label>
                                    <input type="text" id="testOwUserId" class="form-control" placeholder="User ID (e.g. 66bc...)" />
                                </div>

                                <div class="form-group">
                                    <label>Coins / Payout *</label>
                                    <input type="number" id="testOwCoins" class="form-control" value="250" min="1" />
                                </div>

                                <div class="form-group">
                                    <label>Transaction ID *</label>
                                    <div style="display: flex; gap: 6px;">
                                        <input type="text" id="testOwTxId" class="form-control" placeholder="Unique TX ID" />
                                        <button type="button" class="btn-copy-sm" onclick="generateRandomTx()" title="Generate Random TX">🎲</button>
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label>Offer / Task ID (Optional)</label>
                                    <input type="text" id="testOwOfferId" class="form-control" placeholder="e.g. test_offer_01" />
                                </div>
                            </div>
                        </div>

                        <div style="display: flex; gap: 12px; align-items: center; margin-top: 18px;">
                            <button type="button" class="btn-test" onclick="executePostbackTest()">
                                <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                                <span>Dispatch Test S2S Postback</span>
                            </button>
                            <span id="testLoading" style="display: none; font-size: 13px; color: #64748b;">Processing callback...</span>
                        </div>

                        <div id="testResult" class="test-result-box"></div>
                    </div>
                </div>
            </main>
        </div>
    </div>

    <!-- TOAST NOTIFICATION -->
    <div id="toast" class="toast">
        <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="#10b981"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
        <span id="toastMsg">Copied to clipboard!</span>
    </div>

    <script>
        let currentBaseUrl = '<%= baseUrl || "https://crazyreward.zodplaygames.com" %>';

        // Initialize Base Domain: Default to official https://crazyreward.zodplaygames.com
        window.addEventListener('DOMContentLoaded', () => {
            if (!currentBaseUrl) {
                currentBaseUrl = 'https://crazyreward.zodplaygames.com';
            }
            updateDisplayedBaseUrls(currentBaseUrl);
            generateRandomTx();
        });

        function applyCustomDomain() {
            let inputVal = document.getElementById('customDomainInput').value.trim();
            if (!inputVal) {
                inputVal = 'https://crazyreward.zodplaygames.com';
            }
            // Remove trailing slash
            if (inputVal.endsWith('/')) {
                inputVal = inputVal.slice(0, -1);
            }
            currentBaseUrl = inputVal;
            updateDisplayedBaseUrls(currentBaseUrl);
            showToast('Target domain applied: ' + currentBaseUrl);
        }

        function updateDisplayedBaseUrls(domain) {
            document.getElementById('activeDomainBadge').textContent = domain;
            document.getElementById('customDomainInput').value = domain;
            document.querySelectorAll('.url-base-token').forEach(el => {
                el.textContent = domain;
            });
        }

        function copyDynamicUrl(template) {
            const finalUrl = template.replace('{BASE_URL}', currentBaseUrl);
            copyText(finalUrl);
        }

        function copyTaskFromBtn(btn) {
            const offerId = btn.getAttribute('data-offer-id') || '';
            const secret = btn.getAttribute('data-secret') || '';
            const isMulti = btn.getAttribute('data-multi') === '1';
            copyTaskPostback(offerId, secret, isMulti);
        }

        function copyTaskPostback(offerId, secret, isMulti) {
            let url = `${currentBaseUrl}/cpa-postback?userId={subId}&appName=crazyreward&offerId=${offerId}&secret=${secret}`;
            if (isMulti) {
                url += '&eventId={eventId}';
            }
            copyText(url);
        }

        function copyText(text) {
            navigator.clipboard.writeText(text).then(() => {
                showToast('Copied to clipboard!');
            }).catch(err => {
                console.error('Copy error:', err);
            });
        }

        function showToast(msg) {
            const toast = document.getElementById('toast');
            document.getElementById('toastMsg').textContent = msg;
            toast.style.display = 'flex';
            setTimeout(() => {
                toast.style.display = 'none';
            }, 2500);
        }

        // TABS SWITCHING
        function switchDocTab(tabName) {
            document.querySelectorAll('.doc-tab-btn').forEach(btn => btn.classList.remove('active'));
            document.querySelectorAll('.tab-pane').forEach(pane => pane.classList.remove('active'));

            const targetBtn = Array.from(document.querySelectorAll('.doc-tab-btn')).find(b => b.getAttribute('onclick').includes(tabName));
            if (targetBtn) targetBtn.classList.add('active');

            const targetPane = document.getElementById('tab-' + tabName);
            if (targetPane) targetPane.classList.add('active');
        }

        function openTesterWithProvider(providerName) {
            switchDocTab('tester');
            const radio = document.querySelector('input[name="testerMode"][value="offerwall"]');
            if (radio) {
                radio.checked = true;
                toggleTesterMode();
            }
            const providerSelect = document.getElementById('testProviderSelect');
            if (providerSelect) {
                providerSelect.value = providerName.toLowerCase();
                onProviderSelectChange();
            }
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function toggleTesterMode() {
            const mode = document.querySelector('input[name="testerMode"]:checked').value;
            const cpaSec = document.getElementById('testerCpaSection');
            const owSec = document.getElementById('testerOfferwallSection');
            const resultBox = document.getElementById('testResult');
            resultBox.style.display = 'none';

            if (mode === 'cpa') {
                cpaSec.style.display = 'block';
                owSec.style.display = 'none';
            } else {
                cpaSec.style.display = 'none';
                owSec.style.display = 'block';
            }
        }

        function onProviderSelectChange() {
            const val = document.getElementById('testProviderSelect').value;
            const customGroup = document.getElementById('customProviderInputGroup');
            customGroup.style.display = val === 'custom' ? 'block' : 'none';
        }

        function generateRandomTx() {
            const rand = 'tx_' + Date.now() + '_' + Math.floor(Math.random() * 1000);
            const input = document.getElementById('testOwTxId');
            if (input) input.value = rand;
        }

        function onTaskSelectChange() {
            const select = document.getElementById('testTaskSelect');
            const selectedOpt = select.options[select.selectedIndex];
            const eventGroup = document.getElementById('testEventGroup');
            const eventSelect = document.getElementById('testEventSelect');

            if (!selectedOpt || !selectedOpt.value) {
                document.getElementById('testOfferId').value = '';
                document.getElementById('testSecret').value = '';
                eventGroup.style.display = 'none';
                eventSelect.innerHTML = '';
                return;
            }

            document.getElementById('testOfferId').value = selectedOpt.value;
            document.getElementById('testSecret').value = selectedOpt.dataset.secret || '';

            try {
                const events = JSON.parse(selectedOpt.dataset.events || '[]');
                if (Array.isArray(events) && events.length > 0) {
                    eventSelect.innerHTML = '';
                    events.forEach((ev, idx) => {
                        const opt = document.createElement('option');
                        opt.value = ev.eventId || `event_${idx + 1}`;
                        opt.textContent = `Event ${idx + 1}: ${ev.label || ev.name || 'Event'} (+${ev.coins || 0} Coins) [ID: ${opt.value}]`;
                        eventSelect.appendChild(opt);
                    });
                    eventGroup.style.display = 'block';
                } else {
                    eventGroup.style.display = 'none';
                    eventSelect.innerHTML = '';
                }
            } catch (e) {
                eventGroup.style.display = 'none';
            }
        }

        // UNIFIED LIVE TESTER EXECUTION
        async function executePostbackTest() {
            const mode = document.querySelector('input[name="testerMode"]:checked').value;
            const resultBox = document.getElementById('testResult');
            const loading = document.getElementById('testLoading');

            loading.style.display = 'inline';
            resultBox.style.display = 'none';

            try {
                if (mode === 'cpa') {
                    // Direct CPA Task Dispatch
                    const userId = document.getElementById('testUserId').value.trim();
                    const offerId = document.getElementById('testOfferId').value.trim();
                    const secret = document.getElementById('testSecret').value.trim();
                    const eventGroup = document.getElementById('testEventGroup');
                    const eventSelect = document.getElementById('testEventSelect');

                    if (!offerId) throw new Error('Please select an active Daily Task.');
                    if (!userId) throw new Error('Please enter a target User ID.');
                    if (!secret) throw new Error('Please enter or verify the Secret Key.');

                    const params = new URLSearchParams({
                        userId: userId,
                        appName: 'crazyreward',
                        offerId: offerId,
                        secret: secret
                    });
                    if (eventGroup.style.display !== 'none' && eventSelect.value) {
                        params.set('eventId', eventSelect.value);
                    }

                    const testUrl = '/cpa-postback?' + params.toString();
                    const res = await fetch(testUrl, { method: 'GET' });
                    const text = await res.text();

                    loading.style.display = 'none';
                    resultBox.style.display = 'block';

                    if (res.ok && (text === '1' || text.includes('success'))) {
                        resultBox.className = 'test-result-box test-result-success';
                        resultBox.innerHTML = `<b>SUCCESS (HTTP ${res.status}):</b> Direct CPA Postback verified. Response: <code>${text}</code>. Coins successfully credited to User <code>${userId}</code>.`;
                    } else {
                        resultBox.className = 'test-result-box test-result-error';
                        resultBox.innerHTML = `<b>EXECUTION REJECTED (HTTP ${res.status}):</b> Server response: <code>${text}</code>.<br/><small>Check that the User exists, task secret is valid, and account is not blocked.</small>`;
                    }
                } else {
                    // Offerwall & Survey Dispatch
                    const provider = document.getElementById('testProviderSelect').value;
                    let targetProvider = provider;
                    if (provider === 'custom') {
                        targetProvider = document.getElementById('testCustomProvider').value.trim() || 'Custom';
                    }

                    const userId = document.getElementById('testOwUserId').value.trim();
                    const coins = document.getElementById('testOwCoins').value.trim();
                    const txId = document.getElementById('testOwTxId').value.trim() || ('tx_' + Date.now());
                    const offerId = document.getElementById('testOwOfferId').value.trim() || `${targetProvider}_test`;

                    if (!userId) throw new Error('Please enter a target User ID.');
                    if (!coins || Number(coins) <= 0) throw new Error('Please enter a valid coin amount (> 0).');

                    // Determine route & parameters according to provider
                    let endpoint = `/postback/${targetProvider}`;
                    let params = new URLSearchParams();

                    if (targetProvider === 'pubscale') {
                        params.set('userId', userId);
                        params.set('token', txId);
                        params.set('value', coins);
                        params.set('offer_id', offerId);
                    } else if (targetProvider === 'bitlabs') {
                        params.set('uid', userId);
                        params.set('val', coins);
                        params.set('tx', txId);
                        params.set('offer_id', offerId);
                    } else if (targetProvider === 'cpx') {
                        params.set('sub_id', userId);
                        params.set('amount', coins);
                        params.set('trans_id', txId);
                        params.set('status', '1');
                    } else if (targetProvider === 'timewall') {
                        params.set('userID', userId);
                        params.set('currencyAmount', coins);
                        params.set('transactionID', txId);
                        params.set('offerId', offerId);
                    } else if (targetProvider === 'growdeck') {
                        params.set('user_id', userId);
                        params.set('reward', coins);
                        params.set('trans_id', txId);
                        params.set('offer_id', offerId);
                    } else if (targetProvider === 'playtimeads') {
                        params.set('userId', userId);
                        params.set('coins', coins);
                        params.set('txId', txId);
                        params.set('offerId', offerId);
                    } else if (targetProvider === 'wannads') {
                        params.set('subId', userId);
                        params.set('reward', coins);
                        params.set('transId', txId);
                        params.set('status', '1');
                    } else if (targetProvider === 'tapjoy') {
                        params.set('snuid', userId);
                        params.set('currency', coins);
                        params.set('id', txId);
                    } else {
                        params.set('userId', userId);
                        params.set('amount', coins);
                        params.set('trans_id', txId);
                        params.set('offer_id', offerId);
                    }

                    const testUrl = `${endpoint}?${params.toString()}`;
                    const res = await fetch(testUrl, { method: 'GET' });
                    const text = await res.text();

                    loading.style.display = 'none';
                    resultBox.style.display = 'block';

                    if (res.ok && (text === '1' || text.toLowerCase().includes('success'))) {
                        resultBox.className = 'test-result-box test-result-success';
                        resultBox.innerHTML = `<b>SUCCESS (HTTP ${res.status}):</b> [${targetProvider.toUpperCase()}] Postback verified. Response: <code>${text}</code>. ${coins} coins credited to User <code>${userId}</code> (TX: <code>${txId}</code>).`;
                        generateRandomTx(); // Refresh TX for next click
                    } else {
                        resultBox.className = 'test-result-box test-result-error';
                        resultBox.innerHTML = `<b>EXECUTION FAILED (HTTP ${res.status}):</b> Server returned: <code>${text}</code>.<br/><small>Ensure the User ID exists, is not blocked, and coins > 0.</small>`;
                    }
                }
            } catch (err) {
                loading.style.display = 'none';
                resultBox.style.display = 'block';
                resultBox.className = 'test-result-box test-result-error';
                resultBox.innerHTML = `<b>ERROR:</b> ${err.message}`;
            }
        }
    </script>
    <script src="/js/admin.js"></script>
</body>

</html>
