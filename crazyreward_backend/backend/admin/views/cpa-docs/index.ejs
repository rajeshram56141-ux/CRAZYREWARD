<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Postback & Tracking Documentation - Crazyreward Admin</title>
    <link rel="stylesheet" href="/css/admin.css">
    <link rel="icon" href="/images/favicon.png">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;600;700&display=swap" rel="stylesheet">
    <style>
        * {
            font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
            box-sizing: border-box;
        }

        body.dashboard-body {
            background-color: #f8fafc;
            color: #0f172a;
            margin: 0;
        }

        .cpa-docs-container {
            padding: 24px 32px 60px 32px;
            max-width: 1440px;
            margin: 0 auto;
        }

        .page-header {
            margin-bottom: 24px;
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            flex-wrap: wrap;
            gap: 16px;
        }

        .page-header h1 {
            font-size: 24px;
            font-weight: 800;
            color: #0f172a;
            margin: 0;
            letter-spacing: -0.5px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .page-header p {
            color: #64748b;
            margin: 6px 0 0 0;
            font-size: 13.5px;
        }

        .badge-s2s {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 4px 12px;
            border-radius: 999px;
            font-size: 11px;
            font-weight: 800;
            background: linear-gradient(135deg, #10b981, #059669);
            color: #ffffff;
            letter-spacing: 0.5px;
            box-shadow: 0 2px 8px rgba(16, 185, 129, 0.25);
        }

        /* TABS NAVIGATION */
        .tabs-header-nav {
            display: flex;
            align-items: center;
            gap: 8px;
            background: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 16px;
            padding: 6px;
            margin-bottom: 24px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.02);
            overflow-x: auto;
            scrollbar-width: thin;
        }

        .doc-tab-btn {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 10px 18px;
            border-radius: 12px;
            font-size: 13px;
            font-weight: 700;
            color: #64748b;
            background: transparent;
            border: none;
            cursor: pointer;
            transition: all 0.2s ease;
            white-space: nowrap;
        }

        .doc-tab-btn:hover {
            color: #0f172a;
            background: #f1f5f9;
        }

        .doc-tab-btn.active {
            color: #ffffff;
            background: #052e1f;
            box-shadow: 0 4px 12px rgba(5, 46, 31, 0.2);
        }

        .doc-tab-btn .tab-count {
            padding: 2px 8px;
            border-radius: 999px;
            font-size: 11px;
            font-weight: 800;
            background: rgba(0, 0, 0, 0.08);
        }

        .doc-tab-btn.active .tab-count {
            background: rgba(255, 255, 255, 0.25);
            color: #ffffff;
        }

        /* DOMAIN CONFIG BAR */
        .domain-bar-card {
            background: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 14px;
            padding: 12px 18px;
            margin-bottom: 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 12px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.02);
        }

        .domain-bar-left {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 13px;
            color: #334155;
        }

        .domain-badge {
            background: #ecfdf5;
            color: #059669;
            border: 1px solid #a7f3d0;
            padding: 4px 10px;
            border-radius: 8px;
            font-weight: 700;
            font-family: 'JetBrains Mono', monospace;
            font-size: 12px;
        }

        .domain-input-group {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .domain-input {
            padding: 6px 12px;
            border: 1px solid #cbd5e1;
            border-radius: 8px;
            font-size: 12px;
            font-family: 'JetBrains Mono', monospace;
            width: 260px;
            outline: none;
            background: #f8fafc;
        }

        .domain-input:focus {
            border-color: #10b981;
            background: #ffffff;
        }

        /* TAB PANES */
        .tab-pane {
            display: none;
        }

        .tab-pane.active {
            display: block;
            animation: fadeIn 0.25s ease;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(4px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* CARDS & GRIDS */
        .grid-2col {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(440px, 1fr));
            gap: 24px;
            margin-bottom: 28px;
        }

        .grid-partner-cards {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(460px, 1fr));
            gap: 22px;
            margin-bottom: 28px;
        }

        .doc-card {
            background: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 20px;
            padding: 24px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
            position: relative;
            overflow: hidden;
            transition: all 0.2s ease;
            display: flex;
            flex-direction: column;
        }

        .doc-card:hover {
            border-color: #cbd5e1;
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.05);
        }

        .card-header-flex {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 14px;
            gap: 12px;
        }

        .card-title {
            margin: 0;
            font-size: 16px;
            font-weight: 800;
            color: #0f172a;
            display: flex;
            align-items: center;
            gap: 10px;
            letter-spacing: -0.3px;
        }

        .card-title-icon {
            width: 36px;
            height: 36px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .card-title-icon svg {
            width: 18px;
            height: 18px;
        }

        .icon-blue { background: #eff6ff; color: #2563eb; }
        .icon-green { background: #ecfdf5; color: #059669; }
        .icon-purple { background: #f5f3ff; color: #7c3aed; }
        .icon-orange { background: #fff7ed; color: #ea580c; }
        .icon-cyan { background: #ecfeff; color: #0891b2; }
        .icon-emerald { background: #f0fdf4; color: #16a34a; }
        .icon-amber { background: #fffbeb; color: #d97706; }
        .icon-rose { background: #fff1f2; color: #e11d48; }

        .method-badge {
            font-family: 'JetBrains Mono', monospace;
            font-size: 10.5px;
            font-weight: 800;
            padding: 3px 8px;
            border-radius: 6px;
            background: #dbeafe;
            color: #1e40af;
        }

        .status-pill {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            font-size: 11px;
            font-weight: 700;
            padding: 3px 8px;
            border-radius: 999px;
        }

        .status-pill.enabled {
            background: #ecfdf5;
            color: #059669;
            border: 1px solid #a7f3d0;
        }

        .status-pill.disabled {
            background: #f1f5f9;
            color: #64748b;
            border: 1px solid #e2e8f0;
        }

        .code-box {
            background: #0f172a;
            border-radius: 14px;
            padding: 14px 16px;
            position: relative;
            margin: 12px 0;
            border: 1px solid #1e293b;
        }

        .code-box pre {
            margin: 0;
            font-family: 'JetBrains Mono', monospace;
            font-size: 12px;
            color: #e2e8f0;
            white-space: pre-wrap;
            word-break: break-all;
            line-height: 1.6;
            padding-right: 70px;
        }

        .copy-btn {
            position: absolute;
            top: 10px;
            right: 10px;
            background: rgba(255, 255, 255, 0.1);
            border: 1px solid rgba(255, 255, 255, 0.15);
            color: #e2e8f0;
            font-size: 11px;
            font-weight: 700;
            padding: 5px 10px;
            border-radius: 8px;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 5px;
            transition: all 0.15s ease;
        }

        .copy-btn:hover {
            background: rgba(255, 255, 255, 0.2);
            color: #ffffff;
        }

        .copy-btn svg {
            width: 13px;
            height: 13px;
        }

        .param-hl { color: #38bdf8; font-weight: 700; }
        .param-val { color: #f472b6; font-weight: 700; }
        .param-static { color: #34d399; font-weight: 700; }

        .param-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 12px;
            margin-top: 10px;
        }

        .param-table th {
            text-align: left;
            padding: 8px 10px;
            background: #f8fafc;
            color: #475569;
            font-weight: 700;
            border-bottom: 1px solid #e2e8f0;
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .param-table td {
            padding: 8px 10px;
            border-bottom: 1px solid #f1f5f9;
            color: #334155;
            vertical-align: middle;
        }

        .param-table tr:last-child td {
            border-bottom: none;
        }

        .param-name {
            font-family: 'JetBrains Mono', monospace;
            font-weight: 700;
            color: #0f172a;
            background: #f1f5f9;
            padding: 2px 6px;
            border-radius: 4px;
            font-size: 11.5px;
        }

        .req-pill {
            font-size: 10px;
            font-weight: 800;
            padding: 2px 6px;
            border-radius: 4px;
            display: inline-block;
            letter-spacing: 0.3px;
        }

        .req-mandatory { background: #fee2e2; color: #b91c1c; }
        .req-optional { background: #f1f5f9; color: #64748b; }

        .flow-steps {
            display: flex;
            flex-direction: column;
            gap: 12px;
            margin-top: 8px;
        }

        .flow-step-item {
            display: flex;
            align-items: flex-start;
            gap: 12px;
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 12px;
            padding: 12px 14px;
        }

        .flow-num {
            width: 24px;
            height: 24px;
            border-radius: 50%;
            background: #052e1f;
            color: #ffffff;
            font-size: 11px;
            font-weight: 800;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .flow-content h4 {
            margin: 0 0 4px 0;
            font-size: 13px;
            font-weight: 700;
            color: #0f172a;
        }

        .flow-content p {
            margin: 0;
            font-size: 12px;
            color: #64748b;
            line-height: 1.4;
        }

        .flow-content code {
            font-family: 'JetBrains Mono', monospace;
            background: #e2e8f0;
            color: #0f172a;
            padding: 1px 4px;
            border-radius: 4px;
            font-size: 11px;
        }

        /* ACTIVE TASKS TABLE */
        .tasks-table-card {
            background: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 20px;
            padding: 24px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
            margin-top: 28px;
        }

        .tasks-data-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 13px;
            margin-top: 14px;
        }

        .tasks-data-table th {
            text-align: left;
            padding: 10px 14px;
            background: #f8fafc;
            color: #475569;
            font-weight: 700;
            border-bottom: 2px solid #e2e8f0;
            font-size: 11.5px;
            text-transform: uppercase;
        }

        .tasks-data-table td {
            padding: 12px 14px;
            border-bottom: 1px solid #f1f5f9;
            vertical-align: middle;
        }

        .tasks-data-table tr:hover {
            background-color: #fafafa;
        }

        .btn-copy-sm {
            padding: 6px 12px;
            border-radius: 8px;
            background: #f1f5f9;
            border: 1px solid #cbd5e1;
            color: #0f172a;
            font-size: 12px;
            font-weight: 700;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            transition: all 0.15s ease;
            text-decoration: none;
        }

        .btn-copy-sm:hover {
            background: #e2e8f0;
        }

        /* LIVE TESTER FORM */
        .tester-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 14px;
            margin-top: 12px;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .form-group label {
            font-size: 11.5px;
            font-weight: 700;
            color: #475569;
            text-transform: uppercase;
            letter-spacing: 0.3px;
        }

        .form-control {
            padding: 9px 12px;
            border: 1px solid #cbd5e1;
            border-radius: 10px;
            font-size: 13px;
            outline: none;
            background: #ffffff;
            color: #0f172a;
            transition: border-color 0.2s;
        }

        .form-control:focus {
            border-color: #10b981;
            box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.1);
        }

        .btn-test {
            background: linear-gradient(135deg, #052e1f, #064e3b);
            color: #ffffff;
            border: none;
            padding: 10px 20px;
            border-radius: 10px;
            font-size: 13px;
            font-weight: 800;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: all 0.2s ease;
            box-shadow: 0 4px 12px rgba(5, 46, 31, 0.15);
        }

        .btn-test:hover {
            opacity: 0.95;
            transform: translateY(-1px);
        }

        .test-result-box {
            margin-top: 14px;
            border-radius: 12px;
            padding: 14px 16px;
            font-size: 13px;
            display: none;
            line-height: 1.5;
        }

        .test-result-success {
            background: #ecfdf5;
            border: 1px solid #a7f3d0;
            color: #065f46;
        }

        .test-result-error {
            background: #fef2f2;
            border: 1px solid #fecaca;
            color: #991b1b;
        }

        .toast {
            position: fixed;
            bottom: 24px;
            right: 24px;
            background: #0f172a;
            color: #ffffff;
            padding: 12px 20px;
            border-radius: 12px;
            font-size: 13px;
            font-weight: 700;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2);
            display: none;
            align-items: center;
            gap: 8px;
            z-index: 9999;
        }

        .card-footer-action {
            margin-top: auto;
            padding-top: 14px;
            border-top: 1px dashed #e2e8f0;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .key-val-display {
            font-size: 11.5px;
            color: #64748b;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .key-val-display code {
            font-family: 'JetBrains Mono', monospace;
            background: #f1f5f9;
            padding: 2px 6px;
            border-radius: 6px;
            color: #0f172a;
            font-size: 11px;
            max-width: 160px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }
    </style>
</head>

<body class="dashboard-body">
    <div class="dashboard-shell">
        <%- include('../partials/sidebar', { activePage: 'cpa-docs' }) %>

        <div class="dashboard-main">
            <!-- NAVBAR -->
            <header class="navbar dashboard-navbar">
                <div class="nav-left" style="display: flex; align-items: center; gap: 12px; white-space: nowrap;">
                    <button type="button" class="sidebar-toggle-btn" onclick="toggleSidebar()">☰</button>
                    <h2 style="margin: 0; font-size: 18px; font-weight: 800; white-space: nowrap;">
                        Postback & Tracking Documentation
                    </h2>
                </div>

                <div class="nav-right" onclick="toggleDropdown()">
                    <div class="avatar"><%= admin.name ? admin.name.split(' ').map(part => part[0]).join('').toUpperCase() : (admin.username ? admin.username.charAt(0).toUpperCase() : 'A') %></div>
                    <div class="dropdown" id="dropdown">
                        <a href="/logout">Logout</a>
                    </div>
                </div>
            </header>

            <main class="cpa-docs-container">
                <!-- PAGE HEADER -->
                <div class="page-header">
                    <div>
                        <h1>
                            <span>Postback & Tracking Documentation</span>
                            <span class="badge-s2s">
                                <svg width="12" height="12" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                                LIVE S2S DOCS
                            </span>
                        </h1>
                        <p>Complete integration specification for Direct CPA Tasks, Offerwall Partners, Survey Networks, and Webhook Callbacks.</p>
                    </div>
                    <div style="display: flex; gap: 10px; flex-wrap: wrap;">
                        <a href="/manage-daily-task" class="btn-copy-sm">
                            <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
                            Daily Tasks
                        </a>
                        <a href="/app-settings/offerwall" class="btn-copy-sm">
                            <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16"/></svg>
                            Offerwalls Config
                        </a>
                        <a href="/app-settings/survey" class="btn-copy-sm">
                            <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/></svg>
                            Surveys Config
                        </a>
                    </div>
                </div>

                <!-- DOMAIN SELECTOR BAR -->
                <div class="domain-bar-card">
                    <div class="domain-bar-left">
                        <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="#059669"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/></svg>
                        <span>Active Server Domain:</span>
                        <span class="domain-badge" id="activeDomainBadge"><%= baseUrl || 'https://crazyreward.zodplaygames.com' %></span>
                    </div>
                    <div class="domain-input-group">
                        <label style="font-size: 12px; font-weight: 700; color: #64748b;">Target Domain:</label>
                        <input type="text" id="customDomainInput" class="domain-input" value="<%= baseUrl || 'https://crazyreward.zodplaygames.com' %>" placeholder="e.g. https://crazyreward.zodplaygames.com" />
                        <button type="button" class="btn-copy-sm" onclick="applyCustomDomain()" style="background: #052e1f; color: #ffffff; border-color: #052e1f;">Apply</button>
                    </div>
                </div>

                <!-- MAIN TABS HEADER -->
                <div class="tabs-header-nav">
                    <button type="button" class="doc-tab-btn active" onclick="switchDocTab('direct-cpa')">
                        <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                        Direct CPA Tasks
                        <span class="tab-count"><%= (dailyTasks || []).length %></span>
                    </button>
                    <button type="button" class="doc-tab-btn" onclick="switchDocTab('offerwalls')">
                        <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/></svg>
                        Offerwall Partners
                        <span class="tab-count" id="offerwallCount">10</span>
                    </button>
                    <button type="button" class="doc-tab-btn" onclick="switchDocTab('surveys')">
                        <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
                        Survey Partners
                        <span class="tab-count" id="surveyCount">7</span>
                    </button>
                    <button type="button" class="doc-tab-btn" onclick="switchDocTab('tester')">
                        <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                        Live Postback Simulator
                        <span class="tab-count" style="background: #10b981; color: #fff;">TEST</span>
                    </button>
                </div>

                <!-- ========================================================================= -->
                <!-- TAB 1: DIRECT CPA TASKS -->
                <!-- ========================================================================= -->
                <div id="tab-direct-cpa" class="tab-pane active">
                    <div class="grid-2col">
                        <!-- CARD 1: REDIRECTION URL MACROS -->
                        <div class="doc-card">
                            <div class="card-header-flex">
                                <h3 class="card-title">
                                    <span class="card-title-icon icon-blue">
                                        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/></svg>
                                    </span>
                                    1. Redirection URL (App to Advertiser Link)
                                </h3>
                                <span class="method-badge">TRACKING LINK</span>
                            </div>
                            <p style="font-size: 13px; color: #64748b; margin: 0 0 12px 0; line-height: 1.5;">
                                When configuring a Daily Task, enter the advertiser tracking link in the <b>Redirection URL</b> field. The mobile app dynamically substitutes the <code>{userId}</code> and <code>{gaid}</code> tokens:
                            </p>

                            <div class="code-box">
                                <button class="copy-btn" onclick="copyDynamicUrl('https://advertiser-network.com/click?subId={userId}&gaid={gaid}')">
                                    <svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                                    Copy
                                </button>
                                <pre>https://advertiser-network.com/click?<span class="param-hl">subId</span>=<span class="param-val">{userId}</span>&<span class="param-hl">gaid</span>=<span class="param-val">{gaid}</span></pre>
                            </div>

                            <table class="param-table">
                                <thead>
                                    <tr>
                                        <th>Macro Token</th>
                                        <th>Resolved Value</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td><span class="param-name">{userId}</span></td>
                                        <td>Unique User Account ID (e.g., <code>66b2f4...</code>)</td>
                                        <td><span class="req-pill req-mandatory">MANDATORY</span></td>
                                    </tr>
                                    <tr>
                                        <td><span class="param-name">{gaid}</span></td>
                                        <td>Google Advertising ID (Android Device)</td>
                                        <td><span class="req-pill req-optional">OPTIONAL</span></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <!-- CARD 2: HOW THE FLOW WORKS -->
                        <div class="doc-card">
                            <div class="card-header-flex">
                                <h3 class="card-title">
                                    <span class="card-title-icon icon-cyan">
                                        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
                                    </span>
                                    Integration Architecture Flow
                                </h3>
                                <span class="method-badge" style="background: #e0e7ff; color: #4338ca;">3-STEP WORKFLOW</span>
                            </div>

                            <div class="flow-steps">
                                <div class="flow-step-item">
                                    <div class="flow-num">1</div>
                                    <div class="flow-content">
                                        <h4>User Engages Task in App</h4>
                                        <p>App resolves <code>{userId}</code> with the logged-in user ID and redirects to the advertiser's platform.</p>
                                    </div>
                                </div>

                                <div class="flow-step-item">
                                    <div class="flow-num">2</div>
                                    <div class="flow-content">
                                        <h4>Conversion Milestone Completed</h4>
                                        <p>The user registers, reaches a level, or completes the required action on the advertiser's application.</p>
                                    </div>
                                </div>

                                <div class="flow-step-item">
                                    <div class="flow-num">3</div>
                                    <div class="flow-content">
                                        <h4>Server-to-Server Postback Fired</h4>
                                        <p>Advertiser server triggers our <code>/cpa-postback</code> endpoint. Signature and credentials are verified, and coins are instantly credited.</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- CARD 3 & 4: SINGLE EVENT VS MULTI EVENT POSTBACK URLS -->
                    <div class="grid-2col">
                        <!-- CARD 3: SINGLE EVENT POSTBACK -->
                        <div class="doc-card">
                            <div class="card-header-flex">
                                <h3 class="card-title">
                                    <span class="card-title-icon icon-green">
                                        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                                    </span>
                                    2. Single Event Postback Specification
                                </h3>
                                <span class="method-badge" style="background: #dcfce7; color: #15803d;">HTTP GET / POST</span>
                            </div>
                            <p style="font-size: 13px; color: #64748b; margin: 0 0 10px 0;">
                                For standard single-conversion offers (Install, Registration, First Action), provide the advertiser with this Postback URL:
                            </p>

                            <div class="code-box">
                                <button class="copy-btn" onclick="copyDynamicUrl('{BASE_URL}/cpa-postback?userId={subId}&appName=crazyreward&offerId={offerId}&secret={secretKey}')">
                                    <svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                                    Copy
                                </button>
                                <pre><span class="url-base-token"><%= baseUrl %></span>/cpa-postback?<span class="param-hl">userId</span>=<span class="param-val">{subId}</span>&<span class="param-hl">appName</span>=<span class="param-val">crazyreward</span>&<span class="param-hl">offerId</span>=<span class="param-val">{offerId}</span>&<span class="param-hl">secret</span>=<span class="param-val">{secretKey}</span></pre>
                            </div>

                            <table class="param-table">
                                <thead>
                                    <tr>
                                        <th>Parameter</th>
                                        <th>Description</th>
                                        <th>Requirement</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td><span class="param-name">userId</span></td>
                                        <td>The user identifier forwarded in the click subId macro</td>
                                        <td><span class="req-pill req-mandatory">MANDATORY</span></td>
                                    </tr>
                                    <tr>
                                        <td><span class="param-name">appName</span></td>
                                        <td>Constant application identifier: <code>crazyreward</code></td>
                                        <td><span class="req-pill req-mandatory">MANDATORY</span></td>
                                    </tr>
                                    <tr>
                                        <td><span class="param-name">offerId</span></td>
                                        <td>Unique Task <b>Offer ID</b> defined in Admin Panel</td>
                                        <td><span class="req-pill req-mandatory">MANDATORY</span></td>
                                    </tr>
                                    <tr>
                                        <td><span class="param-name">secret</span></td>
                                        <td>Task <b>Secret Key</b> for authentication</td>
                                        <td><span class="req-pill req-mandatory">MANDATORY</span></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <!-- CARD 4: MULTI EVENT POSTBACK -->
                        <div class="doc-card">
                            <div class="card-header-flex">
                                <h3 class="card-title">
                                    <span class="card-title-icon icon-purple">
                                        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/></svg>
                                    </span>
                                    3. Multi-Event & Milestone Specification
                                </h3>
                                <span class="method-badge" style="background: #ede9fe; color: #6d28d9;">MULTI-TIER</span>
                            </div>
                            <p style="font-size: 13px; color: #64748b; margin: 0 0 10px 0;">
                                For progressive offers with tiered milestones (e.g., Level 1, Level 5, Level 10 rewards), append <code>&eventId=</code>:
                            </p>

                            <div class="code-box">
                                <button class="copy-btn" onclick="copyDynamicUrl('{BASE_URL}/cpa-postback?userId={subId}&appName=crazyreward&offerId={offerId}&secret={secretKey}&eventId={eventId}')">
                                    <svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                                    Copy
                                </button>
                                <pre><span class="url-base-token"><%= baseUrl %></span>/cpa-postback?<span class="param-hl">userId</span>=<span class="param-val">{subId}</span>&<span class="param-hl">appName</span>=<span class="param-val">crazyreward</span>&<span class="param-hl">offerId</span>=<span class="param-val">{offerId}</span>&<span class="param-hl">secret</span>=<span class="param-val">{secretKey}</span>&<span class="param-hl">eventId</span>=<span class="param-val">{eventId}</span></pre>
                            </div>

                            <table class="param-table">
                                <thead>
                                    <tr>
                                        <th>Parameter</th>
                                        <th>Description</th>
                                        <th>Requirement</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td><span class="param-name">userId</span></td>
                                        <td>User identifier from tracking token</td>
                                        <td><span class="req-pill req-mandatory">MANDATORY</span></td>
                                    </tr>
                                    <tr>
                                        <td><span class="param-name">offerId</span></td>
                                        <td>Task <b>Offer ID</b></td>
                                        <td><span class="req-pill req-mandatory">MANDATORY</span></td>
                                    </tr>
                                    <tr>
                                        <td><span class="param-name">secret</span></td>
                                        <td>Task <b>Secret Key</b></td>
                                        <td><span class="req-pill req-mandatory">MANDATORY</span></td>
                                    </tr>
                                    <tr>
                                        <td><span class="param-name">eventId</span></td>
                                        <td>Milestone Event ID (e.g., <code>event_1</code>, <code>level_5</code>)</td>
                                        <td><span class="req-pill req-mandatory">MANDATORY</span></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- ACTIVE TASKS QUICK REFERENCE TABLE -->
                    <div class="tasks-table-card">
                        <div class="card-header-flex">
                            <h3 class="card-title">
                                <span class="card-title-icon icon-emerald">
                                    <svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/></svg>
                                </span>
                                Registered Active Daily Tasks & Postback Endpoints
                            </h3>
                            <a href="/add-daily-task" class="btn-copy-sm" style="background: #0f172a; color: #fff;">
                                <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
                                Create New Task
                            </a>
                        </div>

                        <div class="table-responsive">
                            <table class="tasks-data-table">
                                <thead>
                                    <tr>
                                        <th>Task Details</th>
                                        <th>Offer ID</th>
                                        <th>Secret Key</th>
                                        <th>Integration Mode</th>
                                        <th>Ready Postback Endpoint</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if (!dailyTasks || dailyTasks.length === 0) { %>
                                        <tr>
                                            <td colspan="5" style="text-align: center; color: #94a3b8; padding: 24px;">No active daily tasks registered.</td>
                                        </tr>
                                    <% } else { %>
                                        <% dailyTasks.forEach(t => { 
                                            const isMulti = Array.isArray(t.events) && t.events.length > 0;
                                            const secret = t.secretKey || 'NO_SECRET_SET';
                                        %>
                                            <tr>
                                                <td>
                                                    <div style="font-weight: 800; color: #0f172a;"><%= t.offerName %></div>
                                                    <div style="font-size: 11px; color: #64748b;">Reward: <%= t.payout || 0 %> Coins</div>
                                                </td>
                                                <td>
                                                    <span class="param-name"><%= t.offerId %></span>
                                                </td>
                                                <td>
                                                    <span style="font-family: 'JetBrains Mono', monospace; font-size: 12px; background: #f8fafc; padding: 4px 8px; border-radius: 6px; border: 1px solid #e2e8f0;">
                                                        <%= secret %>
                                                    </span>
                                                </td>
                                                <td>
                                                    <% if (isMulti) { %>
                                                        <span class="req-pill" style="background: #ede9fe; color: #6d28d9;">Multi Event (<%= t.events.length %> Milestones)</span>
                                                    <% } else { %>
                                                        <span class="req-pill" style="background: #dcfce7; color: #15803d;">Single Event</span>
                                                    <% } %>
                                                </td>
                                                <td>
                                                    <button class="btn-copy-sm" data-offer-id="<%= t.offerId %>" data-secret="<%= secret %>" data-multi="<%= isMulti ? '1' : '0' %>" onclick="copyTaskFromBtn(this)">
                                                        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                                                        Copy Endpoint
                                                    </button>
                                                </td>
                                            </tr>
                                        <% }); %>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- ========================================================================= -->
                <!-- TAB 2: OFFERWALL PARTNERS -->
                <!-- ========================================================================= -->
                <div id="tab-offerwalls" class="tab-pane">
                    <!-- Offerwall Overview Alert -->
                    <div style="background: #ecfdf5; border: 1px solid #a7f3d0; border-radius: 16px; padding: 16px 20px; margin-bottom: 24px; display: flex; align-items: flex-start; gap: 14px;">
                        <span style="font-size: 24px;">🎁</span>
                        <div>
                            <h4 style="margin: 0 0 4px 0; font-size: 14px; font-weight: 800; color: #065f46;">Offerwall S2S Postback Integration Guide</h4>
                            <p style="margin: 0; font-size: 13px; color: #047857; line-height: 1.5;">
                                When a user finishes an app offer or game milestone on any partner wall, the provider dispatches an S2S HTTP request to our server. 
                                Our backend validates transactions, avoids duplicates, credits user wallet coins, updates daily challenge goals, and distributes squad referral bonuses.
                            </p>
                        </div>
                    </div>

                    <div class="grid-partner-cards">
                        <!-- 1. PUBSCALE -->
                        <% 
                            const pubscaleCfg = offersSettings.Pubscale || offersSettings.pubscale || {}; 
                            const pubscaleEnabled = pubscaleCfg.enabled !== false && pubscaleCfg.enabled !== 'false';
                        %>
                        <div class="doc-card">
                            <div class="card-header-flex">
                                <h3 class="card-title">
                                    <span class="card-title-icon icon-teal" style="background: #ccfbf1; color: #0d9488;">
                                        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                                    </span>
                                    PubScale (Native SDK)
                                </h3>
                                <div style="display: flex; gap: 6px; align-items: center;">
                                    <span class="status-pill <%= pubscaleEnabled ? 'enabled' : 'disabled' %>">
                                        <%= pubscaleEnabled ? '● Enabled' : '○ Disabled' %>
                                    </span>
                                    <span class="method-badge">GET / POST</span>
                                </div>
                            </div>
                            <p style="font-size: 12.5px; color: #64748b; margin: 0 0 8px 0;">
                                Integrated via Native Android SDK with MD5 signature validation. Paste this URL in your PubScale Publisher Dashboard:
                            </p>

                            <div class="code-box">
                                <button class="copy-btn" onclick="copyDynamicUrl('{BASE_URL}/postback/pubscale?userId={user_id}&token={trans_id}&value={payout}&offer_id={offer_id}&signature={signature}')">
                                    <svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                                    Copy
                                </button>
                                <pre><span class="url-base-token"><%= baseUrl %></span>/postback/pubscale?<span class="param-hl">userId</span>=<span class="param-val">{user_id}</span>&<span class="param-hl">token</span>=<span class="param-val">{trans_id}</span>&<span class="param-hl">value</span>=<span class="param-val">{payout}</span>&<span class="param-hl">signature</span>=<span class="param-val">{signature}</span></pre>
                            </div>

                            <table class="param-table">
                                <thead>
                                    <tr>
                                        <th>Parameter</th>
                                        <th>Pubscale Macro</th>
                                        <th>Requirement</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td><span class="param-name">userId</span></td>
                                        <td><code>{user_id}</code> or <code>{subId}</code></td>
                                        <td><span class="req-pill req-mandatory">MANDATORY</span></td>
                                    </tr>
                                    <tr>
                                        <td><span class="param-name">token</span></td>
                                        <td><code>{trans_id}</code> or <code>{token}</code></td>
                                        <td><span class="req-pill req-mandatory">MANDATORY</span></td>
                                    </tr>
                                    <tr>
                                        <td><span class="param-name">value</span></td>
                                        <td><code>{payout}</code> or <code>{reward}</code></td>
                                        <td><span class="req-pill req-mandatory">MANDATORY</span></td>
                                    </tr>
                                    <tr>
                                        <td><span class="param-name">signature</span></td>
                                        <td><code>{signature}</code> (MD5 hash)</td>
                                        <td><span class="req-pill req-optional">SECURITY</span></td>
                                    </tr>
                                </tbody>
                            </table>

                            <div class="card-footer-action">
                                <div class="key-val-display">
                                    <span>App ID:</span>
                                    <code><%= pubscaleCfg.appId || 'Not Set' %></code>
                                </div>
                                <button type="button" class="btn-copy-sm" onclick="openTesterWithProvider('pubscale')">
                                    Test Postback ➔
                                </button>
                            </div>
                        </div>

                        <!-- 2. PLAYTIME ADS -->
                        <% 
                            const playtimeCfg = offersSettings.PlaytimeAds || offersSettings.playtimeAds || offersSettings.Playtime || {}; 
                            const playtimeEnabled = playtimeCfg.enabled !== false && playtimeCfg.enabled !== 'false';
                        %>
                        <div class="doc-card">
                            <div class="card-header-flex">
                                <h3 class="card-title">
                                    <span class="card-title-icon icon-purple">
                                        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                                    </span>
                                    Playtime Ads (Native SDK)
                                </h3>
                                <div style="display: flex; gap: 6px; align-items: center;">
                                    <span class="status-pill <%= playtimeEnabled ? 'enabled' : 'disabled' %>">
                                        <%= playtimeEnabled ? '● Enabled' : '○ Disabled' %>
                                    </span>
                                    <span class="method-badge">GET / POST</span>
                                </div>
                            </div>
                            <p style="font-size: 12.5px; color: #64748b; margin: 0 0 8px 0;">
                                Rewards users per minute of active game playtime. Configure in Playtime Ads Dashboard:
                            </p>

                            <div class="code-box">
                                <button class="copy-btn" onclick="copyDynamicUrl('{BASE_URL}/postback/playtimeads?userId={userId}&txId={txId}&coins={coins}&offerId={offerId}')">
                                    <svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                                    Copy
                                </button>
                                <pre><span class="url-base-token"><%= baseUrl %></span>/postback/playtimeads?<span class="param-hl">userId</span>=<span class="param-val">{userId}</span>&<span class="param-hl">txId</span>=<span class="param-val">{txId}</span>&<span class="param-hl">coins</span>=<span class="param-val">{coins}</span>&<span class="param-hl">offerId</span>=<span class="param-val">{offerId}</span></pre>
                            </div>

                            <table class="param-table">
                                <thead>
                                    <tr>
                                        <th>Parameter</th>
                                        <th>Playtime Macro</th>
                                        <th>Requirement</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td><span class="param-name">userId</span></td>
                                        <td><code>{userId}</code></td>
                                        <td><span class="req-pill req-mandatory">MANDATORY</span></td>
                                    </tr>
                                    <tr>
                                        <td><span class="param-name">txId</span></td>
                                        <td><code>{txId}</code> or <code>{trans_id}</code></td>
                                        <td><span class="req-pill req-mandatory">MANDATORY</span></td>
                                    </tr>
                                    <tr>
                                        <td><span class="param-name">coins</span></td>
                                        <td><code>{coins}</code> or <code>{amount}</code></td>
                                        <td><span class="req-pill req-mandatory">MANDATORY</span></td>
                                    </tr>
                                    <tr>
