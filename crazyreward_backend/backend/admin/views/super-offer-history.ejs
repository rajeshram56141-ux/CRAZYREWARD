<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>Super Offer History</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300..800;1,300..800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/admin.css">
    <link rel="icon" href="/images/favicon.png">
    <style>
        body.dashboard-body {
            background-color: #f3f4f6 !important;
            font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif !important;
        }

        .history-page-container {
            max-width: 1440px;
            margin: 0 auto;
            padding: 24px;
        }

        /* 1. Page Header Card */
        .history-header-card {
            background: #ffffff;
            border-radius: 20px;
            padding: 24px;
            margin-bottom: 24px;
            border: 1px solid #e2e8f0;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 16px;
        }

        .history-header-title h1 {
            font-size: 24px;
            font-weight: 800;
            color: #0f172a;
            margin: 0 0 4px;
        }

        .history-header-title p {
            font-size: 14px;
            color: #64748b;
            margin: 0;
        }

        /* 2. Stats Grid */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 16px;
            margin-bottom: 24px;
        }

        @media (max-width: 1024px) {
            .stats-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @media (max-width: 640px) {
            .stats-grid {
                grid-template-columns: 1fr;
            }
        }

        .stat-card {
            background: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 18px;
            padding: 20px;
            text-align: left;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.02);
            position: relative;
            overflow: hidden;
        }

        .stat-card-label {
            font-size: 11px;
            font-weight: 700;
            color: #94a3b8;
            text-transform: uppercase;
            letter-spacing: 0.6px;
            margin-bottom: 6px;
        }

        .stat-card-value {
            font-size: 24px;
            font-weight: 800;
            color: #0f172a;
        }

        .stat-card.green { background: #f0fdf4; border-color: #dcfce7; }
        .stat-card.green .stat-card-label { color: #166534; }
        .stat-card.green .stat-card-value { color: #15803d; }

        .stat-card.blue { background: #eff6ff; border-color: #bfdbfe; }
        .stat-card.blue .stat-card-label { color: #1e3a8a; }
        .stat-card.blue .stat-card-value { color: #1d4ed8; }

        .stat-card.orange { background: #fffbeb; border-color: #fde68a; }
        .stat-card.orange .stat-card-label { color: #78350f; }
        .stat-card.orange .stat-card-value { color: #d97706; }

        .stat-card.purple { background: #faf5ff; border-color: #f3e8ff; }
        .stat-card.purple .stat-card-label { color: #7e22ce; }
        .stat-card.purple .stat-card-value { color: #6b21a8; }

        /* 3. Filters Card */
        .filters-section {
            background: #ffffff;
            border-radius: 20px;
            padding: 22px;
            margin-bottom: 24px;
            border: 1px solid #e2e8f0;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
        }

        .filters-row {
            display: flex;
            gap: 14px;
            align-items: flex-end;
            flex-wrap: wrap;
        }

        .filter-group {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .filter-group label {
            font-size: 11px;
            font-weight: 700;
            color: #64748b;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .filter-group input,
        .filter-group select {
            background: #ffffff;
            border: 1px solid #cbd5e1;
            border-radius: 12px;
            padding: 10px 14px;
            color: #0f172a;
            font-size: 14px;
            font-weight: 600;
            min-width: 140px;
        }

        .filter-group input:focus,
        .filter-group select:focus {
            outline: none;
            border-color: #052e1f;
            box-shadow: 0 0 0 3px rgba(5, 46, 31, 0.12);
        }

        .search-input {
            flex: 1;
            min-width: 240px;
        }

        .filter-actions {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 18px;
            padding-top: 16px;
            border-top: 1px solid #f1f5f9;
            flex-wrap: wrap;
            gap: 10px;
        }

        .actions-left {
            display: flex;
            gap: 10px;
        }

        .btn-apply {
            background: #052e1f;
            color: #fff;
            border: none;
            border-radius: 12px;
            padding: 10px 22px;
            font-weight: 700;
            font-size: 14px;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .btn-apply:hover {
            background: #042418;
            transform: translateY(-1px);
        }

        .btn-reset {
            background: #f1f5f9;
            color: #475569;
            border: 1px solid #cbd5e1;
            border-radius: 12px;
            padding: 10px 20px;
            font-weight: 700;
            font-size: 14px;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .btn-reset:hover {
            background: #e2e8f0;
            color: #0f172a;
        }

        .btn-danger-action {
            background: #dc2626;
            color: #fff;
            border: none;
            border-radius: 12px;
            padding: 10px 22px;
            font-weight: 700;
            font-size: 14px;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .btn-danger-action:hover:not(:disabled) {
            background: #b91c1c;
            transform: translateY(-1px);
        }

        .btn-danger-action:disabled {
            background: #fca5a5;
            cursor: not-allowed;
            opacity: 0.7;
        }

        /* 4. Table Card */
        .history-table-container {
            background: #ffffff;
            border-radius: 20px;
            overflow: hidden;
            border: 1px solid #e2e8f0;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
        }

        .table-dark-header {
            background: #052e1f;
            color: #ffffff;
            padding: 16px 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .table-header-title {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .table-header-title h3 {
            font-size: 14px;
            font-weight: 700;
            letter-spacing: 0.6px;
            margin: 0;
            color: #ffffff;
        }

        .accent-bar {
            width: 4px;
            height: 16px;
            background: #d97706;
            border-radius: 2px;
        }

        .history-table {
            width: 100%;
            border-collapse: collapse;
        }

        .history-table th {
            background: #f8fafc;
            padding: 14px 16px;
            text-align: left;
            font-size: 12px;
            font-weight: 700;
            color: #64748b;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            border-bottom: 1px solid #e2e8f0;
        }

        .history-table td {
            padding: 14px 16px;
            border-bottom: 1px solid #f1f5f9;
            color: #0f172a;
            font-size: 13.5px;
            font-weight: 500;
            vertical-align: middle;
        }

        .history-table tr:hover td {
            background: #f8fafc;
        }

        .status-pill {
            display: inline-block;
            padding: 4px 10px;
            border-radius: 8px;
            font-size: 11px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.3px;
        }

        .status-pill.completed, .status-pill.approved { background: #dcfce7; color: #15803d; }
        .status-pill.in_progress, .status-pill.pending { background: #fef3c7; color: #b45309; }
        .status-pill.rejected { background: #fee2e2; color: #dc2626; }
        .status-pill.removed { background: #f1f5f9; color: #64748b; text-decoration: line-through; }
        .status-pill.skipped { background: #fef2f2; color: #991b1b; }

        .btn-row-action {
            padding: 6px 12px;
            border-radius: 8px;
            border: 1px solid #cbd5e1;
            background: #ffffff;
            font-size: 12px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.15s;
            display: inline-flex;
            align-items: center;
            gap: 4px;
        }

        .btn-row-action.edit { color: #052e1f; border-color: #a7f3d0; background: #f0fdf4; }
        .btn-row-action.edit:hover { background: #dcfce7; }

        .btn-row-action.delete { color: #dc2626; border-color: #fecaca; background: #fef2f2; }
        .btn-row-action.delete:hover { background: #fee2e2; }

        .proof-thumb {
            width: 40px;
            height: 40px;
            border-radius: 8px;
            object-fit: cover;
            border: 1.5px solid #cbd5e1;
            cursor: pointer;
            transition: transform 0.15s;
        }
        .proof-thumb:hover { transform: scale(1.1); }

        .pagination-info {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 16px 20px;
            color: #64748b;
            font-size: 13.5px;
            font-weight: 600;
            background: #ffffff;
            border-top: 1px solid #f1f5f9;
        }

        .pagination-controls {
            display: flex;
            gap: 8px;
        }

        .pagination-controls button {
            background: #f1f5f9;
            border: 1px solid #cbd5e1;
            border-radius: 10px;
            padding: 8px 16px;
            color: #0f172a;
            cursor: pointer;
            font-size: 13px;
            font-weight: 700;
            transition: all 0.2s ease;
        }

        .pagination-controls button:hover:not(:disabled) {
            background: #e2e8f0;
        }

        .pagination-controls button:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

        .checkbox-cell {
            width: 45px;
            text-align: center !important;
        }

        .checkbox-cell input[type="checkbox"] {
            width: 18px;
            height: 18px;
            cursor: pointer;
            accent-color: #052e1f;
            vertical-align: middle;
        }

        /* Modal Styles */
        .modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(15, 23, 42, 0.6);
            backdrop-filter: blur(4px);
            display: none;
            justify-content: center;
            align-items: center;
            z-index: 9999;
            padding: 20px;
        }

        .modal-card {
            background: #ffffff;
            border-radius: 20px;
            max-width: 580px;
            width: 100%;
            max-height: 90vh;
            overflow-y: auto;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);
            border: 1px solid #e2e8f0;
        }

        .modal-header {
            padding: 20px 24px;
            border-bottom: 1px solid #f1f5f9;
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: #fafafa;
            border-radius: 20px 20px 0 0;
        }

        .modal-header h3 {
            margin: 0;
            font-size: 17px;
            font-weight: 800;
            color: #0f172a;
        }

        .modal-close-btn {
            background: transparent;
            border: none;
            font-size: 20px;
            font-weight: 800;
            color: #64748b;
            cursor: pointer;
        }

        .modal-body {
            padding: 24px;
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        .modal-footer {
            padding: 16px 24px;
            border-top: 1px solid #f1f5f9;
            display: flex;
            justify-content: flex-end;
            gap: 10px;
            background: #fafafa;
            border-radius: 0 0 20px 20px;
        }
    </style>
</head>

<body class="dashboard-body">

    <%- include('partials/user_lookup') %>

    <!-- Inline Alert Modal -->
    <div id="alert-modal" class="modal">
        <div class="modal-content">
            <h3>Notification</h3>
            <p class="alert-message">Something happened</p>
            <div class="modal-actions">
                <button id="alert-ok" class="btn-ok">OK</button>
            </div>
        </div>
    </div>

    <div class="dashboard-shell">
        <%- include('partials/sidebar', { activePage: 'super-offer-history' }) %>

        <div class="dashboard-main">
            <header class="navbar dashboard-navbar">
                <div class="nav-left">
                    <button type="button" class="sidebar-toggle-btn" onclick="toggleSidebar()">
                        ☰
                    </button>
                    <h2>Super Offer History</h2>

                    <select id="appSelect" onchange="onAppChanged()">
                        <% (firebaseServices || []).forEach(service=> { %>
                            <option value="<%= service.appName %>">
                                <%= service.displayName %>
                            </option>
                        <% }) %>
                    </select>
                </div>

                <div class="nav-right" onclick="toggleDropdown()">
                    <div class="avatar">
                        <%- typeof photo !== 'undefined' && photo ? photo : 'A' %>
                    </div>
                    <div class="dropdown" id="dropdown">
                        <a href="/logout">Logout</a>
                    </div>
                </div>
            </header>

            <main class="container history-page-container">
                <div class="history-header-card">
                    <div class="history-header-title">
                        <h1>🔥 Super Offer History</h1>
                        <p>Complete historical logs of all installed offers, verification steps, and coin rewards with full edit controls.</p>
                    </div>

                    <button type="button" class="btn-apply" onclick="openUserLookupModal()">
                        <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" style="vertical-align: middle; margin-right: 6px;"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                        Search User Details
                    </button>
                </div>

                <!-- Stats Cards -->
                <div class="stats-grid">
                    <div class="stat-card purple">
                        <div class="stat-card-label">Today's Super Offer Coins</div>
                        <div class="stat-card-value" id="stat-today">0</div>
                    </div>
                    <div class="stat-card green">
                        <div class="stat-card-label">This Month's Coins</div>
                        <div class="stat-card-value" id="stat-month">0</div>
                    </div>
                    <div class="stat-card orange">
                        <div class="stat-card-label">In-Progress Tasks</div>
                        <div class="stat-card-value" id="stat-inprogress">0</div>
                    </div>
                    <div class="stat-card blue">
                        <div class="stat-card-label">Total Completed Steps</div>
                        <div class="stat-card-value" id="stat-completed">0</div>
                    </div>
                </div>

                <!-- Filters -->
                <div class="filters-section">
                    <div class="filters-row">
                        <div class="filter-group">
                            <label>From Date</label>
                            <input type="date" id="startDateInput">
                        </div>
                        <div class="filter-group">
                            <label>To Date</label>
                            <input type="date" id="endDateInput">
                        </div>
                        <div class="filter-group">
                            <label>Status</label>
                            <select id="statusFilter">
                                <option value="">All Statuses</option>
                                <option value="completed">Completed / Approved</option>
                                <option value="in_progress">In Progress</option>
                                <option value="pending">Pending</option>
                                <option value="rejected">Rejected</option>
                                <option value="skipped">Skipped</option>
                                <option value="removed">Removed</option>
                            </select>
                        </div>
                        <div class="filter-group">
                            <label>Step Type</label>
                            <select id="stepTypeFilter">
                                <option value="">All Steps</option>
                                <option value="install">Step 1: Install</option>
                                <option value="screenshot">Step 2: Screenshot</option>
                                <option value="usage">Step 3+: Usage</option>
                            </select>
                        </div>
                        <div class="filter-group search-input">
                            <label>Search User / Package / App</label>
                            <input type="text" id="searchInput" placeholder="User ID, Email, App Name or Package...">
                        </div>
                    </div>
                    <div class="filter-actions">
                        <div class="actions-left">
                            <button class="btn-apply" onclick="applyFilters()">Apply Filters</button>
                            <button class="btn-reset" onclick="resetFilters()">Reset</button>
                        </div>
                        <button class="btn-danger-action" id="btnDeleteSelected" disabled onclick="executeBulkDelete()">
                            <i class="fa-solid fa-trash-can" style="margin-right: 4px;"></i> Delete Selected (<span id="deleteCount">0</span>)
                        </button>
                    </div>
                </div>

                <!-- History Table -->
                <div class="history-table-container">
                    <div class="table-dark-header">
                        <div class="table-header-title">
                            <span class="accent-bar"></span>
                            <h3>SUPER OFFER LOGGED ACTIVITY RECORDS</h3>
                        </div>
                    </div>

                    <div id="tableContent">
                        <div class="loading-spinner">Loading super offer records...</div>
                    </div>

                    <div class="pagination-info" id="paginationInfo" style="display: none;">
                        <span id="paginationText">Showing 0-0 of 0 records</span>
                        <div class="pagination-controls">
                            <button id="prevBtn" onclick="changePage(-1)">Previous</button>
                            <button id="nextBtn" onclick="changePage(1)">Next</button>
                        </div>
                    </div>
                </div>
            </main>
        </div>
    </div>

    <!-- EDIT RECORD MODAL -->
    <div class="modal-overlay" id="editRecordModal">
        <div class="modal-card">
            <div class="modal-header">
                <h3>✏️ Edit Super Offer Record</h3>
                <button class="modal-close-btn" onclick="closeEditModal()">✕</button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="editRecordId">

                <div class="filter-group">
                    <label>User ID</label>
                    <input type="text" id="editUserId" readonly style="background: #f1f5f9; cursor: not-allowed;">
                </div>

                <div class="filter-group">
                    <label>App Name</label>
                    <input type="text" id="editAppName">
                </div>

                <div class="filter-group">
                    <label>Package Name</label>
                    <input type="text" id="editPackageName">
                </div>

                <div style="display: flex; gap: 12px;">
                    <div class="filter-group" style="flex: 1;">
                        <label>Step Number</label>
                        <input type="number" id="editStepNumber" min="1">
                    </div>
                    <div class="filter-group" style="flex: 2;">
                        <label>Step Name</label>
                        <input type="text" id="editStepName">
                    </div>
                </div>

                <div style="display: flex; gap: 12px;">
                    <div class="filter-group" style="flex: 1;">
                        <label>Coins (🪙)</label>
                        <input type="number" id="editCoins">
                    </div>
                    <div class="filter-group" style="flex: 1;">
                        <label>Usage Minutes</label>
                        <input type="number" id="editUsageMinutes" step="0.5">
                    </div>
                </div>

                <div class="filter-group">
                    <label>Status</label>
                    <select id="editStatus">
                        <option value="completed">Completed</option>
                        <option value="approved">Approved</option>
                        <option value="in_progress">In Progress</option>
                        <option value="pending">Pending</option>
                        <option value="rejected">Rejected</option>
                        <option value="skipped">Skipped</option>
                        <option value="removed">Removed</option>
                    </select>
                </div>

                <div class="filter-group" id="editRejectionGroup">
                    <label>Rejection Reason (Optional)</label>
                    <input type="text" id="editRejectionReason" placeholder="e.g. Invalid screenshot proof">
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn-reset" onclick="closeEditModal()">Cancel</button>
                <button class="btn-apply" id="btnSaveRecord" onclick="saveRecordChanges()">💾 Save Changes</button>
            </div>
        </div>
    </div>

    <script src="/js/admin.js"></script>
    <script src="/js/user_lookup.js"></script>
    <script src="/js/super-offer-history.js"></script>
</body>

</html>
