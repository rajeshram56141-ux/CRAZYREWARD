<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>Reward History</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300..800;1,300..800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/admin.css">
    <link rel="icon" href="/images/favicon.png">
    <style>
        body.dashboard-body {
            background-color: #f3f4f6 !important;
            font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif !important;
        }

        .history-page-container {
            max-width: 1440px;
            margin: 0 auto;
            padding: 24px;
        }

        /* 1. Page Header Card */
        .history-header-card {
            background: #ffffff;
            border-radius: 20px;
            padding: 24px;
            margin-bottom: 24px;
            border: 1px solid #e2e8f0;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 16px;
        }

        .history-header-title h1 {
            font-size: 24px;
            font-weight: 800;
            color: #0f172a;
            margin: 0 0 4px;
        }

        .history-header-title p {
            font-size: 14px;
            color: #64748b;
            margin: 0;
        }

        /* 2. Stats Grid */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 16px;
            margin-bottom: 24px;
        }

        @media (max-width: 768px) {
            .stats-grid {
                grid-template-columns: 1fr;
            }
        }

        .stat-card {
            background: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 18px;
            padding: 20px;
            text-align: left;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.02);
            position: relative;
            overflow: hidden;
        }

        .stat-card-label {
            font-size: 11px;
            font-weight: 700;
            color: #94a3b8;
            text-transform: uppercase;
            letter-spacing: 0.6px;
            margin-bottom: 6px;
        }

        .stat-card-value {
            font-size: 24px;
            font-weight: 800;
            color: #0f172a;
        }

        .stat-card.green { background: #f0fdf4; border-color: #dcfce7; }
        .stat-card.green .stat-card-label { color: #166534; }
        .stat-card.green .stat-card-value { color: #15803d; }

        .stat-card.blue { background: #eff6ff; border-color: #bfdbfe; }
        .stat-card.blue .stat-card-label { color: #1e3a8a; }
        .stat-card.blue .stat-card-value { color: #1d4ed8; }

        .stat-card.orange { background: #fffbeb; border-color: #fde68a; }
        .stat-card.orange .stat-card-label { color: #78350f; }
        .stat-card.orange .stat-card-value { color: #d97706; }

        /* 3. Filters Card */
        .filters-section {
            background: #ffffff;
            border-radius: 20px;
            padding: 22px;
            margin-bottom: 24px;
            border: 1px solid #e2e8f0;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
        }

        .filters-row {
            display: flex;
            gap: 14px;
            align-items: flex-end;
            flex-wrap: wrap;
        }

        .filter-group {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .filter-group label {
            font-size: 11px;
            font-weight: 700;
            color: #64748b;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .filter-group input,
        .filter-group select {
            background: #ffffff;
            border: 1px solid #cbd5e1;
            border-radius: 12px;
            padding: 10px 14px;
            color: #0f172a;
            font-size: 14px;
            font-weight: 600;
            min-width: 140px;
        }

        .filter-group input:focus,
        .filter-group select:focus {
            outline: none;
            border-color: #052e1f;
            box-shadow: 0 0 0 3px rgba(5, 46, 31, 0.12);
        }

        .search-input {
            flex: 1;
            min-width: 240px;
        }

        .filter-actions {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 18px;
            padding-top: 16px;
            border-top: 1px solid #f1f5f9;
            flex-wrap: wrap;
            gap: 10px;
        }

        .actions-left {
            display: flex;
            gap: 10px;
        }

        .btn-apply {
            background: #052e1f;
            color: #fff;
            border: none;
            border-radius: 12px;
            padding: 10px 22px;
            font-weight: 700;
            font-size: 14px;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .btn-apply:hover {
            background: #042418;
            transform: translateY(-1px);
        }

        .btn-reset {
            background: #f1f5f9;
            color: #475569;
            border: 1px solid #cbd5e1;
            border-radius: 12px;
            padding: 10px 20px;
            font-weight: 700;
            font-size: 14px;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .btn-reset:hover {
            background: #e2e8f0;
            color: #0f172a;
        }

        .btn-danger-action {
            background: #dc2626;
            color: #fff;
            border: none;
            border-radius: 12px;
            padding: 10px 22px;
            font-weight: 700;
            font-size: 14px;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .btn-danger-action:hover:not(:disabled) {
            background: #b91c1c;
            transform: translateY(-1px);
        }

        .btn-danger-action:disabled {
            background: #fca5a5;
            cursor: not-allowed;
            opacity: 0.7;
        }

        /* 4. Table Card */
        .history-table-container {
            background: #ffffff;
            border-radius: 20px;
            overflow: hidden;
            border: 1px solid #e2e8f0;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
        }

        .table-dark-header {
            background: #052e1f;
            color: #ffffff;
            padding: 16px 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .table-header-title {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .table-header-title h3 {
            font-size: 14px;
            font-weight: 700;
            letter-spacing: 0.6px;
            margin: 0;
            color: #ffffff;
        }

        .accent-bar {
            width: 4px;
            height: 16px;
            background: #d97706;
            border-radius: 2px;
        }

        .history-table {
            width: 100%;
            border-collapse: collapse;
        }

        .history-table th {
            background: #f8fafc;
            padding: 14px 16px;
            text-align: left;
            font-size: 12px;
            font-weight: 700;
            color: #64748b;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            border-bottom: 1px solid #e2e8f0;
        }

        .history-table td {
            padding: 14px 16px;
            border-bottom: 1px solid #f1f5f9;
            color: #0f172a;
            font-size: 13.5px;
            font-weight: 500;
        }

        .history-table tr:hover td {
            background: #f8fafc;
        }

        .pagination-info {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 16px 20px;
            color: #64748b;
            font-size: 13.5px;
            font-weight: 600;
            background: #ffffff;
            border-top: 1px solid #f1f5f9;
        }

        .pagination-controls {
            display: flex;
            gap: 8px;
        }

        .pagination-controls button {
            background: #f1f5f9;
            border: 1px solid #cbd5e1;
            border-radius: 10px;
            padding: 8px 16px;
            color: #0f172a;
            cursor: pointer;
            font-size: 13px;
            font-weight: 700;
            transition: all 0.2s ease;
        }

        .pagination-controls button:hover:not(:disabled) {
            background: #e2e8f0;
        }

        .pagination-controls button:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

        .checkbox-cell {
            width: 45px;
            text-align: center !important;
        }

        .checkbox-cell input[type="checkbox"] {
            width: 18px;
            height: 18px;
            cursor: pointer;
            accent-color: #052e1f;
            vertical-align: middle;
        }
    </style>
</head>

<body class="dashboard-body">

    <%- include('partials/user_lookup') %>

    <!-- Inline Alert Modal -->
    <div id="alert-modal" class="modal">
        <div class="modal-content">
            <h3>Notification</h3>
            <p class="alert-message">Something happened</p>
            <div class="modal-actions">
                <button id="alert-ok" class="btn-ok">OK</button>
            </div>
        </div>
    </div>

    <div class="dashboard-shell">
        <%- include('partials/sidebar', { activePage: 'reward-history' }) %>

        <div class="dashboard-main">
            <header class="navbar dashboard-navbar">
                <div class="nav-left">
                    <button type="button" class="sidebar-toggle-btn" onclick="toggleSidebar()">
                        ☰
                    </button>
                    <h2>User Reward History</h2>

                    <select id="appSelect">
                        <% firebaseServices.forEach(service=> { %>
                            <option value="<%= service.appName %>">
                                <%= service.displayName %>
                            </option>
                        <% }) %>
                    </select>
                </div>

                <div class="nav-right" onclick="toggleDropdown()">
                    <div class="avatar">
                        <%- typeof photo !== 'undefined' && photo ? photo : 'A' %>
                    </div>
                    <div class="dropdown" id="dropdown">
                        <a href="/logout">Logout</a>
                    </div>
                </div>
            </header>

            <main class="container history-page-container">
                <div class="history-header-card">
                    <div class="history-header-title">
                        <h1>User Reward History</h1>
                        <p>Track, filter, and manage coin reward distribution history</p>
                    </div>

                    <button type="button" class="btn-apply" onclick="openUserLookupModal()">
                        <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" style="vertical-align: middle; margin-right: 6px;"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                        Search User Details
                    </button>
                </div>

                <!-- Stats Cards -->
                <div class="stats-grid">
                    <div class="stat-card green">
                        <div class="stat-card-label">Today's Distributed Coins</div>
                        <div class="stat-card-value" id="stat-today">0</div>
                    </div>
                    <div class="stat-card blue">
                        <div class="stat-card-label">This Month's Coins</div>
                        <div class="stat-card-value" id="stat-month">0</div>
                    </div>
                    <div class="stat-card orange">
                        <div class="stat-card-label">Total Coins Reward Logged</div>
                        <div class="stat-card-value" id="stat-total">0</div>
                    </div>
                </div>

                <!-- Filters -->
                <div class="filters-section">
                    <div class="filters-row">
                        <div class="filter-group">
                            <label>From Date</label>
                            <input type="date" id="startDate">
                        </div>
                        <div class="filter-group">
                            <label>To Date</label>
                            <input type="date" id="endDate">
                        </div>
                        <div class="filter-group search-input">
                            <label>Search by User ID</label>
                            <input type="text" id="searchInput" placeholder="Enter user ID...">
                        </div>
                    </div>
                    <div class="filter-actions">
                        <div class="actions-left">
                            <button class="btn-apply" onclick="applyFilters()">Apply Filters</button>
                            <button class="btn-reset" onclick="resetFilters()">Reset</button>
                        </div>
                        <button class="btn-danger-action" id="btnDeleteSelected" disabled onclick="deleteSelectedRecords()">
                            <i class="fa-solid fa-trash-can" style="margin-right: 4px;"></i> Delete Selected (<span id="deleteCount">0</span>)
                        </button>
                    </div>
                </div>

                <!-- History Table -->
                <div class="history-table-container">
                    <div class="table-dark-header">
                        <div class="table-header-title">
                            <span class="accent-bar"></span>
                            <h3>COIN REWARD DISTRIBUTION RECORDS</h3>
                        </div>
                    </div>

                    <div id="tableContent">
                        <div class="loading-spinner">Loading reward records...</div>
                    </div>
                    <div class="pagination-info" id="paginationInfo" style="display: none;">
                        <span id="paginationText">Showing 0-0 of 0 records</span>
                        <div class="pagination-controls">
                            <button id="prevBtn" onclick="changePage(-1)">Previous</button>
                            <button id="nextBtn" onclick="changePage(1)">Next</button>
                        </div>
                    </div>
                </div>
            </main>
        </div>
    </div>

    <script src="/js/admin.js"></script>
    <script src="/js/user_lookup.js"></script>
    <script src="/js/reward-history.js"></script>
</body>

</html>
