        function initLeaderboardMonths() {
            const select = document.getElementById('leaderboardMonthSelect');
            if (!select || select.children.length > 0) return;

            const now = new Date();
            for (let i = 0; i < 6; i++) {
                const d = new Date(now.getFullYear(), now.getMonth() - i, 1);
                const year = d.getFullYear();
                const month = String(d.getMonth() + 1).padStart(2, '0');
                const monthKey = `${year}-${month}`;
                const label = d.toLocaleString('en-US', { month: 'long', year: 'numeric' });

                const opt = document.createElement('option');
                opt.value = monthKey;
                opt.textContent = label + (i === 0 ? ' (Current Month)' : '');
                select.appendChild(opt);
            }
        }

        function formatDatetimeLocal(dateObj) {
            if (!dateObj) return '';
            const d = new Date(dateObj);
            if (isNaN(d.getTime())) return '';
            const pad = (n) => String(n).padStart(2, '0');
            return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}T${pad(d.getHours())}:${pad(d.getMinutes())}`;
        }

        function setContestPreset(type) {
            const startEl = document.getElementById('contestStartTimeModal');
            const endEl = document.getElementById('contestEndTimeModal');
            const titleEl = document.getElementById('contestTitleModal');

            if (type === 'custom') {
                if (startEl) {
                    startEl.focus();
                    startEl.style.borderColor = '#10b981';
                    startEl.style.boxShadow = '0 0 0 3px rgba(16, 185, 129, 0.25)';
                    setTimeout(() => {
                        startEl.style.borderColor = '';
                        startEl.style.boxShadow = '';
                    }, 2500);
                }
                return;
            }

            const now = new Date();
            let start = new Date(now);
            let end = new Date(now);
            let title = '';

            if (type === 'daily') {
                end.setDate(now.getDate() + 1);
                title = 'Super Offer Daily Contest';
            } else if (type === 'weekly') {
                end.setDate(now.getDate() + 7);
                title = 'Super Offer Weekly League';
            } else if (type === 'monthly') {
                end.setDate(now.getDate() + 30);
                title = 'Super Offer Monthly Championship';
            } else if (type === 'endOfMonth') {
                end = new Date(now.getFullYear(), now.getMonth() + 1, 0, 23, 59, 59);
                title = 'Super Offer Mega Contest';
            }

            if (startEl) startEl.value = formatDatetimeLocal(start);
            if (endEl) endEl.value = formatDatetimeLocal(end);
            if (titleEl && (!titleEl.value || titleEl.value.startsWith('Super Offer'))) {
                titleEl.value = title;
            }
        }

