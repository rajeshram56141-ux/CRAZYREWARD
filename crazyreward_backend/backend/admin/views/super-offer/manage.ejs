    <script>
        // Helper function for XSS protection and string formatting
        function escapeHtml(str) {
            if (str === null || str === undefined) return '';
            return String(str)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#039;');
        }

        // Initial active method from server
        let currentActiveMethod = parseInt(document.getElementById('activeMethod')?.value) || 1;
        let pendingTargetMethod = null;

        function handleMethodToggleClick(targetMethod, event) {
            if (targetMethod === currentActiveMethod) {
                // User clicked the currently active toggle switch (trying to turn it off)
                event.preventDefault();
                document.getElementById('methodToggle' + targetMethod).checked = true;
                alert('Method ' + targetMethod + ' is currently active. At least one method must remain active. To change, click the toggle switch of another method.');
                return;
            }

            // User wants to switch to a different method -> Prompt confirmation!
            event.preventDefault();
            pendingTargetMethod = targetMethod;

            const modalMsg = document.getElementById('methodSwitchMessage');
            if (modalMsg) {
                modalMsg.innerHTML = '<strong>Method ' + currentActiveMethod + '</strong> is currently active.<br><br>Switching to <strong>Method ' + targetMethod + '</strong> will immediately deactivate Method ' + currentActiveMethod + ' and set Method ' + targetMethod + ' as the operational Super Offer flow.<br><br>Do you want to proceed?';
            }
            const modal = document.getElementById('methodSwitchModal');
            if (modal) modal.style.display = 'flex';
        }

        function confirmMethodSwitch() {
            if (!pendingTargetMethod) return;
            currentActiveMethod = pendingTargetMethod;
            pendingTargetMethod = null;

            const modal = document.getElementById('methodSwitchModal');
            if (modal) modal.style.display = 'none';

            // Update hidden activeMethod field
            const activeInput = document.getElementById('activeMethod');
            if (activeInput) activeInput.value = currentActiveMethod;

            const displayNum = document.getElementById('activeMethodNumberDisplay');
            if (displayNum) displayNum.innerText = currentActiveMethod;

            // Update UI on all 4 method cards
            for (let m = 1; m <= 4; m++) {
                const isThisActive = (m === currentActiveMethod);
                const toggle = document.getElementById('methodToggle' + m);
                if (toggle) toggle.checked = isThisActive;

                const badge = document.getElementById('methodBadge' + m);
                if (badge) {
                    badge.className = isThisActive ? 'badge-active' : 'badge-inactive';
                    badge.innerText = isThisActive ? '● ACTIVE' : 'INACTIVE';
                }

                const card = document.getElementById('methodCard' + m);
                if (card) {
                    card.className = 'method-card ' + (isThisActive ? 'active-method' : 'inactive-method');
                    const header = card.querySelector('.config-card-header');
                    if (header) {
                        header.style.background = isThisActive ? '#f0fdf4' : '#fafcfb';
                    }
                }
            }

            // Auto-save configuration immediately so server DB syncs without manual Save click
            saveSuperOfferConfig(new Event('submit'));
        }

        function cancelMethodSwitch() {
            if (pendingTargetMethod) {
                const toggle = document.getElementById('methodToggle' + pendingTargetMethod);
                if (toggle) toggle.checked = false;
            }
            pendingTargetMethod = null;
            const modal = document.getElementById('methodSwitchModal');
            if (modal) modal.style.display = 'none';
        }

        // Initial config usage steps from server
        let initialUsageSteps = [];
        try {
            const rawJson = document.getElementById('initialUsageStepsJson')?.value || '[]';
            initialUsageSteps = JSON.parse(rawJson);
        } catch (e) {
            initialUsageSteps = [
                { stepNumber: 1, name: 'Use App Step 1', minutes: 5, coins: 672, hoursGap: 0 },
                { stepNumber: 2, name: 'Use App Step 2', minutes: 5, coins: 672, hoursGap: 24 },
                { stepNumber: 3, name: 'Use App Step 3', minutes: 5, coins: 1152, hoursGap: 24 }
            ];
        }

        let usageSteps = [...initialUsageSteps];

        function renderUsageSteps() {
            const containerM3 = document.getElementById('usageStepsContainerM3');
            const containerM4 = document.getElementById('usageStepsContainerM4');

            [containerM3, containerM4].forEach((container) => {
                if (!container) return;
                container.innerHTML = '';

                if (usageSteps.length === 0) {
                    container.innerHTML = '<p style="font-size: 13px; color: var(--text-muted); margin: 0; padding: 12px 0;">No usage steps configured yet. Click "+ Add Step" to add one.</p>';
                    return;
                }

                usageSteps.forEach((step, idx) => {
                    const stepDiv = document.createElement('div');
                    stepDiv.style.cssText = 'background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 14px;';
                    stepDiv.innerHTML = `
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
                            <strong style="font-size: 13.5px; color: #052e1f;">Usage Step ${idx + 1}: ${step.name || 'Use App'}</strong>
                            <button type="button" class="btn-del-step" onclick="removeUsageStep(${idx})"><i class="fa-solid fa-trash-can" style="margin-right: 4px;"></i> Remove</button>
                        </div>
                        <div class="form-grid-2">
                            <div class="field-group">
                                <label class="field-label">Required Usage (Seconds)</label>
                                <input type="number" class="field-input" min="1" value="${step.usageSeconds !== undefined ? step.usageSeconds : ((step.minutes || 5) * 60)}" oninput="updateStepData(${idx}, 'usageSeconds', this.value)">
                                <span class="field-help">Time to use app in seconds (e.g. 30s, 60s = 1m, 300s = 5m)</span>
                            </div>
                            <div class="field-group">
                                <label class="field-label">Coins Reward</label>
                                <input type="number" class="field-input" min="0" value="${step.coins || 0}" oninput="updateStepData(${idx}, 'coins', this.value)">
                            </div>
                            <div class="field-group">
                                <label class="field-label">Cooldown Gap (Seconds)</label>
                                <input type="number" class="field-input" min="0" value="${step.cooldownSeconds !== undefined ? step.cooldownSeconds : (step.hoursGap || 0)}" oninput="updateStepData(${idx}, 'cooldownSeconds', this.value)">
                                <span class="field-help">Wait time in seconds after previous step (e.g. 60, 300, 3600, 86400)</span>
                            </div>
                            <div class="field-group">
                                <label class="field-label">Step Label</label>
                                <input type="text" class="field-input" value="${step.name || `Use App Step ${idx + 1}`}" oninput="updateStepData(${idx}, 'name', this.value)">
                            </div>
                        </div>
                    `;
                    container.appendChild(stepDiv);
                });
            });
        }

        function toggleAutoApproveFields() {
            const el = document.getElementById('screenshotApprovalType');
            if (!el) return;
            const val = el.value;
            const group = document.getElementById('autoApproveDelayGroup');
            if (group) {
                group.style.display = val === 'auto' ? '' : 'none';
            }
        }

        function addNewUsageStep() {
            const nextIdx = usageSteps.length + 1;
            usageSteps.push({
                stepNumber: nextIdx,
                name: `Use App Step ${nextIdx}`,
                usageSeconds: 300,
                minutes: 5,
                coins: 500,
                cooldownSeconds: 86400,
                hoursGap: 86400
            });
            renderUsageSteps();
        }

        function removeUsageStep(idx) {
            usageSteps.splice(idx, 1);
            usageSteps.forEach((s, i) => { s.stepNumber = i + 1; });
            renderUsageSteps();
        }

        function updateStepData(idx, field, val) {
            if (!usageSteps[idx]) return;
            if (field === 'minutes' || field === 'usageSeconds' || field === 'coins' || field === 'hoursGap' || field === 'cooldownSeconds') {
                const parsedNum = parseInt(val) || 0;
                usageSteps[idx][field] = parsedNum;
                if (field === 'usageSeconds') {
                    usageSteps[idx]['minutes'] = Math.ceil(parsedNum / 60) || 1;
                } else if (field === 'minutes') {
                    usageSteps[idx]['usageSeconds'] = parsedNum * 60;
                }
                if (field === 'cooldownSeconds') {
                    usageSteps[idx]['hoursGap'] = parsedNum;
                }
            } else {
                usageSteps[idx][field] = val;
            }
        }

        function switchSoTab(tab) {
            document.getElementById('tabBtnConfig').classList.toggle('active', tab === 'config');
            document.getElementById('tabBtnProofs').classList.toggle('active', tab === 'proofs');
            const lbBtn = document.getElementById('tabBtnLeaderboard');
            if (lbBtn) lbBtn.classList.toggle('active', tab === 'leaderboard');

            document.getElementById('so-panel-config').style.display = tab === 'config' ? 'block' : 'none';
            document.getElementById('so-panel-proofs').style.display = tab === 'proofs' ? 'block' : 'none';
            const lbPanel = document.getElementById('so-panel-leaderboard');
            if (lbPanel) lbPanel.style.display = tab === 'leaderboard' ? 'block' : 'none';

            if (tab === 'proofs') {
                fetchPendingProofs();
            } else if (tab === 'leaderboard') {
                initLeaderboardMonths();
                fetchAdminLeaderboard();
            }
        }

        async function saveSuperOfferConfig(e) {
            e.preventDefault();
            const statusHeader = document.getElementById('saveStatusHeader');
            
            function setStatus(msg, color) {
                if (statusHeader) { statusHeader.innerText = msg; statusHeader.style.color = color; }
            }

            setStatus('Saving changes...', '#64748b');

            const rawTargetScores = document.getElementById('targetScores')?.value || '10, 20, 30';
            const targetScores = rawTargetScores
                .split(',')
                .map(s => parseInt(s.trim()))
                .filter(n => !isNaN(n) && n > 0);

            const rawHowToPlay = document.getElementById('howToPlay')?.value || '';
            const howToPlay = rawHowToPlay
                .split('\n')
                .map(s => s.trim())
                .filter(Boolean);

            const superOfferLimitVal = document.getElementById('dailyLimit')?.value.trim() || '10';
            const gameLimitVal = document.getElementById('gameDailyLimit')?.value.trim() || '10-20';

            const payload = {
                appData: {
                    superOfferConfig: {
                        activeMethod: currentActiveMethod,
                        reward: parseInt(document.getElementById('reward')?.value) || 0,
                        gemsRequired: parseInt(document.getElementById('gemsRequired')?.value) || 0,
                        limitType: document.getElementById('limitType')?.value || 'hours',
                        hoursGap: document.getElementById('hoursGap')?.value || '60',
                        gapMinutes: document.getElementById('hoursGap')?.value || '60',
                        dailyLimit: superOfferLimitVal,
                        superOfferDailyLimit: superOfferLimitVal,
                        gameDailyLimit: gameLimitVal,
                        adsRequired: document.getElementById('adsRequired')?.value === 'true',
                        initialUsageSeconds: parseInt(document.getElementById('initialUsageSeconds')?.value) || 120,
                        superOfferVerificationEnabled: (currentActiveMethod === 3 || currentActiveMethod === 4),
                        screenshotVerificationEnabled: (currentActiveMethod === 4),
                        screenshotCoins: parseInt(document.getElementById('screenshotCoins')?.value) || 200,
                        screenshotApprovalType: document.getElementById('screenshotApprovalType')?.value || 'auto',
                        screenshotAutoApproveDelay: document.getElementById('screenshotAutoApproveDelay')?.value.trim() || '10-15',
                        usageSteps: usageSteps,
                        installTask: (currentActiveMethod !== 1),
                        installGems: parseInt(document.getElementById('installGems')?.value) || 0,
                        gameGems: parseInt(document.getElementById('gameGems')?.value) || 0,
                        gameInstallTaskTriggerLimit: document.getElementById('gameInstallTaskTriggerLimit')?.value.trim() || '10-20',
                        adType: document.getElementById('adType')?.value || 'rewarded',
                        installTaskMb: parseInt(document.getElementById('installTaskMb')?.value) || 15,
                        targetScores: targetScores.length > 0 ? targetScores : [10, 20, 30],
                        tutorialUrl: document.getElementById('tutorialUrl')?.value.trim() || '',
                        howToPlay: howToPlay
                    }
                }
            };

            try {
                const res = await fetch('/app-data-config/app-data', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const data = await res.json();
                if (data.success) {
                    setStatus('Saved successfully! (Method ' + currentActiveMethod + ' Active)', '#10b981');
                    setTimeout(() => { setStatus('', '#64748b'); }, 3000);
                } else {
                    setStatus('Failed: ' + (data.message || 'Error'), '#ef4444');
                }
            } catch (err) {
                console.error(err);
                setStatus('Request failed', '#ef4444');
