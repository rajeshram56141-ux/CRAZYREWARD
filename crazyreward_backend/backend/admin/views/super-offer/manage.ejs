        async function fetchAdminLeaderboard(selectedId) {
            const select = document.getElementById('leaderboardMonthSelect');
            const contestId = selectedId || (select ? select.value : '');
            const tbody = document.getElementById('adminLeaderboardBody');
            if (tbody) tbody.innerHTML = '<tr><td colspan="7" style="text-align: center; color: var(--text-muted); padding: 36px;">Loading leaderboard data...</td></tr>';

            try {
                const res = await fetch(`/admin/super-offer/leaderboard?contestId=${encodeURIComponent(contestId)}`);
                const data = await res.json();
                if (!data.success) throw new Error(data.message || 'Failed to load');

                const contest = data.contest || {};
                const allContests = data.allContests || [];

                // Populate Select Dropdown with all active/created contests
                if (select && allContests.length > 0) {
                    const currentVal = contest.contestId || contest.monthKey;
                    select.innerHTML = allContests.map(c => {
                        const cid = c.contestId || c._id;
                        const isSel = (cid === currentVal || c.monthKey === currentVal) ? 'selected' : '';
                        const stBadge = c.isActive !== false ? '🟢 Active' : '🔴 Paused';
                        return `<option value="${cid}" ${isSel} style="color: #0f172a; background: #ffffff;">${c.title || 'Contest'} - ${stBadge}</option>`;
                    }).join('');
                }

                // Update Live Summary Card
                if (document.getElementById('summaryContestTitle')) document.getElementById('summaryContestTitle').innerText = contest.title || 'Super Offer Bumper League';
                if (document.getElementById('summaryContestSubtitle')) document.getElementById('summaryContestSubtitle').innerText = contest.subtitle || 'Unlock maximum super offers & win Bumper Prizes!';
                
                if (document.getElementById('summaryStartTime')) {
                    document.getElementById('summaryStartTime').innerText = contest.startTime ? new Date(contest.startTime).toLocaleString() : 'Not Set';
                }
                if (document.getElementById('summaryEndTime')) {
                    document.getElementById('summaryEndTime').innerText = contest.endTime ? new Date(contest.endTime).toLocaleString() : 'Not Set';
                }

                const prizes = contest.prizes || [];
                if (document.getElementById('summaryPrizeCount')) {
                    document.getElementById('summaryPrizeCount').innerText = prizes.length + ' Tiers Configured';
                }

                const isActive = contest.isActive !== false;
                const toggleHeader = document.getElementById('contestActiveToggleHeader');
                const labelHeader = document.getElementById('contestActiveLabelHeader');
                const toggleModal = document.getElementById('contestIsActiveModal');
                
                if (toggleHeader) toggleHeader.checked = isActive;
                if (toggleModal) toggleModal.checked = isActive;
                if (labelHeader) {
                    labelHeader.innerText = isActive ? 'ON (Visible)' : 'OFF (Hidden)';
                    labelHeader.style.color = isActive ? '#4ade80' : '#f87171';
                }

                const statusBadge = document.getElementById('summaryStatusBadge');
                if (statusBadge) {
                    if (contest.isWinnerDeclared) {
                        statusBadge.innerText = '🏆 WINNERS DECLARED';
                        statusBadge.style.background = '#8b5cf6';
                    } else if (!isActive) {
                        statusBadge.innerText = 'PAUSED / OFF';
                        statusBadge.style.background = '#ef4444';
                    } else {
                        statusBadge.innerText = 'ACTIVE';
                        statusBadge.style.background = '#22c55e';
                    }
                }

                // Fill Modal Input Fields
                if (document.getElementById('contestTitleModal')) document.getElementById('contestTitleModal').value = contest.title || '';
                if (document.getElementById('contestSubtitleModal')) document.getElementById('contestSubtitleModal').value = contest.subtitle || '';
                if (document.getElementById('contestStartTimeModal')) document.getElementById('contestStartTimeModal').value = formatDatetimeLocal(contest.startTime);
                if (document.getElementById('contestEndTimeModal')) document.getElementById('contestEndTimeModal').value = formatDatetimeLocal(contest.endTime);

                if (prizes.length > 0) {
                    const p1 = prizes.find(p => p.minRank === 1 || p.rankRange === "1");
                    const p2 = prizes.find(p => p.minRank === 2 || p.rankRange === "2");
                    const p3 = prizes.find(p => p.minRank === 3 || p.rankRange === "3");
                    const p4 = prizes.find(p => p.minRank >= 4 || (p.rankRange && p.rankRange.includes("-")));

                    if (p1) {
                        if (document.getElementById('prize1Title')) document.getElementById('prize1Title').value = p1.title || '';
                        if (document.getElementById('prize1ImageUrl')) document.getElementById('prize1ImageUrl').value = p1.imageUrl || '';
                    }
                    if (p2) {
                        if (document.getElementById('prize2Title')) document.getElementById('prize2Title').value = p2.title || '';
                        if (document.getElementById('prize2ImageUrl')) document.getElementById('prize2ImageUrl').value = p2.imageUrl || '';
                    }
                    if (p3) {
                        if (document.getElementById('prize3Title')) document.getElementById('prize3Title').value = p3.title || '';
                        if (document.getElementById('prize3ImageUrl')) document.getElementById('prize3ImageUrl').value = p3.imageUrl || '';
                    }
                    if (p4) {
                        if (document.getElementById('prize4MinRank')) document.getElementById('prize4MinRank').value = p4.minRank || 4;
                        if (document.getElementById('prize4MaxRank')) document.getElementById('prize4MaxRank').value = p4.maxRank || 12;
                        if (document.getElementById('prize4Title')) document.getElementById('prize4Title').value = p4.title || '';
                        if (document.getElementById('prize4ImageUrl')) document.getElementById('prize4ImageUrl').value = p4.imageUrl || '';
                        updatePrize4Header();
                    }
                }

                // Render Table
                const rows = data.leaderboard || [];
                if (rows.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="7" style="text-align: center; color: var(--text-muted); padding: 36px;">No users found in leaderboard for this month.</td></tr>';
                    return;
                }

                tbody.innerHTML = rows.map((u, i) => {
                    const rank = i + 1;
                    const badge = rank === 1 ? '🥇 Rank 1' : rank === 2 ? '🥈 Rank 2' : rank === 3 ? '🥉 Rank 3' : `#${rank}`;
                    const isDisq = u.isDisqualified;
                    const dateStr = u.lastUnlockedAt ? new Date(u.lastUnlockedAt).toLocaleString() : 'N/A';

                    return `
                        <tr style="border-bottom: 1px solid #e2e8f0; font-size: 13px; ${isDisq ? 'opacity: 0.5; background: #fff1f2;' : ''}">
                            <td style="padding: 12px 10px; font-weight: 800; color: ${rank <= 3 ? '#b45309' : '#0f172a'};">${badge}</td>
                            <td style="padding: 12px 10px; font-weight: 700;">
                                <div style="display: flex; align-items: center; gap: 8px;">
                                    <img src="${u.avatar || 'https://cdn-icons-png.flaticon.com/512/847/847969.png'}" style="width: 28px; height: 28px; border-radius: 50%; object-fit: cover;">
                                    <span>${escapeHtml(u.userName || 'User')}</span>
                                </div>
                            </td>
                            <td style="padding: 12px 10px; font-family: monospace; color: #475569;">${escapeHtml(u.userId)}</td>
                            <td style="padding: 12px 10px; font-weight: 800; color: #15803d;">⚡ ${u.unlockCount} Offers</td>
                            <td style="padding: 12px 10px; color: #64748b;">${dateStr}</td>
                            <td style="padding: 12px 10px;">
                                ${isDisq ? '<span style="color: #ef4444; font-weight: 800;">Disqualified</span>' : '<span style="color: #22c55e; font-weight: 800;">Active</span>'}
                            </td>
                            <td style="padding: 12px 10px; text-align: right;">
                                <button type="button" class="btn-del-step" style="padding: 4px 10px; font-size: 11.5px;" onclick="toggleDisqualifyUser('${escapeHtml(u.userId)}')">
                                    ${isDisq ? 'Re-qualify' : 'Disqualify'}
                                </button>
                            </td>
                        </tr>
                    `;
                }).join('');
            } catch (err) {
                if (tbody) tbody.innerHTML = `<tr><td colspan="7" style="text-align: center; color: #ef4444; padding: 24px;">Failed to load: ${err.message}</td></tr>`;
            }
