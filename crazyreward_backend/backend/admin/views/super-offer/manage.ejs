        async function fetchPendingProofs() {
            const searchInput = document.getElementById('proofSearchInput');
            const statusFilter = document.getElementById('proofStatusFilter');
            const search = searchInput ? searchInput.value.trim() : '';
            const status = statusFilter ? statusFilter.value : 'pending';
            const tbody = document.getElementById('proofsTableBody');
            if (!tbody) return;
            tbody.innerHTML = '<tr><td colspan="7" style="text-align: center; color: var(--text-muted); padding: 36px;"><i class="fa-solid fa-spinner fa-spin" style="margin-right: 6px;"></i> Loading proofs...</td></tr>';

            try {
                const res = await fetch(`/admin/super-offer/pending-proofs?search=${encodeURIComponent(search)}&status=${encodeURIComponent(status)}`);
                const data = await res.json();

                if (data.success && Array.isArray(data.proofs)) {
                    const localPending = data.proofs.filter(p => !p.status || String(p.status).toLowerCase().startsWith('pending')).length;
                    const finalCount = (data.pendingCount !== undefined && data.pendingCount > localPending)
                        ? data.pendingCount
                        : ((status === 'pending' && !search) ? data.proofs.length : localPending);
                    updatePendingBadge(finalCount);
                } else if (data.pendingCount !== undefined) {
                    updatePendingBadge(data.pendingCount);
                }

                if (data.success && data.proofs && data.proofs.length > 0) {
                    tbody.innerHTML = data.proofs.map(p => {
                        const statusColor = p.status === 'approved' ? '#15803d' : (p.status === 'rejected' ? '#dc2626' : '#d97706');
                        const statusBg = p.status === 'approved' ? '#dcfce7' : (p.status === 'rejected' ? '#fee2e2' : '#fef3c7');
                        const dateStr = p.createdAt ? new Date(p.createdAt).toLocaleString('en-IN') : '-';

                        let rawImg = p.imageUrl || p.proofImageUrl || '';
                        let imgUrl = rawImg;
                        if (imgUrl && !imgUrl.startsWith('http') && !imgUrl.startsWith('/') && !imgUrl.startsWith('data:')) {
                            imgUrl = '/' + imgUrl;
                        }
                        const isInvalidLocalPath = rawImg.includes('/data/user/') || rawImg.includes('/cache/');

                        let imgHtml = '<span style="color: #94a3b8; font-size: 11.5px;">No Image</span>';
                        if (isInvalidLocalPath) {
                            imgHtml = '<span style="color: #ef4444; font-size: 11px; font-weight: 700; background: #fee2e2; padding: 2px 6px; border-radius: 4px;">Old Path (Unreadable)</span>';
                        } else if (imgUrl) {
                            imgHtml = `<img src="${imgUrl}" class="proof-thumb" onclick="openImageModal('${imgUrl}')" alt="Proof" onerror="this.style.display='none'; this.nextElementSibling.style.display='inline-block';"><span style="display:none; color: #ef4444; font-size: 11px;">Image failed</span>`;
                        }

                        return `
                            <tr style="border-bottom: 1px solid #f1f5f9; font-size: 13px;">
                                <td style="padding: 12px 10px;">
                                    <strong style="color: #0f172a;">${p.userId}</strong><br>
                                    <span style="font-size: 11.5px; color: #64748b;">${p.userEmail || '-'}</span>
                                </td>
                                <td style="padding: 12px 10px; font-weight: 700;">${p.appName || 'Super Offer'}</td>
                                <td style="padding: 12px 10px;">
                                    ${imgHtml}
                                </td>
                                <td style="padding: 12px 10px; font-weight: 800; color: #b45309;"><i class="fa-solid fa-coins" style="color: #eab308; margin-right: 4px;"></i> ${p.coins || 0}</td>
                                <td style="padding: 12px 10px;">
                                    <span style="background: ${statusBg}; color: ${statusColor}; padding: 3px 8px; border-radius: 6px; font-size: 11px; font-weight: 800; text-transform: uppercase;">
                                        ${p.status}
                                    </span>
                                </td>
                                <td style="padding: 12px 10px; color: #64748b; font-size: 12px;">${dateStr}</td>
                                <td style="padding: 12px 10px; text-align: right;">
                                    ${p.status === 'pending' ? `
                                        <div style="display: inline-flex; gap: 6px;">
                                            <button type="button" class="btn-approve" onclick="approveProof('${p._id}')"><i class="fa-solid fa-check" style="margin-right: 4px;"></i> Approve</button>
                                            <button type="button" class="btn-reject" onclick="openRejectModal('${p._id}')"><i class="fa-solid fa-xmark" style="margin-right: 4px;"></i> Reject</button>
                                        </div>
                                    ` : `<span style="color: #94a3b8; font-size: 12px; font-weight: 600;">Reviewed</span>`}
                                </td>
                            </tr>
                        `;
                    }).join('');
                } else {
                    tbody.innerHTML = '<tr><td colspan="7" style="text-align: center; color: var(--text-muted); padding: 36px;">No proof records found</td></tr>';
                }
            } catch (err) {
                console.error(err);
                tbody.innerHTML = '<tr><td colspan="7" style="text-align: center; color: #ef4444; padding: 36px;">Error loading proofs</td></tr>';
            }
        }

