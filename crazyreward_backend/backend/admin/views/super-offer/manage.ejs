                if (!data.success) throw new Error(data.message || 'Failed to fetch history');

                const history = data.history || [];
                if (history.length === 0) {
                    container.innerHTML = '<div style="text-align: center; color: var(--text-muted); padding: 36px;"><i class="fa-solid fa-trophy" style="font-size: 32px; color: #cbd5e1; margin-bottom: 8px;"></i><p style="margin: 0;">No past declared contest history found yet.</p></div>';
                    return;
                }

                container.innerHTML = history.map((item) => {
                    const winners = item.winners || [];
                    const declaredDate = item.declaredAt ? new Date(item.declaredAt).toLocaleString() : 'N/A';

                    return `
                        <div style="background: #ffffff; border: 1.5px solid var(--border-color); border-radius: 14px; padding: 16px;">
                            <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px; margin-bottom: 12px;">
                                <div>
                                    <h4 style="margin: 0 0 2px 0; font-size: 16px; font-weight: 800; color: #0f172a;">${escapeHtml(item.title || 'Super Offer Bumper League')} (${item.monthKey})</h4>
                                    <span style="font-size: 12px; color: #64748b;">Declared on: <strong>${declaredDate}</strong> | By: <strong>${escapeHtml(item.declaredBy || 'Admin')}</strong></span>
                                </div>
                                <div style="display: flex; gap: 10px; align-items: center;">
                                    <span style="background: #f0fdf4; color: #15803d; padding: 4px 10px; border-radius: 20px; font-weight: 800; font-size: 12px; border: 1px solid #bbf7d0;">
                                        🏆 ${item.totalWinnersCount || winners.length} Winners
                                    </span>
                                    <span style="background: #fffbeb; color: #b45309; padding: 4px 10px; border-radius: 20px; font-weight: 800; font-size: 12px; border: 1px solid #fde68a;">
                                        💰 +${item.totalCoinsAwarded || 0} Coins Credited
                                    </span>
                                </div>
                            </div>

                            <div style="background: #f8fafc; border-radius: 10px; padding: 12px; margin-top: 10px; max-height: 200px; overflow-y: auto;">
                                <table style="width: 100%; border-collapse: collapse; font-size: 12.5px;">
                                    <thead>
                                        <tr style="border-bottom: 1px solid #e2e8f0; text-align: left; color: #64748b;">
                                            <th style="padding: 4px 8px;">Rank</th>
                                            <th style="padding: 4px 8px;">Winner Name</th>
                                            <th style="padding: 4px 8px;">User ID</th>
                                            <th style="padding: 4px 8px;">Unlocks</th>
                                            <th style="padding: 4px 8px;">Prize Awarded</th>
                                            <th style="padding: 4px 8px;">Coins</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        ${winners.slice(0, 50).map(w => `
                                            <tr style="border-bottom: 1px solid #f1f5f9;">
                                                <td style="padding: 4px 8px; font-weight: 800; color: ${w.rank <= 3 ? '#b45309' : '#0f172a'};">#${w.rank}</td>
                                                <td style="padding: 4px 8px; font-weight: 700;">${escapeHtml(w.userName || 'User')}</td>
                                                <td style="padding: 4px 8px; font-family: monospace; color: #64748b;">${escapeHtml(w.userId)}</td>
                                                <td style="padding: 4px 8px; font-weight: 700; color: #15803d;">⚡ ${w.unlockCount}</td>
                                                <td style="padding: 4px 8px; font-weight: 700; color: #0284c7;">${escapeHtml(w.prizeTitle || 'Prize')}</td>
                                                <td style="padding: 4px 8px; font-weight: 800; color: #b45309;">${w.coinBonusAwarded ? `+${w.coinBonusAwarded}` : '-'}</td>
                                            </tr>
                                        `).join('')}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    `;
                }).join('');
            } catch (err) {
                if (container) container.innerHTML = `<div style="text-align: center; color: #ef4444; padding: 24px;">Failed to load winner history: ${err.message}</div>`;
            }
        }

        async function fetchAdminLeaderboardPreviewForDeclaration() {
            const container = document.getElementById('winnerDeclarationPreviewContainer');
            if (container) container.innerHTML = '<p style="text-align: center; color: var(--text-muted); margin: 0;">Loading winner preview...</p>';

            const select = document.getElementById('leaderboardMonthSelect');
            const monthKey = select ? select.value : '';

            try {
                const res = await fetch(`/admin/super-offer/leaderboard?month=${encodeURIComponent(monthKey)}`);
                const data = await res.json();
                if (!data.success) throw new Error(data.message);

                const rows = data.leaderboard || [];
                const prizes = (data.contest && Array.isArray(data.contest.prizes)) ? data.contest.prizes : [];
                let previewHtml = `<h4 style="margin: 0 0 10px 0; color: #0f172a;">Top Standings Preview (${rows.length} Total Participants)</h4>`;
                
                if (rows.length === 0) {
                    previewHtml += '<p style="color: #64748b; margin: 0;">No active users found in leaderboard.</p>';
                } else {
                    previewHtml += '<table style="width: 100%; border-collapse: collapse; font-size: 13px;">';
                    previewHtml += '<tr style="border-bottom: 1px solid #cbd5e1; text-align: left;"><th style="padding: 6px;">Rank</th><th style="padding: 6px;">User</th><th style="padding: 6px;">Unlocks</th><th style="padding: 6px;">Prize Tier</th></tr>';
                    
                    rows.slice(0, 15).forEach((u, i) => {
                        const rank = i + 1;
                        let matchedPrize = prizes.find(p => rank >= p.minRank && rank <= p.maxRank);
                        const prizeText = matchedPrize ? `${matchedPrize.title} ${matchedPrize.coinBonus ? `(+${matchedPrize.coinBonus} Coins)` : ''}` : 'No Prize';
                        previewHtml += `<tr style="border-bottom: 1px solid #f1f5f9;"><td style="padding: 6px; font-weight: 800;">#${rank}</td><td style="padding: 6px;">${escapeHtml(u.userName)}</td><td style="padding: 6px;">⚡ ${u.unlockCount}</td><td style="padding: 6px; font-weight: 700; color: #15803d;">${prizeText}</td></tr>`;
                    });
                    previewHtml += '</table>';
                }
                if (container) container.innerHTML = previewHtml;
            } catch (err) {
                if (container) container.innerHTML = `<p style="color: #ef4444; margin: 0;">Failed to load preview: ${err.message}</p>`;
            }
        }

        async function confirmDeclareWinners() {
            const select = document.getElementById('leaderboardMonthSelect');
            const monthKey = select ? select.value : '';

            try {
                const res = await fetch('/admin/super-offer/finalize-winners', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ monthKey })
                });
                const data = await res.json();
                if (data.success) {
                    alert(data.message);
                    closeDeclareWinnersModal();
                    fetchAdminLeaderboard();
                } else {
                    alert('Error: ' + data.message);
                }
            } catch (err) {
                alert('Request failed');
            }
        }

        async function toggleDisqualifyUser(userId) {
            const select = document.getElementById('leaderboardMonthSelect');
            const monthKey = select ? select.value : '';
            if (!confirm(`Toggle qualification status for user ${userId}?`)) return;

            try {
                const res = await fetch('/admin/super-offer/toggle-disqualify', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ userId, monthKey })
                });
                const data = await res.json();
                if (data.success) {
                    fetchAdminLeaderboard();
                } else {
                    alert('Error: ' + data.message);
                }
            } catch (err) {
                alert('Request failed');
            }
        }

        // Initialize on page load
        document.addEventListener('DOMContentLoaded', () => {
            renderUsageSteps();
            toggleAutoApproveFields();
            fetchPendingProofsCount();
        });
    </script>
    <script src="/js/admin.js"></script>
</body>

</html>
