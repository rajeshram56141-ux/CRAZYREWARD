        async function saveWalletDenomination(button) {
            try {
                const card = button.closest('.wallet-card, .wallet-method-card');
                const row = button.closest('.denom-row, .wallet-denom-row');
                if (!card || !row) {
                    alert('Error: Could not find denomination container.');
                    return;
                }

                const methodId = String(card.dataset.methodId || '').trim();
                const selectedApp = String(card.dataset.appName || getVal('appSelect', ACTIVE_APP_NAME)).trim();
                const oldId = String(row.dataset.oldId || '').trim();

                const amountInput = row.querySelector('.wallet-denom-amount');
                const coinsInput = row.querySelector('.wallet-denom-coins');
                const subtitleInput = row.querySelector('.wallet-denom-subtitle');
                const enabledSelect = row.querySelector('.wallet-denom-enabled');
                const amount = Number(amountInput ? amountInput.value : 0) || 0;
                const coins = Number(coinsInput ? coinsInput.value : 0) || 0;
                const subtitle = String(subtitleInput ? subtitleInput.value : '').trim();
                const enabled = enabledSelect ? (enabledSelect.value === 'true') : true;

                if (!amount || amount <= 0 || !coins || coins <= 0) {
                    alert('Please enter valid Amount and Coins (> 0)');
                    return;
                }

                showToast('Saving denomination...', 'info');
                const res = await fetch('/wallet-catalog/denomination', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ selectedApp, methodId, oldId, oldDenominationId: oldId, amount, coins, enabled, subtitle })
                });
                const json = await res.json();
                if (!res.ok || !json.success) throw new Error(json.message || 'Failed to save denomination');

                showToast('Denomination saved successfully!', 'success');
                setTimeout(() => location.reload(), 600);
            } catch (err) {
                console.error('Error saving denomination:', err);
                alert('Save failed: ' + (err.message || err));
            }
        }

        async function deleteWalletDenomination(button) {
            try {
                const card = button.closest('.wallet-card, .wallet-method-card');
                const row = button.closest('.denom-row, .wallet-denom-row');
                if (!card || !row) return;

                const methodId = String(card.dataset.methodId || '').trim();
                const selectedApp = String(card.dataset.appName || getVal('appSelect', ACTIVE_APP_NAME)).trim();
                const oldId = String(row.dataset.oldId || '').trim();

