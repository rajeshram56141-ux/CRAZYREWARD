        async function duplicateWalletMethod(button) {
            const card = button.closest('.wallet-card, .wallet-method-card');
            if (!card) return;

            const methodId = String(card.dataset.methodId || '').trim();
            const selectedApp = String(card.dataset.appName || getVal('appSelect', ACTIVE_APP_NAME)).trim();
            const newMethodId = prompt(`Duplicate ${methodId} as new Method ID:`, `${methodId}_copy`);
            if (!newMethodId) return;

            try {
                showToast('Duplicating method...', 'info');
                const res = await fetch('/wallet-catalog/method/duplicate', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ selectedApp, sourceMethodId: methodId, targetMethodId: newMethodId })
                });
                const json = await res.json();
                if (!res.ok || !json.success) throw new Error(json.message || 'Failed to duplicate method');

                showToast('Method duplicated successfully!', 'success');
                setTimeout(() => location.reload(), 600);
            } catch (err) {
                showToast(err.message || 'Failed to duplicate method', 'error');
            }
        }

        async function deleteWalletMethod(button) {
            const card = button.closest('.wallet-card, .wallet-method-card');
            if (!card) return;

            const methodId = String(card.dataset.methodId || '').trim();
            const selectedApp = String(card.dataset.appName || getVal('appSelect', ACTIVE_APP_NAME)).trim();

