        function getVal(id, fallback) {
            const el = document.getElementById(id);
            const v = el ? el.value : '';
            return v ? v : (fallback || '');
        }

        function changeApp(appName) {
            window.location.href = `/manage-wallet?appName=${encodeURIComponent(appName)}`;
        }

        function showToast(message, type) {
            type = type || 'success';
            let container = document.querySelector('.toast-container');
            if (!container) {
                container = document.createElement('div');
                container.className = 'toast-container';
                document.body.appendChild(container);
            }

            const toast = document.createElement('div');
            toast.className = `toast toast-${type}`;
            
            let icon = '<i class="fa-solid fa-circle-info" style="color: #0284c7; font-size: 18px;"></i>';
            if (type === 'success') icon = '<i class="fa-solid fa-circle-check" style="color: #16a34a; font-size: 18px;"></i>';
            if (type === 'error') icon = '<i class="fa-solid fa-circle-xmark" style="color: #dc2626; font-size: 18px;"></i>';

            toast.innerHTML = `
                <span style="font-size:18px;">${icon}</span>
                <div style="flex:1; font-size:13px; font-weight:700; color:#1e293b;">${message}</div>
                <button type="button" style="background:none; border:none; cursor:pointer; font-size:16px; color:#94a3b8;" onclick="this.parentElement.remove()">&times;</button>
            `;

            container.appendChild(toast);
            toast.offsetHeight;
            toast.classList.add('show');
            setTimeout(() => {
                toast.classList.remove('show');
                setTimeout(() => toast.remove(), 400);
            }, 4000);
        }

        function renderValidatorsConfigurator(wrapperId, hiddenInputId) {
            const wrapper = document.getElementById(wrapperId);
            const hidden = document.getElementById(hiddenInputId);
            if (!wrapper || !hidden) return;

            const valStr = hidden.value || '';
            const validators = valStr.split(',').map(s => s.trim()).filter(Boolean);
            
            // Ensure email is always present by default
            if (!validators.includes('email') && !validators.some(v => v.startsWith('email:'))) {
                validators.unshift('email');
            }

            wrapper.innerHTML = '';
            validators.forEach(v => {
                const parts = v.split(':');
                const name = parts[0];
                const isSelection = parts.length > 1;
                const options = isSelection ? parts[1].split('|').join(', ') : '';
                addValidatorRow(wrapperId, hiddenInputId, name, isSelection, options);
            });
            updateHiddenValidators(wrapperId, hiddenInputId);
        }

        function updateHiddenValidators(wrapperId, hiddenInputId) {
            const wrapper = document.getElementById(wrapperId);
            const hidden = document.getElementById(hiddenInputId);
            if (!wrapper || !hidden) return;

            const rows = wrapper.querySelectorAll('.configurator-row');
            const validators = [];
            rows.forEach(row => {
                const nameInput = row.querySelector('.val-name');
                const selectToggle = row.querySelector('.val-toggle');
                const optInput = row.querySelector('.val-opts');
                if (!nameInput) return;

                const name = nameInput.value.trim();
                if (!name) return;

                const isSelection = selectToggle ? selectToggle.checked : false;
                if (isSelection && optInput) {
                    const opts = optInput.value.trim().split(',').map(o => o.trim()).filter(Boolean).join('|');
                    if (opts) {
                        validators.push(`${name}:${opts}`);
                    } else {
                        validators.push(name);
                    }
                } else {
                    validators.push(name);
                }
            });

            hidden.value = validators.join(', ');
            
            // Trigger hints configurators update because the available validator dropdown options changed
            const isEdit = wrapperId.startsWith('edit');
            const hintsWrapperId = isEdit ? 'edit-hints-configurator' : 'add-hints-configurator';
            const hintsTextareaId = isEdit ? 'edit-method-hints' : 'add-method-hints';
            updateHintsDropdowns(hintsWrapperId, wrapperId);
        }

        function addValidatorRow(wrapperId, hiddenInputId, name = '', isSelection = false, options = '') {
            const wrapper = document.getElementById(wrapperId);
            if (!wrapper) return;

            const isEmail = name === 'email';

            const row = document.createElement('div');
            row.className = 'configurator-row';
            row.innerHTML = `
                <input class="configurator-input val-name" type="text" placeholder="Validator key (e.g. upiId)" value="${name}" ${isEmail ? 'readonly style="background:#f1f5f9; color:#64748b; font-weight:600;"' : ''} style="flex: 2; font-weight: 500;" />
                <label style="display: inline-flex; align-items: center; gap: 4px; font-size: 11px; font-weight: bold; color: #475569; user-select: none;">
                    <input class="val-toggle" type="checkbox" ${isSelection ? 'checked' : ''} /> Selection
                </label>
                <input class="configurator-input val-opts" type="text" placeholder="Choices (e.g. GPay,PhonePe)" value="${options}" style="flex: 3; display: ${isSelection ? 'block' : 'none'};" />
                <button type="button" class="btn-config-delete" ${isEmail ? 'disabled style="opacity:0.5; cursor:not-allowed;"' : ''}><i class="fa-solid fa-trash-can"></i></button>
            `;

            const nameInput = row.querySelector('.val-name');
            const selectToggle = row.querySelector('.val-toggle');
            const optInput = row.querySelector('.val-opts');
            const delBtn = row.querySelector('.btn-config-delete');

            if (nameInput) {
                nameInput.addEventListener('input', () => updateHiddenValidators(wrapperId, hiddenInputId));
            }
            if (selectToggle) {
                selectToggle.addEventListener('change', () => {
                    optInput.style.display = selectToggle.checked ? 'block' : 'none';
                    updateHiddenValidators(wrapperId, hiddenInputId);
                });
            }
            if (optInput) {
                optInput.addEventListener('input', () => updateHiddenValidators(wrapperId, hiddenInputId));
            }
            if (delBtn && !isEmail) {
                delBtn.addEventListener('click', () => {
                    row.remove();
                    updateHiddenValidators(wrapperId, hiddenInputId);
                });
            }

            wrapper.appendChild(row);
            updateHiddenValidators(wrapperId, hiddenInputId);
        }

        function renderHintsConfigurator(wrapperId, hiddenTextareaId, validatorsHiddenInputId) {
            const wrapper = document.getElementById(wrapperId);
            const hidden = document.getElementById(hiddenTextareaId);
            if (!wrapper || !hidden) return;

            let hints = {};
            try {
                hints = JSON.parse(hidden.value || '{}');
            } catch (e) {
                console.error('Failed to parse hints:', e);
            }

            wrapper.innerHTML = '';
            Object.entries(hints).forEach(([key, hint]) => {
                addHintRow(wrapperId, hiddenTextareaId, validatorsHiddenInputId, key, hint);
            });
            updateHiddenHints(wrapperId, hiddenTextareaId);
        }

        function updateHiddenHints(wrapperId, hiddenTextareaId) {
            const wrapper = document.getElementById(wrapperId);
            const hidden = document.getElementById(hiddenTextareaId);
            if (!wrapper || !hidden) return;

            const rows = wrapper.querySelectorAll('.configurator-row');
            const hintsObj = {};
            rows.forEach(row => {
                const keySelect = row.querySelector('.hint-key');
                const textInput = row.querySelector('.hint-text');
                if (!keySelect || !textInput) return;

                const key = keySelect.value;
                const text = textInput.value.trim();
                if (key && text) {
                    hintsObj[key] = text;
                }
            });

            hidden.value = JSON.stringify(hintsObj, null, 2);
        }

        function addHintRow(wrapperId, hiddenTextareaId, validatorsHiddenInputId, key = '', hint = '') {
            const wrapper = document.getElementById(wrapperId);
            if (!wrapper) return;

            const valWrapper = document.getElementById(validatorsHiddenInputId);
            let validators = ['email'];
            if (valWrapper && valWrapper.tagName === 'DIV') {
                const names = Array.from(valWrapper.querySelectorAll('.val-name'))
                    .map(input => input.value.trim())
                    .filter(Boolean);
                names.forEach(n => {
                    if (!validators.includes(n)) validators.push(n);
                });
            } else {
                const valStr = document.getElementById(validatorsHiddenInputId)?.value || '';
                const parts = valStr.split(',').map(s => s.trim().split(':')[0]).filter(Boolean);
                parts.forEach(n => {
                    if (!validators.includes(n)) validators.push(n);
                });
            }

            const row = document.createElement('div');
            row.className = 'configurator-row';
            row.innerHTML = `
                <select class="configurator-select hint-key" style="flex: 2; height: 32px; font-weight: 600;">
                    ${validators.map(v => `<option value="${v}" ${v === key ? 'selected' : ''}>${v}</option>`).join('')}
                </select>
                <input class="configurator-input hint-text" type="text" placeholder="Hint message (e.g. Enter email ID)" value="${hint}" style="flex: 4;" />
                <button type="button" class="btn-config-delete"><i class="fa-solid fa-trash-can"></i></button>
            `;

            const keySelect = row.querySelector('.hint-key');
            const textInput = row.querySelector('.hint-text');
            const delBtn = row.querySelector('.btn-config-delete');

            if (keySelect) {
                keySelect.addEventListener('change', () => updateHiddenHints(wrapperId, hiddenTextareaId));
            }
            if (textInput) {
                textInput.addEventListener('input', () => updateHiddenHints(wrapperId, hiddenTextareaId));
            }
            if (delBtn) {
                delBtn.addEventListener('click', () => {
                    row.remove();
                    updateHiddenHints(wrapperId, hiddenTextareaId);
                });
            }

            wrapper.appendChild(row);
        }

        function updateHintsDropdowns(hintsWrapperId, validatorsWrapperId) {
            const hintsWrapper = document.getElementById(hintsWrapperId);
            const valWrapper = document.getElementById(validatorsWrapperId);
            if (!hintsWrapper || !valWrapper) return;

            // Get current list of validator clean names
            const names = Array.from(valWrapper.querySelectorAll('.val-name'))
                .map(input => input.value.trim())
                .filter(Boolean);
            if (!names.includes('email')) names.unshift('email');

            const selects = hintsWrapper.querySelectorAll('.hint-key');
            selects.forEach(select => {
                const currentVal = select.value;
                select.innerHTML = names.map(v => `<option value="${v}" ${v === currentVal ? 'selected' : ''}>${v}</option>`).join('');
            });
        }

        function toggleCountryChip(chip) {
            chip.classList.toggle('selected');
        }

        function addCustomCountryChip(button, fieldName) {
            const wrapper = button.closest('.wallet-country-chips-wrapper');
            if (!wrapper) return;
            const input = wrapper.querySelector('.wallet-input-custom-country');
            if (!input) return;
            const code = String(input.value || '').toUpperCase().trim().replace(/[^A-Z]/g, '');
            if (!code) return;

            const list = wrapper.querySelector('.country-chips-list');
            let existingChip = Array.from(list.querySelectorAll('.country-chip')).find(c => c.dataset.country === code);
            if (existingChip) {
                existingChip.classList.add('selected');
            } else {
                const newChip = document.createElement('span');
                newChip.className = 'country-chip selected';
                newChip.onclick = function () { toggleCountryChip(this); };
                newChip.dataset.country = code;
                newChip.textContent = code;
                list.appendChild(newChip);
            }
            input.value = '';
        }

        function addCustomModalCountryChip(wrapperId, inputId) {
            const input = document.getElementById(inputId);
            if (!input) return;
            const code = String(input.value || '').toUpperCase().trim().replace(/[^A-Z]/g, '');
            if (!code) return;

            const wrapper = document.getElementById(wrapperId);
            if (!wrapper) return;
            let existingChip = Array.from(wrapper.querySelectorAll('.country-chip')).find(c => c.dataset.country === code);
            if (existingChip) {
                existingChip.classList.add('selected');
            } else {
                const newChip = document.createElement('span');
                newChip.className = 'country-chip selected';
                newChip.onclick = function () { toggleCountryChip(this); };
                newChip.dataset.country = code;
                newChip.textContent = code;
                wrapper.appendChild(newChip);
            }
            input.value = '';
        }

        function renderModalCountryChips(wrapperId, selectedList) {
            const wrapper = document.getElementById(wrapperId);
            if (!wrapper) return;
            const popular = ['GLOBAL', 'IN', 'BD', 'PK', 'NP', 'LK', 'US', 'GB', 'CA', 'AE'];
            let arr = [];
            if (Array.isArray(selectedList)) {
                arr = selectedList;
            } else if (typeof selectedList === 'string' && selectedList.trim()) {
                arr = selectedList.split(',').map(s => s.trim());
            }

            const selectedNormalized = arr.map(c => String(c).toUpperCase().trim()).filter(Boolean);
            const all = Array.from(new Set([...popular, ...selectedNormalized])).map(c => c.toUpperCase().trim()).filter(Boolean);

            wrapper.innerHTML = all.map(country => {
                const isSelected = selectedNormalized.includes(country);
                return `<span class="country-chip ${isSelected ? 'selected' : ''}" onclick="toggleCountryChip(this)" data-country="${country}">${country}</span>`;
            }).join('');
        }

        async function toggleWalletMethodEnabled(checkbox, methodId) {
            const isChecked = !!checkbox.checked;
            const card = checkbox.closest('.wallet-card, .wallet-method-card');
            const selectedApp = String(card?.dataset?.appName || document.getElementById('appSelect')?.value || document.body.getAttribute('data-active-app') || ACTIVE_APP_NAME || '').trim();

            if (card) {
                const badge = card.querySelector('.wallet-badge.badge-active, .wallet-badge.badge-disabled');
                if (badge) {
                    badge.className = `wallet-badge ${isChecked ? 'badge-active' : 'badge-disabled'}`;
                    badge.textContent = isChecked ? '● Active' : '● Disabled';
                }
            }

            showToast(`Updating ${methodId} status to ${isChecked ? 'Active' : 'Disabled'}...`, 'info');
            try {
                const res = await fetch('/wallet-catalog/method', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        selectedApp,
                        methodId,
                        enabled: isChecked
                    })
                });

                const json = await res.json();
                if (!res.ok || !json.success) throw new Error(json.message || 'Failed to toggle');

                showToast(`${methodId} is now ${isChecked ? 'Active' : 'Disabled'}`, 'success');
                if (METHODS_MAP && METHODS_MAP[methodId]) {
                    METHODS_MAP[methodId].enabled = isChecked;
                }
                if (card && card.dataset.methodJson) {
                    try {
                        const mObj = JSON.parse(decodeURIComponent(card.dataset.methodJson));
                        mObj.enabled = isChecked;
                        card.dataset.methodJson = encodeURIComponent(JSON.stringify(mObj));
                    } catch (e) {}
                }
            } catch (err) {
                console.error('Toggle error:', err);
                checkbox.checked = !isChecked;
                if (card) {
                    const badge = card.querySelector('.wallet-badge.badge-active, .wallet-badge.badge-disabled');
                    if (badge) {
                        badge.className = `wallet-badge ${!isChecked ? 'badge-active' : 'badge-disabled'}`;
                        badge.textContent = !isChecked ? '● Active' : '● Disabled';
                    }
                }
                showToast(err.message || 'Failed to update status', 'error');
            }
        }

        function openEditWalletMethodModal(methodId, btn) {
            try {
                let method = null;
                const idStr = String(methodId || '').trim();

                if (METHODS_MAP && idStr && METHODS_MAP[idStr]) {
                    method = METHODS_MAP[idStr];
                }
                if (!method && btn) {
                    const card = btn.closest('.wallet-card, .wallet-method-card');
                    if (card && card.dataset.methodJson) {
                        try {
                            method = JSON.parse(decodeURIComponent(card.dataset.methodJson));
                        } catch (e) {
                            console.error('Error decoding card JSON:', e);
                        }
                    }
                }
                if (!method && idStr) {
                    try {
                        const safeSelector = (window.CSS && CSS.escape) ? CSS.escape(idStr) : idStr.replace(/["\\]/g, '\\$&');
                        const card = document.querySelector(`.wallet-card[data-method-id="${safeSelector}"], .wallet-method-card[data-method-id="${safeSelector}"]`);
                        if (card && card.dataset.methodJson) {
                            method = JSON.parse(decodeURIComponent(card.dataset.methodJson));
                        }
                    } catch (e) {
                        console.error('Error searching card element:', e);
                    }
                }

                if (!method) {
                    method = { id: idStr, title: idStr, symbol: '₹', rank: 0, enabled: true, autoPayment: false };
                }

                const setField = (id, val) => {
                    const el = document.getElementById(id);
                    if (el) el.value = (val !== undefined && val !== null) ? val : '';
                };

                setField('edit-method-id', method.id || method.methodId || idStr);
                setField('edit-method-title', method.title || '');
                setField('edit-method-symbol', method.symbol || '₹');
                setField('edit-method-rank', method.rank !== undefined ? method.rank : 0);
                setField('edit-method-image', method.image || '');
                setField('edit-method-validators', Array.isArray(method.validators) ? method.validators.join(', ') : (method.validators || ''));
                setField('edit-method-hints', typeof method.hints === 'object' && method.hints !== null ? JSON.stringify(method.hints, null, 2) : String(method.hints || '{}'));
                setField('edit-method-auto-payment', method.autoPayment ? 'true' : 'false');
                setField('edit-method-enabled', method.enabled ? 'true' : 'false');

                renderModalCountryChips('edit-country-chips-wrapper', method.country || []);
                renderModalCountryChips('edit-ex-country-chips-wrapper', method.ex_country || []);

                renderValidatorsConfigurator('edit-validators-configurator', 'edit-method-validators');
