            super_offer: { name: 'Super Offer', icon: 'assets/icons/super.png', error: 'Please complete super offer for redeem', minCount: 1 },
            daily_challenge: { name: 'Daily Challenge / Daily Task', icon: 'assets/icons/badge.png', error: 'Please complete daily task before redeeming', minCount: 1 },
            battle_arena: { name: 'Battle Arena (Matches)', icon: 'assets/icons/battles.png', error: 'Please play at least 1 match in Battle Arena before redeeming', minCount: 1 },
            read_and_earn: { name: 'Read & Earn', icon: 'assets/icons/readd.png', error: 'Please complete Read & Earn task before redeeming', minCount: 1 },
            watch_earn: { name: 'Watch & Earn', icon: 'assets/icons/watch video.png', error: 'Please complete Watch & Earn task before redeeming', minCount: 1 },
            play_games: { name: 'Play Games', icon: 'assets/icons/plygames.png', error: 'Please play games before redeeming', minCount: 1 },
            diamond_catch: { name: 'Diamond Catch', icon: 'assets/icons/emoji.png', error: 'Please play Diamond Catch game before redeeming', minCount: 1 },
            giveaway: { name: 'Giveaway Entry', icon: 'assets/icons/givwy.png', error: "Please join today's giveaway before redeeming", minCount: 1 },
            offerwall: { name: 'Offerwall Task', icon: 'assets/icons/pubscale-logo.png', error: 'Please complete at least 1 offerwall task before redeeming', minCount: 1 },
            survey: { name: 'Surveys', icon: 'assets/icons/bitlabs-logo.png', error: 'Please complete at least 1 survey before redeeming', minCount: 1 },
            daily_checkin: { name: 'Daily Check-in', icon: 'assets/icons/clock.png', error: 'Please claim daily check-in before redeeming', minCount: 1 }
        };

        function onRedeemTaskPresetSelect(val) {
            const keyInput = document.getElementById('modal-task-key-input');
            const nameInput = document.getElementById('modal-task-name-input');
            const iconInput = document.getElementById('modal-task-icon-input');
            const errorInput = document.getElementById('modal-task-error-msg-input');
            const minCountInput = document.getElementById('modal-task-min-count-input');

            if (val === 'custom') {
                if (keyInput) { keyInput.value = ''; keyInput.focus(); }
                if (nameInput) nameInput.value = '';
                if (iconInput) iconInput.value = '';
                if (errorInput) errorInput.value = '';
                if (minCountInput) minCountInput.value = '1';
                return;
            }

            const preset = REDEEM_TASK_PRESETS[val];
            if (preset) {
                if (keyInput) keyInput.value = val;
                if (nameInput) nameInput.value = preset.name;
                if (iconInput) iconInput.value = preset.icon;
                if (errorInput) errorInput.value = preset.error;
                if (minCountInput) minCountInput.value = preset.minCount || 1;
            }
        }

        function openAddRedeemTaskModal() {
            const select = document.getElementById('modal-task-preset-select');
            if (select) {
                select.value = 'super_offer';
                onRedeemTaskPresetSelect('super_offer');
            }
            const modal = document.getElementById('add-redeem-task-modal');
            if (modal) {
                modal.classList.add('is-open');
                modal.style.display = 'flex';
            }
        }

        function closeAddRedeemTaskModal() {
            const modal = document.getElementById('add-redeem-task-modal');
            if (modal) {
                modal.classList.remove('is-open');
                modal.style.display = 'none';
            }
        }

        function submitAddRedeemTaskFromModal() {
            const keyRaw = document.getElementById('modal-task-key-input')?.value || '';
            const nameRaw = document.getElementById('modal-task-name-input')?.value || '';
            const iconRaw = document.getElementById('modal-task-icon-input')?.value || '';
            const minCountRaw = parseInt(document.getElementById('modal-task-min-count-input')?.value, 10) || 1;
            const errorRaw = document.getElementById('modal-task-error-msg-input')?.value || '';

            const cleanKey = keyRaw.trim().toLowerCase().replace(/[^a-z0-9_]/g, '_');
            if (!cleanKey) {
                alert('Please enter a valid unique task key (e.g. super_offer, scratch_card)');
                return;
            }

            const existing = document.querySelector(`#redeem-tasks-table tr[data-task-key="${cleanKey}"]`);
            if (existing) {
                alert(`Task with key "${cleanKey}" already exists in the checklist!`);
                return;
            }

            const taskName = nameRaw.trim() || cleanKey;
            const errorMsg = errorRaw.trim() || `Please complete ${taskName} before redeeming`;
            const iconPath = iconRaw.trim();

            const tbody = document.querySelector('#redeem-tasks-table tbody');
            if (!tbody) return;

            const iconHtml = iconPath
                ? `<img src="/${escapeWalletHtml(iconPath.replace(/^\/+/, ''))}" alt="${escapeWalletHtml(taskName)}" style="width: 28px; height: 28px; object-fit: contain; border-radius: 6px;" onerror="this.style.display='none'" />`
                : `<div style="width: 28px; height: 28px; border-radius: 6px; background: #f1f5f9; display: flex; align-items: center; justify-content: center; font-size: 13px; color: #052e1f;"><i class="fa-solid fa-star"></i></div>`;

            const tr = document.createElement('tr');
            tr.setAttribute('data-task-key', cleanKey);
            tr.setAttribute('data-task-name', taskName);
            tr.setAttribute('data-task-icon', iconPath);
            tr.className = 'task-row-highlight';
            tr.style.borderBottom = '1px solid #f1f5f9';
            tr.style.transition = 'background 0.15s';
            tr.innerHTML = `
                <td style="padding: 12px 16px; vertical-align: middle;">
                    <label class="toggle-switch" title="Toggle this task requirement">
                        <input type="checkbox" class="task-enable-checkbox" aria-label="Enable ${escapeWalletHtml(taskName)}" checked onchange="highlightTaskRow(this)" />
                        <span class="toggle-track"><span class="toggle-thumb"></span></span>
                    </label>
                </td>
                <td style="padding: 12px 16px; vertical-align: middle;">
                    <div style="display: flex; align-items: center; gap: 10px;">
                        ${iconHtml}
                        <div>
                            <div style="font-weight: 800; color: #0f172a;">${escapeWalletHtml(taskName)}</div>
                            <code style="font-size: 10.5px; background: #f1f5f9; padding: 1px 5px; border-radius: 4px; color: #64748b;">${escapeWalletHtml(cleanKey)}</code>
                        </div>
                    </div>
                </td>
                <td style="padding: 12px 16px; vertical-align: middle;">
                    <input type="number" class="task-min-count-input" aria-label="Minimum count for ${escapeWalletHtml(taskName)}" min="1" value="${minCountRaw}" style="width: 80px; padding: 6px 10px; font-weight: 700; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 13px; text-align: center;" />
                </td>
                <td style="padding: 12px 16px; vertical-align: middle;">
                    <input type="text" class="task-error-msg-input" aria-label="Error message for ${escapeWalletHtml(taskName)}" value="${escapeWalletHtml(errorMsg)}" style="width: 100%; padding: 7px 12px; font-weight: 600; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 13px; color: #0f172a;" />
                </td>
                <td style="padding: 12px 16px; vertical-align: middle; text-align: center;">
                    <button type="button" onclick="removeRedeemTaskRow(this)" aria-label="Remove Task" class="btn-sm danger" style="padding: 6px 10px; border-radius: 8px; font-size: 11px; cursor: pointer; border: 1px solid #fee2e2; background: #fef2f2; color: #ef4444;" title="Delete Task from Checklist"><i class="fa-solid fa-trash-can"></i></button>
                </td>
            `;

            tbody.appendChild(tr);
            closeAddRedeemTaskModal();
            updateRedeemChecklistBadge();
            if (typeof showToast === 'function') {
                showToast(`Added "${taskName}". Click "Save Checklist" to apply.`, 'success');
            }
        }

        function removeRedeemTaskRow(btn) {
            const tr = btn.closest('tr');
            if (!tr) return;
            const taskName = tr.getAttribute('data-task-name') || tr.getAttribute('data-task-key') || 'this task';
            if (!confirm(`Are you sure you want to remove "${taskName}" from the checklist?`)) return;
            tr.remove();
            updateRedeemChecklistBadge();
            if (typeof showToast === 'function') {
                showToast(`Removed "${taskName}". Click "Save Checklist" to persist.`, 'info');
            }
        }

        async function savePayoutAndRedeemSettings(btn) {
            const saveBtn = btn || document.getElementById('btn-save-payout-settings');
            const originalHtml = saveBtn ? saveBtn.innerHTML : '';
            if (saveBtn) {
                saveBtn.disabled = true;
                saveBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Saving...';
            }

            try {
                const dailyMaxPayout = parseInt(document.getElementById('walletDailyMaxPayout')?.value, 10) || 0;
                const redeemCheckEnabled = document.getElementById('walletRedeemCheckEnabled')?.checked || false;

                const rows = document.querySelectorAll('#redeem-tasks-table tbody tr');
                const rules = [];
                rows.forEach(tr => {
                    const taskKey = tr.getAttribute('data-task-key');
                    const taskName = tr.getAttribute('data-task-name') || taskKey;
                    const icon = tr.getAttribute('data-task-icon') || '';
                    const minCount = parseInt(tr.querySelector('.task-min-count-input')?.value, 10) || 1;
                    const errorMessage = tr.querySelector('.task-error-msg-input')?.value || '';
                    const enabled = tr.querySelector('.task-enable-checkbox')?.checked || false;

                    if (taskKey) {
                        rules.push({ taskKey, taskName, icon, minCount, errorMessage, enabled });
                    }
                });

                const hideDenomEnabledElem = document.getElementById('walletHideDenomEnabled');
                const hideDenomEnabled = hideDenomEnabledElem ? Boolean(hideDenomEnabledElem.checked) : false;
                const hideDenomThreshElem = document.getElementById('walletHideDenomThreshold');
                const hideDenomThreshold = hideDenomThreshElem ? (parseFloat(hideDenomThreshElem.value) || 99) : 99;
                const hideDenomCountElem = document.getElementById('walletHideDenomCount');
                const hideDenomCount = hideDenomCountElem ? (parseInt(hideDenomCountElem.value, 10) || 1) : 1;
                const hideDenomActionElem = document.getElementById('walletHideDenomActionToggle');
                const hideDenomActionToggle = hideDenomActionElem ? Boolean(hideDenomActionElem.checked) : true;
                const hideMode = hideDenomActionToggle ? 'hide' : 'out_of_stock';
                const hideDenomCondElem = document.getElementById('walletHideDenomCondition');
                const hideDenomCondition = hideDenomCondElem ? (hideDenomCondElem.value || 'always') : 'always';
                const hideDenomTargetElem = document.getElementById('walletHideDenomTargetCount');
                const hideDenomTargetCount = hideDenomTargetElem ? (parseInt(hideDenomTargetElem.value, 10) || 0) : 0;

                const payload = {
                    dailyMaxPayout,
                    redeemCheck: {
                        enabled: redeemCheckEnabled,
                        rules
                    },
                    hideDenomination: {
                        enabled: hideDenomEnabled,
                        thresholdPercent: hideDenomThreshold,
                        hideCount: hideDenomCount,
                        hideMode: hideMode,
                        redeemCondition: hideDenomCondition,
                        targetRedeemCount: hideDenomTargetCount
                    }
                };

                const res = await fetch('/manage-wallet/save-settings', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                const data = await res.json();
                if (!res.ok || !data.success) {
                    throw new Error(data.message || 'Failed to save payout settings');
                }

                showToast('Payout limits and Redeem Check rules saved successfully!', 'success');
                updateRedeemChecklistBadge();
                const badge = document.getElementById('payout-settings-status-badge');
                if (badge) {
                    badge.textContent = '● Saved';
                    badge.style.color = '#16a34a';
                    badge.style.background = 'rgba(22, 163, 74, 0.1)';
                }
            } catch (err) {
                console.error('Save payout settings error:', err);
                alert('Save failed: ' + (err.message || err));
            } finally {
                if (saveBtn) {
                    saveBtn.disabled = false;
                    saveBtn.innerHTML = originalHtml;
                }
            }
        }

        // Global exports for inline HTML attributes
        window.openEditWalletMethodModal = openEditWalletMethodModal;
        window.closeEditWalletMethodModal = closeEditWalletMethodModal;
        window.submitEditWalletMethod = submitEditWalletMethod;
        window.openAddWalletMethodModal = openAddWalletMethodModal;
        window.closeAddWalletMethodModal = closeAddWalletMethodModal;
        window.submitAddWalletMethod = submitAddWalletMethod;
        window.onWalletPresetChange = onWalletPresetChange;
        window.toggleWalletMethodEnabled = toggleWalletMethodEnabled;
        window.toggleCountryChip = toggleCountryChip;
        window.addCustomCountryChip = addCustomCountryChip;
        window.addCustomModalCountryChip = addCustomModalCountryChip;
        window.renderModalCountryChips = renderModalCountryChips;
        window.duplicateWalletMethod = duplicateWalletMethod;
        window.deleteWalletMethod = deleteWalletMethod;
        window.saveWalletDenomination = saveWalletDenomination;
        window.deleteWalletDenomination = deleteWalletDenomination;
        window.changeApp = changeApp;
        window.showToast = showToast;
        window.addValidatorRow = addValidatorRow;
        window.addHintRow = addHintRow;
        window.renderValidatorsConfigurator = renderValidatorsConfigurator;
        window.renderHintsConfigurator = renderHintsConfigurator;
        window.toggleRedeemCheckSection = toggleRedeemCheckSection;
        window.openRedeemChecklistModal = openRedeemChecklistModal;
        window.closeRedeemChecklistModal = closeRedeemChecklistModal;
        window.updateRedeemChecklistBadge = updateRedeemChecklistBadge;
        window.highlightTaskRow = highlightTaskRow;
        window.openAddRedeemTaskModal = openAddRedeemTaskModal;
        window.closeAddRedeemTaskModal = closeAddRedeemTaskModal;
        window.onRedeemTaskPresetSelect = onRedeemTaskPresetSelect;
        window.submitAddRedeemTaskFromModal = submitAddRedeemTaskFromModal;
        window.addCustomRedeemTaskRow = openAddRedeemTaskModal;
        window.removeRedeemTaskRow = removeRedeemTaskRow;
        window.removeCustomRedeemTaskRow = removeRedeemTaskRow;
        function toggleHideDenomFields(enabled) {
            const controls = document.getElementById('hide-denom-controls');
            if (controls) {
                controls.style.opacity = enabled ? '1' : '0.5';
                controls.style.pointerEvents = enabled ? 'auto' : 'none';
            }
        }

        function toggleRedeemConditionInput(val) {
            const wrapper = document.getElementById('target-redeem-count-wrapper');
            if (wrapper) {
                wrapper.style.display = (val === 'always') ? 'none' : 'block';
            }
        }

        function toggleHideActionMode(isChecked) {
            const badge = document.getElementById('hideModeBadge');
            const text = document.getElementById('hideModeText');
            if (badge) {
                badge.innerText = isChecked ? 'Hide Card' : 'Out of Stock';
                badge.style.background = isChecked ? '#e0f2fe' : '#fef3c7';
                badge.style.color = isChecked ? '#0369a1' : '#b45309';
            }
            if (text) {
                text.innerText = isChecked ? 'Hide Card' : 'Out of Stock';
            }
        }

        window.toggleHideDenomFields = toggleHideDenomFields;
        window.toggleHideActionMode = toggleHideActionMode;
        window.toggleRedeemConditionInput = toggleRedeemConditionInput;
        window.savePayoutAndRedeemSettings = savePayoutAndRedeemSettings;
    })();
    </script>
</body>

</html>
