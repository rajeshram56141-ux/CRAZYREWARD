                    <input type="hidden" id="modalRewardTiersJson" name="rewardTiersJson" value="" />
                    <input type="hidden" id="modalIsActive" name="isActive" value="true" />
                    <input type="hidden" id="modalAutoRewardProcess" name="autoRewardProcess" value="true" />
                    <input type="hidden" id="modalShowWinnersOnly" name="showWinnersOnly" value="true" />

                    <!-- Leaderboard Title -->
