    <script>
        function switchTab(tabId, btn) {
            const contents = document.querySelectorAll('.tab-content');
            contents.forEach(c => c.classList.remove('active'));

            const buttons = document.querySelectorAll('.tab-btn-pill');
            buttons.forEach(b => b.classList.remove('active'));

            const target = document.getElementById(tabId);
            if (target) target.classList.add('active');
            if (btn) btn.classList.add('active');
        }

        let currentWinnersList = [];
        let currentCycleId = '';
        let currentCyclePayoutStatus = 'PENDING';

        function openWinnersModal(btn) {
            currentCycleId = btn.getAttribute('data-cycle-id') || '';
            currentCyclePayoutStatus = btn.getAttribute('data-payout-status') || 'PENDING';
            const rawSnapshotEncoded = btn.getAttribute('data-snapshot') || '';
            
            document.getElementById('modalCycleTitle').innerText = `Cycle Winners (${currentCycleId})`;
            document.getElementById('modalCycleSubTitle').innerText = `Payout Status: ${currentCyclePayoutStatus} • Review and release individual or bulk prizes`;
            document.getElementById('winnersSearchInput').value = '';

            try {
                const jsonStr = decodeURIComponent(rawSnapshotEncoded);
                currentWinnersList = JSON.parse(jsonStr) || [];
            } catch(e) {
                currentWinnersList = [];
            }

            filterWinnersList();
            document.getElementById('winnersModal').classList.add('open');
        }

        function filterWinnersList() {
            const q = (document.getElementById('winnersSearchInput').value || '').toLowerCase().trim();
            const tbody = document.getElementById('modalWinnersBody');
            tbody.innerHTML = '';

            const filtered = currentWinnersList.filter(w => {
                if (!q) return true;
                const name = (w.userName || '').toLowerCase();
                const uid = (w.userId || '').toLowerCase();
                return name.includes(q) || uid.includes(q);
            });

            document.getElementById('winnersCountBadge').innerText = `${filtered.length} of ${currentWinnersList.length} Winners`;

            if (filtered.length === 0) {
                tbody.innerHTML = `<tr><td colspan="5" style="text-align: center; color: var(--muted); padding: 24px;">No matching winners found for "${q}".</td></tr>`;
                return;
            }

            filtered.forEach(w => {
                const rNum = parseInt(w.rank) || 99;
                const rClass = rNum <= 3 ? `rank-tag-${rNum}` : 'rank-tag-def';
                const isPaid = (currentCyclePayoutStatus === 'PROCESSED') || (w.isPaid === true);
                const coins = Number(w.projectedPrizeCoins || w.coinsAwarded || 0);

                let avatarHtml = '';
                const initial = (w.userName || 'P').charAt(0).toUpperCase();
                if (w.avatar && w.avatar !== 'null') {
                    avatarHtml = `
                        <img src="${w.avatar}" alt="avatar" style="width: 34px; height: 34px; border-radius: 50%; object-fit: cover; border: 1.5px solid #cbd5e1;" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                        <div style="display: none; width: 34px; height: 34px; border-radius: 50%; background: #e0e7ff; color: #4338ca; font-weight: 800; font-size: 13px; align-items: center; justify-content: center;">${initial}</div>
                    `;
                } else {
                    avatarHtml = `<div style="width: 34px; height: 34px; border-radius: 50%; background: #e0e7ff; color: #4338ca; font-weight: 800; font-size: 13px; display: flex; align-items: center; justify-content: center;">${initial}</div>`;
                }

                let actionHtml = '';
                if (isPaid) {
                    actionHtml = `<span class="status-tag-active" style="padding: 4px 10px; font-size: 11px;">PAID</span>`;
                } else {
                    if (coins > 0) {
                        actionHtml = `<button type="button" class="btn-action" style="padding: 5px 12px; font-size: 11.5px; background: #16a34a; border-color: #16a34a;" onclick="paySingleUser('${currentCycleId}', '${w.userId}', this)">Pay User</button>`;
                    } else {
                        actionHtml = `<span style="color: var(--muted); font-size: 12px; font-weight: 600;">No Prize</span>`;
                    }
                }

                tbody.innerHTML += `
                    <tr>
                        <td><span class="${rClass}">Rank ${w.rank}</span></td>
                        <td>
                            <div style="display: flex; align-items: center; justify-content: space-between; gap: 10px;">
                                <div style="display: flex; align-items: center; gap: 10px;">
                                    ${avatarHtml}
                                    <div>
                                        <div style="font-weight: 800; color: var(--text); font-size: 13.5px;">${w.userName || 'Player'}</div>
                                        <div style="font-size: 11px; color: var(--muted); font-family: monospace;">${w.userId || ''}</div>
                                    </div>
                                </div>
                                <button type="button" class="btn-card-edit" style="font-size: 11px; padding: 4px 10px; border-radius: 6px; background: #e0e7ff; color: #4338ca; border: 1px solid #c7d2fe; white-space: nowrap; font-weight: 700; cursor: pointer; display: flex; align-items: center; gap: 4px;"
                                    data-user-id="${w.userId}"
                                    data-cycle-id="${currentCycleId}"
                                    onclick="openUserMatchesModal(this)"
                                    title="View player match history for this leaderboard">
                                    <svg width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                                    View
                                </button>
                            </div>
                        </td>
                        <td>${w.winsCount || 0} Wins <span style="color: var(--muted); font-size: 12px;">(${w.totalSpeedPoints || 0} pts)</span></td>
                        <td style="font-weight: 800; color: #052e1f;">${coins > 0 ? (coins.toLocaleString() + ' Coins') : '-'}</td>
                        <td>${actionHtml}</td>
                    </tr>
                `;
            });
        }

        async function paySingleUser(cycleId, userId, btn) {
            if (!confirm(`Are you sure you want to release prize coins to User ID: ${userId}?`)) return;
            
            btn.disabled = true;
            btn.innerText = 'Processing...';

            try {
                const res = await fetch('/admin/battle-arena/leaderboard/payout/single-user', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ cycleId, userId })
                });
                const data = await res.json();

                if (data.success) {
                    btn.parentElement.innerHTML = '<span class="status-tag-active" style="padding: 4px 10px; font-size: 11px;">PAID</span>';
                    const found = currentWinnersList.find(x => x.userId === userId);
                    if (found) found.isPaid = true;
                    alert(data.message || 'Prize coins credited successfully!');
                    if (data.allPaid) {
                        setTimeout(() => window.location.reload(), 1200);
                    }
                } else {
                    alert(data.message || 'Failed to process payout');
                    btn.disabled = false;
                    btn.innerText = 'Pay User';
                }
            } catch(err) {
                alert('Network error while processing payout: ' + err.message);
                btn.disabled = false;
                btn.innerText = 'Pay User';
            }
        }

        function closeWinnersModal() {
            document.getElementById('winnersModal').classList.remove('open');
        }

        // --- CYCLE MODAL LOGIC (Indian Standard Time: UTC+05:30) ---
        function getLocalIsoString(date) {
            if (!date) return '';
            if (typeof date === 'string') {
                if (date.length === 16 && date.includes('T')) return date;
                if (date.length > 16 && (date.includes('+') || date.endsWith('Z'))) {
                    const d = new Date(date);
                    if (isNaN(d.getTime())) return '';
                    const istTime = new Date(d.getTime() + (5.5 * 60 * 60 * 1000));
                    return istTime.toISOString().slice(0, 16);
                }
            }
            const d = new Date(date);
            if (isNaN(d.getTime())) return '';
            // Shift to IST (UTC + 5 hours 30 mins)
            const istTime = new Date(d.getTime() + (5.5 * 60 * 60 * 1000));
            return istTime.toISOString().slice(0, 16);
        }

        function toggleStatus(val) {
            document.getElementById('modalIsActive').value = val ? 'true' : 'false';
            document.getElementById('statusEnabledOpt').classList.toggle('active', val);
            document.getElementById('statusDisabledOpt').classList.toggle('active', !val);
        }

        function toggleRankingBasis(val) {
            const isPoints = val === 'points';
            document.getElementById('modalRankingBasis').value = isPoints ? 'points' : 'wins';
            document.getElementById('rankingPointsOpt').classList.toggle('active', isPoints);
            document.getElementById('rankingWinsOpt').classList.toggle('active', !isPoints);
            const help = document.getElementById('rankingBasisHelp');
            if (help) {
                help.innerText = isPoints
                    ? 'Players ranked primarily by total Speed / Battle Points. Match victories used as tie-breaker.'
                    : 'Players ranked primarily by total match victories. Speed points used as tie-breaker.';
            }
        }

        function toggleAutoReschedule(val) {
            document.getElementById('modalAutoReschedule').value = val ? 'true' : 'false';
            document.getElementById('rescheduleOnOpt').classList.toggle('active', val);
            document.getElementById('rescheduleOffOpt').classList.toggle('active', !val);
        }

        function toggleAutoReward(val) {
            document.getElementById('modalAutoRewardProcess').value = val ? 'true' : 'false';
            document.getElementById('rewardAutoOpt').classList.toggle('active', val);
            document.getElementById('rewardManualOpt').classList.toggle('active', !val);
        }

        function toggleShowWinners(val) {
            document.getElementById('modalShowWinnersOnly').value = val ? 'true' : 'false';
            document.getElementById('winnersOnOpt').classList.toggle('active', val);
            document.getElementById('winnersOffOpt').classList.toggle('active', !val);
        }

        function renderRewardTiers(tiers) {
            const container = document.getElementById('modalRewardTiersContainer');
            container.innerHTML = '';
            if (tiers && tiers.length > 0) {
                tiers.forEach(t => {
                    let rangeStr = t.range;
                    if (!rangeStr && t.rankStart !== undefined) {
                        rangeStr = t.rankStart === t.rankEnd ? String(t.rankStart) : `${t.rankStart}-${t.rankEnd}`;
                    }
                    addTierRow(rangeStr, t.coins, t.iconUrl || '', t.customText || '');
                });
            } else {
                addTierRow('', '', '', '');
            }
        }

        function addTierRow(range, coins, iconUrl, customText) {
            const container = document.getElementById('modalRewardTiersContainer');
            const row = document.createElement('div');
            row.className = 'tier-item-row';
            row.innerHTML = `
                <input type="text" class="form-control tier-range-input" placeholder="Rank (1 or 4-10)" value="${range || ''}" required />
                <input type="number" class="form-control tier-coin-input" placeholder="Coins" value="${coins !== undefined && coins !== null && coins !== '' ? coins : ''}" min="0" />
                <input type="url" class="form-control tier-icon-input" placeholder="Icon URL (Opt)" value="${iconUrl || ''}" />
                <input type="text" class="form-control tier-text-input" placeholder="Prize Text (Opt)" value="${customText || ''}" />
                <button type="button" class="btn-trash-row" onclick="removeTierRow(this)" title="Remove Tier">✕</button>
            `;
            container.appendChild(row);
        }

        function removeTierRow(btn) {
            const row = btn.closest('.tier-item-row');
            if (row) row.remove();
        }

        function clearAllTiers() {
            document.getElementById('modalRewardTiersContainer').innerHTML = '';
        }

        function openCreateCycleModal() {
            document.getElementById('modalConfigKey').value = '';
            document.getElementById('modalHeadingTitle').innerText = 'Create Leaderboard';
            document.getElementById('modalTitle').value = '';
            toggleStatus(true);
            toggleRankingBasis('wins');
            toggleAutoReschedule(true);
            toggleAutoReward(true);
            toggleShowWinners(true);

            const now = new Date();
            const nextWeek = new Date(Date.now() + 7 * 24 * 60 * 60 * 1000);
            document.getElementById('modalStartTime').value = getLocalIsoString(now);
            document.getElementById('modalPayoutTime').value = getLocalIsoString(nextWeek);

            const container = document.getElementById('modalRewardTiersContainer');
            container.innerHTML = '';
            addTierRow('', '', '', '');
            document.getElementById('cycleModal').classList.add('open');
        }

        function handleEditBtnClick(btn) {
            const key = btn.getAttribute('data-config-key') || '';
            const title = btn.getAttribute('data-title') || '';
            const isActive = btn.getAttribute('data-active') === 'true';
            const rankingBasis = btn.getAttribute('data-ranking-basis') || 'wins';
            const autoReschedule = btn.getAttribute('data-auto-reschedule') !== 'false';
            const autoReward = btn.getAttribute('data-auto-reward') === 'true';
            const startTime = btn.getAttribute('data-start-time') || '';
            const payoutTime = btn.getAttribute('data-payout-time') || '';
            const showWinners = btn.getAttribute('data-show-winners') === 'true';
            const rawTiers = btn.getAttribute('data-tiers') || '[]';

            document.getElementById('modalConfigKey').value = key;
            document.getElementById('modalHeadingTitle').innerText = `Edit ${title || 'Leaderboard'}`;
            document.getElementById('modalTitle').value = title || 'Battle Leaderboard';

            toggleStatus(isActive);
            toggleRankingBasis(rankingBasis);
            toggleAutoReschedule(autoReschedule);
            toggleAutoReward(autoReward);
            toggleShowWinners(showWinners);

            const startVal = getLocalIsoString(startTime) || getLocalIsoString(new Date());
            const payoutVal = getLocalIsoString(payoutTime) || getLocalIsoString(new Date(Date.now() + 7 * 24 * 60 * 60 * 1000));

            document.getElementById('modalStartTime').value = startVal;
            document.getElementById('modalPayoutTime').value = payoutVal;

            let parsedTiers = [];
            try {
                parsedTiers = JSON.parse(rawTiers);
            } catch(e) {}
            renderRewardTiers(parsedTiers);

            document.getElementById('cycleModal').classList.add('open');
        }

        function closeCycleModal() {
            document.getElementById('cycleModal').classList.remove('open');
        }

        function saveCycleForm(e) {
            const rangeInputs = document.querySelectorAll('.tier-range-input');
            const coinInputs = document.querySelectorAll('.tier-coin-input');
            const iconInputs = document.querySelectorAll('.tier-icon-input');
            const textInputs = document.querySelectorAll('.tier-text-input');
            const tiers = [];

            for (let i = 0; i < rangeInputs.length; i++) {
                const rVal = rangeInputs[i].value.trim();
                const cVal = Number(coinInputs[i].value) || 0;
                const iconVal = iconInputs[i] ? iconInputs[i].value.trim() : '';
                const textVal = textInputs[i] ? textInputs[i].value.trim() : '';
                if (rVal) {
                    tiers.push({
                        range: rVal,
                        coins: cVal,
                        iconUrl: iconVal,
                        customText: textVal
                    });
                }
            }

            document.getElementById('modalRewardTiersJson').value = JSON.stringify(tiers);

            const sVal = document.getElementById('modalStartTime').value;
            const pVal = document.getElementById('modalPayoutTime').value;
            if (sVal) {
                document.getElementById('modalStartTimeIso').value = sVal.includes('+') || sVal.endsWith('Z') ? sVal : `${sVal}:00+05:30`;
            }
            if (pVal) {
                document.getElementById('modalPayoutTimeIso').value = pVal.includes('+') || pVal.endsWith('Z') ? pVal : `${pVal}:00+05:30`;
            }
            return true;
        }

        // --- USER MATCH HISTORY POPUP MODAL LOGIC ---
        async function openUserMatchesModal(btn) {
            const userId = btn.getAttribute('data-user-id');
            const cycleId = btn.getAttribute('data-cycle-id');
            
            document.getElementById('userMatchesHeaderTitle').innerText = 'Player Match History';
            document.getElementById('userMatchesSubTitle').innerText = `Loading matches for ID: ${userId}...`;
            document.getElementById('userMatchesLoading').style.display = 'block';
            document.getElementById('userMatchesTableWrapper').style.display = 'none';
            document.getElementById('userMatchesSummary').innerHTML = '';
            document.getElementById('userMatchesAvatarContainer').innerHTML = `<div style="width: 44px; height: 44px; border-radius: 50%; background: rgba(255,255,255,0.2); color: #ffffff; font-weight: 800; font-size: 18px; display: flex; align-items: center; justify-content: center;">P</div>`;
            document.getElementById('userMatchesModal').classList.add('open');

            try {
                const res = await fetch(`/admin/battle-arena/leaderboard/user-matches/${encodeURIComponent(cycleId)}/${encodeURIComponent(userId)}`);
                const data = await res.json();

                if (!data.success) {
                    document.getElementById('userMatchesLoading').innerText = 'Failed to load matches: ' + (data.message || 'Error');
                    return;
                }

                const u = data.user || {};
                const matches = data.matches || [];

                document.getElementById('userMatchesHeaderTitle').innerText = `${u.name || 'Player'}`;
                document.getElementById('userMatchesSubTitle').innerText = `User ID: ${u.userId} | Leaderboard ID: ${cycleId}`;

                if (u.avatar && u.avatar !== 'null') {
                    document.getElementById('userMatchesAvatarContainer').innerHTML = `
                        <img src="${u.avatar}" alt="avatar" style="width: 44px; height: 44px; border-radius: 50%; object-fit: cover; border: 2px solid rgba(255,255,255,0.7);" onerror="this.outerHTML='<div style=\\'width: 44px; height: 44px; border-radius: 50%; background: rgba(255,255,255,0.2); color: #ffffff; font-weight: 800; font-size: 18px; display: flex; align-items: center; justify-content: center;\\'>${(u.name || 'P').charAt(0).toUpperCase()}</div>';" />
                    `;
                } else {
                    document.getElementById('userMatchesAvatarContainer').innerHTML = `
                        <div style="width: 44px; height: 44px; border-radius: 50%; background: rgba(255,255,255,0.2); color: #ffffff; font-weight: 800; font-size: 18px; display: flex; align-items: center; justify-content: center;">
                            ${(u.name || 'P').charAt(0).toUpperCase()}
                        </div>
                    `;
                }

                document.getElementById('userMatchesSummary').innerHTML = `
                    <div style="background: #f8fafc; border: 1px solid var(--border); border-radius: 10px; padding: 10px 14px; text-align: center;">
                        <div style="font-size: 11px; font-weight: 700; color: var(--muted); text-transform: uppercase;">Total Matches</div>
                        <div style="font-size: 17px; font-weight: 800; color: var(--text);">${u.totalMatchesPlayed || 0}</div>
                    </div>
                    <div style="background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 10px; padding: 10px 14px; text-align: center;">
                        <div style="font-size: 11px; font-weight: 700; color: #16a34a; text-transform: uppercase;">Total Wins</div>
                        <div style="font-size: 17px; font-weight: 800; color: #15803d;">${u.totalWins || 0}</div>
                    </div>
                    <div style="background: #faf5ff; border: 1px solid #e9d5ff; border-radius: 10px; padding: 10px 14px; text-align: center;">
                        <div style="font-size: 11px; font-weight: 700; color: #9333ea; text-transform: uppercase;">Total Speed Points</div>
                        <div style="font-size: 17px; font-weight: 800; color: #7e22ce;">${u.totalSpeedPoints || 0} Pts</div>
                    </div>
                `;

                const tbody = document.getElementById('userMatchesBody');
                tbody.innerHTML = '';

                if (matches.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="6" style="text-align: center; color: var(--muted); padding: 24px;">No free battle matches found for this player in this leaderboard window.</td></tr>';
                } else {
                    matches.forEach(m => {
                        const dateStr = m.playedAt ? new Date(m.playedAt).toLocaleString('en-IN', { timeZone: 'Asia/Kolkata', day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit', hour12: true }) : 'N/A';
                        const opp = m.opponentStats || {};
                        const my = m.myStats || {};
                        
                        let resultBadge = '';
                        if (m.isWinner) {
                            resultBadge = '<span class="status-tag-active" style="padding: 3px 10px; font-size: 11px; font-weight: 800;">WIN</span>';
                        } else if (m.isTie) {
                            resultBadge = '<span class="status-tag-manual" style="padding: 3px 10px; font-size: 11px; font-weight: 800;">TIED</span>';
                        } else {
                            resultBadge = '<span class="status-tag-inactive" style="padding: 3px 10px; font-size: 11px; font-weight: 800;">LOSS</span>';
                        }

                        tbody.innerHTML += `
                            <tr>
                                <td style="font-family: monospace; font-size: 11.5px; font-weight: 800; color: #0f172a; white-space: nowrap;">
                                    ${m.matchId || '-'}
                                </td>
                                <td style="font-size: 12px; font-weight: 600; white-space: nowrap;">${dateStr}</td>
                                <td>
                                    <div style="display: flex; align-items: center; gap: 8px;">
                                        <div style="width: 28px; height: 28px; border-radius: 50%; background: #f1f5f9; display: flex; align-items: center; justify-content: center; font-size: 11px; font-weight: 700; color: #475569;">
                                            ${opp.isBot ? '🤖' : (opp.name || 'O').charAt(0).toUpperCase()}
                                        </div>
                                        <div>
                                            <span style="font-weight: 700; color: var(--text);">${opp.name}</span>
                                            ${opp.isBot ? '<span style="font-size: 10px; background: #e2e8f0; color: #475569; padding: 1px 5px; border-radius: 4px; margin-left: 4px; font-weight: 700;">BOT</span>' : ''}
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <strong style="color: #052e1f; font-size: 13.5px;">${my.score || 0} Pts</strong>
                                    <div style="font-size: 11px; color: var(--muted); font-weight: 600;">${my.timeSec || 0}s | ${my.correct || 0}✓ ${my.wrong || 0}✗</div>
                                </td>
                                <td>
                                    <strong style="color: #475569; font-size: 13.5px;">${opp.score || 0} Pts</strong>
                                    <div style="font-size: 11px; color: var(--muted); font-weight: 600;">${opp.timeSec || 0}s</div>
                                </td>
                                <td>${resultBadge}</td>
                            </tr>
                        `;
                    });
                }

                document.getElementById('userMatchesLoading').style.display = 'none';
                document.getElementById('userMatchesTableWrapper').style.display = 'block';
            } catch (err) {
                document.getElementById('userMatchesLoading').innerText = 'Error loading matches: ' + err.message;
            }
        }

        function closeUserMatchesModal() {
            document.getElementById('userMatchesModal').classList.remove('open');
        }

        // Close modal on click outside
        window.addEventListener('click', (e) => {
            const cycleModal = document.getElementById('cycleModal');
            const winnersModal = document.getElementById('winnersModal');
            const userMatchesModal = document.getElementById('userMatchesModal');
            if (e.target === cycleModal) closeCycleModal();
            if (e.target === winnersModal) closeWinnersModal();
            if (e.target === userMatchesModal) closeUserMatchesModal();
        });

        document.addEventListener('DOMContentLoaded', () => {
            const urlParams = new URLSearchParams(window.location.search);
            const activeTabParam = urlParams.get('tab');
            if (activeTabParam === 'current-standings') {
                const btn = document.querySelector('[data-tab="current-standings"]');
                if (btn) switchTab('current-standings', btn);
            } else if (activeTabParam === 'historical-records') {
                const btn = document.querySelector('[data-tab="historical-records"]');
                if (btn) switchTab('historical-records', btn);
            } else if (activeTabParam === 'cycle-settings') {
                const btn = document.querySelector('[data-tab="cycle-settings"]');
                if (btn) switchTab('cycle-settings', btn);
            }
        });
    </script>
    <script src="/js/admin.js"></script>
</body>
</html>
